// Constructing a nonexistent NO-PAYLOAD variant used to be silently accepted
// (it typed as the union and emitted an undeclared fc__u_tag_zzz). The
// payload form u.zzz(5) always checked; the non-call path needs the same
// judgment.
union u =
    | a(i32)
    | b

let main = (args: str[]) ->
    let x = u.zzz
    0
