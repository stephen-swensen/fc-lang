// A raw newline inside a string literal is a lexer error (unterminated
// string). Regression: it used to be accepted and emitted verbatim, so the C
// string literal spanned two lines and gcc/clang reported a missing
// terminating " character.
let main = (args: str[]) ->
    let s = "abc
def"
    assert(s.len == 7)
    0
