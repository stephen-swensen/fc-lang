// An interpolation precision above the guaranteed range of a C int (32767),
// such as %.4294967297s, is a compile error. Regression: the digits used to
// wrap through 32 bits, so this precision became 1 and the 5-char string
// silently rendered as "h".
let main = (args: str[]) ->
    let s = "hello"
    let t = "%.4294967297s{s}"
    assert(t.len == 5)
    0
