// `??` sequences in a string literal are ordinary bytes: "what??!" is 7 bytes
// ending in `?`, `?`, `!`. Regression: they used to be emitted raw into the C
// string, which gcc/clang -std=c11 reject under -Werror=trigraphs ("trigraph
// ??! converted to |") and a conforming C11 translator would rewrite.
let main = (args: str[]) ->
    let s = "what??!"
    assert(s.len == 7)
    assert(s[4] == 63)
    assert(s[5] == 63)
    assert(s[6] == 33)
    0
