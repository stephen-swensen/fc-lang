// BUG (bugsearch 2026-07-18): `??` sequences in string literals are emitted
// raw into the C string — gcc/clang -std=c11 reject with -Werror=trigraphs
// ("trigraph ??! converted to |"), and a conforming C11 translator would
// silently rewrite the bytes. The emitter needs to escape `?` runs.
let main = (args: str[]) ->
    let s = "what??!"
    assert(s.len == 7)
    assert(s[4] == 63)
    assert(s[5] == 63)
    assert(s[6] == 33)
    0
