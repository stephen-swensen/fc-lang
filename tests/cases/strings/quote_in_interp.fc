// An escaped double quote in the static text of an interpolated string is a
// single `"` byte, as it is in a plain string (string_escapes.fc).
// Regression: it used to be emitted into the snprintf format as `\\"` (an
// escaped backslash and a raw quote), ending the C string literal early.
let main = (args: str[]) ->
    let x = 7
    let s = "say \"hi\" %d{x}"
    assert(s.len == 10)
    assert(s[4] == 34)
    assert(s[9] == 55)
    0
