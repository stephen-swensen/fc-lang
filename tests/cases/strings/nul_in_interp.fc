// A \0 escape in the static text of an interpolated string is an ordinary
// byte, since str is length-delimited: "a\0b%d{x}" is the 4 bytes
// {a, 0, b, '7'}. Regression: the NUL used to land inside the snprintf format
// string, tripping gcc -Werror=format-contains-nul (and at runtime it would
// have cut off every later segment).
let main = (args: str[]) ->
    let x = 7
    let s = "a\0b%d{x}"
    assert(s.len == 4)
    assert(s[1] == 0)
    assert(s[3] == 55)
    0
