// `%%` is a single `%` in a string literal with no interpolation segment too:
// "50%% off" is the 7 bytes "50% off". Regression: the emitted bytes kept
// both `%` while .len counted one (`((fc_str){"50%% off", 7})`), so the
// string read as "50%% of".
let main = (args: str[]) ->
    let s = "50%% off"
    assert(s.len == 7)
    assert(s[2] == 37)
    assert(s[3] == 32)
    assert(s[6] == 102)
    0
