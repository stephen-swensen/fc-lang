// FC's \x escape takes exactly two hex digits (see hex_escape_one_digit_err),
// so "\x411" is the two bytes {0x41, '1'}. Regression: codegen passed the
// escape through verbatim, and C's greedy \x read all three digits (gcc/clang:
// "hex escape sequence out of range").
let main = (args: str[]) ->
    let s = "\x411"
    assert(s.len == 2)
    assert(s[0] == 65)
    assert(s[1] == 49)
    0
