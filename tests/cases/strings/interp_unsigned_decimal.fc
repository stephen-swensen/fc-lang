// %d of an unsigned operand formats it as unsigned decimal: "%d{u64.max}" is
// "18446744073709551615". Regression: %d used to be emitted as
// `"%lld", (long long)x` regardless of signedness, so this printed "-1".
let main = (args: str[]) ->
    let s = "%d{u64.max}"
    assert(s.len == 20)
    assert(s[0] == 49)
    0
