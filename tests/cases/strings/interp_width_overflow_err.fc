// An interpolation width above the guaranteed range of a C int (32767), such
// as %99999999999d, is a compile error. Regression: width digits used to wrap
// through 32 bits, so this one emitted `uint8_t _fc_back_0[1215752192];` and
// crashed on stack overflow, while %4294967297d silently lost its width.
let main = (args: str[]) ->
    let x = 5
    let s = "%99999999999d{x}"
    assert(s.len > 0)
    0
