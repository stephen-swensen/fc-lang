// A checked c"%.Ns{s}" truncation aborts inside a monomorphized generic body
// exactly as in a plain function.
let clip = (x: 'a) ->
    let label = "hello"
    let cs = checked c"%.3s{label}"    // len 5 > max 3 -> abort
    let _ = cs
    x

let main = (args: str[]) ->
    let _ = clip(1i32)
    1   // not reached
