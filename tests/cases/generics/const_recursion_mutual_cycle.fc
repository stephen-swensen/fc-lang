// Through another generic, with values that come round again: ping<1> makes
// pong<2>, ping<4>, pong<1>, ping<2> and pong<4>, which makes ping<1>.
let ping = <'n>(k: i32) ->
    if k <= 0 then 'n else pong<('n * 2) % 7>(k - 1)

let pong = <'n>(k: i32) ->
    if k <= 0 then 'n + 10 else ping<('n * 2) % 7>(k - 1)

let main = (args: str[]) ->
    assert(ping<1>(1) == 12)
    assert(ping<1>(3) == 11)
    assert(ping<1>(6) == 1)
    0
