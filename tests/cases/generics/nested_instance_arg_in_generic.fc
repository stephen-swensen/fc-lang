// BUG (bugsearch 2026-07-19, found while testing §4.4): a *generic* function
// whose body instantiates another generic function at a generic-instance
// argument type never gets the resulting struct instance registered — the C
// references an undefined `fc__box__14_fc__box__3_i32` (box<box<i32>>), and
// the callee's own instance is mangled `fc__bx__7_fc__box` (a bare `box`, no
// arguments). The same nesting from a NON-generic caller (`bx(bx(5))` in main)
// works, so it is the substitution of the caller's 'a into an already-generic
// argument type that goes wrong. Pre-existing; verified against d5cfe7b.
struct box =
    v: 'a

let bx = (v: 'a) ->
    box { v = v }

let bx2 = (v: 'a) ->
    bx(bx(v))

let main = (args: str[]) ->
    // the working non-generic twin, so the test pins both
    let n = bx(bx(5))
    assert(n.v.v == 5)
    let d = bx2(7)
    assert(d.v.v == 7)
    0
