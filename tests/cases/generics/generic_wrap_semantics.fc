// FC's defined-behavior machinery must survive monomorphization: wrap-defining
// casts, shift masks, min/-1 handling, and sub-int truncation are decided per
// concrete instance type, not the raw type variable. Regression test for the
// codegen bug where every such decision keyed on the unsubstituted 'a and the
// emitted C silently degraded to bare (UB-carrying) operators.
let gadd = (a: 'a, b: 'a) -> a + b
let gmul = (a: 'a, b: 'a) -> a * b
let gneg = (a: 'a) -> -a
let gshl = (a: 'a, b: 'a) -> a << b
let gdiv = (a: 'a, b: 'a) -> a / b
let gmod = (a: 'a, b: 'a) -> a % b
let gnot = (a: 'a) -> ~a

let main = (args: str[]) ->
    assert(gadd(i32.max, 1) == i32.min)        // signed overflow wraps
    assert(gadd(200u8, 100u8) == 44u8)         // sub-int wraps, no int promotion leak
    assert(gmul(i32.max, 2) == -2)             // signed multiply wraps
    assert(gneg(i32.min) == i32.min)           // -INT_MIN wraps to INT_MIN
    assert(gshl(1, 33) == 2)                   // shift amount masked: 33 & 31 == 1
    assert(gshl(1i64, 65i64) == 2i64)          // distinct monomorph: 65 & 63 == 1
    assert(gdiv(i32.min, -1) == i32.min)       // min / -1 wraps (no hardware trap)
    assert(gmod(i32.min, -1) == 0)             // min % -1 is 0, always
    assert(gnot(200u8) == 55u8)                // sub-int NOT truncates back to u8
    0
