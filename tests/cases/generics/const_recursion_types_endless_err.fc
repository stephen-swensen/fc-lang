// A type family whose values never come round, reached from a generic
// function's body, is rejected at the depth limit as a function's is.
struct a =
    b: b<'n + 1>*?
    v: u8['n]

struct b =
    a: a<'n + 1>*?

let make = <'n>() -> default(a<'n>)

let main = (args: str[]) ->
    let x = make<2>()
    0
