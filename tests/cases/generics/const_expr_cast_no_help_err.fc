// A const param over i32 range is read as a value in expression position.
// Casting the use site does not lift it (the check is on the read of 'n), so the
// message must not suggest a cast.
let f = <'n>() ->
    let x = (i64) 'n
    x
let main = (args: str[]) ->
    let _ = f<5000000000>()
    0
