// The instantiation-chain diagnostic, with template names long enough to
// overrun the fixed buffers it used to be assembled in.
//
// Two of those clipped: the per-frame descriptor ("name(argtypes)") was built
// in a `static char buf[512]`, and the multi-frame message in a
// `char buf[4096]`. Truncation dropped the outer frames — the actionable ones,
// since the innermost frame is inside a generic the user did not write. The
// descriptor also keys the memo that stops the validation descent from
// re-walking an instantiation, so two long-named instances that clipped to the
// same text deduped to one and the second went unvalidated.
let inner_ = (x: 'a) ->
    x + x

let outer_ = (x: 'a) ->
    inner_(x)

let main = (args: str[]) ->
    let r = outer_(true)
    0
