// static_assert placement. Type bodies: anywhere among the members (position
// is documentation — adjacency to the field it justifies). Function bodies:
// an assert over const params is the instantiation contract and must lead
// the body (the prologue, fused to the signature); a concrete assert is a
// standalone fact and may sit at any straight-line position, co-located with
// what it protects.
module cfg =
    let frame_bytes = 64

struct ring =
    static_assert('cap > 0, "capacity must be positive")
    buf: 'a['cap]
    static_assert('cap % 2 == 0, "capacity must be even")
    head: i32
    static_assert('cap <= 4096, "capacity too large")

let f = <'n>() ->
    static_assert('n >= 64, "f requires at least 64")
    static_assert('n % 32 == 0, "width must be limb-aligned")
    let words = 'n / 32
    words

let main = (args: str[]) ->
    let r = default(ring<u8, 64>)
    assert(r.buf.len == 64)
    assert(f<128>() == 4)
    // concrete assert co-located with the buffer it protects
    static_assert(cfg.frame_bytes % 16 == 0, "frame must be 16-byte aligned")
    let frame = u8[cfg.frame_bytes] { }
    assert(frame.len == 64)
    0
