// static_assert placement: anywhere among a type body's members, and any
// straight-line statement position in a function body — co-locate an assert
// with what it protects (the convention for an instantiation contract is the
// top of the body, but that is style, not law). Never nested inside control
// flow or a lambda (see the _in_*_err tests).
module cfg =
    let frame_bytes = 64

struct ring =
    static_assert('cap > 0, "capacity must be positive")
    buf: 'a['cap]
    static_assert('cap % 2 == 0, "capacity must be even")
    head: i32
    static_assert('cap <= 4096, "capacity too large")

let f = <'n>() ->
    static_assert('n >= 64, "f requires at least 64")
    let words = 'n / 32
    // const-param assert co-located with the buffer it justifies
    static_assert('n <= 4096, "scratch below caps at 4096 bits")
    let scratch = u8['n / 8] { }
    assert(scratch.len == ('n / 8))
    words

let main = (args: str[]) ->
    let r = default(ring<u8, 64>)
    assert(r.buf.len == 64)
    assert(f<128>() == 4)
    // concrete assert co-located with the buffer it protects
    static_assert(cfg.frame_bytes % 16 == 0, "frame must be 16-byte aligned")
    let frame = u8[cfg.frame_bytes] { }
    assert(frame.len == 64)
    0
