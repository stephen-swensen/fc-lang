// The same with the const argument carried by a parameter's type.
struct tag =
    v: u8[('n & 1) + 1]

let f = (b: tag<'n>, k: i32) ->
    if k <= 0 then 0
    else f(default(tag<'n * 2>), k - 1) + f(default(tag<'n * 2 + 1>), k - 1)

let main = (args: str[]) ->
    assert(f(default(tag<1>), 3) == 0)
    0
