// Written type arguments instantiate a generic union through its companion
// module's name, as they do through the plain name.
union maybe =
    | nothing
    | just('a)

module maybe =
    let tag = 1

let main = (args: str[]) ->
    let x = maybe<i32>.nothing
    let y = maybe<i32>.just(5)
    let a = match x with
    | just(v) -> v
    | nothing -> 1
    let b = match y with
    | just(v) -> v
    | nothing -> 0
    assert(a + b == 6)
    0
