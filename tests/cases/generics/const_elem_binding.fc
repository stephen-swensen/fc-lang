// How a `const 'a[]` or `const 'a*` parameter binds 'a: to the element (or
// pointee) as the argument hands it out. A writable argument keeps its
// writable elements, since the caller could already write through them; a
// read-only one binds the read-only element, so callbacks take `const str`.
// Value elements are unaffected.
let first = (xs: const 'a[]) -> xs[0]
let deref = (p: const 'a*) -> *p

let count_where = (xs: const 'a[], pred: ('a) -> bool) ->
    let mut n = 0
    for x in xs do
        if pred(x) then n = n + 1
    n

let main = (args: str[]) ->
    let mut buf = alloc(u8[2] { 1u8, 2u8 })!
    defer free(buf)
    let writable = str[1] { buf }
    let w = first(writable)
    w[0] = 9u8
    assert(buf[0] == 9u8)
    let mut p = buf
    let q = deref(&p)
    q[1] = 8u8
    assert(buf[1] == 8u8)

    assert(first(i32[2] { 4, 5 }) == 4)
    let x = 7
    assert(deref(&x) == 7)

    let words = const str[3] { "ab", "cde", "fghi" }
    assert(first(words).len == 2)
    assert(count_where(words, (s: const str) -> s.len > 2) == 2)
    assert(count_where(writable, (s: str) -> s.len == 2) == 1)
    0
