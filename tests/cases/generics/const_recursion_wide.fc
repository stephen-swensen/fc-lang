// A generic may have any number of instances: wide<1> makes wide<2> and
// wide<3>, and so on, until all 2600 values below 2600 are instances (the
// longest chain is 12 steps).
let wide = <'n>(k: i32) ->
    if k <= 0 then 'n
    else wide<('n * 2) % 2600>(k - 1) + wide<('n * 2 + 1) % 2600>(k - 1)

let main = (args: str[]) ->
    assert(wide<1>(0) == 1)
    assert(wide<1>(2) == 4 + 5 + 6 + 7)
    0
