// A division by zero inside a transitively-discovered const argument (pass2
// never folds it — the callee's const param is only inferable per instance)
// must fail the FC build, not leak unresolved names into the emitted C.
let g = <'n>() -> 'n

let f = <'n>() -> g<('n / ('n - 8))>()

let main = (args: str[]) ->
    f<8>()
