// A slice literal's element type may take a parenthesized const argument (the
// form a shift or comparison needs), in the sized and the raw-parts literal,
// nested inside another argument list, and inside a generic. Comparisons with a
// parenthesized operand next to it keep their comparison reading.
struct wide =
    limbs: u32['n / 32]

struct pair =
    key: 'a
    slots: u8['n]

let half = <'n>() ->
    let s = wide<('n >> 1)>[2] {}
    s[0].limbs.len

let main = (args: str[]) ->
    let a = wide<(256 >> 1)>[2] {}
    assert(a.len == 2)
    assert(a[0].limbs.len == 4)

    let b = pair<wide<(64 >> 1)>, (2 << 1)>[3] {}
    assert(b.len == 3)
    assert(b[2].slots.len == 4)
    assert(b[0].key.limbs.len == 1)

    let q = wide<32>[1] {}
    let raw = wide<(128 >> 2)>[] { ptr = q.ptr, len = q.len }
    assert(raw.len == 1)
    assert(raw[0].limbs.len == 1)

    assert(half<256>() == 4)

    let n = 3
    let m = 10
    let lt = n < (m >> 1)
    let gt = (m >> 1) > n
    assert(lt && gt)
    0
