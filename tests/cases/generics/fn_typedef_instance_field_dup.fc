// A struct field whose function type mentions a generic instance
// (`(wide<64>) -> i32`) shares one fn-type typedef with the matching function
// signature. Regression: the typedef used to be emitted twice, once for the
// field and once for the signature, and gcc/clang rejected it with
// "conflicting types for 'fc_fn_fc__wide__5___k64__int32_t'".
struct wide =
    limbs: u32['n / 32]

struct ops =
    measure: (wide<64>) -> i32

let mlen = (w: wide<64>) -> (i32) w.limbs.len

let main = (args: str[]) ->
    let o = ops { measure = mlen }
    let w = default(wide<64>)
    assert(o.measure(w) == 2)
    0
