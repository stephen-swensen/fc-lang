// Each instance names two new ones, so the instances double at every step
// and never run out; the count of instances stops them long before the
// depth limit would.
let f = <'n>(k: i32) ->
    if k <= 0 then 'n else f<'n * 2>(k - 1) + f<'n * 2 + 1>(k - 1)

let main = (args: str[]) ->
    assert(f<1>(3) > 0)
    0
