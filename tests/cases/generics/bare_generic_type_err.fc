// A generic type name used bare — no type arguments — has unbound type
// variables and no layout. Left unjudged it reached codegen and emitted
// `struct fc__outer { fc__box inner; };` with fc__box never defined.
struct box =
    value: 'a

struct outer =
    inner: box

let main = (args: str[]) ->
    let o = default(outer)
    0
