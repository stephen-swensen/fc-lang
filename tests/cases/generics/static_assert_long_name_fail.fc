// The instantiation descriptor in a static_assert diagnostic must name the
// whole instance. It was formatted into a `char inst_buf[256]`, so a template
// whose name alone exceeds that lost its `<args>` suffix and the message text
// after it — the diagnostic no longer identified which instantiation failed.
struct wide_ =
    static_assert('n % 32 == 0, "width must be a multiple of 32")
    limbs: u32['n / 32]

let main = (args: str[]) ->
    let a = default(wide_<100>)
    0
