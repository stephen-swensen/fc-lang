// A transitive const-generic call with a computed argument (mk2<64> calls
// mk<'n * 2>) instantiates the callee at the computed value, 128, even though
// the callee's parameter is also named 'n. Regression: the fn-type typedef
// collection substituted the caller's 'n (64) into the callee's signature,
// emitting a typedef over the never-defined type fc__wide__5___k64.
struct wide =
    limbs: u32['n / 32]

let mk = <'n>() ->
    default(wide<'n>)

let mk2 = <'n>() ->
    mk<'n * 2>()

let main = (args: str[]) ->
    let w = mk2<64>()
    assert(w.limbs.len == 4)
    0
