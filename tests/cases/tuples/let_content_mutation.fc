// A tuple element is contents, not the binding: assigning one and taking its
// address are both valid on a plain `let`, exactly as a struct field is.
// Only whole-tuple reassignment needs `let mut`.
struct point =
    x: i32
    y: i32

let main = (args: str[]) ->
    let t = { 1, 2 }
    t[0] = 99
    assert(t[0] == 99)
    assert(t[1] == 2)

    // address of an element off a `let` tuple, and a write through it
    let p = &t[1]
    *p = 7
    assert(t[1] == 7)

    // nested tuples and struct elements follow the same rule
    let n = { { 1, 2 }, point { x = 3, y = 4 } }
    n[0][1] = 20
    n[1].x = 30
    assert(n[0][1] == 20)
    assert(n[1].x == 30)

    // a `let` tuple holding a pointer still writes through it
    let mut q = point { x = 0, y = 0 }
    let pt = { &q, 5 }
    pt[0].x = 10
    assert(q.x == 10)

    // whole-tuple reassignment is the one thing that needs `let mut`
    let mut m = { 1, 2 }
    m = { 8, 9 }
    assert(m[0] == 8)
    0
