// A statically negative slice-literal size is a compile error in concrete
// code, as it is in a generic instance. Regression: `u8[-4]{}` used to be
// accepted and emitted `uint8_t _fc_back_0[18446744073709551612];`, which is
// invalid C.
let main = (args: str[]) ->
    let a = u8[-4]{}
    (i32) a.len
