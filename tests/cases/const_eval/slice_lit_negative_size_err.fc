// BUG (bugsearch 2026-07-18): a statically-negative slice-literal size on the
// fully-concrete path is accepted (only the per-instance generic path checks
// sz <= 0). Emits `uint8_t _fc_back_0[18446744073709551612];` — invalid C.
// Spec: "A statically-negative length is therefore a compile error."
let main = (args: str[]) ->
    let a = u8[-4]{}
    (i32) a.len
