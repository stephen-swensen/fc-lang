// BUG (bugsearch 2026-07-18): const arguments are evaluated in the i64
// domain (spec: "evaluated in the 64-bit signed integer domain"), and a bare
// literal f<4000000000> is accepted — but the same literal inside const-arg
// arithmetic is type-checked through the normal i32-literal path and
// rejected ("integer literal 4000000000 out of range for i32"), then
// evaluates as 0 producing a bogus "fixed array size must be positive"
// cascade. Should compile and run.
struct wide =
    limbs: u32['n / 100000000]

let main = (args: str[]) ->
    let a = default(wide<4000000000 / 10 + 0>)
    assert(a.limbs.len == 4)
    0
