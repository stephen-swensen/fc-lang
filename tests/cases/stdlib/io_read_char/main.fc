import io from std::
import sys from std::

let main = (args: str[]) ->
    let tmp = sys.temp_dir()!
    let path = alloca("%s{tmp}/fc_test_read_char.txt")

    // Write a tiny known payload.
    match io.open(path, "w") with
    | err(_) -> return 1
    | ok(wf) ->
        io.write("ab", wf)
        io.close(wf)!

    match io.open(path, "r") with
    | err(_) -> return 2
    | ok(rf) ->
        // Two bytes available, then EOF. read_char is u8?!:
        // ok(some(byte)) = data, ok(none) = EOF, err = real read error.
        match io.read_char(rf) with
        | ok(some(c)) -> assert(c == 'a')
        | ok(none) -> return 3
        | err(_) -> return 4

        match io.read_char(rf) with
        | ok(some(c)) -> assert(c == 'b')
        | ok(none) -> return 5
        | err(_) -> return 6

        // Past end → ok(none), not an error.
        match io.read_char(rf) with
        | ok(none) -> assert(true)
        | ok(some(_)) -> return 7
        | err(_) -> return 8

        io.close(rf)!

    io.remove(path)!
    0
