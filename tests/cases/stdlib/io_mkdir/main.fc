import io from std::
import sys from std::

let main = (args: str[]) ->
    let tmp = sys.temp_dir()!
    let dir = alloca("%s{tmp}/fc_test_mkdir")
    let file = alloca("%s{tmp}/fc_test_mkdir/test.txt")

    // Create a directory
    io.mkdir(dir)!

    // Creating again fails with the named condition
    match io.mkdir(dir) with
    | ok -> return 1
    | err(e) -> assert(e == io.file.exists)

    // Should be able to create a file inside it
    match io.open(file, "w") with
    | ok(f) ->
        io.write("hello", f)
        io.close(f)!
    | err(_) -> return 2

    // Clean up
    io.remove(file)!
    c.rmdir(alloca(c"%s{dir}"))

    0

#if os == "windows"
module c from "direct.h" =
    extern _rmdir as rmdir: (const cstr) -> i32
#else
module c from "unistd.h" =
    extern rmdir: (const cstr) -> i32
#end
