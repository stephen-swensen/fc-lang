import text from std::

let main = (args: str[]) ->
    // parse_i32 — success
    assert(text.parse_i32("42") == ok(42))
    assert(text.parse_i32("-7") == ok(-7))
    assert(text.parse_i32("0") == ok(0))

    // parse_i32 — invalid input
    assert(text.parse_i32("abc") == err(i32, text.parse.invalid))
    assert(text.parse_i32("") == err(i32, text.parse.invalid))

    // strict whole-string contract: every byte must belong to the number —
    // nothing is skipped in front, nothing may trail
    assert(text.parse_i32(" 42") == err(i32, text.parse.invalid))
    assert(text.parse_i32("42 ") == err(i32, text.parse.invalid))
    assert(text.parse_i32("\t42") == err(i32, text.parse.invalid))
    assert(text.parse_i32("42\n") == err(i32, text.parse.invalid))
    assert(text.parse_i32("42abc") == err(i32, text.parse.invalid))
    assert(text.parse_i32("4 2") == err(i32, text.parse.invalid))
    assert(text.parse_i32("12-3") == err(i32, text.parse.invalid))
    assert(text.parse_i32("+42") == ok(42))       // an explicit sign is part of the number
    assert(text.parse_i32(text.trim(" 42\n")) == ok(42))   // trim first for whitespace-y input

    // an embedded NUL is not part of any number (the C parser would stop
    // there silently and validate only the prefix)
    let nul = u8[3] { '1', '2', 0u8 }
    assert(text.parse_i32(nul) == err(i32, text.parse.invalid))

    // parse_i32 — overflow: the i32-range check the wrapper applies, and the
    // i64-range case strtoll itself reports via ERANGE. The extremes parse.
    assert(text.parse_i32("2147483648") == err(i32, text.parse.overflow))
    assert(text.parse_i32("-2147483649") == err(i32, text.parse.overflow))
    assert(text.parse_i32("99999999999999999999") == err(i32, text.parse.overflow))
    assert(text.parse_i32("2147483647") == ok(i32.max))

    // parse_i64 — success
    assert(text.parse_i64("1000000000000") == ok(1000000000000i64))
    assert(text.parse_i64("-999") == ok(-999i64))
    assert(text.parse_i64("9223372036854775807") == ok(i64.max))

    // parse_i64 — failure (incl. the strict whole-string contract)
    assert(text.parse_i64("xyz") == err(i64, text.parse.invalid))
    assert(text.parse_i64("") == err(i64, text.parse.invalid))
    assert(text.parse_i64("123x") == err(i64, text.parse.invalid))
    assert(text.parse_i64(" 123") == err(i64, text.parse.invalid))
    assert(text.parse_i64("9223372036854775808") == err(i64, text.parse.overflow))
    assert(text.parse_i64("-9223372036854775809") == err(i64, text.parse.overflow))

    // parse_f64 — success
    assert(text.parse_f64("3.14").is_ok)
    assert(text.parse_f64("0.0") == ok(0.0))
    assert(text.parse_f64("-1.5") == ok(-1.5))

    // parse_f64 — failure; underflow to zero/denormal is NOT an error
    assert(text.parse_f64("bad") == err(f64, text.parse.invalid))
    assert(text.parse_f64("") == err(f64, text.parse.invalid))
    assert(text.parse_f64("1e999") == err(f64, text.parse.overflow))
    assert(text.parse_f64("-1e999") == err(f64, text.parse.overflow))
    assert(text.parse_f64("1e-999").is_ok)

    // strict whole-string contract for floats: the exponent is part of the
    // number, whitespace and trailing characters are not
    assert(text.parse_f64("1e3") == ok(1000.0))
    assert(text.parse_f64("3.14x") == err(f64, text.parse.invalid))
    assert(text.parse_f64(" 1.5") == err(f64, text.parse.invalid))
    assert(text.parse_f64("1.5\n") == err(f64, text.parse.invalid))
    assert(text.parse_f64("1.5 2.5") == err(f64, text.parse.invalid))

    // parse_f32 — success
    assert(text.parse_f32("2.5") == ok(2.5f32))
    assert(text.parse_f32("0.0") == ok(0.0f32))

    // parse_f32 — failure; 1e50 fits f64 but overflows f32
    assert(text.parse_f32("bad") == err(f32, text.parse.invalid))
    assert(text.parse_f32("") == err(f32, text.parse.invalid))
    assert(text.parse_f32("1e50") == err(f32, text.parse.overflow))
    assert(text.parse_f32("2.5 ") == err(f32, text.parse.invalid))

    // over-length input fails with too_long rather than overflowing the
    // stack. build a 600-byte run of '0' digits — a "valid" number far past
    // the max_parse_len cap, so every parse_* must reject it.
    let big = alloc(u8[600] {})!
    defer free(big)
    let mut i = 0i64
    loop
        if i >= big.len then break
        big[i] = 48u8   // '0'
        i = i + 1i64
    assert(text.parse_i32(big) == err(i32, text.parse.too_long))
    assert(text.parse_i64(big) == err(i64, text.parse.too_long))
    assert(text.parse_f32(big) == err(f32, text.parse.too_long))
    assert(text.parse_f64(big) == err(f64, text.parse.too_long))

    // the cap is inclusive: a 512-byte run still parses, 513 does not.
    assert(text.parse_i32(big[0..512]) == ok(0))
    assert(text.parse_i64(big[0..512]) == ok(0i64))
    assert(text.parse_i32(big[0..513]) == err(i32, text.parse.too_long))
    assert(text.parse_i64(big[0..513]) == err(i64, text.parse.too_long))

    0
