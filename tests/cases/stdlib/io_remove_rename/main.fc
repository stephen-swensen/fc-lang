import io from std::
import sys from std::

let main = (args: str[]) ->
    let tmp = sys.temp_dir()!
    let src = alloca("%s{tmp}/fc_test_rename_src.txt")
    let dst = alloca("%s{tmp}/fc_test_rename_dst.txt")

    // Clean up any leftovers from a prior run (Windows rename() fails if dst
    // exists). The discarded results are fine: absent files just err.
    io.remove(src)
    io.remove(dst)

    // Create a file
    match io.open(src, "w") with
    | ok(wf) ->
        io.write("data", wf)
        io.close(wf)!
    | err(_) -> return 1

    // Rename it
    io.rename(src, dst)!

    // Original should not be openable — and the error names why.
    match io.open(src, "r") with
    | ok(rf) ->
        io.close(rf)!
        return 2
    | err(e) -> assert(e == io.file.not_found)

    // New name should be readable
    match io.open(dst, "r") with
    | ok(rf) ->
        let mut buf = u8[16] {}
        let n = io.read(buf, 16, rf)
        assert(n == 4i64)
        io.close(rf)!
    | err(_) -> return 3

    // Remove the file
    io.remove(dst)!

    // Removing it again reports not_found.
    match io.remove(dst) with
    | ok -> return 4
    | err(e) -> assert(e == io.file.not_found)

    // Renaming a missing file reports not_found.
    match io.rename(src, dst) with
    | ok -> return 5
    | err(e) -> assert(e == io.file.not_found)

    0
