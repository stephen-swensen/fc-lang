import io from std::
import sys from std::

let main = (args: str[]) ->
    let tmp = sys.temp_dir()!
    let path = alloca("%s{tmp}/fc_test_sync.txt")

    // Write a payload, then force it to stable storage with sync().
    // Binary mode ("wb") keeps the byte count identical across platforms —
    // text mode on Windows would translate each '\n' to "\r\n", inflating the
    // on-disk size past the 13 bytes read_all (which opens "rb") reads back.
    match io.open(path, "wb") with
    | err(_) -> return 1
    | ok(wf) ->
        io.write("durable\n", wf)
        // On a valid handle sync reports ok.
        io.sync(wf)!
        // sync leaves the handle open and writable — keep appending.
        io.write("more\n", wf)
        io.sync(wf)!
        io.close(wf)!

    // sync must not corrupt or truncate: both lines read back intact.
    match io.read_all(path) with
    | err(_) -> return 2
    | ok(buf) ->
        assert(buf.len == 13i64)
        assert(buf[0] == 'd')
        assert(buf[7] == '\n')
        assert(buf[12] == '\n')
        free(buf)

    io.remove(path)!
    0
