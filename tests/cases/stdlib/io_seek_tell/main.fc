import io from std::
import sys from std::

let main = (args: str[]) ->
    let tmp = sys.temp_dir()!
    let path = alloca("%s{tmp}/fc_test_seek_tell.txt")

    // Write a test file
    match io.open(path, "w") with
    | ok(wf) ->
        io.write("abcdefghij", wf)
        io.close(wf)!
    | err(_) -> return 1

    // Read it back with seek/tell
    match io.open(path, "r") with
    | ok(rf) ->
        // tell at start should be 0
        assert(io.tell(rf)! == 0i64)

        // seek to position 5
        io.seek(rf, 5i64, io.seek_set)!
        assert(io.tell(rf)! == 5i64)

        // read 3 bytes from position 5 -> "fgh"
        let mut buf = u8[3] {}
        let n = io.read(buf, 3, rf)
        assert(n == 3i64)
        assert(io.tell(rf)! == 8i64)

        // seek relative to current (-2)
        io.seek(rf, -2i64, io.seek_cur)!
        assert(io.tell(rf)! == 6i64)

        // seek from end
        io.seek(rf, -3i64, io.seek_end)!
        assert(io.tell(rf)! == 7i64)

        // an invalid whence is a real error, reported not swallowed
        match io.seek(rf, 0i64, 99) with
        | ok -> return 3
        | err(e) -> assert(e > 0)

        io.close(rf)!
    | err(_) -> return 2

    io.remove(path)!
    0
