import wideint from std::

// Division by zero aborts, exactly like the built-in `/`. The test expects the
// abort exit code (134 = 128 + SIGABRT).
let main = (args: str[]) ->
    let a = wideint.uwide<256>.from_u64(100u64)
    let q = wideint.uwide.div(a, default(wideint.uwide<256>))
    assert(!wideint.uwide.is_zero(q))    // unreachable — div aborted above
    0
