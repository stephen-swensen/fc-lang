import wideint from std::

let h2048 = (s: const str) -> wideint.uwide<2048>.parse_hex(s)!

let main = (args: str[]) ->
    let zero = default(wideint.uwide<2048>)
    let one = wideint.uwide<2048>.from_u64(1u64)
    let mx = wideint.uwide<2048>.max()

    // ---- u1024.mul_wide -> u2048: (2^P-1)^2 = 2^2048 - 2^(P+1) + 1 ----
    let mP = wideint.uwide<1024>.max()
    assert(wideint.uwide.mul_wide(mP, mP) == h2048(""))

    // ---- add/carry and sub/borrow at the 2048-bit boundary ----
    assert(wideint.uwide.add(mx, one) == zero)          // wraps to 0
    let { s1, c1 } = wideint.uwide.add_carry(mx, one)
    assert(wideint.uwide.is_zero(s1))
    assert(c1)
    let { s2, c2 } = wideint.uwide.add_carry(one, one)
    assert(s2 == wideint.uwide<2048>.from_u64(2u64))
    assert(!c2)
    let { d1, bor1 } = wideint.uwide.sub_borrow(zero, one)
    assert(d1 == mx)                                 // 0 - 1 wraps to max
    assert(bor1)
    let { d2, bor2 } = wideint.uwide.sub_borrow(mx, mx)
    assert(wideint.uwide.is_zero(d2))
    assert(!bor2)

    // ---- mul wraps mod 2^2048: (2^2048-1)^2 mod 2^2048 = 1 ----
    assert(wideint.uwide.mul(mx, mx) == one)

    // ---- shifts across limb boundaries ----
    let top = wideint.uwide.shl(one, 2047u32)            // 2^2047
    assert(wideint.uwide.shr(top, 2047u32) == one)
    assert(wideint.uwide.shl(one, 2048u32) == zero)        // full-width shift -> 0
    assert(wideint.uwide.shr(top, 2048u32) == zero)

    // ---- cmp / min / max ----
    assert(wideint.uwide<2048>.min() == zero)
    assert(wideint.uwide.cmp(zero, mx) == -1)
    assert(wideint.uwide.cmp(mx, zero) == 1)
    assert(wideint.uwide.cmp(mx, mx) == 0)

    // ---- div/rem/divmod ----
    let seven = wideint.uwide<2048>.from_u64(7u64)
    let { q, r } = wideint.uwide.divmod(mx, seven)
    assert(wideint.uwide.add(wideint.uwide.mul(q, seven), r) == mx)
    assert(wideint.uwide.div(mx, seven) == q)
    assert(wideint.uwide.rem(mx, seven) == r)
    assert(wideint.uwide.cmp(r, seven) == -1)

    // ---- checked ops: happy path ----
    assert(wideint.uwide.checked_add(mx, zero) == mx)
    assert(wideint.uwide.checked_sub(mx, mx) == zero)
    assert(wideint.uwide.checked_mul(top, one) == top)

    // ---- conversions ----
    assert(wideint.uwide.try_to_u64(wideint.uwide<2048>.from_u64(0xdeadbeefcafef00du64))! == 0xdeadbeefcafef00du64)
    assert(wideint.uwide.try_to_u64(top).is_none)

    // ---- parse / to_str round trip at u2048.max, overflow one past ----
    let mxp = wideint.uwide<2048>.parse("")!
    assert(mxp == mx)
    let mxs = wideint.uwide.to_str(mx)
    assert(mxs == "")
    free(mxs)
    assert(wideint.uwide<2048>.parse("") == err(wideint.uwide<2048>, wideint.parse.overflow))
    assert(wideint.uwide<2048>.parse("") == err(wideint.uwide<2048>, wideint.parse.invalid))

    // ---- to_hex / parse_hex round trip ----
    let th = wideint.uwide.to_hex(mx)
    let back = wideint.uwide<2048>.parse_hex(th)!
    assert(back == mx)
    free(th)

    // ---- 300! is the widest factorial that fits 2048 bits (2042 bits) ----
    let mut fact = one
    for n in 2..301 do
        fact = wideint.uwide.checked_mul(fact, wideint.uwide<2048>.from_u64((u64) n))
    let fs = wideint.uwide.to_str(fact)
    assert(fs == "")
    free(fs)

    // ================= i2048 =================
    let izero = default(wideint.iwide<2048>)
    let ione = wideint.iwide<2048>.from_i64(1i64)
    let imn = wideint.iwide<2048>.min()
    let imx = wideint.iwide<2048>.max()

    // ---- sign-extending conversions ----
    let neg7 = wideint.iwide<2048>.from_i64(-7i64)
    assert(wideint.iwide.is_neg(neg7))
    assert(wideint.iwide.try_to_i64(neg7)! == -7i64)
    assert(wideint.iwide.try_to_i64(imn).is_none)
    assert(wideint.iwide.try_to_i64(wideint.iwide<2048>.from_i64(-9223372036854775807i64 - 1i64))! == -9223372036854775807i64 - 1i64)

    // ---- neg / abs, incl. min wrap ----
    assert(wideint.iwide.neg(neg7) == wideint.iwide<2048>.from_i64(7i64))
    assert(wideint.iwide.abs(neg7) == wideint.iwide<2048>.from_i64(7i64))
    assert(wideint.iwide.neg(imn) == imn)               // wraps
    assert(wideint.iwide.abs(imn) == imn)               // wraps

    // ---- min/max relations ----
    assert(wideint.iwide.add(imx, ione) == imn)         // wraps around
    assert(wideint.iwide.cmp(imn, imx) == -1)
    assert(wideint.iwide.cmp(imn, izero) == -1)
    assert(wideint.iwide.cmp(imx, izero) == 1)

    // ---- truncating division: remainder takes the dividend's sign ----
    let two = wideint.iwide<2048>.from_i64(2i64)
    let { qf, rf } = wideint.iwide.divmod(neg7, two)
    assert(qf == wideint.iwide<2048>.from_i64(-3i64))
    assert(rf == wideint.iwide<2048>.from_i64(-1i64))
    assert(wideint.iwide.div(neg7, two) == wideint.iwide<2048>.from_i64(-3i64))
    assert(wideint.iwide.rem(neg7, two) == wideint.iwide<2048>.from_i64(-1i64))
    assert(wideint.iwide.div(wideint.iwide<2048>.from_i64(7i64), wideint.iwide<2048>.from_i64(-2i64)) == wideint.iwide<2048>.from_i64(-3i64))
    assert(wideint.iwide.rem(wideint.iwide<2048>.from_i64(7i64), wideint.iwide<2048>.from_i64(-2i64)) == ione)

    // ---- checked ops: happy path (incl. min / 1 and abs(max)) ----
    assert(wideint.iwide.checked_add(imx, izero) == imx)
    assert(wideint.iwide.checked_sub(imn, izero) == imn)
    assert(wideint.iwide.checked_mul(imn, ione) == imn)
    assert(wideint.iwide.checked_neg(imx) == wideint.iwide.add(imn, ione))
    assert(wideint.iwide.checked_abs(imx) == imx)
    assert(wideint.iwide.checked_div(imn, two) == wideint.iwide.shr(imn, 1u32))

    // ---- arithmetic shr sign-extends ----
    assert(wideint.iwide.shr(wideint.iwide<2048>.from_i64(-8i64), 2u32) == wideint.iwide<2048>.from_i64(-2i64))
    assert(wideint.iwide.shr(wideint.iwide<2048>.from_i64(-1i64), 2048u32) == wideint.iwide<2048>.from_i64(-1i64))

    // ---- parse / to_str round trips at the signed extremes ----
    let mns = wideint.iwide.to_str(imn)
    assert(mns == "-")
    free(mns)
    let mnp = wideint.iwide<2048>.parse("-")!
    assert(mnp == imn)
    let mxp2 = wideint.iwide<2048>.parse("")!
    assert(mxp2 == imx)
    // one past min / one past max -> overflow
    assert(wideint.iwide<2048>.parse("-") == err(wideint.iwide<2048>, wideint.parse.overflow))
    assert(wideint.iwide<2048>.parse("") == err(wideint.iwide<2048>, wideint.parse.overflow))

    // ---- raw two's-complement hex: 512 f's is -1 ----
    let ffs = wideint.iwide.to_hex(wideint.iwide<2048>.from_i64(-1i64))
    assert(ffs.len == 512)
    let mut all_f = true
    for c in ffs do
        if c != 'f' then all_f = false
    assert(all_f)
    let m1 = wideint.iwide<2048>.parse_hex(ffs)!
    assert(m1 == wideint.iwide<2048>.from_i64(-1i64))
    free(ffs)
    0
