import fixint from std::

// Division by zero aborts, exactly like the built-in `/`. The test expects the
// abort exit code (134 = 128 + SIGABRT).
let main = (args: str[]) ->
    let a = fixint.u256.from_u64(100u64)
    let q = fixint.u256.div(a, default(fixint.u256))
    assert(!fixint.u256.is_zero(q))    // unreachable — div aborted above
    0
