import io from std::
import sys from std::

// Compare two str values byte-for-byte.
let str_eq = (a: const str, b: const str) ->
    if a.len != b.len then false
    else
        let mut i = 0i64
        let mut eq = true
        loop
            if i >= a.len then break
            if a[i] != b[i] then
                eq = false
                break
            i = i + 1
        eq

let main = (args: str[]) ->
    let tmp = sys.temp_dir()!
    let dir = alloca("%s{tmp}/fc_test_list_dir")
    let path_a = alloca("%s{tmp}/fc_test_list_dir/a.txt")
    let path_b = alloca("%s{tmp}/fc_test_list_dir/b.txt")
    let path_c = alloca("%s{tmp}/fc_test_list_dir/c.txt")
    let missing = alloca("%s{tmp}/fc_test_list_dir_does_not_exist")

    // Start fresh: remove any leftover files from a prior run and (re)create.
    // If the directory doesn't exist yet, the discarded errs are no-ops.
    io.remove(path_a)
    io.remove(path_b)
    io.remove(path_c)
    c.rmdir(alloca(c"%s{dir}"))
    io.mkdir(dir)!

    // Listing an empty directory should return ok([]).
    match io.list_dir(dir) with
    | err(_) -> return 1
    | ok(names) ->
        assert(names.len == 0)
        free(names)

    // Create three files.
    let touch = (name: const str) ->
        match io.open(name, "w") with
        | ok(f) ->
            io.close(f)!
            true
        | err(_) -> false
    if !touch(path_a) then return 2
    if !touch(path_b) then return 2
    if !touch(path_c) then return 2

    // List and verify: expect exactly a.txt, b.txt, c.txt (no ".", "..").
    match io.list_dir(dir) with
    | err(_) -> return 3
    | ok(names) ->
        assert(names.len == 3)
        let mut saw_a = false
        let mut saw_b = false
        let mut saw_c = false
        for n in names do
            if str_eq(n, "a.txt") then saw_a = true
            else if str_eq(n, "b.txt") then saw_b = true
            else if str_eq(n, "c.txt") then saw_c = true
            else return 4
        assert(saw_a && saw_b && saw_c)
        for n in names do
            free(n)
        free(names)

    // Listing a nonexistent directory reports the named condition.
    match io.list_dir(missing) with
    | ok(_) -> return 5
    | err(e) -> assert(e == io.file.not_found)

    // Cleanup.
    io.remove(path_a)!
    io.remove(path_b)!
    io.remove(path_c)!
    c.rmdir(alloca(c"%s{dir}"))

    0

#if os == "windows"
module c from "direct.h" =
    extern _rmdir as rmdir: (const cstr) -> i32
#else
module c from "unistd.h" =
    extern rmdir: (const cstr) -> i32
#end
