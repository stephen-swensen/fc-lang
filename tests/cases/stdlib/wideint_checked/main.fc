import wideint from std::

let main = (args: str[]) ->
    // unsigned: no-overflow checked == unchecked
    let a = wideint.uwide<256>.from_u64(0xFFFFFFFFFFFFFFFFu64)
    let b = wideint.uwide<256>.from_u64(2u64)
    assert(wideint.uwide.checked_add(a, b) == wideint.uwide.add(a, b))
    assert(wideint.uwide.checked_sub(a, b) == wideint.uwide.sub(a, b))
    assert(wideint.uwide.checked_mul(a, b) == wideint.uwide.mul(a, b))
    let mx = wideint.uwide<256>.parse_hex("ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff")!
    assert(mx == wideint.uwide<256>.max())          // max() is all bits set
    assert(wideint.uwide.is_zero(wideint.uwide<256>.min()))
    assert(wideint.uwide.checked_add(mx, default(wideint.uwide<256>)) == mx)
    // 2^128 * 2^127 = 2^255 (no overflow); result is 2^255
    let p128 = wideint.uwide.shl(wideint.uwide<256>.from_u64(1u64), 128u32)
    let p127 = wideint.uwide.shl(wideint.uwide<256>.from_u64(1u64), 127u32)
    assert(wideint.uwide.checked_mul(p128, p127) == wideint.uwide.shl(wideint.uwide<256>.from_u64(1u64), 255u32))

    // signed: no-overflow checked == unchecked
    let x = wideint.iwide<256>.from_i64(-1000000i64)
    let y = wideint.iwide<256>.from_i64(7i64)
    assert(wideint.iwide.checked_add(x, y) == wideint.iwide.add(x, y))
    assert(wideint.iwide.checked_sub(x, y) == wideint.iwide.sub(x, y))
    assert(wideint.iwide.checked_mul(x, y) == wideint.iwide.mul(x, y))
    assert(wideint.iwide.checked_div(x, y) == wideint.iwide.div(x, y))
    assert(wideint.iwide.checked_neg(x) == wideint.iwide.neg(x))
    assert(wideint.iwide.checked_abs(x) == wideint.iwide.abs(x))
    // signed boundaries that must NOT abort
    let smax = wideint.iwide<256>.parse("57896044618658097711785492504343953926634992332820282019728792003956564819967")!
    assert(smax == wideint.iwide<256>.max())        // max() is 2^255 - 1
    assert(wideint.iwide.checked_add(smax, wideint.iwide<256>.from_i64(0i64)) == smax)
    assert(wideint.iwide.checked_mul(smax, wideint.iwide<256>.from_i64(1i64)) == smax)
    let smin = wideint.iwide<256>.parse("-57896044618658097711785492504343953926634992332820282019728792003956564819968")!
    assert(smin == wideint.iwide<256>.min())        // min() is -2^255
    assert(wideint.iwide.checked_mul(smin, wideint.iwide<256>.from_i64(1i64)) == smin)  // min*1 ok
    assert(wideint.iwide.checked_div(smin, wideint.iwide<256>.from_i64(1i64)) == smin)  // min/1 ok
    assert(wideint.iwide.checked_mul(wideint.iwide<256>.from_i64(-3i64), wideint.iwide<256>.from_i64(-4i64)) == wideint.iwide<256>.from_i64(12i64))

    // width coverage
    assert(wideint.uwide.checked_add(wideint.uwide<128>.from_u64(5u64), wideint.uwide<128>.from_u64(6u64)) == wideint.uwide<128>.from_u64(11u64))
    assert(wideint.uwide.checked_mul(wideint.uwide<512>.from_u64(1000000u64), wideint.uwide<512>.from_u64(1000000u64)) == wideint.uwide<512>.from_u64(1000000000000u64))
    assert(wideint.iwide.checked_neg(wideint.iwide<128>.from_i64(42i64)) == wideint.iwide<128>.from_i64(-42i64))
    assert(wideint.iwide.checked_sub(wideint.iwide<512>.from_i64(10i64), wideint.iwide<512>.from_i64(20i64)) == wideint.iwide<512>.from_i64(-10i64))
    0
