import wideint from std::

let h256 = (s: const str) -> wideint.uwide<256>.parse_hex(s)!

let main = (args: str[]) ->
    // ---- from_u64 / try_to_u64 ----
    let x = wideint.uwide<256>.from_u64(0xdeadbeefcafef00du64)
    assert(wideint.uwide.try_to_u64(x)! == 0xdeadbeefcafef00du64)
    // value that exceeds u64 -> none
    let big = wideint.uwide.shl(wideint.uwide<256>.from_u64(1u64), 64u32)   // 2^64
    assert(wideint.uwide.try_to_u64(big).is_none)
    // exactly u64 max fits
    assert(wideint.uwide.try_to_u64(wideint.uwide<256>.from_u64(0xFFFFFFFFFFFFFFFFu64))! == 0xFFFFFFFFFFFFFFFFu64)

    // ---- decimal parse: success (u256 max) + to_str round-trip ----
    let mx = wideint.uwide<256>.parse("115792089237316195423570985008687907853269984665640564039457584007913129639935")!
    let mxs = wideint.uwide.to_str(mx)
    assert(mxs == "115792089237316195423570985008687907853269984665640564039457584007913129639935")
    free(mxs)
    // one past u256 max -> overflow
    assert(wideint.uwide<256>.parse("115792089237316195423570985008687907853269984665640564039457584007913129639936") == err(wideint.uwide<256>, wideint.parse.overflow))

    // leading zeros ok
    let lz = wideint.uwide<256>.parse("00000000123")!
    let lzs = wideint.uwide.to_str(lz)
    assert(lzs == "123")
    free(lzs)
    // zero formats as "0"
    let zs = wideint.uwide.to_str(default(wideint.uwide<256>))
    assert(zs == "0")
    free(zs)
    let zh = wideint.uwide.to_hex(default(wideint.uwide<256>))
    assert(zh == "0")
    free(zh)

    // ---- invalid inputs -> err(parse.invalid) ----
    assert(wideint.uwide<256>.parse("") == err(wideint.uwide<256>, wideint.parse.invalid))
    assert(wideint.uwide<256>.parse("12 3") == err(wideint.uwide<256>, wideint.parse.invalid))
    assert(wideint.uwide<256>.parse("12a3") == err(wideint.uwide<256>, wideint.parse.invalid))  // 'a' not decimal
    assert(wideint.uwide<256>.parse("-5") == err(wideint.uwide<256>, wideint.parse.invalid))
    assert(wideint.uwide<256>.parse_hex("") == err(wideint.uwide<256>, wideint.parse.invalid))
    assert(wideint.uwide<256>.parse_hex("0xff") == err(wideint.uwide<256>, wideint.parse.invalid))  // no 0x prefix
    assert(wideint.uwide<256>.parse_hex("g1") == err(wideint.uwide<256>, wideint.parse.invalid))

    // ---- hex round-trip (upper accepted, lower emitted) ----
    let h = h256("DEADBEEF")
    let hs = wideint.uwide.to_hex(h)
    assert(hs == "deadbeef")
    free(hs)
    let ds = wideint.uwide.to_str(h)
    assert(ds == "3735928559")
    free(ds)

    // ---- u128 boundary ----
    let m128 = wideint.uwide<128>.parse("340282366920938463463374607431768211455")!   // 2^128-1
    let m128h = wideint.uwide.to_hex(m128)
    assert(m128h == "ffffffffffffffffffffffffffffffff")
    free(m128h)
    assert(wideint.uwide<128>.parse("340282366920938463463374607431768211456") == err(wideint.uwide<128>, wideint.parse.overflow))  // 2^128
    assert(m128 == wideint.uwide<128>.max())
    assert(wideint.uwide.is_zero(wideint.uwide<128>.min()))
    // u128 mul_wide: (2^64-1)^2
    let f = wideint.uwide<128>.from_u64(0xFFFFFFFFFFFFFFFFu64)
    assert(wideint.uwide.mul_wide(f, f) == h256("fffffffffffffffe0000000000000001"))

    // ---- u512: parse, wrap-mul + to_hex, add-carry across full width ----
    let b512 = wideint.uwide<512>.parse("3273390607896141870013189696827599152216642046043064789483291368096133796520466644120586287749475142159574591980830055674857820585342977061241657241657")!
    let b512h = wideint.uwide.to_hex(wideint.uwide.mul(b512, wideint.uwide<512>.from_u64(1000u64)))
    assert(b512h == "3e800000000000000000000000000000000000000000000000000000000003e80000000000000000000000000000000000000000000000000000000000bc5ea8")
    free(b512h)
    // (2^512 - 1) + 1 wraps to 0 with carry
    let max512 = wideint.uwide<512>.parse_hex("ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff")!
    assert(max512 == wideint.uwide<512>.max())
    let { s, carry } = wideint.uwide.add_carry(max512, wideint.uwide<512>.from_u64(1u64))
    assert(wideint.uwide.is_zero(s))
    assert(carry)
    0
