import fixint from std::

let hi = (s: const str) -> fixint.i256.parse_hex(s)!

let main = (args: str[]) ->
    let a = fixint.i256.parse("-1000000000000000000000000000000000000")!
    let b = fixint.i256.from_i64(7i64)

    // signed decimal round-trip through to_str (keeps the sign)
    let astr = fixint.i256.to_str(a)
    assert(astr == "-1000000000000000000000000000000000000")
    free(astr)
    assert(fixint.i256.is_neg(a))
    assert(!fixint.i256.is_neg(b))

    // signed div/rem — C truncation: quotient toward zero, remainder takes the
    // dividend's sign
    let q = fixint.i256.div(a, b)
    let r = fixint.i256.rem(a, b)
    let qs = fixint.i256.to_str(q)
    let rs = fixint.i256.to_str(r)
    assert(qs == "-142857142857142857142857142857142857")
    assert(rs == "-1")
    free(qs)
    free(rs)
    // identity q*b + r == a
    assert(fixint.i256.add(fixint.i256.mul(q, b), r) == a)

    // abs / neg
    assert(fixint.i256.cmp(fixint.i256.abs(a), fixint.i256.neg(a)) == 0)
    assert(fixint.i256.is_neg(fixint.i256.neg(b)))

    // arithmetic shift right preserves the sign bit
    assert(fixint.i256.shr(a, 10u32) == hi("ffffffffffffffffffffffffffffffffffffcfda0c610dbe3a932d183c000000"))
    assert(fixint.i256.shr(fixint.i256.from_i64(-1i64), 100u32) == fixint.i256.from_i64(-1i64))

    // signed compare
    assert(fixint.i256.cmp(a, b) == -1)
    assert(fixint.i256.cmp(b, a) == 1)
    assert(fixint.i256.cmp(fixint.i256.from_i64(-5i64), fixint.i256.from_i64(-3i64)) == -1)

    // min / -1 wraps to min (signed overflow, two's complement)
    let mn = fixint.i256.parse("-57896044618658097711785492504343953926634992332820282019728792003956564819968")!
    assert(mn == fixint.i256.min())
    let mns = fixint.i256.to_str(fixint.i256.div(mn, fixint.i256.from_i64(-1i64)))
    assert(mns == "-57896044618658097711785492504343953926634992332820282019728792003956564819968")
    free(mns)

    // parse range: max ok (== max()), max+1 overflow, min-1 overflow
    assert(fixint.i256.parse("57896044618658097711785492504343953926634992332820282019728792003956564819967")! == fixint.i256.max())
    assert(fixint.i256.parse("57896044618658097711785492504343953926634992332820282019728792003956564819968") == err(fixint.i256, fixint.parse.overflow))
    assert(fixint.i256.parse("-57896044618658097711785492504343953926634992332820282019728792003956564819969") == err(fixint.i256, fixint.parse.overflow))

    // parse_hex reads raw two's-complement bits ("ff..ff" == -1)
    assert(fixint.i256.parse_hex("ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff")! == fixint.i256.from_i64(-1i64))

    // try_to_i64 round-trip and out-of-range
    assert(fixint.i256.try_to_i64(fixint.i256.from_i64(-123456789i64))! == -123456789i64)
    assert(fixint.i256.try_to_i64(a).is_none)

    // i128 / i512 basics: negative round-trip + div identity
    let p = fixint.i128.parse("-170141183460469231731687303715884105728")!  // i128 min
    assert(p == fixint.i128.min())
    let ph = fixint.i128.to_hex(p)
    assert(ph == "80000000000000000000000000000000")
    free(ph)
    // min/max order and the min == max+1 wrap relation (i512)
    assert(fixint.i512.cmp(fixint.i512.min(), fixint.i512.max()) == -1)
    assert(fixint.i512.add(fixint.i512.max(), fixint.i512.from_i64(1i64)) == fixint.i512.min())
    let e = fixint.i512.from_i64(-1000000i64)
    let f = fixint.i512.from_i64(-7i64)
    let { eq, er } = fixint.i512.divmod(e, f)
    assert(fixint.i512.add(fixint.i512.mul(eq, f), er) == e)
    0
