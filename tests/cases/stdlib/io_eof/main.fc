import io from std::
import sys from std::

let main = (args: str[]) ->
    let tmp = sys.temp_dir()!
    let path = alloca("%s{tmp}/fc_test_eof.txt")

    // Write a small file
    match io.open(path, "w") with
    | ok(wf) ->
        io.write("hi", wf)
        io.close(wf)!
    | err(_) -> return 1

    match io.open(path, "r") with
    | ok(rf) ->
        // Not at EOF yet
        assert(io.eof(rf) == false)

        // Read all content
        let mut buf = u8[16] {}
        io.read(buf, 16, rf)

        // After reading past end, eof should be true
        assert(io.eof(rf) == true)

        io.close(rf)!
    | err(_) -> return 2

    io.remove(path)!
    0
