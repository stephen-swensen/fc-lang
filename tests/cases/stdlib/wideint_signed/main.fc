import wideint from std::

let hi = (s: const str) -> wideint.iwide<256>.parse_hex(s)!

let main = (args: str[]) ->
    let a = wideint.iwide<256>.parse("-1000000000000000000000000000000000000")!
    let b = wideint.iwide<256>.from_i64(7i64)

    // signed decimal round-trip through to_str (keeps the sign)
    let astr = wideint.iwide.to_str(a)
    assert(astr == "-1000000000000000000000000000000000000")
    free(astr)
    assert(wideint.iwide.is_neg(a))
    assert(!wideint.iwide.is_neg(b))

    // signed div/rem — C truncation: quotient toward zero, remainder takes the
    // dividend's sign
    let q = wideint.iwide.div(a, b)
    let r = wideint.iwide.rem(a, b)
    let qs = wideint.iwide.to_str(q)
    let rs = wideint.iwide.to_str(r)
    assert(qs == "-142857142857142857142857142857142857")
    assert(rs == "-1")
    free(qs)
    free(rs)
    // identity q*b + r == a
    assert(wideint.iwide.add(wideint.iwide.mul(q, b), r) == a)

    // abs / neg
    assert(wideint.iwide.cmp(wideint.iwide.abs(a), wideint.iwide.neg(a)) == 0)
    assert(wideint.iwide.is_neg(wideint.iwide.neg(b)))

    // arithmetic shift right preserves the sign bit
    assert(wideint.iwide.shr(a, 10u32) == hi("ffffffffffffffffffffffffffffffffffffcfda0c610dbe3a932d183c000000"))
    assert(wideint.iwide.shr(wideint.iwide<256>.from_i64(-1i64), 100u32) == wideint.iwide<256>.from_i64(-1i64))

    // signed compare
    assert(wideint.iwide.cmp(a, b) == -1)
    assert(wideint.iwide.cmp(b, a) == 1)
    assert(wideint.iwide.cmp(wideint.iwide<256>.from_i64(-5i64), wideint.iwide<256>.from_i64(-3i64)) == -1)

    // min / -1 wraps to min (signed overflow, two's complement)
    let mn = wideint.iwide<256>.parse("-57896044618658097711785492504343953926634992332820282019728792003956564819968")!
    assert(mn == wideint.iwide<256>.min())
    let mns = wideint.iwide.to_str(wideint.iwide.div(mn, wideint.iwide<256>.from_i64(-1i64)))
    assert(mns == "-57896044618658097711785492504343953926634992332820282019728792003956564819968")
    free(mns)

    // parse range: max ok (== max()), max+1 overflow, min-1 overflow
    assert(wideint.iwide<256>.parse("57896044618658097711785492504343953926634992332820282019728792003956564819967")! == wideint.iwide<256>.max())
    assert(wideint.iwide<256>.parse("57896044618658097711785492504343953926634992332820282019728792003956564819968") == err(wideint.iwide<256>, wideint.parse.overflow))
    assert(wideint.iwide<256>.parse("-57896044618658097711785492504343953926634992332820282019728792003956564819969") == err(wideint.iwide<256>, wideint.parse.overflow))

    // parse_hex reads raw two's-complement bits ("ff..ff" == -1)
    assert(wideint.iwide<256>.parse_hex("ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff")! == wideint.iwide<256>.from_i64(-1i64))

    // try_to_i64 round-trip and out-of-range
    assert(wideint.iwide.try_to_i64(wideint.iwide<256>.from_i64(-123456789i64))! == -123456789i64)
    assert(wideint.iwide.try_to_i64(a).is_none)

    // i128 / i512 basics: negative round-trip + div identity
    let p = wideint.iwide<128>.parse("-170141183460469231731687303715884105728")!  // i128 min
    assert(p == wideint.iwide<128>.min())
    let ph = wideint.iwide.to_hex(p)
    assert(ph == "80000000000000000000000000000000")
    free(ph)
    // min/max order and the min == max+1 wrap relation (i512)
    assert(wideint.iwide.cmp(wideint.iwide<512>.min(), wideint.iwide<512>.max()) == -1)
    assert(wideint.iwide.add(wideint.iwide<512>.max(), wideint.iwide<512>.from_i64(1i64)) == wideint.iwide<512>.min())
    let e = wideint.iwide<512>.from_i64(-1000000i64)
    let f = wideint.iwide<512>.from_i64(-7i64)
    let { eq, er } = wideint.iwide.divmod(e, f)
    assert(wideint.iwide.add(wideint.iwide.mul(eq, f), er) == e)
    0
