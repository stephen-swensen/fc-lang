// Comparing a variable with itself (`x == x`, `x <= x`) is legal FC (only
// self-assignment is rejected) and compiles to warning-clean C. Regression:
// integer self-compares used to be emitted as `_l_x_0 == _l_x_0`, which trips
// gcc/clang -Werror=tautological-compare.
let main = (args: str[]) ->
    let x = 5
    assert(x == x)
    assert(x <= x)
    assert(!(x != x))
    0
