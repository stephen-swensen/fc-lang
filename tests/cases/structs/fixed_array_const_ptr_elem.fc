// A fixed-array field whose elements are read-only pointers is used like any
// other: read, written, iterated, and viewed as a slice, whole or in part.
let total = (xs: (const i32*)[]) ->
    let mut t = 0
    for p in xs do
        t = t + p[0]
    t

let count = (xs: const (const i32*)[]) -> xs.len

struct holder =
    nums: (const i32*)[3]
    names: (const cstr)[2]
    raw: (const any*)[2]

let main = (args: str[]) ->
    let n = 7
    let m = 30
    let mut h = holder { }
    h.nums[0] = &n
    h.nums[1] = &m
    h.nums[2] = &n
    h.names[0] = c"hi"
    h.raw[1] = (const any*) &m

    let x = h.nums[1]
    assert(x[0] == 30)
    assert(h.names[0][1] == 'i')
    assert(h.raw[1] == (const any*) &m)

    assert(total(h.nums) == 44)
    assert(total(h.nums[1..3]) == 37)
    assert(count(h.nums) == 3)
    let view = h.nums
    assert(view[2][0] == 7)

    let mut sum = 0
    for i, p in h.nums do
        sum = sum + (i32) i + p[0]
    assert(sum == 3 + 44)

    let slot = &h.nums[1]
    assert(slot[0][0] == 30)

    // through a pointer to the struct, and from a copy of it
    let ph = &h
    ph.nums[0] = &m
    assert(ph.nums[0][0] == 30)
    let copy = h
    assert(total(copy.nums) == 67)
    0
