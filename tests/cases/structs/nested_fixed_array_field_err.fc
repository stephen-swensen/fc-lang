// A fixed array must be a field's outermost type, so a nested fixed-array
// field `u8[2][3]` is a compile error. Regression: it used to be accepted and
// emitted `uint8_t[2] m[3];`, which is not a C declaration.
struct grid =
    m: u8[2][3]

let main = (args: str[]) ->
    let g = default(grid)
    assert(g.m.len == 2)
    0
