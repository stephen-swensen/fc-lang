// A trailing comma after the last element is accepted in every slice-literal
// form, as it is after the last field of a struct literal.
let main = (args: str[]) ->
    let a = i32[3] { 1, 2, 3, }
    let h = alloc(i32[3] { 4, 5, 6, })!
    let s = alloca(i32[2] { 7, 8, })
    let lines = i32[2] {
        9,
        10,
    }
    assert(a[2] + h[2] + s[1] + lines[1] == 3 + 6 + 8 + 10)
    free(h)
    0
