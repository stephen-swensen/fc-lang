// A runtime raw-parts len over the stored width traps at construction:
// a 40000-element slice cannot exist under --len-repr 16.
let main = (args: str[]) ->
    match alloc(u8, 16) with
    | some(p) ->
        let mut n = 40000i64
        n = n + 0
        let s = u8[] { ptr = p, len = n }
        (i32) s.len
    | none -> 1
