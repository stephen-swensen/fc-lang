// The representation-preserving widens reach slice-literal elements too:
// adding const, and T* -> any*.
struct pt =
    x: i32

let main = (args: str[]) ->
    let mut buf = alloc(u8[2] { 65u8, 66u8 })!
    let mut other = alloc(u8[2] { 67u8, 68u8 })!

    // str -> const str (the literal spelling a mixed list of both)
    let names = const str[3] { buf, other, "lit" }
    assert(names[0][0] == 65u8)
    assert(names[2].len == 3)

    // i32* -> any*
    let mut a = 1i32
    let mut b = 2i32
    let ptrs = any*[2] { &a, &b }
    assert(ptrs.len == 2)

    // struct pointers into any*, mixed with an exact any* element
    let mut p = pt { x = 7 }
    let opaque = (any*) &b
    let mixed = any*[2] { &p, opaque }
    assert(mixed.len == 2)

    // const i32* elements stay exact (no widening needed)
    let cp = (const i32*) &a
    let cps = const i32*[2] { cp, cp }
    assert(*cps[0] == 1)

    free(buf)
    free(other)
    0
