// A dotted module-const reference folds as a slice-literal length (the same
// const-fold path that serves bare idents and type properties).
module cfg =
    let words = 4
    let bits = 32

let main = (args: str[]) ->
    let b = u32[cfg.words] { }
    assert(b.len == 4)
    let c = bool[cfg.words * 2] { }
    assert(c.len == 8)
    let d = u8[cfg.bits / 8] { 1u8, 2u8, 3u8, 4u8 }
    assert(d[3] == 4u8)
    0
