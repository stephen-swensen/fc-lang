// A slice literal's element type may start with `const`: `const str[2] { ... }`
// is the only spelling that can hold string literals (`str[2] { "a" }` is
// rejected, since a const str doesn't narrow to str). Regression: the
// expression parser used to reject a const-prefixed slice-literal head.
let main = (args: str[]) ->
    let names = const str[2] { "a", "bc" }
    assert(names.len == 2)
    assert(names[1].len == 2)
    0
