// An extern function has no FC fat-pointer representation — its C ABI lacks the
// trailing context param every FC function value carries — so binding it as a
// value is a clean FC error, not uncompilable C. Call it directly or wrap it in
// a lambda instead.
module c from "stdlib.h" =
    extern abs: (i32) -> i32

let main = (args: str[]) ->
    let f = c.abs
    assert(f(0 - 10) == 10)
    0
