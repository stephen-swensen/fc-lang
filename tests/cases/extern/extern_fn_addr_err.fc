// `&f` extracts the fn_ptr field of an FC fat pointer; an extern function is not
// a fat pointer, so &extern is rejected (spec §Address-of covers FC functions).
module c from "stdlib.h" =
    extern abs: (i32) -> i32

let take = (p: any*) -> 0

let main = (args: str[]) ->
    let p = &c.abs
    take(p)
