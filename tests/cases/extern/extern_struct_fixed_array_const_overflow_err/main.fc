// A module constant of an extern struct type gets the same compile-time
// overflow check on its fixed-array field as an FC struct.
module h from "fixed_array_box.h" =
    extern struct fc_box =
        name: u8[2]
        filled: i32

module m =
    let b = h.fc_box { name = u8[3] { 1u8, 2u8, 3u8 }, filled = 3 }

let main = (args: str[]) ->
    m.b.filled
