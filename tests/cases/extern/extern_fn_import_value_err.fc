// An extern function reached as a bare (imported) name is rejected the same as
// the qualified form — the EXPR_IDENT resolution path is covered too.
module c from "stdlib.h" =
    extern abs: (i32) -> i32

module user =
    import abs from c
    let go = () ->
        let f = abs
        0

let main = (args: str[]) ->
    user.go()
    0
