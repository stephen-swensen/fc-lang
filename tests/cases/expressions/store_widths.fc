// Stores of each width write exactly their own bytes. The native backend
// stores a constant or a variable straight into a place it can address
// without code (a local, a global, a field or tuple element of one), and
// into an element or a pointed-to field once its address is computed; each
// form is checked with every neighbor left intact. Reads of fixed places (a
// slice's len and ptr, fields of globals) are checked along the way.

struct packed =
    a: u8
    b: i8
    c: u16
    d: i32
    e: i64
    f: f32
    g: f64
    h: bool

let mut glob = packed { a = 0u8, b = 0i8, c = 0u16, d = 0, e = 0i64, f = 0.0f32, g = 0.0, h = false }
let mut g8 = 0i64
let mut g4 = 0u32
let mut g1 = 0u8
let mut gf = 0.0
let mut gs = i64[3] { 1i64, 2i64, 3i64 }

let fill = (p: packed*, v8: u8, v64: i64) ->
    p.a = v8
    p.b = -1i8
    p.c = 65535u16
    p.d = -2147483648
    p.e = v64
    p.f = 0.5f32
    p.g = -2.25
    p.h = true
    0

let check = (s: packed, v8: u8, v64: i64) ->
    assert(s.a == v8 && s.b == -1i8 && s.c == 65535u16 && s.d == -2147483648)
    assert(s.e == v64 && s.f == 0.5f32 && s.g == -2.25 && s.h)
    0

let main = (args: str[]) ->
    let v8 = 200u8
    let v64 = -4294967297i64

    // a local struct's fields, one by one: the others stay as they were
    let mut s = packed { a = 1u8, b = 2i8, c = 3u16, d = 4, e = 5i64, f = 6.0f32, g = 7.0, h = false }
    s.a = 255u8
    assert(s.a == 255u8 && s.b == 2i8 && s.c == 3u16)
    s.b = -128i8
    assert(s.a == 255u8 && s.b == -128i8 && s.c == 3u16)
    s.c = 65535u16
    assert(s.b == -128i8 && s.c == 65535u16 && s.d == 4)
    s.d = -1
    assert(s.c == 65535u16 && s.d == -1 && s.e == 5i64)
    s.e = 9223372036854775807i64
    assert(s.d == -1 && s.e == 9223372036854775807i64 && s.f == 6.0f32)
    s.e = 2147483648i64
    assert(s.e == 2147483648i64)
    s.f = 1.25f32
    s.g = 3.5
    s.h = true
    assert(s.e == 2147483648i64 && s.f == 1.25f32 && s.g == 3.5 && s.h)
    s.a = v8
    s.e = v64
    assert(s.a == v8 && s.b == -128i8 && s.e == v64)

    // through a pointer, constants and variables
    let mut t = default(packed)
    fill(&t, v8, v64)
    check(t, v8, v64)

    // globals
    fill(&glob, v8, v64)
    check(glob, v8, v64)
    glob.c = 1u16
    glob.e = -2147483649i64
    assert(glob.b == -1i8 && glob.c == 1u16 && glob.d == -2147483648 && glob.e == -2147483649i64)
    g8 = 4294967295i64
    g4 = 4294967295u32
    g1 = 255u8
    gf = 0.125
    assert(g8 == 4294967295i64 && g4 == 4294967295u32 && g1 == 255u8 && gf == 0.125)
    g8 = -1
    g4 = 0u32
    assert(g8 == -1 && g4 == 0u32 && g1 == 255u8)
    gs[1] = 42i64
    assert(gs.len == 3 && gs[0] == 1i64 && gs[1] == 42i64 && gs[2] == 3i64)

    // a local tuple's elements
    let mut tup = { 1u8, 2i64, 3u16 }
    tup[0] = 255u8
    tup[2] = 65535u16
    tup[1] = v64
    assert(tup[0] == 255u8 && tup[1] == v64 && tup[2] == 65535u16)

    // slice elements of each width
    let mut b = u8[4] { 1u8, 2u8, 3u8, 4u8 }
    b[1] = 255u8
    b[2] = v8
    assert(b[0] == 1u8 && b[1] == 255u8 && b[2] == v8 && b[3] == 4u8)
    let mut w = i16[3] { 1i16, 2i16, 3i16 }
    w[1] = -32768i16
    assert(w[0] == 1i16 && w[1] == -32768i16 && w[2] == 3i16)
    let mut q = i64[3] { 1i64, 2i64, 3i64 }
    q[1] = 2147483648i64
    q[2] = -2147483649i64
    q[0] = v64
    assert(q[0] == v64 && q[1] == 2147483648i64 && q[2] == -2147483649i64)
    let mut fl = f32[3] { 1.0f32, 2.0f32, 3.0f32 }
    let half = 0.5f32
    fl[1] = half
    fl[2] = 8.0f32
    assert(fl[0] == 1.0f32 && fl[1] == 0.5f32 && fl[2] == 8.0f32)

    // a slice's len and ptr read in place, as an index bound
    let mut sum = 0i64
    for i in 0..q.len do sum = sum + q[i]
    assert(sum == v64 + 2147483648i64 - 2147483649i64)
    let mut n = 0i64
    loop
        if n >= gs.len then break
        n = n + 1
    assert(n == 3 && q.ptr != gs.ptr)
    0
