// `a<b>(c)` on numeric locals: `a` is not a generic declaration, so the
// expression keeps its comparison reading `(a < b) > (c)` — which orders a
// bool against an i32 and is rejected with a comparison diagnostic (not a
// misleading "cannot call" error from a stolen generic-call parse).
let main = (args: str[]) ->
    let a = 3
    let b = 4
    let c = 5
    let r = a<b>(c)
    if r then 1 else 0
