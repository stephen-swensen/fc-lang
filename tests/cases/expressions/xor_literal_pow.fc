// Xor of decimal literals such as `10 ^ 6` and `2 ^ 8` is plain xor and
// compiles to warning-clean C. Regression: the operands used to be emitted
// verbatim, tripping gcc/clang -Werror=xor-used-as-pow ("result of '10^6' is
// 12; did you mean '1e6'?").
let main = (args: str[]) ->
    let x = 10 ^ 6
    assert(x == 12)
    let y = 2 ^ 8
    assert(y == 10)
    0
