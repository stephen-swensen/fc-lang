// Indexing evaluates the container before the index, so an index that
// changes the container (reassigns the slice or pointer, or calls something
// that does) indexes the container as it was. The same holds for an
// assignment's target and a sub-slice's bounds, and an index reads what the
// container's evaluation left behind.

struct holder =
    items: i64[]

struct bank =
    vals: i64[3]

let mut gs = i64[3] { 10, 20, 30 }
let mut other = i64[3] { 40, 50, 60 }
let mut counter = 0i64

// Points gs elsewhere and returns 1.
let swap_global = () ->
    gs = other
    1

let next_slice = (s: i64[]) ->
    counter = counter + 1
    s

let next_ptr = (p: i64*) ->
    counter = counter + 1
    p

let main = (args: str[]) ->
    let a = i64[3] { 10, 20, 30 }
    let b = i64[3] { 40, 50, 60 }

    // a slice local reassigned by the index, read and written
    let mut s = a
    assert(s[(s = b; 1)] == 20 && s[0] == 40)
    let mut t = a
    t[(t = b; 0)] = 11
    assert(a[0] == 11 && b[0] == 40 && t[0] == 40)

    // a pointer local reassigned by the index, read and written
    let mut p = &a[0]
    let q = p
    assert(p[(p = &b[0]; 2)] == 30 && p[0] == 40 && q[1] == 20)
    p[(p = &a[0]; 1)] = 55
    assert(b[1] == 55 && a[1] == 20)

    // a sub-slice evaluates the slice, then lo, then hi
    let mut r = a
    let mut m = 0i64
    let w = r[(r = b; m = 1; m)..m + 2]
    assert(w.len == 2 && w[0] == 20 && w[1] == 30 && r[0] == 40)

    // a slice field through a pointer, reassigned by the index
    let mut h = holder { items = a }
    let hp = &h
    assert(hp.items[(hp.items = b; 2)] == 30 && h.items[2] == 60)

    // a fixed-array field through a pointer the index moves
    let mut b1 = bank { vals = i64[3] { 1, 2, 3 } }
    let mut b2 = bank { vals = i64[3] { 4, 5, 6 } }
    let mut bp = &b1
    assert(bp.vals[(bp = &b2; 1)] == 2 && bp.vals[1] == 5)
    bp.vals[(bp = &b1; 0)] = 9
    assert(b2.vals[0] == 9 && b1.vals[0] == 1)

    // a global slice changed by a call in the index
    assert(gs[swap_global()] == 20 && gs[1] == 50)

    // the index reads counter after the container's call has bumped it
    counter = 0
    let c = i64[3] { 7, 8, 9 }
    assert(next_slice(c)[counter] == 8 && counter == 1)
    assert(next_ptr(&c[0])[counter] == 9 && counter == 2)
    0
