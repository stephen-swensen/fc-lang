// Division and remainder by a constant divisor agree with the same operation
// on that value held in a parameter, for every integer width and both
// signednesses: negative dividends round toward zero, powers of two (which the
// native backend turns into shifts and masks) included, up to 2^62 signed and
// 2^63 unsigned, and other constants, negative ones and the type's minimum.

let div_i64 = (x: i64, d: i64) -> x / d
let rem_i64 = (x: i64, d: i64) -> x % d
let div_u64 = (x: u64, d: u64) -> x / d
let rem_u64 = (x: u64, d: u64) -> x % d
let div_i32 = (x: i32, d: i32) -> x / d
let rem_i32 = (x: i32, d: i32) -> x % d
let div_u32 = (x: u32, d: u32) -> x / d
let rem_u32 = (x: u32, d: u32) -> x % d
let div_i16 = (x: i16, d: i16) -> x / d
let rem_i16 = (x: i16, d: i16) -> x % d
let div_u8 = (x: u8, d: u8) -> x / d
let rem_u8 = (x: u8, d: u8) -> x % d
let div_i8 = (x: i8, d: i8) -> x / d
let rem_i8 = (x: i8, d: i8) -> x % d

let check_i64 = (x: i64) ->
    assert(x / 1 == div_i64(x, 1) && x % 1 == rem_i64(x, 1))
    assert(x / 2 == div_i64(x, 2) && x % 2 == rem_i64(x, 2))
    assert(x / 8 == div_i64(x, 8) && x % 8 == rem_i64(x, 8))
    assert(x / 1024 == div_i64(x, 1024) && x % 1024 == rem_i64(x, 1024))
    assert(x / 2147483648i64 == div_i64(x, 2147483648i64) && x % 2147483648i64 == rem_i64(x, 2147483648i64))
    assert(x / 4294967296i64 == div_i64(x, 4294967296i64) && x % 4294967296i64 == rem_i64(x, 4294967296i64))
    assert(x / 4611686018427387904i64 == div_i64(x, 4611686018427387904i64))
    assert(x % 4611686018427387904i64 == rem_i64(x, 4611686018427387904i64))
    assert(x / 3 == div_i64(x, 3) && x % 3 == rem_i64(x, 3))
    assert(x / 10 == div_i64(x, 10) && x % 10 == rem_i64(x, 10))
    assert(x / -4 == div_i64(x, -4) && x % -4 == rem_i64(x, -4))
    assert(x / -7 == div_i64(x, -7) && x % -7 == rem_i64(x, -7))
    assert(x / -1 == div_i64(x, -1) && x % -1 == rem_i64(x, -1))
    assert(x / i64.min == div_i64(x, i64.min) && x % i64.min == rem_i64(x, i64.min))
    assert(x / i64.max == div_i64(x, i64.max) && x % i64.max == rem_i64(x, i64.max))

let check_u64 = (x: u64) ->
    assert(x / 1u64 == div_u64(x, 1u64) && x % 1u64 == rem_u64(x, 1u64))
    assert(x / 2u64 == div_u64(x, 2u64) && x % 2u64 == rem_u64(x, 2u64))
    assert(x / 4096u64 == div_u64(x, 4096u64) && x % 4096u64 == rem_u64(x, 4096u64))
    assert(x / 4294967296u64 == div_u64(x, 4294967296u64))
    assert(x % 4294967296u64 == rem_u64(x, 4294967296u64))
    assert(x / 9223372036854775808u64 == div_u64(x, 9223372036854775808u64))
    assert(x % 9223372036854775808u64 == rem_u64(x, 9223372036854775808u64))
    assert(x / 10u64 == div_u64(x, 10u64) && x % 10u64 == rem_u64(x, 10u64))
    assert(x / u64.max == div_u64(x, u64.max) && x % u64.max == rem_u64(x, u64.max))

let check_i32 = (x: i32) ->
    assert(x / 4 == div_i32(x, 4) && x % 4 == rem_i32(x, 4))
    assert(x / 65536 == div_i32(x, 65536) && x % 65536 == rem_i32(x, 65536))
    assert(x / 1073741824 == div_i32(x, 1073741824) && x % 1073741824 == rem_i32(x, 1073741824))
    assert(x / 7 == div_i32(x, 7) && x % 7 == rem_i32(x, 7))
    assert(x / -2 == div_i32(x, -2) && x % -2 == rem_i32(x, -2))
    assert(x / i32.min == div_i32(x, i32.min) && x % i32.min == rem_i32(x, i32.min))

let check_u32 = (x: u32) ->
    assert(x / 16u32 == div_u32(x, 16u32) && x % 16u32 == rem_u32(x, 16u32))
    assert(x / 2147483648u32 == div_u32(x, 2147483648u32) && x % 2147483648u32 == rem_u32(x, 2147483648u32))
    assert(x / 1000u32 == div_u32(x, 1000u32) && x % 1000u32 == rem_u32(x, 1000u32))
    assert(x / u32.max == div_u32(x, u32.max) && x % u32.max == rem_u32(x, u32.max))

let check_i16 = (x: i16) ->
    assert(x / 2i16 == div_i16(x, 2i16) && x % 2i16 == rem_i16(x, 2i16))
    assert(x / 16384i16 == div_i16(x, 16384i16) && x % 16384i16 == rem_i16(x, 16384i16))
    assert(x / -3i16 == div_i16(x, -3i16) && x % -3i16 == rem_i16(x, -3i16))

let check_u8 = (x: u8) ->
    assert(x / 2u8 == div_u8(x, 2u8) && x % 2u8 == rem_u8(x, 2u8))
    assert(x / 128u8 == div_u8(x, 128u8) && x % 128u8 == rem_u8(x, 128u8))
    assert(x / 255u8 == div_u8(x, 255u8) && x % 255u8 == rem_u8(x, 255u8))

let check_i8 = (x: i8) ->
    assert(x / 2i8 == div_i8(x, 2i8) && x % 2i8 == rem_i8(x, 2i8))
    assert(x / 64i8 == div_i8(x, 64i8) && x % 64i8 == rem_i8(x, 64i8))
    assert(x / -128i8 == div_i8(x, -128i8) && x % -128i8 == rem_i8(x, -128i8))
    assert(x / 5i8 == div_i8(x, 5i8) && x % 5i8 == rem_i8(x, 5i8))

// The divisor as a const type parameter.
let div_by = <'n>(x: i64) -> x / 'n
let rem_by = <'n>(x: i64) -> x % 'n

let main = (args: str[]) ->
    for x in i64[] { len = 17, i64.min, i64.min + 1, -1000000007, -4294967297i64, -1025, -1024, -1023,
                       -8, -7, -1, 0, 1, 7, 1024, 4294967297i64, i64.max - 1, i64.max } do
        check_i64(x)
        assert(div_by<8>(x) == div_i64(x, 8) && rem_by<8>(x) == rem_i64(x, 8))
        assert(div_by<10>(x) == div_i64(x, 10) && rem_by<10>(x) == rem_i64(x, 10))
    for x in u64[] { len = 8, 0u64, 1u64, 4095u64, 4096u64, 4294967297u64, 9223372036854775807u64,
                      9223372036854775808u64, u64.max } do
        check_u64(x)
    for x in i32[] { i32.min, i32.min + 1, -65537, -5, -1, 0, 5, 65537, i32.max } do
        check_i32(x)
    for x in u32[] { 0u32, 15u32, 2147483648u32, 4000000000u32, u32.max } do
        check_u32(x)
    for x in i16[] { i16.min, -16385i16, -3i16, -1i16, 0i16, 16385i16, i16.max } do
        check_i16(x)
    for x in u8[] { 0u8, 1u8, 127u8, 128u8, 255u8 } do
        check_u8(x)
    for x in i8[] { -128i8, -127i8, -65i8, -1i8, 0i8, 1i8, 65i8, 127i8 } do
        check_i8(x)
    0
