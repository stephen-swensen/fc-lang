// Block items must be separated by a newline or `;`. Two expressions juxtaposed
// on one line (`let x = 5 6`, `continue 5`) are a syntax error. Regression: the
// parser used to accept them as separate statements and discard the trailing
// expression.
let main = (args: str[]) ->
    let x = 5 6
    assert(x == 5)
    0
