// 4 levels: outer struct -> inner struct -> option -> union
// Tests that Maranget recurses through multiple struct layers
union status =
    | good
    | bad(i32)

struct header =
    code: status
    flag: bool

struct packet =
    hdr: header
    size: i32

let classify = (p: packet) ->
    match p with
    | { hdr = { code = good, flag = true } } -> 1
    | { hdr = { code = good, flag = false } } -> 2
    | { hdr = { code = bad(c), flag = true } } -> c
    | { hdr = { code = bad(c), flag = false } } -> 0 - c

let main = (args: str[]) ->
    let p1 = packet { hdr = header { code = status.good, flag = true }, size = 100 }
    let p2 = packet { hdr = header { code = status.good, flag = false }, size = 200 }
    let p3 = packet { hdr = header { code = status.bad(5), flag = true }, size = 300 }
    let p4 = packet { hdr = header { code = status.bad(5), flag = false }, size = 400 }
    assert(classify(p1) == 1)
    assert(classify(p2) == 2)
    assert(classify(p3) == 5)
    assert(classify(p4) + 5 == 0)
    0
