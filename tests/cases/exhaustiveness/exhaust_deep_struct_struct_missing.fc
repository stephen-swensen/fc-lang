// 4 levels: outer struct -> inner struct -> union x bool
// Missing { code = bad(_), flag = false }
union status =
    | good
    | bad(i32)

struct header =
    code: status
    flag: bool

struct packet =
    hdr: header
    size: i32

let classify = (p: packet) ->
    match p with
    | { hdr = { code = good, flag = true } } -> 1
    | { hdr = { code = good, flag = false } } -> 2
    | { hdr = { code = bad(c), flag = true } } -> c

let main = (args: str[]) ->
    classify(packet { hdr = header { code = status.good, flag = true }, size = 0 })
