// A fixed-array field overflow on assignment reports a backtrace like every
// other runtime abort.
struct small =
    data: i32[2]

let fill = (s: small*, xs: i32[]) ->
    s.data = xs

let main = (args: str[]) ->
    let mut s = small { }
    let big = i32[4] { 1, 2, 3, 4 }
    fill(&s, big)
    0
