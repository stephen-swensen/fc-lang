// A heap copy of a read-only slice of strings copies the string views, not
// the bytes they point at, so the views stay read-only. Regression: the copy
// was a `str[]`, and writes reached the source's read-only strings.
let main = (args: str[]) ->
    let mut buf = alloc(u8[4] { })!
    let ro = (const str[]) str[1] { buf }
    let h = alloc(ro)!
    let w = h[0]
    w[0] = 5u8
    (i32) buf[0]
