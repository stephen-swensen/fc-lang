// A value loaded out of a slice is the *stored value*, not the backing store,
// so it carries the container's element provenance rather than the container's
// own. Without that split a slice literal — always stack-backed — made every
// heap allocation parked in it unfreeable, which is the basic collection
// pattern. escape/free_stack_slice_elem_err pins the other side: a container
// that has actually held a stack slice stays tainted.
let main = (args: str[]) ->
    let ss = (i32[])[2] { }
    ss[0] = alloc(i32[2] { 4, 5 })!
    ss[1] = alloc(i32[3] { 6, 7, 8 })!
    assert(ss[0][1] == 5)
    assert(ss[1][2] == 8)
    free(ss[0])
    // …and through a local copy of the element, too
    let last = ss[1]
    free(last)
    0
