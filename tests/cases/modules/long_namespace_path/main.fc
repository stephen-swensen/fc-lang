// Each module imports the `cfg` of one namespace; if the two namespaces merge,
// both imports name the same module and one of the assertions fails.
module use_a =
    import cfg from nspre_::aaa::
    let get = () -> cfg.v

module use_b =
    import cfg from nspre_::bbb::
    let get = () -> cfg.v

let main = (args: str[]) ->
    assert(use_a.get() == 1)
    assert(use_b.get() == 2)
    0
