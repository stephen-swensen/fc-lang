module lib =
    union result =
        | good('a)
        | bad(i32)

let main = (args: str[]) ->
    let _result =
        let r1 = lib.result<i32>.good(42)
        let r2 = lib.result<i32>.good(10)
        let r3 = lib.result<i32>.bad(0)
        match r1 with
        | good(v) -> match r2 with
            | good(w) -> v + w
            | bad(_) -> 1
        | bad(_) -> 2
    assert(_result == 52)
    0
