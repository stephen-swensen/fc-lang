// Importing over a route does not bind the modules it passed through: `inner`
// is not in scope after `import bump from outer.inner`.
import bump from outer.inner

module outer =
    module inner =
        let bump = (n: i32) -> n + 1

let main = (args: str[]) ->
    assert(bump(1) == 2)
    inner.bump(1)
    0
