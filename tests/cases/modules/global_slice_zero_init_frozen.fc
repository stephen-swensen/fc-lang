// Frozen module `let` with the empty slice form `T[N]{ }` reads as N
// zeros (same regression class as the mut twin: the backing array must
// exist even with no written elements). Also covers the genuinely
// zero-length literal (no backing, len 0) and an empty literal nested
// in a frozen struct member.

struct pair =
    xs: i32[]
    n: i32

module m =
    let fz = i32[5]{ }
    let zl = i32[0]{ }
    let p = pair { xs = i32[3]{ }, n = 7 }

let main = (args: str[]) ->
    for i in 0..5 do assert(m.fz[i] == 0)
    assert(m.fz.len == 5)
    assert(m.zl.len == 0)
    assert(m.p.xs.len == 3)
    assert(m.p.xs[0] == 0 && m.p.xs[2] == 0)
    assert(m.p.n == 7)
    0
