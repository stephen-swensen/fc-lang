// A match pattern binding inherits the scrutinee's provenance, so
// `| some(p) -> p` on some(&x) cannot return a stack pointer, just as
// `some(&x)!` cannot. Regression: pattern bindings used to get unknown
// provenance, letting the pointer escape the frame (ASan:
// stack-use-after-return).
let bad = () ->
    let mut x = 42
    let o = some(&x)
    match o with
    | some(p) -> p
    | none -> default(i32*)

let clobber = (n: i32) ->
    let mut a = n * 3
    let mut b = a + n
    a + b

let main = (args: str[]) ->
    let p = bad()
    let _c = clobber(9)
    assert(*p == 42)
    0
