// Heap-copying a slice whose elements point into the stack is a compile
// error: alloc(slice) copies only the top level, so the heap slice would hold
// pointers into a dead frame. Regression: returning `ptrs` directly was
// rejected, but `alloc(ptrs)!` let the stack pointers escape (ASan:
// stack-use-after-return).
let bad = () ->
    let mut x = 42
    let ptrs = i32*[1] { &x }
    alloc(ptrs)!

let clobber = (n: i32) ->
    let mut q = n * 3
    q + 1

let main = (args: str[]) ->
    let hs = bad()
    let _c = clobber(9)
    let p = hs[0]
    assert(*p == 42)
    0
