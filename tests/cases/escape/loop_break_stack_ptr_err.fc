// A loop's value carries the provenance of its break values, as if and match
// values do, so returning a loop that does `break &x` is a compile error.
// Regression: the break value used to lose its stack provenance, so the
// pointer escaped the frame (ASan: stack-use-after-return).
let bad = () ->
    let p = loop
        let mut x = 41
        x = x + 1
        break &x
    p

let clobber = (n: i32) ->
    let mut q = n * 3
    q + 1

let main = (args: str[]) ->
    let r = bad()
    let _c = clobber(9)
    assert(*r == 42)
    0
