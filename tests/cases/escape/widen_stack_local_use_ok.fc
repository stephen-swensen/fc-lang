// A mut `const cstr` tainted by a stack c"%.Ns{s}" copy may still be used within
// the frame — the taint only forbids escaping, never local use.
let use_local = (p: const str) ->
    let mut c = c"xxxxxxxx"
    c = c"%.7s{p}"
    c[0]

let main = (args: str[]) ->
    let n = use_local("hi")
    assert(n == 104)
    0
