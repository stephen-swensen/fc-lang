// BUG (bugsearch 2026-07-18): alloc(union.variant(&stack)) copies a stack
// pointer into heap memory with no diagnostic (ASan: stack-use-after-return).
// The struct-literal twin IS rejected (escape/alloc_struct_stack_field_err)
// — the union-constructor path misses the same check.
union carrier =
    | held(i32*)
    | empty

let bad = () ->
    let mut x = 42
    alloc(carrier.held(&x))!

let clobber = (n: i32) ->
    let mut q = n * 3
    q + 1

let main = (args: str[]) ->
    let h = bad()
    let _c = clobber(9)
    match *h with
    | held(p) -> assert(*p == 42)
    | empty -> assert(false)
    free(h)
    0
