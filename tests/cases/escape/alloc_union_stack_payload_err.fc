// Heap-allocating a union variant whose payload is a stack pointer
// (`alloc(carrier.held(&x))`) is a compile error, like the struct-literal
// case (escape/alloc_struct_stack_field_err). Regression: the
// union-constructor path used to skip the check and copy the stack pointer
// into heap memory (ASan: stack-use-after-return).
union carrier =
    | held(i32*)
    | empty

let bad = () ->
    let mut x = 42
    alloc(carrier.held(&x))!

let clobber = (n: i32) ->
    let mut q = n * 3
    q + 1

let main = (args: str[]) ->
    let h = bad()
    let _c = clobber(9)
    match *h with
    | held(p) -> assert(*p == 42)
    | empty -> assert(false)
    free(h)
    0
