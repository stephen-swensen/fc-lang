// Loop-carried taint through a bounded c"%.Ns{s}" copy, which copies into a
// stack buffer.
let bad = (name: const str) ->
    let mut p = default(cstr)
    let mut saved = default(cstr)
    for i in 0..2 do
        saved = p
        p = c"%.15s{name}"
    return saved

let main = (args: str[]) ->
    let r = bad("x")
    0
