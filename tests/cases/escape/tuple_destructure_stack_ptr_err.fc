// A tuple-destructure binding inherits the provenance of its component, so
// returning p destructured from `{&x, 1}` is a compile error. Regression:
// destructure bindings used to get unknown provenance, letting the stack
// pointer escape bad()'s frame (ASan: stack-use-after-return).
let bad = () ->
    let mut x = 41
    x = x + 1
    let pair = {&x, 1}
    let {p, n} = pair
    p

let clobber = (m: i32) ->
    let mut q = m * 3
    q + 1

let main = (args: str[]) ->
    let r = bad()
    let _c = clobber(9)
    assert(*r == 42)
    0
