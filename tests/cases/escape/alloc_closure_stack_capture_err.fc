// alloc(lambda) is a compile error when the closure captures a
// stack-allocated value, just as storing that value into a heap struct field
// is. Regression: the closure context used to be promoted to the heap without
// checking its captures, so calling the closure after make() returned read a
// dead frame (ASan: stack-use-after-return).
let make = () ->
    let buf = i32[2] { 7, 8 }
    alloc(() -> buf[0])!

let main = (args: str[]) ->
    let f = make()
    let v = f()
    free(f)
    assert(v == 7)
    0
