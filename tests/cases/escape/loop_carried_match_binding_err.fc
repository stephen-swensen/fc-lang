// Loop-carried taint through a match binding of a stack pointer.
let bad = () ->
    let mut p = default(i32*)
    let mut saved = default(i32*)
    for i in 0..2 do
        saved = p
        let mut x = 5
        p = match some(&x) with
            | some(q) -> q
            | none -> p
    return saved

let main = (args: str[]) ->
    let r = bad()
    0
