// A for-loop element binding keeps the provenance of the slice's elements,
// so `for p in ptrs do return p` is rejected like `return ptrs[0]`
// (escape/return_indexed_stack_ptr_err). Regression: the element variable
// used to get unknown provenance, letting a stack pointer escape the frame
// (ASan: stack-use-after-return).
let bad = () ->
    let mut a = 41
    a = a + 1
    let ptrs = i32*[1] { &a }
    for p in ptrs do
        return p
    default(i32*)

let clobber = (n: i32) ->
    let mut q = n * 3
    q + 1

let main = (args: str[]) ->
    let r = bad()
    let _c = clobber(9)
    assert(*r == 42)
    0
