// Loop-carried taint through a let inside the assigned block.
let bad = () ->
    let mut p = default(i32*)
    let mut saved = default(i32*)
    for i in 0..2 do
        saved = p
        let mut x = 5
        p = (let q = &x in q)
    return saved

let main = (args: str[]) ->
    let r = bad()
    0
