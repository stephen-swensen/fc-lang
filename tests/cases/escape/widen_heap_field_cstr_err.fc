// Storing a stack c"%.Ns{s}" copy into a heap struct's `const cstr` field widens
// cstr -> const cstr; the widen must not strip PROV_STACK at the heap sink.
struct holder =
    name: const cstr

let leak = (p: const str) ->
    let h = alloc(holder)!
    h.name = c"%.7s{p}"
    free(h)

let main = (args: str[]) ->
    leak("hi")
    0
