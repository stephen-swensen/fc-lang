// A condition means the same whether it is branched on (if, a match guard,
// assert, a loop exit) or computed as a bool. The native backend branches on
// comparisons directly and splits &&, || and ! into jumps, so every shape is
// checked against the computed value: signed and unsigned comparisons at each
// width, constants on either side and beyond 32 bits, and floats with NaN,
// where every comparison is false except !=.

let branch = (c: bool) -> if c then 1 else 0

let ints = (x: i64, y: i64) ->
    let a = if x < y && !(y == 3) || x >= 7 then 1 else 0
    assert(a == branch(x < y && !(y == 3) || x >= 7))
    let b = if !(x < y || y <= 0) && x != 2 then 1 else 0
    assert(b == branch(!(x < y || y <= 0) && x != 2))
    let c = if x > 4294967296i64 || y < -2147483649i64 || x == -1 then 1 else 0
    assert(c == branch(x > 4294967296i64 || y < -2147483649i64 || x == -1))
    let d = if 0 < x && 10 > y then 1 else 0
    assert(d == branch(0 < x && 10 > y))
    let e = if !(!(x <= y)) then 1 else 0
    assert(e == branch(x <= y))
    0

let unsigned = (x: u64, y: u32, z: u8) ->
    let a = if x > 9223372036854775807u64 && y >= 4294967295u32 then 1 else 0
    assert(a == branch(x > 9223372036854775807u64 && y >= 4294967295u32))
    let b = if z < 128u8 || y == 0u32 then 1 else 0
    assert(b == branch(z < 128u8 || y == 0u32))
    let c = if x != 0u64 && (u64) y < x then 1 else 0
    assert(c == branch(x != 0u64 && (u64) y < x))
    0

let floats = (x: f64, y: f32) ->
    assert((if x == x then 1 else 0) == branch(x == x))
    assert((if x != x then 1 else 0) == branch(x != x))
    assert((if x < 1.5 then 1 else 0) == branch(x < 1.5))
    assert((if x <= 1.5 then 1 else 0) == branch(x <= 1.5))
    assert((if x > 1.5 then 1 else 0) == branch(x > 1.5))
    assert((if x >= 1.5 then 1 else 0) == branch(x >= 1.5))
    assert((if !(x < 1.5) then 1 else 0) == branch(!(x < 1.5)))
    assert((if !(x == 1.5) then 1 else 0) == branch(!(x == 1.5)))
    assert((if y == 2.5f32 || x == 1.5 then 1 else 0) == branch(y == 2.5f32 || x == 1.5))
    assert((if y != 2.5f32 && x != 1.5 then 1 else 0) == branch(y != 2.5f32 && x != 1.5))
    0

enum color =
    | red
    | green
    | blue

let guard = (c: color, n: i32) ->
    match c with
    | red when n > 0 && n < 10 -> 1
    | red when !(n > 0) -> 2
    | green when n == 0 || n == 5 -> 3
    | _ -> 4

let mut defers_run = 0

// `if c then break` and `if c then continue`, with and without a defer to
// run on the way out.
let loops = () ->
    let mut i = 0
    let mut sum = 0
    loop
        if i == 10 then break
        i = i + 1
        if i % 2 == 0 then continue
        sum = sum + i
    assert(i == 10 && sum == 25)
    let mut j = 0
    loop
        defer defers_run = defers_run + 1
        if j >= 3 then break
        j = j + 1
        if j == 2 then continue
    assert(j == 3 && defers_run == 4)
    let mut k = 0
    for n in 0..100 do
        if n > 4 && k > 0 then break
        if !(n % 2 == 0) then continue
        k = k + n
    assert(k == 6)
    0

let main = (args: str[]) ->
    for x in i64[7] { i64.min, -2147483649i64, -1, 0, 3, 7, 4294967297i64 } do
        for y in i64[5] { -2147483650i64, -1, 0, 3, 11 } do
            ints(x, y)
    for x in u64[3] { 0u64, 9223372036854775807u64, u64.max } do
        for y in u32[3] { 0u32, 7u32, u32.max } do
            for z in u8[3] { 0u8, 127u8, 255u8 } do
                unsigned(x, y, z)
    for x in f64[5] { f64.nan, 1.5, 1.0, 2.0, -f64.inf } do
        for y in f32[3] { f32.nan, 2.5f32, 0.0f32 } do
            floats(x, y)
    assert(guard(color.red, 5) == 1 && guard(color.red, -1) == 2 && guard(color.red, 10) == 4)
    assert(guard(color.green, 5) == 3 && guard(color.green, 1) == 4 && guard(color.blue, 0) == 4)
    loops()
    if true then assert(true) else assert(false)
    if false then assert(false)
    0
