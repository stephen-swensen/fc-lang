// BUG (bugsearch 2026-07-18): a value loop mixing a bare `break` with
// `break <value>` is accepted; the bare-break path leaves the loop result
// uninitialized in the emitted C (clang -Werror rejects it; gcc binaries
// read garbage). Should be a break type mismatch error (void vs i32).
let main = (args: str[]) ->
    let mut i = 10
    let v = loop
        if i > 3 then break
        break 5
    assert(v == 5)
    0
