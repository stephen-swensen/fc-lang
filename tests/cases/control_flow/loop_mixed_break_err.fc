// A valueless `break` makes the loop void, so mixing it with `break <value>`
// is a break type mismatch. Left unjudged, the emitted `_loop_result` was
// never assigned on the bare-break path (clang rejects the C, gcc reads
// garbage).
let main = (args: str[]) ->
    let mut i = 10
    let v = loop
        if i > 3 then break
        break 5
    assert(v == 5)
    0
