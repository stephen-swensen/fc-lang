// Iterating a read-only slice reads its elements: values as themselves, and
// references as read-only views that can still be read and passed on.
let total = (s: const str) ->
    let mut n = 0
    for c in s do
        n = n + (i32) c
    n

let main = (args: str[]) ->
    let nums = (const i32[]) i32[3] { 1, 2, 3 }
    let mut sum = 0
    for x in nums do
        sum = sum + x
    assert(sum == 6)
    let words = (const str[]) const str[2] { "ab", "c" }
    let mut chars = 0
    for i, w in words do
        chars = chars + total(w) + (i32) i
    assert(chars == 97 + 98 + 99 + 1)
    0
