// An enum-variant pattern nested inside a union payload (`| chosen(red)`)
// matches on the enum's value. Regression: this path used to emit
// tagged-union code for the enum (`.tag == fc__color_tag_red` on an integer
// typedef), which is invalid C; enum patterns under an option or result were
// unaffected.
enum color =
    | red
    | green

union pick =
    | chosen(color)
    | nothing

let main = (args: str[]) ->
    let p = pick.chosen(color.green)
    let r = match p with
            | chosen(red) -> 1
            | chosen(green) -> 2
            | nothing -> 3
    r - 2
