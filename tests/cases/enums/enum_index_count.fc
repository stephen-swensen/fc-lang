// Enum rides the slice-index rule; count sizes tables
enum dir =
    | east
    | north
    | west
    | south

let main = (args: str[]) ->
    let dx = i32[dir.count]{ 1, 0, -1, 0 }
    let dy = i32[dir.count]{ 0, -1, 0, 1 }
    assert(dx[dir.east] == 1)
    assert(dx[dir.west] == -1)
    assert(dy[dir.south] == 1)
    let mut sum = 0
    for i in 0..dx.len do
        sum = sum + dx[i]
    assert(sum == 0)
    0
