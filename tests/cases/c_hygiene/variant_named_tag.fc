// A union variant may be named `tag` and carry a payload; it does not collide
// with the discriminant member the compiler adds. Regression: the emitted
// struct used to be `{ fc__thing_tag tag; union { int32_t tag; }; }`, and C
// rejected the duplicate member 'tag' (anonymous-union members share the
// enclosing namespace).
union thing =
    | tag(i32)
    | other

let main = (args: str[]) ->
    let t = thing.tag(5)
    let v = match t with
            | tag(n) -> n
            | other -> 0
    assert(v == 5)
    0
