// A parameter, for-loop variable or match binding named like a codegen
// temporary (`_sg0_0`, `_fe0`, `_subj0`) does not collide with it.
// Regression: these binding forms used to be emitted with their source
// spelling, so the parameter _sg0_0 used in interpolation emitted the
// self-initializing `int32_t _sg0_0 = _sg0_0;` (clean under -Werror, formats
// garbage), and the other two produced invalid C.
let f = (_sg0_0: i32) ->
    let s = "v=%d{_sg0_0}"
    if s == "v=42" then 1 else 0

let count = (n: i32) ->
    let mut c = 0
    for _fe0 in 0..n do
        c = c + 1
    c

union sh =
    | circle(i32)
    | square(i32)

let pick = (s: sh) ->
    match s with
    | circle(_subj0) -> _subj0
    | square(v) -> v

let main = (args: str[]) ->
    assert(f(42) == 1)
    assert(count(3) == 3)
    assert(pick(sh.circle(9)) == 9)
    0
