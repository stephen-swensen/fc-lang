// An extern C name is emitted verbatim, so before the reserved-root ban this
// extern and module member `m.counter` silently referred to one C object (the
// original §5 silent-merge, through the extern door). Now the parser rejects
// any extern C name under `fc__` outright — nothing a header can legitimately
// export lives there.
module libc from "stdlib.h" =
    extern fc__m__counter as ext_counter: i32

module m =
    let counter = 5

let main = (args: str[]) ->
    assert(m.counter == 5)
    0
