// `extern` is the one FC construct that may spell a C name containing `__`
// (that is where the implementation-reserved namespace lives, so the name is
// emitted verbatim with a mandatory `as` alias). It can therefore land inside
// the reserved fc__ space that every declaration is rooted at — here it names
// the same C object as module member `m.counter`, and the two silently
// referred to one global.
module libc from "stdlib.h" =
    extern fc__m__counter as ext_counter: i32

module m =
    let counter = 5

let main = (args: str[]) ->
    assert(m.counter == 5)
    0
