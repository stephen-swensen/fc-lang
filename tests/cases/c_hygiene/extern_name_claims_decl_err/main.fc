// An extern C name is emitted verbatim, so without the reserved-root ban this
// extern and module member `m.counter` would silently name one C object. The
// parser rejects any extern C name starting with `fc__`; nothing a header can
// legitimately export lives there.
module libc from "stdlib.h" =
    extern fc__m__counter as ext_counter: i32

module m =
    let counter = 5

let main = (args: str[]) ->
    assert(m.counter == 5)
    0
