// A match-pattern binding may be spelled like a C keyword (`int`), as every
// other binding form may (see the rest of c_hygiene/). Regression: pattern
// bindings used to be emitted with their source spelling, so this emitted
// `int32_t int = _subj0.circle;`.
union u =
    | circle(i32)
    | blank

let main = (args: str[]) ->
    let s = u.circle(21)
    let v = match s with
            | circle(int) -> int * 2
            | blank -> 0
    assert(v == 42)
    0
