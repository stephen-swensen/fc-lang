// A module member spelled `main` is an ordinary function — only a file-scope
// `let main` is the entry point. Keying the entry-point emission on the source
// name alone emitted two `fc_main` definitions and two `int main` wrappers for
// this program, and crashed the compiler on the zero-parameter form below
// (the entry-point path reads params[0] unconditionally).
module m =
    let main = (args: str[]) -> 7
    let bare_main = () -> 9

module deeper =
    module inner =
        let main = () -> 11

let main = (args: str[]) ->
    assert(m.main(args) == 7)
    assert(m.bare_main() == 9)
    assert(deeper.inner.main() == 11)
    0
