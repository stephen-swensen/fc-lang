// A module named `fc` keeps its members distinct from top-level declarations
// of the same name: `fc.counter` and the top-level `counter` are two globals.
// Regression: members of module fc used to be emitted as fc__<name>, the same
// spelling as top-level declarations, so the two counters silently merged
// into one C global (and struct twins produced a C redefinition).
module fc =
    let counter = 111

let counter = 222

let main = (args: str[]) ->
    assert(fc.counter == 111)
    assert(counter == 222)
    0
