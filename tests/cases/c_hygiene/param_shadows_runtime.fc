// A parameter may be named after a libc or FC runtime symbol (`abort`,
// `fc_str`, `snprintf`) without breaking the code generated around it.
// Regression: parameters used to be emitted with their source spelling and
// shadowed the file-scope name, breaking the assert expansion ("called
// object 'abort' is not a function"), later str declarations, and
// interpolation respectively.
let f = (abort: i32) ->
    assert(abort == 1)
    abort + 1

let g = (fc_str: i32) ->
    let s = "abc"
    fc_str + (i32) s.len

let h = (snprintf: i32) ->
    let t = "n=%d{snprintf}"
    (i32) t.len

let main = (args: str[]) ->
    assert(f(1) == 2)
    assert(g(4) == 7)
    assert(h(12) == 4)
    0
