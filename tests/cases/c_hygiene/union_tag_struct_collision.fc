// A user struct named `<union>_tag` (here shape_tag) does not collide with the
// tag enum the compiler derives for union `shape`. Regression: the tag enum
// used to be named fc__<union>_tag, inside the user declaration namespace, so
// C reported "conflicting types for 'fc__shape_tag'".
union shape =
    | circle(i32)
    | square

struct shape_tag =
    kind: i32

let main = (args: str[]) ->
    let s = shape.circle(3)
    let t = shape_tag { kind = 1 }
    let v = match s with
            | circle(r) -> r
            | square -> 0
    assert(v + t.kind == 4)
    0
