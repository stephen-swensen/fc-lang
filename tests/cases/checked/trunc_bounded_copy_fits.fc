// A c"%.Ns{s}" copy whose source fits (len <= N) is unchanged under checked:
// no abort, same copy + NUL as the default form.
module c from "string.h" =
    extern strlen: (const cstr) -> usize

let main = (args: str[]) ->
    let s = "hello"

    // exact fit: len == N (the largest source that does not truncate)
    let c1 = checked c"%.5s{s}"
    assert(c.strlen(c1) == 5usize)
    assert(((str) c1) == "hello")

    // roomy fit
    let c2 = checked c"%.15s{s}"
    assert(((str) c2) == "hello")

    // empty source always fits
    let e = ""
    let c3 = checked c"%.3s{e}"
    assert(c.strlen(c3) == 0usize)
    0
