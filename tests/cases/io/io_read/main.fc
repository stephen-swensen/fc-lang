import io from std::
import sys from std::

let main = (args: str[]) ->
    let tmp = sys.temp_dir()!
    let path = alloca("%s{tmp}/fc_test_io_read.txt")
    let _result =
        let f = io.open(path, "w")
        match f with
        | ok(wf) ->
            io.write("abcde", wf)
            io.close(wf)!
            let f2 = io.open(path, "r")
            match f2 with
            | ok(rf) ->
                let mut buf = u8[16] {}
                let n = io.read(buf, 16, rf)
                io.close(rf)!
                if n == 5i64 then 42
                else (i32) n
            | err(_) -> 2
        | err(_) -> 1
    assert(_result == 42)
    io.remove(path)!
    0
