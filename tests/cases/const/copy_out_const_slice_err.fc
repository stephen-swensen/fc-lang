// A struct holding a writable reference cannot be copied out of a read-only
// slice: the copy would let the program write through a view it may only
// read. Regression: `let q = ro[0]` was accepted.
struct holder =
    s: str

let main = (args: str[]) ->
    let mut buf = alloc(u8[2] { })!
    let ro = (const holder[]) holder[1] { holder { s = buf } }
    let q = ro[0]
    q.s[0] = 5u8
    (i32) buf[0]
