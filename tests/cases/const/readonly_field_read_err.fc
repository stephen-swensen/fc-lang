// A reference read out of read-only storage is read-only whichever way it is
// read: a field of an element of a const slice, a field through a dereferenced
// const pointer, a tuple element, or an unwrapped option. Regression:
// `let t = ro[0].s` gave a writable str.
struct holder =
    s: str
    maybe: str?

let main = (args: str[]) ->
    let mut buf = alloc(u8[2] { })!
    let ro = (const holder[]) holder[1] { holder { s = buf, maybe = some(buf) } }
    let t = ro[0].s
    t[0] = 5u8
    (i32) buf[0]
