struct cell =
    vals: const i32[]

struct row =
    name: const str
    lo: cell
    hi: cell

union holder =
    | one(row)
    | none_of_it

// A module constant's slice literal is lifted to a `static` backing array at
// C file scope, and a slice literal *inside* one needs a backing array of its
// own. The inner array's name appears in the outer array's initializer, so it
// has to be emitted first — C file scope has no forward references.
module k =
    let plain = i32[3] { 1, 2, 3 }

    // One level down: a slice of structs, each carrying slices.
    let rows = row[2] {
        row { name = "a", lo = cell { vals = i32[2] { 10, 11 } },
                          hi = cell { vals = i32[1] { 12 } } },
        row { name = "b", lo = cell { vals = i32[3] { 20, 21, 22 } },
                          hi = cell { vals = i32[1] { 23 } } } }

    // The same nesting reached through an option and a union payload.
    let maybe = some(cell { vals = i32[2] { 60, 61 } })
    let held = holder.one(row { name = "g", lo = cell { vals = i32[1] { 70 } },
                                            hi = cell { vals = i32[1] { 71 } } })

    // A struct constant that borrows another constant's table rather than
    // spelling one of its own.
    let shared = cell { vals = plain }

// The same shapes at file level, where a constant is not frozen and its
// backing array is emitted writable rather than into .rodata. Same lift, same
// ordering problem, different storage class.
let loose = cell { vals = i32[2] { 100, 101 } }
let loose_rows = row[1] {
    row { name = "z", lo = cell { vals = i32[2] { 110, 111 } },
                      hi = cell { vals = i32[1] { 112 } } } }

let main = (args: str[]) ->
    assert(k.plain[1] == 2)

    assert(k.rows.len == 2i64)
    assert(k.rows[0].name == "a")
    assert(k.rows[0].lo.vals[1] == 11)
    assert(k.rows[0].hi.vals[0] == 12)
    assert(k.rows[1].lo.vals.len == 3i64)
    assert(k.rows[1].lo.vals[2] == 22)
    assert(k.rows[1].hi.vals[0] == 23)

    match k.maybe with
    | some(c) -> assert(c.vals[0] == 60 && c.vals[1] == 61)
    | none -> assert(false)

    match k.held with
    | one(r) -> assert(r.name == "g" && r.lo.vals[0] == 70 && r.hi.vals[0] == 71)
    | none_of_it -> assert(false)

    assert(k.shared.vals[2] == 3)

    assert(loose.vals[1] == 101)
    assert(loose_rows[0].lo.vals[0] == 110)
    assert(loose_rows[0].hi.vals[0] == 112)

    // Everything above is still read-only through the freeze, and still
    // reachable by iteration rather than only by constant index.
    let mut sum = 0
    for r in k.rows do
        for v in r.lo.vals do
            sum = sum + v
    assert(sum == 10 + 11 + 20 + 21 + 22)
    0
