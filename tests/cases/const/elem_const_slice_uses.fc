// The element-const slice behaves like any other slice: iteration, subslicing,
// indexing, and .len all work, and each of them hands the element back const.
let taken = (s: const str) ->
    (i32) s.len

let main = (args: str[]) ->
    let words = const str[3] { "a", "bc", "def" }

    let mut n = 0
    for w in words do
        n = n + taken(w)
    assert(n == 6)

    let tail = words[1..3]
    assert(tail.len == 2)
    assert(taken(tail[1]) == 3)

    for i, w in words do
        assert(taken(w) == i + 1)
    0
