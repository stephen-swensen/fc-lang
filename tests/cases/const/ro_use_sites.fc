struct point =
    x: i32
    y: i32

union shape =
    | circle(i32)
    | empty

module k =
    let p = point { x = 3, y = 4 }
    let tbl = i32[4] { 1, 2, 4, 8 }
    let sh = shape.circle(5)
    let opt = some(7)
    let s = "hello"
    let cs = c"world"

let by_value = (p: point) ->
    p.x + p.y

// Every use site a module constant flows through, now that it carries C's
// `const`: the emitted C must stay warning-clean under -Wall -Werror.
let main = (args: str[]) ->
    // by-value pass of a const global struct
    assert(by_value(k.p) == 7)
    // heap copy built from a struct literal reading const globals
    let hp = alloc(point { x = k.p.x, y = k.p.y })!
    assert(hp.x == 3)
    free(hp)
    // interpolation reading const globals
    let msg = "p=%d{k.p.x} n=%d{k.tbl[1]} s=%.16s{k.s}"
    assert(msg.len > 0)
    // match on a const global union
    match k.sh with
    | circle(r) -> assert(r == 5)
    | empty -> assert(false)
    // equality on const global aggregates
    assert(k.p == point { x = 3, y = 4 })
    assert(k.sh == shape.circle(5))
    // option
    match k.opt with
    | some(v) -> assert(v == 7)
    | none -> assert(false)
    // subslice + for
    let mut acc = 0
    for v in k.tbl[1..3] do
        acc = acc + v
    assert(acc == 6)
    0
