// Not str-specific: the same two types, and the same widen, over a pointer
// element. `const i32*[N] { ... }` fills slots with read-only views.
let read_only = (s: const i32*[]) ->
    (i32) s.len

let elem_const = (s: (const i32*)[]) ->
    *s[0]

let main = (args: str[]) ->
    let mut x = 4
    let mut y = 9
    let cx = (const i32*) &x
    let mut ps = const i32*[2] { cx, cx }

    assert(elem_const(ps) == 4)

    ps[1] = (const i32*) &y
    assert(*ps[1] == 9)

    assert(read_only(ps) == 2)
    0
