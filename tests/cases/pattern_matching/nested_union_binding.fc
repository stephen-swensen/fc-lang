// A binding at depth 2 of a nested union pattern (`wrap(chosen(c))`) binds
// the inner payload. Regression: codegen only declared bindings at payload
// depth 1, so the arm body's use of `c` failed in C with "'c' undeclared".
enum color =
    | red
    | green

union pick =
    | chosen(color)
    | nothing

union outer =
    | wrap(pick)
    | empty

let main = (args: str[]) ->
    let o = outer.wrap(pick.chosen(color.red))
    let r = match o with
            | wrap(chosen(c)) -> if c == color.red then 1 else 2
            | wrap(nothing) -> 3
            | empty -> 4
    r - 1
