// An unguarded catch-all arm (`_` or a binding) may come before other arms;
// arms are first-match-wins (see exhaustiveness/exhaust_union_dup_variant), so
// the catch-all wins. Regression: codegen emitted a bare block for the
// catch-all, leaving the next arm's `else` without an `if` (gcc/clang:
// "'else' without a previous 'if'").
let main = (args: str[]) ->
    let v = match 5 with
        | _ -> 1
        | 5 -> 2
    assert(v == 1)
    0
