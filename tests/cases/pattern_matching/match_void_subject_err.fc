// BUG (bugsearch 2026-07-18): a void-typed match subject is accepted and
// codegen emits `void _subj0 = f(...);` — invalid C. The subject of a match
// is a value position; pass2 should reject void there (it already rejects
// void in let bindings and call args).
let f = () -> void()

let main = (args: str[]) ->
    match f() with
    | _ -> void()
    0
