// A name bound twice in one pattern emitted two `int32_t a = ...;`
// declarations in one C scope. Rejected, as in the ML family and Rust — the
// alternative (last wins) silently picks a winner.
let main = (args: str[]) ->
    let t = { 1, 2 }
    let v = match t with
            | { a, a } -> a
    assert(v == 2)
    0
