// Two statements juxtaposed in an inline arm body give the same single
// separator error a block reports, not an "expected '|'" cascade. (`| 3 -> n = 1; n = 2` with a `;` is the legal spelling.)
let main = (args: str[]) ->
    let mut n = 0
    match 3 with
    | 3 -> n = 1 n = 2
    | _ -> n = 3
    n
