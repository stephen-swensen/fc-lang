// `discard expr` evaluates its operand for side effects and yields void. It is
// the blessed explicit discard for a result (like `let _ =`) and, being void-
// typed, also voids a value-returning tail so a block needs no trailing
// `void()`. Covers: value operand, void! and T! results, T? option, and the
// statement / match-arm-tail / if-branch-tail / block-tail positions.
let fallible = () -> if true then ok(1) else err(i32, 3)
let fallible_void = () -> if true then ok else err(void, 3)
let maybe = (x: i32) -> if x > 0 then some(x) else none(i32)
let ival = (x: i32, sink: i32*) ->
    *sink = *sink + x
    (i64) x

// void-returning helper whose last statements are discards (no trailing void()).
let dump = (sink: i32*) ->
    discard ival(1, sink)          // discard a plain value in statement position
    discard fallible_void()        // discard a void! result (the acknowledgment)
    discard fallible()             // discard a T! result
    discard maybe(9)               // discard a T? option
    if *sink > 100 then
        discard ival(2, sink)      // then-branch tail voided
    else
        discard ival(4, sink)      // else-branch tail voided

let main = (args: str[]) ->
    let mut acc = 0
    dump(&acc)
    assert(acc == 1 + 4)

    // discard as a match-arm tail: both arms are void, so the match is void.
    match fallible_void() with
    | ok -> discard ival(8, &acc)
    | err(_) -> discard ival(16, &acc)
    assert(acc == 5 + 8)

    // discard as the void tail of a nested block.
    let r = match fallible() with
            | ok(x) ->
                discard ival(32, &acc)
                x + 1
            | err(_) -> 0
    assert(r == 2)
    assert(acc == 13 + 32)
    0
