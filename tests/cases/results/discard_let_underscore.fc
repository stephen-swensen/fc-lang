// `let _ = expr` is the explicit discard for a result whose failure is
// deliberately ignored (best-effort calls); defer discards by contract.
// The valued-match arm exercises the unused-let silencer in the emitted C
// (the arm-statement emission path, distinct from plain block statements).
let fallible = () -> if true then ok(1) else err(i32, 3)
let fallible_void = () -> if true then ok else err(void, 3)
let helper = () ->
    defer fallible_void()
    let _ = fallible()
    7
let main = (args: str[]) ->
    let _ = fallible()
    let _ = fallible_void()
    defer fallible_void()
    let v = match fallible() with
            | ok(x) ->
                let _ = fallible_void()
                x + 1
            | err(_) -> 0
    assert(v == 2)
    assert(helper() == 7)
    0
