// Propagation on composed carriers acts on the TOP layer only:
// ? on T?! (result of option) propagates err and yields the T? payload.
error cp_err =
    | io_broke

// u8?!: ok(some(b)) = byte, ok(none) = end of input, err = failure
let read_at = (data: u8[], i: i32) ->
    if i < 0 then return err(u8?, cp_err.io_broke)
    if i >= (i32) data.len then return ok(none(u8))
    ok(some(data[i]))

// propagate the result layer, then match the option layer
let read_or_zero = (data: u8[], i: i32) ->
    let o = read_at(data, i)?     // o: u8?
    match o with
    | some(b) -> ok((i32) b)
    | none -> ok(-1)

let main = (args: str[]) ->
    let data = u8[3] { 10u8, 20u8, 30u8 }

    match read_or_zero(data, 1) with
    | ok(v) -> assert(v == 20)
    | err(e) -> assert(false, "expected ok")

    match read_or_zero(data, 5) with
    | ok(v) -> assert(v == -1, "none payload survives the result unwrap")
    | err(e) -> assert(false, "expected ok(none) path")

    match read_or_zero(data, -1) with
    | ok(v) -> assert(false, "expected err")
    | err(e) -> assert(e == cp_err.io_broke)

    0
