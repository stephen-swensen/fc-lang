// §7.8 negative space: aliasing a *value* onto a built-in type name is legal,
// mirroring the exemption for value bindings — the alias enters the value
// namespace, never the type namespace, so it cannot shadow the primitive.
import compute as any from mylib::helpers

let main = (args: str[]) ->
    assert(any(21) == 42, "value import alias resolves")
    0
