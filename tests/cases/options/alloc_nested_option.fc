// A nested option type whose only occurrence is alloc's type operand
// (`alloc(i32??)`) still gets its C typedef. Regression: the option-typedef
// discovery walk skipped alloc's operand, so the C referenced the undeclared
// fc_option_fc_option_int32_t.
let main = (args: str[]) ->
    let ho = alloc(i32??)
    match ho with
    | some(p) -> free(p)
    | none -> void()
    0
