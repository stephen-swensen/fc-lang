// FC Language — Quick Reference by Example
// This file compiles and runs: ./run.sh spec/examples.fc
// Every section exercises a language feature and asserts correctness.

/* Comments come in two forms: `//` line comments (used throughout this
   file) and `/* ... */` block comments — like this one — which span
   multiple lines and /* may be nested */ to any depth. */

// ============================================================
// Structs — named product types with ordered fields
// ============================================================

struct point =
    x: i32
    y: i32

struct color =
    r: u8
    g: u8
    b: u8

// ============================================================
// Unions — tagged sum types with exhaustive matching
// ============================================================

union shape =
    | circle(i32)
    | rect(point)
    | empty

// ============================================================
// Generics — monomorphized at compile time, zero runtime cost
// Type variables ('a, 'b, ...) are implicit — any 'name in a
// signature makes that function/struct/union generic.
// ============================================================

struct pair =
    first: 'a
    second: 'b

union result =
    | good('a)
    | bad('b)

// Const generics — a generic parameter can be a compile-time integer.
// Same 'x sigil; the position decides the kind ('n in a size slot = const
// param). static_assert states what widths are admitted: checked once per
// instantiation, emits no code.
struct nbits =
    static_assert('n % 8 == 0, "nbits width must be a multiple of 8")
    bytes: u8['n / 8]

// Error groups — named i32 error codes for the result type T!. A group is a
// pseudo-module of constants (not a type): the compiler assigns each declared
// error a unique code (sorted fully-qualified names, numbered from 65536;
// 1–65535 is reserved for platform passthrough like errno).
error file_io =
    | not_found
    | invalid_path

// Enums — a closed set of named integer constants over a fixed-width repr
// (default i32; values auto-number from 0). Exhaustive matching like a
// payload-free union, plus a public numeric value: table indexing, ordering,
// total cast out. Some variant must have value 0 (default(E) is that variant).
enum difficulty =
    | baby
    | easy
    | medium
    | hard

enum door_lock of u8 =       // declared repr; explicit values, C-style continuation
    | normal_a               // 0 (auto)
    | gold_key = 1
    | silver_key             // 2 (continues)
    | elevator_b = 5         // values may be sparse

let identity = (x: 'a) -> x

let swap = (p: pair<'a, 'b>) ->
    pair { first = p.second, second = p.first }

// A tuple type may contain type variables — monomorphized per instantiation,
// exactly like a generic struct. (Generics apply to top-level functions.)
let tuple_flip = (p: {'a, 'b}) -> { p[1], p[0] }

// Explicit type args — <'a> declares type vars not inferrable from params
let make_pair = <'a, 'b>() ->
    pair { first = default('a), second = default('b) }

// ============================================================
// Modules — group related functions and types
// ============================================================

module point =
    let origin = () ->
        point { x = 0, y = 0 }

    let manhattan = (p: point) ->
        let abs_x = if p.x < 0 then -p.x else p.x
        let abs_y = if p.y < 0 then -p.y else p.y
        abs_x + abs_y

    // Module-level constant-expression lets: struct literals, slice literals,
    // some(...), and union variant constructors are all allowed as long as
    // their contents are recursively constant.  Slice literals are lifted to
    // a static backing array at C file scope.  Const-expr lets may reference
    // other const-expr lets by name (order-independent, including imports).
    let zero = point { x = 0, y = 0 }
    let steps = i32[4] { 1, 2, 4, 8 }
    let first = some(0)
    let base = 10
    let offsets = i32[3] { base, base + 1, base + 2 }     // refs `base`
    // Fixed-width integer arithmetic is evaluated at compile time, so integer
    // division/modulo/shift fold to literals (div-by-zero is a compile error).
    let half = base / 2                                     // folds to 5
    let rem = base % 3                                      // folds to 1
    let shifted = base << 2                                 // folds to 40
    // Static type properties are constant expressions too; fixed-width integer
    // .min/.max/.bits fold to literals (float and isize/usize emit their macro).
    let lo = i32.min                                      // folds to -2147483648
    let mid = i32.max / 2 + 1                             // type prop in const div
    let nbits = i64.bits                                  // folds to 64

    // A module-level `let` is a module *constant*: frozen contents, everywhere,
    // and placed in read-only memory.  `zero.x = 3` and `steps[0] = 9` are
    // compile errors from any module, as is `geom.zero = other`.  Reads that
    // yield a reference carry the freeze — `steps` has type `const i32[]` — so
    // it only passes to a `const i32[]` parameter.  A writable global says
    // `let mut`; the freeze stops at an address the constant merely holds, so
    // a `(u8*) 0xA0000usize` constant stays writable *through*.
    let mut hits = 0                                      // the writable global

// ============================================================
// Higher-order functions
// ============================================================

let apply = (x: 'a, f: ('a) -> 'b) -> f(x)

// Note: a capturing closure's context lives on its creator's stack frame, so
// it cannot be returned or stored beyond that frame — unless promoted with
// alloc(lambda), which copies the context to the heap (caller frees it).
let make_adder = (n: i32) ->
    alloc((x: i32) -> x + n)!    // heap closure: returnable, caller frees

// ============================================================
// C Interop — extern declarations bind to C headers
// Extern items live in modules with a from "header" clause.
// ============================================================

module c_stdlib from "stdlib.h" =
    extern abs: (i32) -> i32       // extern function
    extern EXIT_SUCCESS: i32         // extern constant
    extern EXIT_FAILURE: i32

// Feature-test macros — define is emitted before the #include
module c_time from "time.h" define "_POSIX_C_SOURCE" "200809L" =
    extern struct timespec =           // extern struct
        tv_sec: i64
        tv_nsec: i64

// Extern unions — C's untagged unions (fields overlap, no tag)
module c_signal from "signal.h" define "_POSIX_C_SOURCE" "200809L" =
    extern union sigval =              // extern union
        sival_int: i32
        sival_ptr: any*

// Variadic functions — ... for untyped trailing args
module c_stdio from "stdio.h" =
    extern snprintf: (cstr, usize, const cstr, ...) -> i32

// Error protocols — an extern returning T! names how the C function signals
// failure (from <protocol>); the compiler wraps the raw return into the
// result at each call site, capturing the platform code (errno here) raw.
// void! is the payload-less result for "can fail, returns nothing" calls.
module c_files from "stdio.h" =
    extern fopen: (const cstr, const cstr) -> any*! from errno(null)
    extern remove: (const cstr) -> void! from errno(-1)

// ============================================================
// Entry point — main receives command-line args as str[]
// Return value becomes the process exit code.
// ============================================================

let main = (args: str[]) ->

    // --------------------------------------------------------
    // Primitive types and literals
    // --------------------------------------------------------

    let i = 42                  // i32 (default integer)
    let f = 3.14                // f64 (default float)
    let b = true                // bool
    let c = 'A'                 // char (alias for u8)
    let s = "hello"             // str (alias for u8[], a fat pointer)
    let cs = c"hello"           // cstr (alias for u8*, null-terminated)

    // Suffixed literals for explicit types
    let i8  = 127i8             // i8
    let u64 = 1000u64           // u64
    let f32 = 2.5f32            // f32
    let isz = 42isize               // isize (ptrdiff_t)
    let usz = 42usize               // usize (size_t)

    // Numeric bases and underscores
    let hex = 0xFF
    let bin = 0b1010_0101
    let oct = 0o77

    // Scientific notation for floats (mantissa may omit '.')
    let billion = 1e9                    // f64
    let micro = 1.5e-6                   // f64
    let avo = 6.022_140_76e23            // separators allowed everywhere
    let mass = 9.109e-31f32              // f32 with exponent

    // Hex float literals — hex mantissa * 2^exponent (binary exponent in decimal).
    // Because 'e' is a hex digit, the exponent uses 'p' and is mandatory.
    let half = 0x1.0p-1                  // exactly 0.5 (bit-exact)
    let three = 0x1.8p+1                 // 1.5 * 2 = 3.0
    let max_f32 = 0x1.fffffep+127f32     // largest finite f32
    assert(half == 0.5)
    assert(three == 3.0)

    // --------------------------------------------------------
    // Bindings: let (immutable) and let mut (mutable)
    // --------------------------------------------------------

    let x = 10                  // immutable — cannot reassign; &x gives const T*
    let mut y = 20              // mutable — can reassign; &y gives writable T*
    y = 30
    assert(y == 30)

    // let controls reassignment, not content mutation
    let p = point { x = 1, y = 2 }
    p.x = 10                   // field mutation on let binding is good
    assert(p.x == 10)

    // Shadowing — any combination of let/let mut
    let z = 1
    let z = z + 1              // shadows previous z
    assert(z == 2)

    // Self-assignment (x = x) is a compile error — it's always a no-op

    // --------------------------------------------------------
    // Operators
    // --------------------------------------------------------

    // Arithmetic (signed wraps via two's complement)
    assert(7 / 2 == 3)
    assert(7 % 2 == 1)

    // Bitwise — bind tighter than comparison (unlike C)
    assert(0xFF & 0x0F == 0x0F) // parses as (0xFF & 0x0F) == 0x0F
    assert(0xF0 | 0x0F == 0xFF)
    assert(0xFF ^ 0xFF == 0)
    assert(1 << 4 == 16)
    assert(~0u8 == 255u8)      // bitwise NOT

    // Comparison and logical
    assert(1 < 2 && 2 < 3)
    assert(!(1 > 2))

    // Implicit widening (lossless only, never int→float)
    let wide = 1i8 + 1000i32   // i8 widens to i32
    assert(wide == 1001)

    // Explicit casts
    let fi = (i32) 3.7       // float→int truncates: 3 (saturating, defined for all inputs)
    assert(fi == 3)

    // bitcast(T, x) reinterprets x's BITS as T (no conversion), unlike (T) x.
    // Both sides must be equal-size fixed-width scalars. Statically total — no
    // runtime failure, so no checked/unguarded variant.
    let raw = bitcast(u32, 1.0f32)   // 0x3f800000 (IEEE-754 bits), not 1
    assert(raw == 0x3f800000u32)
    assert(bitcast(f32, raw) == 1.0f32)   // round-trips exactly

    // Unguarded blocks opt out of FC's runtime guards (float→int saturation,
    // integer divide/modulo, slice bounds) on a hot path. Identical result for
    // in-range/non-zero operands; UB otherwise. `guarded` re-enables a check.
    let fu = unguarded (i32) 3.7   // bare truncation, no saturation: 3
    assert(fu == 3)
    let dq = unguarded 17 / 5        // bare divide, no zero/overflow guard: 3
    assert(dq == 3)
    let ns = i32[3]{4, 5, 6}
    let hot = unguarded
        let a = ns[0]                // unchecked index
        a + (guarded ns[2])          // re-checked index inside the unguarded region
    assert(hot == 10)

    // `checked` is the orthogonal overflow axis: integer +, -, *, signed / (at
    // INT_MIN/-1), signed negation, and lossy narrowing casts ABORT on overflow
    // instead of wrapping. `unchecked` is the default; use it to restore wrapping
    // inside a checked region. The two axes combine freely.
    let sum = checked 100i32 + 200i32        // in range: 300 (would abort on overflow)
    assert(sum == 300)
    let mixed = checked unguarded (ns[0] + ns[2])  // overflow-checked AND bounds-trusted
    assert(mixed == 10)
    let wrapped = checked
        let w = unchecked (127i8 + 1i8)      // intentional wrap to -128 inside a checked region
        w + 0i8                              // a checked op keeps `checked` non-redundant
    assert(wrapped == -128i8)
    // `checked` also governs the truncating string forms: (cstr[N]) and %.Ns
    // clip silently by default, and abort under checked when the source is longer.
    let word = "hello"
    let bounded = checked "%.5s{word}"       // fits (len == precision); would abort past 5
    assert(bounded == "hello")

    // --------------------------------------------------------
    // If expressions — branches produce values
    // --------------------------------------------------------

    let abs_val = if i < 0 then -i else i
    assert(abs_val == 42)

    // If without else is void (used for side effects)
    if true then assert(true)

    // --------------------------------------------------------
    // Match expressions — exhaustive pattern matching
    // --------------------------------------------------------

    let describe = (s: shape) ->
        match s with
        | circle(r) -> r * r
        | rect(p)   -> p.x * p.y
        | empty     -> 0

    assert(describe(shape.circle(5)) == 25)
    assert(describe(shape.rect(point { x = 3, y = 4 })) == 12)
    assert(describe(shape.empty) == 0)

    // Patterns: literals, wildcards, nested, struct destructuring
    let classify = (n: i32) ->
        match n with
        | 0     -> 0
        | 1     -> 1
        | _     -> 2           // wildcard — catches everything else

    assert(classify(0) == 0)
    assert(classify(999) == 2)

    // Struct destructuring in match
    let get_x = (p: point) ->
        match p with
        | { x = 0 }    -> 0        // match when x is 0
        | { x = v }    -> v        // bind x to v

    assert(get_x(point { x = 7, y = 0 }) == 7)

    // `when` guards — boolean predicate on an arm, evaluated after the
    // pattern matches. Pattern bindings are visible in the guard. Guarded
    // arms do NOT count toward exhaustiveness, so an unguarded catch-all
    // (or otherwise complete unguarded coverage) is still required.
    let sign = (n: i32) ->
        match n with
        | 0            -> 0i8
        | x when x < 0 -> -1i8
        | _            -> 1i8

    assert(sign(0) == 0i8)
    assert(sign(-3) == -1i8)
    assert(sign(7) == 1i8)

    // A guard trailing an or-pattern applies to the whole set of alternatives.
    // Pointer-field access `p.x` (`.` auto-derefs one level) needs NO parens in
    // a guard: `.` never collides with the match-arm `->`.
    let grade = (p: point*) ->
        match p.x with
        | 0                       -> 0    // zero
        | 1 | 2 | 3 when p.x > 0  -> 1    // small (or-pattern + guard)
        | _ when p.x < 0          -> -1   // negative
        | _                       -> 2    // other — unguarded catch-all
    let pp = alloc(point { x = 2, y = 0 })!
    defer free(pp)
    assert(grade(pp) == 1)
    pp.x = 50
    assert(grade(pp) == 2)
    pp.x = -1
    assert(grade(pp) == -1)

    // --------------------------------------------------------
    // Loops
    // --------------------------------------------------------

    // loop — infinite loop, optionally produces a value via break
    let mut sum = 0
    let mut idx = 0
    loop
        if idx >= 5 then break
        sum = sum + idx
        idx = idx + 1
    assert(sum == 10)

    // loop as expression — break with a value
    let found = loop
        if idx > 100 then break -1
        if idx == 5 then break idx
        idx = idx + 1
    assert(found == 5)

    // for — range iteration
    let mut total = 0
    for i in 0..5 do              // 0, 1, 2, 3, 4
        total = total + i
    assert(total == 10)

    // for — element iteration over a slice
    let nums = i32[3] { 10, 20, 30 }
    let mut elem_sum = 0
    for n in nums do
        elem_sum = elem_sum + n
    assert(elem_sum == 60)

    // for — index + element iteration
    let mut index_sum = 0
    for i, v in nums do
        index_sum = index_sum + (i32) i + v * 0
    assert(index_sum == 3)     // 0 + 1 + 2

    // for — destructuring the element (tuples or structs, same patterns as let)
    let coords = {i32, i32}[2] { { 1, 2 }, { 3, 4 } }
    let mut coord_sum = 0
    for { cx, cy } in coords do
        coord_sum = coord_sum + cx + cy
    assert(coord_sum == 10)

    // Inline forms — a one-line body. `do` introduces the for body (required
    // in both the block and inline forms, like `then`/`with`); `loop` has no
    // header, so its inline body needs no keyword; `;` sequences items on one
    // line (the explicit spelling of a same-level newline).
    let mut hsum = 0
    for i in 0..5 do hsum = hsum + i              // inline for body
    assert(hsum == 10)

    let mut acc = 0
    let mut cnt = 0
    for n in nums do acc = acc + n; cnt = cnt + 1  // `;` sequences the body
    assert(acc == 60 && cnt == 3)

    let mut k = 0
    loop if k >= 3 then break else k = k + 1       // inline loop — no `do`
    assert(k == 3)

    // (a; b) is a sequence expression — every item runs, the value is the last.
    let mut warmed = 0
    let cached = (warmed = 7; warmed + 1)
    assert(warmed == 7 && cached == 8)

    // let ... in — bind a name scoped to its body. The offside form (a let
    // followed by same-column statements) is the same thing with the `in`
    // implied by layout.
    let boxed = let w = 3 in let h = 4 in w * h
    assert(boxed == 12)

    // The `in` body is greedy (an inline `;`-sequence, as in ML/F#): the
    // binding scopes over every item, and the value is the last.
    let mut probe = 0
    let doubled = let v = 21 in probe = v; v * 2
    assert(probe == 21 && doubled == 42)

    // --------------------------------------------------------
    // Functions and closures
    // --------------------------------------------------------

    // Functions are values — defined with (params) -> body
    let double = (n: i32) -> n * 2
    assert(double(21) == 42)

    // A nested function is in scope within its own body, so it can be self-recursive
    // (mutual recursion of locals is not supported — only the function itself)
    let fac = (n: i32) ->
        if n <= 1 then 1
        else n * fac(n - 1)
    assert(fac(5) == 120)

    // Multi-line body — last expression is the return value
    let clamp = (val: i32, lo: i32, hi: i32) ->
        if val < lo then lo
        else if val > hi then hi
        else val
    assert(clamp(150, 0, 100) == 100)

    // Early return
    let first_positive = (a: i32, b: i32) ->
        if a > 0 then return a
        if b > 0 then return b
        0
    assert(first_positive(-1, 5) == 5)

    // return is a diverging expression — use it to bail out in an else branch
    let check_positive = (x: i32) ->
        if x > 0 then assert(true) else return
        assert(x == 5)  // only reached when x > 0
    check_positive(5)

    // A diverging branch (return/break/continue) carries no value, so it unifies
    // with a value-producing sibling — the binding takes that branch's type:
    let abs_or_bail = (x: i32) ->
        let y = if x >= 0 then x else return -1
        y + 1
    assert(abs_or_bail(9) == 10)
    assert(abs_or_bail(-3) == -1)

    // void() is the void-typed expression — use it as a fall-through arm in
    // statement-level matches so every arm has the same (void) type without
    // needing a `| _ -> return` that would exit the enclosing function.
    let log_phase = (p: shape, counter: i32*) ->
        match p with
        | circle(_) -> *counter = *counter + 1
        | _ -> void()
    let mut seen = 0
    log_phase(shape.circle(3), &seen)
    log_phase(shape.empty, &seen)
    log_phase(shape.circle(7), &seen)
    assert(seen == 2)

    // Evaluation order is left-to-right, each subexpression exactly once —
    // for operands, call arguments, assignment, and aggregate fields alike.
    let bump = (c: i32*) ->
        *c = *c + 1
        *c
    let pack = (a: i32, b: i32) -> a * 10 + b
    let mut tick = 0
    assert(pack(bump(&tick), bump(&tick)) == 12)  // args run 1 then 2, not 2 then 1
    assert(bump(&tick) - bump(&tick) == -1)       // lhs(3) before rhs(4)

    // Closures capture let bindings by copy (let mut cannot be captured)
    let threshold = 50
    let above = (n: i32) -> n > threshold
    assert(above(60))
    assert(!above(40))

    // Higher-order: passing functions as arguments
    assert(apply(21, double) == 42)

    // Closures can be passed as arguments; a stack closure cannot be returned
    let inc = (n: i32) -> n + 1
    assert(apply(41, inc) == 42)

    // Heap closures: alloc(lambda) copies the context to the heap so the
    // closure outlives its creator (see make_adder above). alloc(f) works
    // too when f is an immutable let bound directly to a capturing lambda.
    let add5 = make_adder(5)
    assert(add5(3) == 8)
    free(add5)                       // frees the context block

    // --------------------------------------------------------
    // Structs
    // --------------------------------------------------------

    // Construction — fields in any order, unspecified fields default to zero
    let origin = point { x = 0, y = 0 }
    let partial = point { y = 5 }      // x defaults to 0
    assert(partial.x == 0)
    assert(partial.y == 5)

    // Structural equality
    assert(origin == point { x = 0, y = 0 })
    assert(origin != partial)

    // Destructuring in let bindings
    let { x = px, y = py } = partial
    assert(px == 0)
    assert(py == 5)

    // Type-associated module — point.origin() uses the module
    assert(point.origin() == origin)
    assert(point.manhattan(point { x = -3, y = 4 }) == 7)

    // --------------------------------------------------------
    // Tuples — anonymous positional structs
    // --------------------------------------------------------

    // A tuple is a synthesized struct: bare braces, no type name, >= 2 elements.
    // Type and value share the same shape: value { 4, "hi" } has type {i32, str}.
    let t = { 4, "hello" }
    assert(t[0] == 4)              // 0-based; index is a literal — it selects a field, not an offset
    assert(t[1].len == 5i64)

    // Positional destructuring (binds by position, not by field name)
    let { n, s } = t
    assert(n == 4)
    assert(s.len == 5i64)

    // The headline use case: return several values without declaring a struct
    let divmod = (a: i32, b: i32) -> { a / b, a % b }
    let { q, r } = divmod(17, 5)
    assert(q == 3 && r == 2)

    // Tuples are values: structural equality, default, copy, and nesting all
    // fall out of the struct machinery.
    assert({ 1, 2 } == { 1, 2 })
    assert(default({i32, i32})[0] == 0)
    let nested = { { 1, 2 }, 3 }
    assert(nested[0][1] == 2)     // chained indexing

    // Tuple types compose and may contain type variables — see tuple_flip above,
    // a top-level generic function monomorphized for each tuple shape.
    assert(tuple_flip({ 7, "world" })[1] == 7)
    assert(tuple_flip({ true, 9 })[0] == 9)

    // Tuples match positionally in match arms (with literals, wildcards, binds)
    let quadrant = (pt: {i32, i32}) ->
        match pt with
        | { 0, 0 } -> 0
        | { 0, _ } -> 1
        | { x, y } -> x + y
    assert(quadrant({ 0, 0 }) == 0 && quadrant({ 3, 4 }) == 7)

    // Tuples work as array elements and module-level constants, like structs
    let grid = {i32, i32}[2] { { 1, 2 }, { 3, 4 } }
    assert(grid[1][0] == 3)

    // --------------------------------------------------------
    // Unions (tagged unions)
    // --------------------------------------------------------

    // Construction uses qualified variant names
    let c1 = shape.circle(10)
    let r1 = shape.rect(point { x = 3, y = 4 })
    let e1 = shape.empty

    // Default is first variant with zeroed payload
    let d = default(shape)
    assert(describe(d) == 0)   // circle(0) → 0 * 0

    // --------------------------------------------------------
    // Enums — closed sets with numeric values
    // --------------------------------------------------------

    // Qualified construction; bare-name arms; no `_` needed — the compiler
    // proves the match covers every variant
    let diff = difficulty.medium
    let bonus = match diff with
                | baby | easy -> 0
                | medium -> 10
                | hard -> 25
    assert(bonus == 10)

    // Same-enum ordering, count-sized tables indexed by the enum directly
    assert(difficulty.hard > difficulty.medium)
    let par = i32[difficulty.count]{ 90, 70, 50, 30 }
    assert(par[diff] == 50)

    // Cast out is total; enum_of is the only integer->enum door (yields E?)
    assert((i32) door_lock.elevator_b == 5)
    let lock = match enum_of(door_lock, 2) with
               | some(l) -> l
               | none -> door_lock.normal_a
    assert(lock == door_lock.silver_key)
    assert(default(door_lock) == door_lock.normal_a)

    // --------------------------------------------------------
    // Option types — T? replaces null
    // --------------------------------------------------------

    let some_val = some(42)           // i32?
    let no_val = none(i32)          // i32? with no value
    // none(T) is sugar for default(T?) — the symmetric partner to some(v).
    // default(T?) still works and generalizes to any default value.
    let no_val2 = default(i32?)     // identical to none(i32)

    // Check via .is_some / .is_none
    assert(some_val.is_some)
    assert(no_val.is_none)
    assert(no_val2.is_none)

    // Unwrap with ! (aborts on none)
    assert(some_val! == 42)
    // Hard failures (failed unwrap, bounds check, assert) print a one-line
    // diagnostic then abort. Compile with `fcc --backtraces` to also print a
    // backtrace of FC-level frames before the abort (off by default; costs
    // inlining, so use it only for diagnostic builds).

    // Pattern matching on options
    let unwrap_or = (opt: i32?, fallback: i32) ->
        match opt with
        | some(v) -> v
        | none    -> fallback
    assert(unwrap_or(some_val, 0) == 42)
    assert(unwrap_or(no_val, -1) == -1)

    // Pointer options: T*? uses null as none (no tag overhead)
    let mut val = point { x = 99, y = 0 }
    let ptr_opt = some(&val)          // point*?
    assert(ptr_opt!.x == 99)

    // --------------------------------------------------------
    // Result types — T! = ok(T) | err(i32), the error carrier
    // --------------------------------------------------------

    // ok(v) infers from the payload; err(T, code) is type-anchored like
    // none(T). The error code is always i32 and never 0 (0 is the ok tag —
    // err(T, 0) is a compile error).
    let succ = ok(42)                 // i32!
    let fail = err(i32, 2)          // i32! carrying code 2

    // Check via .is_ok / .is_err
    assert(succ.is_ok)
    assert(fail.is_err)

    // Unwrap with ! (aborts on err, printing the error code)
    assert(succ! == 42)

    // Pattern matching — literal code patterns work; they don't exhaust
    // err (i32 is infinite), so a binding or _ must follow
    let describe_res = (r: i32!) ->
        match r with
        | ok(v)  -> v
        | err(2) -> -2
        | err(e) -> 0 - e
    assert(describe_res(succ) == 42)
    assert(describe_res(fail) == -2)
    assert(describe_res(err(i32, 9)) == -9)

    // default(T!) is ok(default(T)) — zero-filled memory IS the default
    assert(default(i32!).is_ok)

    // Options say "absence is normal"; results say "failure has a reason".
    // Compose them instead of merging: u8?! reads as "fallible read of an
    // optional byte" — ok(some(b)) = data, ok(none(u8)) = clean EOF,
    // err(u8?, code) = I/O error.
    let read_result = ok(some(65u8))  // u8?!
    match read_result with
    | ok(some(b)) -> assert(b == 65u8)
    | ok(none)    -> assert(false)
    | err(_)      -> assert(false)

    // Named error codes — see the `error file_io` group at the top of this
    // file. Members are i32 constants (display type `error`); construction
    // uses the qualified name, and so do patterns (a bare member name in a
    // pattern would be a binding).
    let named_fail = err(i32, file_io.not_found)
    let looked_up = match named_fail with
                    | ok(v) -> 0
                    | err(file_io.not_found) -> 1
                    | err(_) -> 2
    assert(looked_up == 1)

    // error_name(e) -> str?: the qualified name of a declared code, none for
    // platform passthrough codes (errno-range and negative values)
    match error_name(file_io.invalid_path) with
    | some(n) -> assert(n == "file_io.invalid_path")
    | none -> assert(false)
    assert(error_name(13).is_none)   // errno range — belongs to the platform

    // void! — the payload-less result ("can fail, returns nothing"). Bare
    // `ok` constructs it, err(void, code) is the failure, and the bare `ok`
    // pattern matches it — no void value ever materializes. This is the
    // shape of C status calls: see the `c_files.remove` protocol extern
    // above (extern error protocols wrap C failures into T! automatically).
    let cleanup = (dry_run: bool) ->
        if dry_run then ok else c_files.remove(c"examples-no-such-file")
    match cleanup(true) with
    | ok -> assert(true)
    | err(_) -> assert(false)
    let failed = cleanup(false)       // ENOENT passes through raw
    assert(failed.is_err)
    assert(default(void!).is_ok)      // zero-filled memory is the ok tag

    // `ignore expr` evaluates its operand for side effects and yields void.
    // It is the explicit way to drop a result whose failure is deliberately
    // ignored (best-effort) — the acknowledgment the "a result can't be
    // silently dropped" rule requires — and, being void-typed, it also voids a
    // value-returning tail so a block needs no trailing `void()`.
    ignore cleanup(true)             // drop a void! result on purpose
    let step = (n: i32, sink: i32*) ->
        *sink = *sink + n
        n                             // returns i32
    let mut steps = 0
    ignore step(3, &steps)           // its value is dropped here
    if steps > 0 then
        ignore step(4, &steps)       // ignore voids the then-branch tail
    else
        void()
    assert(steps == 7)

    // Propagation: x? unwraps ok/some, or RETURNS the failure (err/none)
    // from the enclosing function — the ?/! grid's fourth cell. err's code
    // is i32 on both sides, so any T!'s failure passes through any
    // U!-returning function unchanged; defers unwind like any return.
    // The enclosing function must already return the matching carrier,
    // anchored by explicit ok/err (or some/none) on its success paths —
    // '?' contributes nothing to inference.
    let halve = (n: i32) ->
        if n % 2 != 0 then err(i32, file_io.invalid_path) else ok(n / 2)
    let quarter = (n: i32) ->
        let h = halve(n)?             // err short-circuits out of quarter
        let q = halve(h)?
        ok(q)                          // explicit ok anchors (i32) -> i32!
    assert(quarter(8)! == 2)
    match quarter(6) with              // 6 halves cleanly, 3 doesn't
    | ok(_) -> assert(false)
    | err(e) -> assert(e == file_io.invalid_path)
    // Works on options too: some passes through, none propagates.
    let tenth = (n: i32) ->
        if n % 10 == 0 then some(n / 10) else none(i32)
    let hundredth = (n: i32) ->
        let t = tenth(n)?
        tenth(t)                       // tail is already i32? — anchored
    assert(hundredth(300)! == 3)
    assert(hundredth(30).is_none)

    // Results cannot be silently ignored: `cleanup(false)` alone as a
    // statement is a compile error (a dropped result loses its failure).
    // Observe it (match / ? / !) or ignore explicitly with `let _ =`;
    // `defer` ignores by contract (best-effort cleanup). In a statement
    // match, a do-nothing arm is spelled void().
    let _ = cleanup(false)            // explicit best-effort ignore
    match cleanup(false) with
    | err(_) -> void()                // expected: nothing to clean up
    | ok -> void()

    // --------------------------------------------------------
    // Pointers
    // --------------------------------------------------------

    // & takes a binding's address. On a let mut it gives a writable T*;
    // on an immutable let it gives a read-only const T*.
    let mut n = 42
    let np = &n                // i32* — writable
    assert(*np == 42)          // dereference with *
    *np = 100                  // mutate through pointer
    assert(n == 100)

    let c = 7
    let cptr = &c              // const i32* — read-only view of an immutable binding
    assert(*cptr == 7)
    // *cptr = 0                // would be a compile error — write through const

    // Pointer to struct — field access with ->
    let mut pt = point { x = 1, y = 2 }
    let pp = &pt
    assert(pp.x == 1)
    pp.y = 20
    assert(pt.y == 20)

    // --------------------------------------------------------
    // Slices and strings
    // --------------------------------------------------------

    // Stack slice — T[N] { elements }
    let buf = i32[4] { 10, 20, 30, 40 }
    assert(buf.len == 4i64)
    assert(buf[0] == 10)
    assert(buf[3] == 40)

    // Subslicing
    let mid = buf[1..3]        // elements at index 1, 2
    assert(mid.len == 2i64)
    assert(mid[0] == 20)

    // String literals are const str (const u8[])
    let greeting = "hello"
    assert(greeting.len == 5i64)
    assert(greeting[0] == 104u8)   // 'h'

    // String interpolation with format specifiers
    // Arbitrary expressions are allowed inside %spec{expr}
    let name = "world"
    let expr_msg = "sum=%d{i + 1}, double=%d{i * 2}"
    assert(expr_msg == "sum=43, double=84")

    // A runtime-length %s has no compile-time buffer size, so a bare
    // interpolation containing one is rejected. Give it a home:
    let bounded = "hello %.16s{name}"          // precision → fixed stack buffer
    let on_stack = alloca("hello %s{name}")     // alloca → dynamic stack
    assert(bounded == "hello world")
    assert(on_stack == "hello world")

    // str → cstr conversion is likewise explicit: the (cstr) cast names the
    // conversion, and the same three homes apply. A bare (cstr) cast is rejected;
    // pick a home.
    let cs = (cstr[16]) name                    // bounded: 16-byte stack buffer (truncating)
    let cs_stack = alloca((cstr) name)          // alloca → dynamic stack (non-truncating)
    let cs_heap = alloc((cstr) name)!           // heap → caller frees
    defer free(cs_heap)
    assert(((str) cs) == "world")
    assert(((str) cs_stack) == "world")
    assert(((str) cs_heap) == "world")

    // Slice construction from raw pointer
    let raw = i32[] { ptr = buf.ptr, len = buf.len }
    assert(raw[2] == 30)

    // --------------------------------------------------------
    // Memory management
    // --------------------------------------------------------

    // Heap allocation — returns T? (option), must unwrap
    let hp = alloc(point { x = 5, y = 6 })!
    assert(hp.x == 5)
    free(hp)

    // Heap slice
    let hs = alloc(i32[4] { 1, 2, 3, 4 })!
    assert(hs[0] == 1)
    free(hs)

    // Raw buffer (pointer, not slice)
    let rb = alloc(u8, 64usize)!
    free(rb)

    // defer — schedule cleanup to run at block scope exit (LIFO order)
    let dp = alloc(point { x = 7, y = 8 })!
    defer free(dp)          // free runs when this scope exits
    assert(dp.x == 7)
    // dp is freed automatically — no manual free needed

    // sizeof and alignof (return i64)
    assert(sizeof(i32) == 4i64)
    assert(sizeof(point) == 8i64)
    assert(alignof(i64) == 8i64)

    // default — zero value for any type
    assert(default(i32) == 0)
    assert(default(bool) == false)
    assert(default(i32?).is_none)

    // Atomics — load-acquire / store-release through a pointer to a plain
    // integer or bool. For publishing data to threads created by C libraries
    // (FC itself has no threads). See spec §Atomics & Memory Model.
    let mut shared = 0usize
    atomic_store_release(&shared, 42usize)              // release: publishes prior writes
    assert(atomic_load_acquire(&shared) == 42usize)     // acquire: sees published writes
    let mut ready = false
    atomic_store_release(&ready, true)
    assert(atomic_load_acquire(&ready))

    // --------------------------------------------------------
    // Generics
    // --------------------------------------------------------

    assert(identity(42) == 42)
    assert(identity(true) == true)

    let p1 = pair { first = 1, second = "two" }
    let p2 = swap(p1)
    assert(p2.first == "two")
    assert(p2.second == 1)

    // Monomorphized for each concrete type used
    assert(identity(42) == 42)
    assert(identity(true) == true)
    assert(identity(3.14) == 3.14)

    // Generic unions — type args required (variant may not constrain all params)
    let good_val = result<i32, bool>.good(42)
    let bad_val = result<i32, bool>.bad(true)
    let got = match good_val with
    | good(v)  -> v
    | bad(_) -> -1
    assert(got == 42)

    // Explicit type args — for functions where types can't be inferred from args
    let dp = make_pair<i32, bool>()
    assert(dp.first == 0)
    assert(dp.second == false)

    // Const generics — nbits<32> and nbits<64> are distinct types from one
    // definition; const args admit arithmetic (parens for shifts)
    let mut n32 = default(nbits<32>)
    n32.bytes[3] = 0xffu8
    assert(n32.bytes.len == 4)
    let n64 = default(nbits<(32 << 1)>)
    assert(n64.bytes.len == 8)
    // 'n in expression position acts as an i32 literal of the bound value;
    // a width failing the struct's static_assert would not compile at all

    // --------------------------------------------------------
    // Const — deep immutability for pointers and slices
    // --------------------------------------------------------

    let v = 42
    let cp = &v                  // &<let> is already const i32* — no cast needed
    assert(*cp == 42)             // reading through const is fine
    // *cp = 10                   // would be a compile error

    // String literals are already const str
    // Slice bindings are non-const by default — element writes work
    // on plain `let` (let mut is only needed to rebind the variable).
    // Const-ness is a type-level property (const T[]), independent
    // of the let / let mut binding distinction.
    let mbuf = i32[2] { 1, 2 }
    mbuf[0] = 99
    assert(mbuf[0] == 99)
    let cmbuf = (const i32[]) mbuf
    // cmbuf[0] = 7              // would be a compile error
    assert(cmbuf[0] == 99)

    // --------------------------------------------------------
    // Escape analysis — the compiler rejects dangling pointers
    // --------------------------------------------------------

    // These are all compile errors (not shown, but tested elsewhere):
    //   return &local_var        → cannot return stack pointer
    //   free(&local_var)         → cannot free stack memory
    //   alloc(s { p = &local })  → cannot store stack ptr in heap

    // Pointers to inner-scope bindings are valid for the entire
    // function call (hoisted to function scope).
    let inner_ptr =
        let inner = 77
        &inner                 // const i32*
    assert(*inner_ptr == 77)

    // --------------------------------------------------------
    // C Interop
    // --------------------------------------------------------

    // Extern functions — a bare C symbol, so it can only be *called*, never
    // used as a value (an extern has no FC fat-pointer form). Wrap it in a
    // lambda to bind, pass, or return it as a function value.
    assert(c_stdlib.abs(-42) == 42)
    assert(c_stdlib.abs(0) == 0)
    let abs_fn = (x: i32) -> c_stdlib.abs(x)   // (i32) -> i32 — a real value
    assert(abs_fn(-5) == 5)

    // Extern constants (C macros imported as typed values)
    assert(c_stdlib.EXIT_SUCCESS == 0)
    assert(c_stdlib.EXIT_FAILURE != 0)

    // Extern structs — construct, access fields, default, sizeof
    let ts = c_time.timespec { tv_sec = 42, tv_nsec = 100 }
    assert(ts.tv_sec == 42)
    assert(ts.tv_nsec == 100)
    assert(default(c_time.timespec).tv_sec == 0)
    assert(sizeof(c_time.timespec) == 16i64)

    // Extern unions — untagged, fields overlap in memory
    let sv = c_signal.sigval { sival_int = 42 }
    assert(sv.sival_int == 42)
    let mut sv2 = default(c_signal.sigval)
    sv2.sival_int = 99
    assert(sv2.sival_int == 99)

    // Variadic extern functions
    let mut strbuf = u8[64] {}
    c_stdio.snprintf(strbuf.ptr, 64usize, c"value=%d", 42)

    // Aliases: extern abs as c_abs renames C's abs to c_abs in FC
    // Useful when C names collide with FC builtins (alloc, free, sizeof)

    // --------------------------------------------------------
    // All done
    // --------------------------------------------------------

    0
