// Fuzzel Fobble — a Puzzle Bobble / Bust-a-Move clone written in FC, on raylib.
//
// Aim the launcher, fire a bubble up into the hex-packed raft above, and match
// three or more of a colour to pop them. Anything left dangling — no longer
// connected to the ceiling — falls, and falling bubbles are where the points
// are. Every few shots the ceiling grinds down another row.
//
// Pure FC: no C helper files. raylib comes in through demos/shared/raylib.fc,
// and every sound is FM-synthesised on an emulated OPL2 (YM3812) — the
// chip module is demos/shared/opl2.fc, the instruments and sequencers are
// in sound.fc next door.
//
// ------------------------------------------------------------------
// This is a port, and the port is the point
// ------------------------------------------------------------------
//
// `demos/fuzzel-fobble` is the same game on SDL2. The two share sound.fc
// byte for byte and the whole of the game logic — grid, flood fills,
// scoring, level pacing — is identical. Everything that differs is the
// platform layer, and the differences are marked with a `// raylib:` note
// where they occur. README.md tallies them up. In short:
//
//   * no renderer handle: raylib's draw state is its own global, so the
//     drawing helpers and every draw_* below lost their first parameter;
//   * circles, thick lines and hexagons are primitives, so `disc`,
//     `thick_line` and `hex_fill` are one call each instead of scanline
//     and normal-offset loops;
//   * input is polled, not queued, so there is no event loop and no
//     mirrored key state in game_state;
//   * there is no logical-size mode, so the 1280x720 letterbox is drawn
//     by hand through a render texture;
//   * raylib's audio callback carries no userdata, so the engine pointer
//     has to live at file scope (see `audio_engine` below).

import raylib from shared::
import opl_audio from shared::
import io from std::
import text from std::
import sys from std::
import math from std::
import pcg_random from std::random

// ============================================================
// Constants (logical coordinates — see `present` for the letterbox)
// ============================================================

let logical_w = 1280
let logical_h = 720

// The playfield is a centred column; the two side strips are HUD panels.
let field_x0 = 352
let field_x1 = 928
let field_y0 = 80
let field_y1 = 700

// Hex-packed bubble raft. Even rows hold `grid_cols` bubbles; odd rows hold
// one fewer, shifted right by a radius. row_h is the vertical pitch of a
// hex packing: 48 * sqrt(3) / 2 = 41.57, rounded to 42.
let bubble_d = 48
let bubble_r = 24
let grid_cols = 12
let grid_rows = 14
let grid_cells = 168           // grid_rows * grid_cols
let row_h = 42
let ceiling_y = 92             // top edge of row 0
let death_row = 12             // a bubble reaching this row ends the run

// A shot sticks when it comes within this distance of a settled bubble.
// Slightly under a full diameter, so a bubble can squeeze into a gap
// before it grabs on.
let collide_d2 = 1936.0        // 44 * 44

let shooter_x = 640
let shooter_y = 656
let danger_y = 620             // ceiling_y + death_row * row_h + bubble_r

let shot_speed = 15.0
let shot_substeps = 5
let aim_limit = 78.0
let aim_speed = 1.7

let max_fallers = 96
let max_particles = 256
let max_drifters = 40

let num_colors = 6

// A grid cell holds -1 for empty, a colour index below num_colors, or one of
// these. `shot_metal` is a launcher payload only and never reaches the grid.
// Anything that reads a cell value has to decide what it means for these
// three, which is why `is_color` exists rather than a bare `>= 0` test.
let cell_star = 6       // hit it with a colour and every bubble of that colour goes
let cell_stone = 7      // indestructible: never pops, only falls
let shot_metal = 8      // ploughs through the raft, sticks to nothing

// When each special starts appearing, and how often. Stars and stones are
// part of the board; a metal shot is handed to the launcher.
let star_from_level = 2
let stone_from_level = 3
let metal_from_level = 2
let star_pct = 6         // per placed bubble, once stars are in play
let stone_pct = 7        // per placed bubble, never in the ceiling row
let metal_pct = 5        // per launcher reload

// The aim guide is a tutorial device: it draws the bounce for you while you
// learn the geometry, and comes off after this level.
let guide_levels = 1

// Ceiling pacing. The countdown runs on shots landed and nothing else — a
// pop scores, it does not buy time back. The interval itself comes from how
// many colours are still on the board: a board down to two colours is an
// easy board, so it earns a faster ceiling. Pressure tracks the position,
// not the level number. (Both rules are how the arcade bubble-shooters have
// always paced themselves; they are what keeps the game from stalling out
// into a solved puzzle.)
let drop_shots_min = 5
let drop_shots_max = 10

// The turn clock, in frames at roughly 60 Hz. Stall and the launcher starts
// nagging; keep stalling and it fires without you. A shooter with no clock
// lets every shot be solved at leisure, which is a different, slower game.
let hurry_warn = 300
let hurry_fire = 600

// A dropped bubble is worth double the one before it, up to a ceiling on the
// doublings — past that the curve is academic and the score runs away. This
// is what makes cutting the raft loose at the neck the point of the game
// rather than a bonus for tidiness.
let drop_score_base = 20
let drop_score_max_doubles = 14

// Clearing the board pays for speed: the bonus decays every few seconds and
// expires outright, so there is a reason to shoot rather than to study.
let clear_bonus_base = 50000
let clear_bonus_step = 5        // seconds per decay step
let clear_bonus_expiry = 65     // seconds after which a clear pays no bonus

// ============================================================
// Types
// ============================================================

union game_phase =
    | splash
    | playing
    | paused
    | level_clear
    | game_over

// The bubble in flight. There is only ever one.
struct shot =
    x: f64
    y: f64
    vx: f64
    vy: f64
    color: i32
    active: bool

// A bubble that lost its grip on the ceiling and is on its way out.
struct faller =
    x: f64
    y: f64
    vx: f64
    vy: f64
    color: i32
    alive: bool

struct particle =
    x: f64
    y: f64
    vx: f64
    vy: f64
    life: i32
    max_life: i32
    r: u8
    g: u8
    b: u8

// Background decoration — soda bubbles drifting up behind the playfield.
struct drifter =
    x: f64
    y: f64
    speed: f64
    rad: i32
    alpha: u8

struct game_state =
    phase: game_phase
    phase_timer: i32

    level: i32
    score: i32
    high_score: i32
    new_high: bool

    // Launcher
    angle: f64              // degrees; 0 = straight up, negative = left
    cur_color: i32
    next_color: i32
    // raylib: the SDL build carries `aim_left`/`aim_right` here, set on
    // keydown and cleared on keyup, because an event queue only reports
    // *changes* and a held key is a state the game has to keep for itself.
    // raylib latches the keyboard each frame and answers is_key_down from
    // the latch, so the state is already kept — see the update block.

    // Ceiling descent
    shots_left: i32
    drop_interval: i32
    row_parity: i32         // 0 = row 0 is a wide row, 1 = row 0 is offset
    shots_fired: i32

    // Clocks
    idle_timer: i32         // frames the turn has been sitting unfired
    level_frames: i32       // frames spent on this level, for the speed bonus
    bonus_paid: i32         // the speed bonus the last clear actually paid

    // Presentation
    show_symbols: bool
    popup_timer: i32
    popup_val: i32
    popup_x: i32
    popup_y: i32

// ============================================================
// World — every mutable scrap of gameplay state, born in main and
// threaded explicitly into the helpers that touch it. The renderer,
// the audio device, and the rng stay outside: they are channels
// (output, output, entropy), not state the game owns.
// ============================================================

struct world =
    grid: i32[]             // grid_cells cells; -1 = empty, else colour index
    mark: i32[]             // flood-fill scratch: same-colour cluster
    anchor: i32[]           // flood-fill scratch: reachable from the ceiling
    stack: i32[]            // flood-fill scratch: work list of cell indices
    fallers: faller[]
    particles: particle[]
    drifters: drifter[]
    shot: shot
    game: game_state

// ============================================================
// Small integer helpers
// ============================================================

let imin = (a: i32, b: i32) -> if a < b then a else b
let imax = (a: i32, b: i32) -> if a > b then a else b
let deg2rad = (d: f64) -> d * math.pi / 180.0

// Scales a colour channel to `pct` percent — the shading primitive.
let shade = (v: u8, pct: i32) -> (u8) ((i32) v * pct / 100)

// ============================================================
// Low-level drawing helpers
//
// raylib: none of these take a renderer. raylib keeps the window, the GL
// context and the current draw target in globals of its own, so there is
// no handle to thread through the ~35 draw_* functions below — which is
// why every one of them has one fewer parameter than its SDL2 twin.
//
// They still take loose r/g/b/a bytes rather than a `raylib.color`,
// because the art below is written in channels (see `shade` and `amul`);
// the colour struct is built once, here, at the boundary.
// ============================================================

let rgba = (cr: u8, cg: u8, cb: u8, ca: u8) ->
    raylib.color { r = cr, g = cg, b = cb, a = ca }

let fill = (x: i32, y: i32, w: i32, h: i32,
            cr: u8, cg: u8, cb: u8, ca: u8) ->
    raylib.fill_rect(x, y, w, h, rgba(cr, cg, cb, ca))

let outline = (x: i32, y: i32, w: i32, h: i32,
               cr: u8, cg: u8, cb: u8, ca: u8) ->
    raylib.draw_rect(x, y, w, h, rgba(cr, cg, cb, ca))

let line = (x1: i32, y1: i32, x2: i32, y2: i32,
            cr: u8, cg: u8, cb: u8, ca: u8) ->
    raylib.draw_line(x1, y1, x2, y2, rgba(cr, cg, cb, ca))

// raylib: a filled circle is a primitive. The SDL2 build draws one as a
// stack of horizontal bands `step` pixels tall — a dozen rects per bubble,
// because SDL2's renderer has points, lines and axis-aligned rects and
// nothing else. The band height was a parameter there; here there are no
// bands, so the call sites lost an argument along with the loop.
let disc = (cx: i32, cy: i32, rad: i32,
            cr: u8, cg: u8, cb: u8, ca: u8) ->
    raylib.fill_circle(cx, cy, (f32) rad, rgba(cr, cg, cb, ca))

// raylib: likewise a line with body. The SDL2 build steps `th` parallel
// one-pixel lines along the segment normal, computing the normal itself;
// draw_line_ex takes the thickness and builds the quad.
let thick_line = (x1: f64, y1: f64, x2: f64, y2: f64, th: i32,
                  cr: u8, cg: u8, cb: u8, ca: u8) ->
    raylib.draw_line_ex(raylib.vec2 { x = (f32) x1, y = (f32) y1 },
                        raylib.vec2 { x = (f32) x2, y = (f32) y2 },
                        (f32) th, rgba(cr, cg, cb, ca))

// ============================================================
// 3x5 pixel font (bitmap packed into an i32: 5 rows of 3 bits)
// ============================================================

let glyph = (ch: u8) ->
    match ch with
    | 'A' -> 2 | (5 << 3) | (7 << 6) | (5 << 9) | (5 << 12)
    | 'B' -> 6 | (5 << 3) | (6 << 6) | (5 << 9) | (6 << 12)
    | 'C' -> 3 | (4 << 3) | (4 << 6) | (4 << 9) | (3 << 12)
    | 'D' -> 6 | (5 << 3) | (5 << 6) | (5 << 9) | (6 << 12)
    | 'E' -> 7 | (4 << 3) | (6 << 6) | (4 << 9) | (7 << 12)
    | 'F' -> 7 | (4 << 3) | (6 << 6) | (4 << 9) | (4 << 12)
    | 'G' -> 3 | (4 << 3) | (5 << 6) | (5 << 9) | (3 << 12)
    | 'H' -> 5 | (5 << 3) | (7 << 6) | (5 << 9) | (5 << 12)
    | 'I' -> 7 | (2 << 3) | (2 << 6) | (2 << 9) | (7 << 12)
    | 'J' -> 1 | (1 << 3) | (1 << 6) | (5 << 9) | (2 << 12)
    | 'K' -> 5 | (6 << 3) | (4 << 6) | (6 << 9) | (5 << 12)
    | 'L' -> 4 | (4 << 3) | (4 << 6) | (4 << 9) | (7 << 12)
    | 'M' -> 5 | (7 << 3) | (5 << 6) | (5 << 9) | (5 << 12)
    | 'N' -> 5 | (7 << 3) | (7 << 6) | (5 << 9) | (5 << 12)
    | 'O' -> 2 | (5 << 3) | (5 << 6) | (5 << 9) | (2 << 12)
    | 'P' -> 6 | (5 << 3) | (6 << 6) | (4 << 9) | (4 << 12)
    | 'Q' -> 2 | (5 << 3) | (5 << 6) | (6 << 9) | (3 << 12)
    | 'R' -> 6 | (5 << 3) | (6 << 6) | (5 << 9) | (5 << 12)
    | 'S' -> 3 | (4 << 3) | (2 << 6) | (1 << 9) | (6 << 12)
    | 'T' -> 7 | (2 << 3) | (2 << 6) | (2 << 9) | (2 << 12)
    | 'U' -> 5 | (5 << 3) | (5 << 6) | (5 << 9) | (2 << 12)
    | 'V' -> 5 | (5 << 3) | (5 << 6) | (2 << 9) | (2 << 12)
    | 'W' -> 5 | (5 << 3) | (7 << 6) | (7 << 9) | (5 << 12)
    | 'X' -> 5 | (5 << 3) | (2 << 6) | (5 << 9) | (5 << 12)
    | 'Y' -> 5 | (5 << 3) | (2 << 6) | (2 << 9) | (2 << 12)
    | 'Z' -> 7 | (1 << 3) | (2 << 6) | (4 << 9) | (7 << 12)
    | '0' -> 7 | (5 << 3) | (5 << 6) | (5 << 9) | (7 << 12)
    | '1' -> 2 | (6 << 3) | (2 << 6) | (2 << 9) | (7 << 12)
    | '2' -> 7 | (1 << 3) | (7 << 6) | (4 << 9) | (7 << 12)
    | '3' -> 7 | (1 << 3) | (3 << 6) | (1 << 9) | (7 << 12)
    | '4' -> 5 | (5 << 3) | (7 << 6) | (1 << 9) | (1 << 12)
    | '5' -> 7 | (4 << 3) | (7 << 6) | (1 << 9) | (7 << 12)
    | '6' -> 3 | (4 << 3) | (7 << 6) | (5 << 9) | (7 << 12)
    | '7' -> 7 | (1 << 3) | (1 << 6) | (1 << 9) | (1 << 12)
    | '8' -> 7 | (5 << 3) | (7 << 6) | (5 << 9) | (7 << 12)
    | '9' -> 7 | (5 << 3) | (7 << 6) | (1 << 9) | (6 << 12)
    | '+' -> 0 | (2 << 3) | (7 << 6) | (2 << 9) | (0 << 12)
    | '-' -> 0 | (0 << 3) | (7 << 6) | (0 << 9) | (0 << 12)
    | ':' -> 0 | (2 << 3) | (0 << 6) | (2 << 9) | (0 << 12)
    | '!' -> 2 | (2 << 3) | (2 << 6) | (0 << 9) | (2 << 12)
    | '.' -> 0 | (0 << 3) | (0 << 6) | (0 << 9) | (2 << 12)
    | _ -> 0

let draw_char = (ch: u8, ox: i32, oy: i32, scale: i32,
                 cr: u8, cg: u8, cb: u8) ->
    let g = glyph(ch)
    for row in 0..5 do
        let bits = (g >> (row * 3)) & 7
        for col in 0..3 do
            if (bits >> (2 - col)) & 1 == 1 then
                fill(ox + col * scale, oy + row * scale, scale, scale, cr, cg, cb, 255u8)

let text_width = (s: const str, scale: i32) ->
    (i32) s.len * 4 * scale - scale

let draw_text = (s: const str, ox: i32, oy: i32, scale: i32,
                 cr: u8, cg: u8, cb: u8) ->
    let mut x = ox
    for ch in s do
        if ch != ' ' then
            draw_char(ch, x, oy, scale, cr, cg, cb)
        x = x + 4 * scale

let draw_text_centered = (s: const str, cx: i32, oy: i32, scale: i32,
                          cr: u8, cg: u8, cb: u8) ->
    let w = text_width(s, scale)
    draw_text(s, cx - w / 2, oy, scale, cr, cg, cb)

// ============================================================
// Bubble art
// ============================================================

// The six playfield colours. A tuple keeps the three channels together
// without a struct for what is really just a literal table.
let bubble_rgb = (c: i32) ->
    match c with
    | 0 -> { 235u8, 72u8,  86u8 }      // cherry
    | 1 -> { 70u8,  132u8, 240u8 }     // blueberry
    | 2 -> { 74u8,  200u8, 104u8 }     // lime
    | 3 -> { 246u8, 202u8, 72u8 }      // lemon
    | 4 -> { 178u8, 96u8,  228u8 }     // grape
    | _ -> { 72u8,  214u8, 220u8 }     // mint

// A 5x5 mark stamped on each bubble so the colours stay distinguishable
// without relying on hue alone. Packed as five 5-bit rows, MSB leftmost.
let symbol_bits = (c: i32) ->
    match c with
    | 0 -> 0b00100_01110_11111_01110_00100      // diamond
    | 1 -> 0b01110_10001_10001_10001_01110      // ring
    | 2 -> 0b00100_00100_11111_00100_00100      // cross
    | 3 -> 0b10001_01010_00100_01010_10001      // star
    | 4 -> 0b11111_10001_10001_10001_11111      // square
    | _ -> 0b00100_00100_01110_01110_11111      // tree

// True for a plain playfield colour, false for empty and for every special.
// Any code that treats a cell value as an index into a colour table has to
// ask this first — `>= 0` alone will hand it a star or a stone.
let is_color = (v: i32) -> v >= 0 && v < num_colors

// Colour for any cell or shot value, specials included.
let cell_rgb = (v: i32) ->
    if v == cell_star then
        // Near-white, not gold: a gold star sat two shades from lemon and the
        // two were a genuine muddle on a busy board. No playfield colour is
        // white, so white is the one hue that cannot be mistaken for a colour.
        { 252u8, 248u8, 232u8 }
    else if v == cell_stone then
        { 128u8, 134u8, 150u8 }
    else if v == shot_metal then
        { 206u8, 214u8, 228u8 }
    else
        bubble_rgb(v)

// Scales an alpha by a percentage — keeps highlights translucent when the
// whole bubble is fading.
let amul = (a: u8, pct: i32) -> (u8) ((i32) a * pct / 100)

// Stamps a packed 5x5 mark across the face of a bubble.
let stamp_mark = (cx: i32, cy: i32, bits: i32,
                  mr: u8, mg: u8, mb: u8, alpha: u8) ->
    for row in 0..5 do
        let rowbits = (bits >> ((4 - row) * 5)) & 31
        for col in 0..5 do
            if (rowbits >> (4 - col)) & 1 == 1 then
                fill(cx - 5 + col * 2, cy - 4 + row * 2, 2, 2, mr, mg, mb, alpha)

// A five-pointed star on a 15x15 grid, one bit per cell, MSB leftmost. Too
// wide to pack into an i32 the way the 5x5 marks are, so it is a row table
// like the font. Inscribed at 2px a cell it very nearly fills the bubble,
// which is the point: the star *is* the bubble, not a badge stuck on one.
let star_row = (y: i32) ->
    match y with
    | 0  -> 0b000000010000000
    | 1  -> 0b000000111000000
    | 2  -> 0b000000111000000
    | 3  -> 0b000001111100000
    | 4  -> 0b000001111100000
    | 5  -> 0b111111111111111
    | 6  -> 0b011111111111110
    | 7  -> 0b001111111111100
    | 8  -> 0b000111111111000
    | 9  -> 0b000011111110000
    | 10 -> 0b000011111110000
    | 11 -> 0b000111111111000
    | 12 -> 0b000111000111000
    | 13 -> 0b001110000011100
    | _  -> 0b001000000000100

let stamp_star = (cx: i32, cy: i32, cell: i32,
                  mr: u8, mg: u8, mb: u8, alpha: u8) ->
    let span = 15 * cell
    for row in 0..15 do
        let bits = star_row(row)
        for col in 0..15 do
            if (bits >> (14 - col)) & 1 == 1 then
                fill(cx - span / 2 + col * cell, cy - span / 2 + row * cell,
                     cell, cell, mr, mg, mb, alpha)

// raylib: a regular polygon is a primitive too, and a hexagon of
// circumradius `rad` with a vertex at angle 0 is exactly what fill_poly
// draws at rotation 0 — the same hexagon `hex_vertex` below walks. The
// SDL2 build spends a `hex_half_width` helper and a scanline loop here to
// reach the same shape out of axis-aligned rects.
let hex_fill = (cx: i32, cy: i32, rad: i32,
                cr: u8, cg: u8, cb: u8, alpha: u8) ->
    raylib.fill_poly(raylib.vec2 { x = (f32) cx, y = (f32) cy },
                     6, (f32) rad, 0.0f32, rgba(cr, cg, cb, alpha))

let hex_vertex = (cx: i32, cy: i32, rad: i32, i: i32) ->
    let a = (f64) i * 1.0471976
    { (f64) cx + math.cos(a) * (f64) rad, (f64) cy + math.sin(a) * (f64) rad }

// The specials are told apart by shape, not by decoration: a star wears a
// star across its whole face and a stone is not a sphere at all. That says
// what the bubble *does*, so unlike the colour-blind marks it is not the
// player's to switch off.
let draw_star_bubble = (cx: i32, cy: i32, alpha: u8) ->
    let { br, bg, bb } = cell_rgb(cell_star)
    // Gold rim, white body, and a gold star inscribed across the whole face.
    // The dark star sits a pixel down-right of the bright one, so the points
    // keep an edge instead of dissolving into the white behind them.
    disc(cx, cy, 23, 228u8, 158u8, 44u8, alpha)
    disc(cx - 2, cy - 2, 19, br, bg, bb, alpha)
    stamp_star(cx - 1, cy - 1, 2, 168u8, 100u8, 12u8, alpha)
    stamp_star(cx - 2, cy - 2, 2, 242u8, 174u8, 50u8, alpha)

let draw_stone_bubble = (cx: i32, cy: i32, alpha: u8) ->
    let { br, bg, bb } = cell_rgb(cell_stone)
    // A cut block rather than a sphere: a faceted hexagon with a flat table
    // and no gloss anywhere. Every other thing on the board is round and
    // glassy, so silhouette alone says "this one does not pop".
    hex_fill(cx, cy, 22, shade(br, 58), shade(bg, 58), shade(bb, 58), alpha)
    hex_fill(cx, cy, 19, br, bg, bb, alpha)
    hex_fill(cx - 1, cy - 1, 10, shade(br, 126), shade(bg, 126), shade(bb, 126), alpha)
    // Facet edges: table corners out to the hull corners. Lit on the upper
    // ridges and shadowed on the lower ones, off the same upper-left light
    // the glass bubbles use — uniformly dark ridges read as scratches on a
    // grey disc rather than as a cut stone.
    for i in 0..6 do
        let { ix, iy } = hex_vertex(cx - 1, cy - 1, 10, i)
        let { ox, oy } = hex_vertex(cx, cy, 20, i)
        let pct = if i >= 3 then 138 else 50
        thick_line(ix, iy, ox, oy, 2,
                   shade(br, pct), shade(bg, pct), shade(bb, pct), alpha)

let draw_metal_bubble = (cx: i32, cy: i32, alpha: u8) ->
    let { br, bg, bb } = cell_rgb(shot_metal)
    // A polished ball: discs of rising brightness, each stepped a little
    // further toward the light, so what is left showing of each is a crescent
    // and the crescents stack into a curve. The coloured bubbles do this with
    // two discs; steel just needs more of them, because its falloff from hot
    // spot to shadow is far shorter than glass's.
    disc(cx,     cy,     23, shade(br, 26), shade(bg, 26), shade(bb, 28), alpha)
    disc(cx - 1, cy - 1, 21, shade(br, 44), shade(bg, 44), shade(bb, 46), alpha)
    disc(cx - 2, cy - 3, 17, shade(br, 64), shade(bg, 64), shade(bb, 66), alpha)
    disc(cx - 4, cy - 5, 12, shade(br, 84), shade(bg, 84), shade(bb, 86), alpha)
    disc(cx - 5, cy - 7,  7, br, bg, bb, alpha)
    disc(cx - 7, cy - 9,  3, 255u8, 255u8, 255u8, alpha)
    // Light bounced up off the shadow side. Without it a metal ball reads as
    // a grey one — the second, dimmer highlight is the whole tell.
    disc(cx + 8, cy + 9, 4, shade(br, 76), shade(bg, 76), shade(bb, 80),
         amul(alpha, 80))

let draw_bubble = (cx: i32, cy: i32, color: i32, alpha: u8, symbols: bool) ->
    if color == cell_star then
        draw_star_bubble(cx, cy, alpha)
        return
    if color == cell_stone then
        draw_stone_bubble(cx, cy, alpha)
        return
    if color == shot_metal then
        draw_metal_bubble(cx, cy, alpha)
        return

    let { br, bg, bb } = bubble_rgb(color)

    // Rim first, then the body inset up-left: the offset between the two
    // discs *is* the shading — a crescent of rim shows on the lower right.
    disc(cx, cy, 23, shade(br, 52), shade(bg, 52), shade(bb, 52), alpha)
    disc(cx - 2, cy - 2, 19, br, bg, bb, alpha)

    // Colour-blind-friendly mark, dark and low-contrast so it reads as texture.
    if symbols then
        stamp_mark(cx, cy, symbol_bits(color),
                   shade(br, 40), shade(bg, 40), shade(bb, 40), amul(alpha, 62))

    // Specular highlight
    disc(cx - 8, cy - 9, 5, 255u8, 255u8, 255u8, amul(alpha, 62))
    fill(cx - 2, cy - 15, 5, 3, 255u8, 255u8, 255u8, amul(alpha, 40))

// ============================================================
// Grid geometry
//
// Rows alternate between wide (grid_cols bubbles, flush left) and narrow
// (grid_cols - 1, shifted right by a radius). `row_parity` says which kind
// row 0 currently is; it flips on every ceiling descent, which is exactly
// what keeps each existing row's stagger intact as the raft slides down.
// ============================================================

let cell_index = (row: i32, col: i32) -> row * grid_cols + col

let row_is_narrow = (w: world*, row: i32) -> (row + w.game.row_parity) % 2 == 1

let row_cols = (w: world*, row: i32) ->
    if row_is_narrow(w, row) then grid_cols - 1 else grid_cols

let cell_get = (w: world*, row: i32, col: i32) ->
    if row < 0 || row >= grid_rows || col < 0 || col >= row_cols(w, row) then
        return -1
    w.grid[cell_index(row, col)]

let cell_center = (w: world*, row: i32, col: i32) ->
    let off = if row_is_narrow(w, row) then bubble_r else 0
    { (f64) (field_x0 + col * bubble_d + bubble_r + off),
      (f64) (ceiling_y + row * row_h + bubble_r) }

// The six hex neighbours, k = 0..5: left, right, up-left, up-right,
// down-left, down-right. A narrow row sits half a bubble to the right of
// the wide row above it, so its upward neighbours are (col, col + 1) where
// a wide row's are (col - 1, col).
let neighbor = (w: world*, row: i32, col: i32, k: i32) ->
    let d = if row_is_narrow(w, row) then 1 else 0
    match k with
    | 0 -> { row,     col - 1 }
    | 1 -> { row,     col + 1 }
    | 2 -> { row - 1, col - 1 + d }
    | 3 -> { row - 1, col + d }
    | 4 -> { row + 1, col - 1 + d }
    | _ -> { row + 1, col + d }

let count_bubbles = (w: world*) ->
    let mut n = 0
    for i in 0..grid_cells do
        if w.grid[i] >= 0 then n = n + 1
    n

let deepest_row = (w: world*) ->
    let mut d = -1
    for row in 0..grid_rows do
        let rc = row_cols(w, row)
        for col in 0..rc do
            if w.grid[cell_index(row, col)] >= 0 && row > d then
                d = row
    d

let color_in_play = (w: world*, c: i32) ->
    let mut found = false
    for i in 0..grid_cells do
        if w.grid[i] == c then found = true
    found

let count_colors_in_play = (w: world*) ->
    let mut seen = i32[6] { 0, 0, 0, 0, 0, 0 }
    for i in 0..grid_cells do
        let v = w.grid[i]
        if is_color(v) then
            seen[v] = 1
    let mut n = 0
    for c in 0..num_colors do
        if seen[c] == 1 then n = n + 1
    n

// Shots between ceiling descents, derived from the colours still on the
// board. Fewer colours is an easier board, so it gets a shorter fuse.
let drop_interval_for = (colors: i32) ->
    imin(imax(colors + 4, drop_shots_min), drop_shots_max)

// Re-derived after every landing, so a colour leaving the board tightens the
// countdown at once. The clamp matters: the interval can shrink underneath a
// countdown that is already running.
let refresh_drop_interval = (w: world*) ->
    w.game.drop_interval = drop_interval_for(count_colors_in_play(w))
    if w.game.shots_left > w.game.drop_interval then
        w.game.shots_left = w.game.drop_interval

// ============================================================
// Scoring
// ============================================================

// Popped bubbles are flat rate; bubbles you cut loose double with each one
// that falls, which is what makes severing the raft worth aiming for.
let drop_score = (n: i32) ->
    if n <= 0 then
        return 0
    let mut v = drop_score_base
    let doubles = imin(n - 1, drop_score_max_doubles)
    for i in 0..doubles do
        v = v * 2
    v

// The speed bonus for clearing a board: full value if you are quick, decayed
// a notch for every few seconds after that, and nothing at all once the
// clock runs past the expiry.
let clear_bonus = (frames: i32) ->
    let secs = frames / 60
    if secs >= clear_bonus_expiry then
        return 0
    let mut v = clear_bonus_base
    let mut t = secs
    loop
        if t < clear_bonus_step then break
        v = v * 3 / 4
        t = t - clear_bonus_step
    v

// ============================================================
// Particles
// ============================================================

let spawn_burst = (w: world*, rng: pcg_random*, cx: f64, cy: f64, count: i32,
                   cr: u8, cg: u8, cb: u8) ->
    let mut spawned = 0
    for i in 0..max_particles do
        if spawned >= count then break
        if w.particles[i].life <= 0 then
            let angle = pcg_random.next_f64(rng) * 6.2831853
            let speed = 1.0 + pcg_random.next_f64(rng) * 4.5
            w.particles[i].x = cx
            w.particles[i].y = cy
            w.particles[i].vx = math.cos(angle) * speed
            w.particles[i].vy = math.sin(angle) * speed
            let life = 22 + (i32) (pcg_random.next_f64(rng) * 22.0)
            w.particles[i].life = life
            w.particles[i].max_life = life
            w.particles[i].r = cr
            w.particles[i].g = cg
            w.particles[i].b = cb
            spawned = spawned + 1

let update_particles = (w: world*) ->
    for i in 0..max_particles do
        if w.particles[i].life > 0 then
            w.particles[i].x = w.particles[i].x + w.particles[i].vx
            w.particles[i].y = w.particles[i].y + w.particles[i].vy
            w.particles[i].vy = w.particles[i].vy + 0.14
            w.particles[i].vx = w.particles[i].vx * 0.98
            w.particles[i].life = w.particles[i].life - 1

let draw_particles = (w: world*) ->
    for i in 0..max_particles do
        if w.particles[i].life > 0 then
            let t = (f64) w.particles[i].life / (f64) w.particles[i].max_life
            let alpha = (u8) (t * 255.0)
            let size = if t > 0.6 then 5 else if t > 0.3 then 3 else 2
            fill((i32) w.particles[i].x - size / 2,
                    (i32) w.particles[i].y - size / 2,
                    size, size,
                    w.particles[i].r, w.particles[i].g, w.particles[i].b, alpha)

let clear_particles = (w: world*) ->
    for i in 0..max_particles do
        w.particles[i].life = 0

// ============================================================
// Falling bubbles
// ============================================================

let spawn_faller = (w: world*, rng: pcg_random*, x: f64, y: f64, color: i32) ->
    for i in 0..max_fallers do
        if !w.fallers[i].alive then
            w.fallers[i].x = x
            w.fallers[i].y = y
            w.fallers[i].vx = (pcg_random.next_f64(rng) - 0.5) * 3.0
            w.fallers[i].vy = -1.5 - pcg_random.next_f64(rng) * 2.0
            w.fallers[i].color = color
            w.fallers[i].alive = true
            return

let update_fallers = (w: world*) ->
    for i in 0..max_fallers do
        if w.fallers[i].alive then
            w.fallers[i].vy = w.fallers[i].vy + 0.55
            w.fallers[i].x = w.fallers[i].x + w.fallers[i].vx
            w.fallers[i].y = w.fallers[i].y + w.fallers[i].vy
            if w.fallers[i].y > (f64) (logical_h + 60) then
                w.fallers[i].alive = false

let draw_fallers = (w: world*) ->
    for i in 0..max_fallers do
        if w.fallers[i].alive then
            draw_bubble((i32) w.fallers[i].x, (i32) w.fallers[i].y,
                        w.fallers[i].color, 235u8, w.game.show_symbols)

let clear_fallers = (w: world*) ->
    for i in 0..max_fallers do
        w.fallers[i].alive = false

// ============================================================
// Background drifters
// ============================================================

let init_drifters = (w: world*, rng: pcg_random*) ->
    for i in 0..max_drifters do
        w.drifters[i].x = (f64) (field_x0 + 24) +
                          pcg_random.next_f64(rng) * (f64) (field_x1 - field_x0 - 48)
        w.drifters[i].y = (f64) field_y0 +
                          pcg_random.next_f64(rng) * (f64) (field_y1 - field_y0)
        w.drifters[i].speed = 0.25 + pcg_random.next_f64(rng) * 0.85
        w.drifters[i].rad = 4 + (i32) (pcg_random.next_f64(rng) * 13.0)
        w.drifters[i].alpha = (u8) (16.0 + pcg_random.next_f64(rng) * 26.0)

let update_drifters = (w: world*, rng: pcg_random*) ->
    for i in 0..max_drifters do
        w.drifters[i].y = w.drifters[i].y - w.drifters[i].speed
        if w.drifters[i].y < (f64) (field_y0 - 24) then
            w.drifters[i].y = (f64) (field_y1 + 24)
            w.drifters[i].x = (f64) (field_x0 + 24) +
                              pcg_random.next_f64(rng) * (f64) (field_x1 - field_x0 - 48)

let draw_drifters = (w: world*) ->
    for i in 0..max_drifters do
        let x = (i32) w.drifters[i].x
        let y = (i32) w.drifters[i].y
        let a = w.drifters[i].alpha
        disc(x, y, w.drifters[i].rad, 150u8, 210u8, 255u8, a)
        fill(x - w.drifters[i].rad / 3, y - w.drifters[i].rad / 2, 3, 3,
             255u8, 255u8, 255u8, amul(a, 220))

// ============================================================
// Flood fills
//
// Two of them, both over the same explicit index stack: one gathers a
// same-colour cluster from the bubble that just landed, the other marks
// everything still hanging from row 0. What the second one *doesn't*
// reach is what falls.
// ============================================================

let flood_same_color = (w: world*, row: i32, col: i32) ->
    for i in 0..grid_cells do
        w.mark[i] = 0
    // Only a plain colour has a cluster. A star or a stone matches nothing,
    // not even another of its own kind.
    let color = cell_get(w, row, col)
    if !is_color(color) then
        return 0

    let start = cell_index(row, col)
    w.mark[start] = 1
    w.stack[0] = start
    let mut top = 1
    let mut count = 0
    loop
        if top == 0 then break
        top = top - 1
        let ci = w.stack[top]
        let cr = ci / grid_cols
        let cc = ci % grid_cols
        count = count + 1
        for k in 0..6 do
            let { nr, nc } = neighbor(w, cr, cc, k)
            if cell_get(w, nr, nc) == color then
                let ni = cell_index(nr, nc)
                if w.mark[ni] == 0 then
                    w.mark[ni] = 1
                    w.stack[top] = ni
                    top = top + 1
    count

let mark_anchored = (w: world*) ->
    for i in 0..grid_cells do
        w.anchor[i] = 0
    let mut top = 0
    let rc = row_cols(w, 0)
    for col in 0..rc do
        if cell_get(w, 0, col) >= 0 then
            let ci = cell_index(0, col)
            w.anchor[ci] = 1
            w.stack[top] = ci
            top = top + 1
    loop
        if top == 0 then break
        top = top - 1
        let ci = w.stack[top]
        let cr = ci / grid_cols
        let cc = ci % grid_cols
        for k in 0..6 do
            let { nr, nc } = neighbor(w, cr, cc, k)
            if cell_get(w, nr, nc) >= 0 then
                let ni = cell_index(nr, nc)
                if w.anchor[ni] == 0 then
                    w.anchor[ni] = 1
                    w.stack[top] = ni
                    top = top + 1

// Pops every cell flagged in `mark`, returning how many went.
let clear_marked = (w: world*, rng: pcg_random*) ->
    let mut popped = 0
    for row in 0..grid_rows do
        let rc = row_cols(w, row)
        for col in 0..rc do
            let ci = cell_index(row, col)
            if w.mark[ci] == 1 && w.grid[ci] >= 0 then
                let c = w.grid[ci]
                let { cx, cy } = cell_center(w, row, col)
                let { pr, pg, pb } = cell_rgb(c)
                spawn_burst(w, rng, cx, cy, 12, pr, pg, pb)
                w.grid[ci] = -1
                popped = popped + 1
    popped

// Cuts loose everything no longer hanging from the ceiling.
let drop_floaters = (w: world*, rng: pcg_random*) ->
    mark_anchored(w)
    let mut dropped = 0
    for row in 0..grid_rows do
        let rc = row_cols(w, row)
        for col in 0..rc do
            let ci = cell_index(row, col)
            if w.grid[ci] >= 0 && w.anchor[ci] == 0 then
                let { cx, cy } = cell_center(w, row, col)
                spawn_faller(w, rng, cx, cy, w.grid[ci])
                w.grid[ci] = -1
                dropped = dropped + 1
    dropped

// ============================================================
// Level setup
// ============================================================

let level_colors = (level: i32) -> imin(3 + (level - 1) / 2, num_colors)
let level_rows = (level: i32) -> imin(5 + (level - 1) / 2, 8)

let roll = (rng: pcg_random*, pct: i32) ->
    (i32) pcg_random.next_bounded_u32(rng, 100u32) < pct

// Picks a colour for the launcher. Only colours actually on the board are
// eligible — handing out a colour with nothing to match would be a dud shot.
let pick_shot_color = (w: world*, rng: pcg_random*) ->
    let mut avail = i32[6] { 0, 0, 0, 0, 0, 0 }
    for i in 0..grid_cells do
        let v = w.grid[i]
        if is_color(v) then
            avail[v] = 1
    let mut n = 0
    for c in 0..num_colors do
        if avail[c] == 1 then n = n + 1
    if n == 0 then
        return (i32) pcg_random.next_bounded_u32(rng, (u32) level_colors(w.game.level))

    let pick = (i32) pcg_random.next_bounded_u32(rng, (u32) n)
    let mut seen = -1
    let mut result = 0
    for c in 0..num_colors do
        if avail[c] == 1 then
            seen = seen + 1
            if seen == pick then result = c
    result

// What the launcher loads: usually a colour that is on the board, and now and
// then a metal shot. Only the launcher queue draws from this — a descending
// row uses the plain colour pick, since the specials are not the ceiling's
// to hand out.
let pick_launcher = (w: world*, rng: pcg_random*) ->
    if w.game.level >= metal_from_level && roll(rng, metal_pct) then
        return shot_metal
    pick_shot_color(w, rng)

let build_level = (w: world*, rng: pcg_random*) ->
    for i in 0..grid_cells do
        w.grid[i] = -1
    w.game.row_parity = 0

    let colors = level_colors(w.game.level)
    let rows = level_rows(w.game.level)
    let stars = w.game.level >= star_from_level
    // A stone in the ceiling row could never be cut loose, and a board you
    // cannot finish is not a hard board, it is a broken one. Row 0 stays
    // clean, and since the raft only ever moves *down*, no stone can reach it.
    let stones = w.game.level >= stone_from_level
    for row in 0..rows do
        let rc = row_cols(w, row)
        let mut prev = -1
        for col in 0..rc do
            // The bottom row is ragged, which gives the opening shots
            // somewhere interesting to go.
            let hole = row == rows - 1 && roll(rng, 35)
            if hole then
                prev = -1
            else if stones && row > 0 && roll(rng, stone_pct) then
                w.grid[cell_index(row, col)] = cell_stone
                prev = -1
            else if stars && roll(rng, star_pct) then
                w.grid[cell_index(row, col)] = cell_star
                prev = -1
            else
                // Repeating the left neighbour part of the time clumps the
                // colours into shapes worth shooting at, instead of static.
                let mut c = (i32) pcg_random.next_bounded_u32(rng, (u32) colors)
                if prev >= 0 && roll(rng, 45) then
                    c = prev
                w.grid[cell_index(row, col)] = c
                prev = c

// Slides the whole raft down one row and grows a fresh row at the ceiling.
// Flipping row_parity is what preserves each existing row's stagger: a row
// moving from index r to r + 1 keeps its own width and offset.
let descend = (w: world*, rng: pcg_random*) ->
    let mut row = grid_rows - 1
    loop
        if row <= 0 then break
        for col in 0..grid_cols do
            w.grid[cell_index(row, col)] = w.grid[cell_index(row - 1, col)]
        row = row - 1
    w.game.row_parity = 1 - w.game.row_parity

    for col in 0..grid_cols do
        w.grid[cell_index(0, col)] = -1
    let rc = row_cols(w, 0)
    let stars = w.game.level >= star_from_level
    for col in 0..rc do
        // Stars can ride down with a new row; stones cannot, for the reason
        // build_level gives.
        if stars && roll(rng, star_pct) then
            w.grid[cell_index(0, col)] = cell_star
        else
            w.grid[cell_index(0, col)] = pick_shot_color(w, rng)

// ============================================================
// Collision and settling
// ============================================================

// True if a bubble centred at (x, y) overlaps any settled bubble. Only the
// rows that could possibly reach are scanned — the raft is 14 rows deep and
// this runs 5 times a frame for the shot plus ~90 times for the aim guide.
let hits_bubble = (w: world*, x: f64, y: f64) ->
    let approx = (i32) ((y - (f64) (ceiling_y + bubble_r)) / (f64) row_h)
    let lo = imax(approx - 2, 0)
    let hi = imin(approx + 2, grid_rows - 1)
    let mut hit = false
    for row in lo..(hi + 1) do
        if !hit then
            let rc = row_cols(w, row)
            for col in 0..rc do
                if !hit && w.grid[cell_index(row, col)] >= 0 then
                    let { cx, cy } = cell_center(w, row, col)
                    let dx = x - cx
                    let dy = y - cy
                    if dx * dx + dy * dy < collide_d2 then
                        hit = true
    hit

// The empty cell nearest the shot that something could actually hold onto:
// row 0 hangs from the ceiling, anything else needs an occupied neighbour.
// Nearest-attachable is more forgiving than snapping to the cell the shot
// happens to be standing in, and it can never pick a floating cell.
let settle_cell = (w: world*) ->
    let mut best = -1
    let mut best_d = 1000000000.0
    for row in 0..grid_rows do
        let rc = row_cols(w, row)
        for col in 0..rc do
            if w.grid[cell_index(row, col)] < 0 then
                let mut attach = row == 0
                for k in 0..6 do
                    if !attach then
                        let { nr, nc } = neighbor(w, row, col, k)
                        if cell_get(w, nr, nc) >= 0 then
                            attach = true
                if attach then
                    let { cx, cy } = cell_center(w, row, col)
                    let dx = w.shot.x - cx
                    let dy = w.shot.y - cy
                    let d = dx * dx + dy * dy
                    if d < best_d then
                        best_d = d
                        best = cell_index(row, col)
    best

// A queued colour that has left the board is a dud shot, so it gets swapped
// out. A metal shot is never a dud — it needs nothing to match — so it is
// exempt from the check rather than being quietly thrown away.
let refresh_queue = (w: world*, rng: pcg_random*) ->
    if w.game.cur_color != shot_metal && !color_in_play(w, w.game.cur_color) then
        w.game.cur_color = pick_shot_color(w, rng)
    if w.game.next_color != shot_metal && !color_in_play(w, w.game.next_color) then
        w.game.next_color = pick_shot_color(w, rng)

// Marks every cell holding `color`, plus the stars that set them off, and
// pops the lot. This is the star's whole trick: it ignores adjacency, so a
// single bubble against a star takes its entire colour off the board.
let star_burst = (w: world*, rng: pcg_random*, color: i32) ->
    for i in 0..grid_cells do
        w.mark[i] = 0
    for row in 0..grid_rows do
        let rc = row_cols(w, row)
        for col in 0..rc do
            let ci = cell_index(row, col)
            if w.grid[ci] == color || w.grid[ci] == cell_star then
                w.mark[ci] = 1
    clear_marked(w, rng)

// Shared tail of a turn. A bubble that lands and a metal shot that ploughs
// straight through both end up here: bank the points, run the countdown down
// one, and see what the board has become.
let finish_turn = (w: world*, rng: pcg_random*, s: opl_audio.audio*,
                   gained: i32, px: i32, py: i32) ->
    if gained > 0 then
        w.game.score = w.game.score + gained
        w.game.popup_val = gained
        w.game.popup_x = px
        w.game.popup_y = py - 30
        w.game.popup_timer = 75

    // The countdown runs on shots landed, full stop. A pop pays in points,
    // not in time — the ceiling is a metronome, not a penalty for missing.
    w.game.shots_left = w.game.shots_left - 1
    // That pop may also have taken a colour off the board, which shortens
    // the fuse from here on.
    refresh_drop_interval(w)

    if w.game.shots_left <= 0 then
        if count_bubbles(w) > 0 then
            descend(w, rng)
            // The new row can reintroduce a colour and slacken the fuse.
            refresh_drop_interval(w)
            opl_audio.play(s, snd.sfx_descend)
        w.game.shots_left = w.game.drop_interval

    if count_bubbles(w) == 0 then
        w.game.bonus_paid = clear_bonus(w.game.level_frames)
        w.game.score = w.game.score + 500 * w.game.level + w.game.bonus_paid
        w.game.phase = game_phase.level_clear
        w.game.phase_timer = 120
        opl_audio.play(s, snd.sfx_clear)
    else if deepest_row(w) >= death_row then
        w.game.phase = game_phase.game_over
        w.game.phase_timer = 0
        // The tune stops here rather than playing over the run's own
        // ending; `music_end` also rewinds, so the next game opens on
        // the first bar instead of wherever this one happened to die.
        opl_audio.music_end(s)
        opl_audio.play(s, snd.sfx_over)
    else
        refresh_queue(w, rng)

let land_shot = (w: world*, rng: pcg_random*, s: opl_audio.audio*) ->
    w.shot.active = false
    let idx = settle_cell(w)
    if idx < 0 then
        return
    let row = idx / grid_cols
    let col = idx % grid_cols
    w.grid[idx] = w.shot.color

    // A star next door fires first, and it does not care how big the cluster
    // is — that is what makes a star worth aiming at rather than around.
    let mut hit_star = false
    for k in 0..6 do
        let { nr, nc } = neighbor(w, row, col, k)
        if cell_get(w, nr, nc) == cell_star then
            hit_star = true

    let mut gained = 0
    if hit_star then
        let popped = star_burst(w, rng, w.shot.color)
        gained = popped * 10
        let dropped = drop_floaters(w, rng)
        gained = gained + drop_score(dropped)
        // Two voices, both heard: the star's own sparkle, and the
        // glissando of whatever it cut loose on the way.
        opl_audio.play(s, snd.sfx_star)
        if dropped > 0 then
            opl_audio.play(s, snd.sfx_drop)
    else
        let cluster = flood_same_color(w, row, col)
        if cluster >= 3 then
            let popped = clear_marked(w, rng)
            gained = popped * 10
            let dropped = drop_floaters(w, rng)
            opl_audio.play(s, snd.sfx_pop)
            if dropped > 0 then
                gained = gained + drop_score(dropped)
                opl_audio.play(s, snd.sfx_drop)
        else
            opl_audio.play(s, snd.sfx_stick)

    let { px, py } = cell_center(w, row, col)
    finish_turn(w, rng, s, gained, (i32) px, (i32) py)

// Everything the metal shot is currently touching, gone. Stones shrug it
// off — indestructible has to mean indestructible or it means nothing — so
// the metal passes through them without either one stopping.
let metal_smash = (w: world*, rng: pcg_random*, x: f64, y: f64) ->
    let mut popped = 0
    for row in 0..grid_rows do
        let rc = row_cols(w, row)
        for col in 0..rc do
            let ci = cell_index(row, col)
            if w.grid[ci] >= 0 && w.grid[ci] != cell_stone then
                let { cx, cy } = cell_center(w, row, col)
                let dx = x - cx
                let dy = y - cy
                if dx * dx + dy * dy < collide_d2 then
                    let { pr, pg, pb } = cell_rgb(w.grid[ci])
                    spawn_burst(w, rng, cx, cy, 12, pr, pg, pb)
                    w.grid[ci] = -1
                    popped = popped + 1
    popped

// The metal shot's whole flight: it never settles, so it is resolved when it
// runs out of board rather than when it touches something.
let update_metal = (w: world*, rng: pcg_random*, s: opl_audio.audio*) ->
    let mut gained = 0
    for step in 0..shot_substeps do
        if !w.shot.active then break
        w.shot.x = w.shot.x + w.shot.vx
        w.shot.y = w.shot.y + w.shot.vy

        let left = (f64) (field_x0 + bubble_r)
        let right = (f64) (field_x1 - bubble_r)
        if w.shot.x < left then
            w.shot.x = left
            w.shot.vx = -w.shot.vx
            spawn_burst(w, rng, w.shot.x - 6.0, w.shot.y, 3, 220u8, 240u8, 255u8)
            opl_audio.play(s, snd.sfx_bounce)
        if w.shot.x > right then
            w.shot.x = right
            w.shot.vx = -w.shot.vx
            spawn_burst(w, rng, w.shot.x + 6.0, w.shot.y, 3, 220u8, 240u8, 255u8)
            opl_audio.play(s, snd.sfx_bounce)

        let popped = metal_smash(w, rng, w.shot.x, w.shot.y)
        if popped > 0 then
            gained = gained + popped * 10
            opl_audio.play(s, snd.sfx_pop)

        if w.shot.y - (f64) bubble_r <= (f64) ceiling_y then
            w.shot.active = false

    if !w.shot.active then
        let px = (i32) w.shot.x
        let py = (i32) w.shot.y
        let dropped = drop_floaters(w, rng)
        if dropped > 0 then
            gained = gained + drop_score(dropped)
            opl_audio.play(s, snd.sfx_drop)
        finish_turn(w, rng, s, gained, px, py)

let update_shot = (w: world*, rng: pcg_random*, s: opl_audio.audio*) ->
    if !w.shot.active then
        return
    if w.shot.color == shot_metal then
        update_metal(w, rng, s)
        return
    for step in 0..shot_substeps do
        if !w.shot.active then break
        w.shot.x = w.shot.x + w.shot.vx
        w.shot.y = w.shot.y + w.shot.vy

        let left = (f64) (field_x0 + bubble_r)
        let right = (f64) (field_x1 - bubble_r)
        if w.shot.x < left then
            w.shot.x = left
            w.shot.vx = -w.shot.vx
            spawn_burst(w, rng, w.shot.x - 6.0, w.shot.y, 3, 220u8, 240u8, 255u8)
            opl_audio.play(s, snd.sfx_bounce)
        if w.shot.x > right then
            w.shot.x = right
            w.shot.vx = -w.shot.vx
            spawn_burst(w, rng, w.shot.x + 6.0, w.shot.y, 3, 220u8, 240u8, 255u8)
            opl_audio.play(s, snd.sfx_bounce)

        if w.shot.y - (f64) bubble_r <= (f64) ceiling_y then
            w.shot.y = (f64) (ceiling_y + bubble_r)
            land_shot(w, rng, s)
        else if hits_bubble(w, w.shot.x, w.shot.y) then
            land_shot(w, rng, s)
        else if w.shot.y > (f64) (field_y1 + 40) then
            // Belt and braces: a shot can only travel upward, but never let
            // one escape the field and hang the turn.
            w.shot.active = false

let fire = (w: world*, rng: pcg_random*, s: opl_audio.audio*) ->
    if w.shot.active then
        return
    let a = deg2rad(w.game.angle)
    let per_step = shot_speed / (f64) shot_substeps
    w.shot.x = (f64) shooter_x
    w.shot.y = (f64) shooter_y
    w.shot.vx = math.sin(a) * per_step
    w.shot.vy = -math.cos(a) * per_step
    w.shot.color = w.game.cur_color
    w.shot.active = true
    w.game.cur_color = w.game.next_color
    w.game.next_color = pick_launcher(w, rng)
    w.game.shots_fired = w.game.shots_fired + 1
    w.game.idle_timer = 0
    opl_audio.play(s, snd.sfx_shoot)

// ============================================================
// Round setup
// ============================================================

let start_level = (w: world*, rng: pcg_random*) ->
    w.shot.active = false
    clear_fallers(w)
    build_level(w, rng)
    w.game.drop_interval = drop_interval_for(count_colors_in_play(w))
    w.game.shots_left = w.game.drop_interval
    w.game.cur_color = pick_launcher(w, rng)
    w.game.next_color = pick_launcher(w, rng)
    w.game.angle = 0.0
    w.game.idle_timer = 0
    w.game.level_frames = 0
    w.game.popup_timer = 0
    w.game.phase = game_phase.playing
    w.game.phase_timer = 0

let reset_game = (w: world*, rng: pcg_random*) ->
    w.game.level = 1
    w.game.score = 0
    w.game.new_high = false
    w.game.shots_fired = 0
    clear_particles(w)
    start_level(w, rng)

// ============================================================
// High score persistence
// ============================================================

let load_high_score = () ->
    match sys.home_dir() with
    | some(hd) ->
        match io.open(alloca("%s{hd}/.fuzzel-fobble/highscore.txt"), "r") with
        | ok(fp) ->
            let mut buf = u8[32] { }
            let n = io.read(buf, 32, fp)
            ignore io.close(fp)  // best-effort: contents already read
            match text.parse_i32(text.trim((const str) buf[0..n])) with
            | ok(v) -> v
            | err(_) -> 0
        | err(_) -> 0
    | none -> 0

let save_high_score = (score: i32) ->
    match sys.home_dir() with
    | some(hd) ->
        ignore io.mkdir(alloca("%s{hd}/.fuzzel-fobble"))  // may already exist
        match io.open(alloca("%s{hd}/.fuzzel-fobble/highscore.txt"), "w") with
        | ok(fp) ->
            io.write("%d{score}\n", fp)
            ignore io.close(fp)  // best-effort: a lost high score is not an error
            return
        | err(_) -> return
    | none -> return

// ============================================================
// Playfield rendering
// ============================================================

let draw_field_bg = () ->
    // Vertical gradient, deep at the top and warmer near the launcher.
    for band in 0..24 do
        let h = (field_y1 - field_y0) / 24
        let y = field_y0 + band * h
        let v = (u8) (10 + band / 2)
        fill(field_x0, y, field_x1 - field_x0, h + 1,
             v, (u8) (v + 8u8), (u8) (v + 26u8), 255u8)

    // Faint column guides through the raft zone — a nod to the grid the
    // bubbles snap to, and a sighting aid for long bank shots.
    for col in 0..grid_cols do
        let x = field_x0 + col * bubble_d
        fill(x, ceiling_y, 1, danger_y - ceiling_y, 255u8, 255u8, 255u8, 7u8)

let draw_grid = (w: world*) ->
    for row in 0..grid_rows do
        let rc = row_cols(w, row)
        for col in 0..rc do
            let c = w.grid[cell_index(row, col)]
            if c >= 0 then
                let { cx, cy } = cell_center(w, row, col)
                draw_bubble((i32) cx, (i32) cy, c, 255u8, w.game.show_symbols)

let draw_ceiling = () ->
    // Steel bar the raft hangs from, drawn over the top row so the bubbles
    // look like they are gripping its underside.
    fill(field_x0, field_y0, field_x1 - field_x0, ceiling_y - field_y0,
         64u8, 74u8, 104u8, 255u8)
    fill(field_x0, field_y0, field_x1 - field_x0, 3, 128u8, 148u8, 190u8, 255u8)
    fill(field_x0, ceiling_y - 3, field_x1 - field_x0, 3, 26u8, 30u8, 48u8, 255u8)
    let mut x = field_x0 + 12
    loop
        if x > field_x1 - 16 then break
        fill(x, field_y0 + 4, 4, 4, 150u8, 170u8, 210u8, 255u8)
        x = x + 32

let draw_danger_line = (w: world*, frame: i32) ->
    let deep = deepest_row(w)
    let close = deep >= death_row - 2
    let pulse = if close then (i32) (math.sin((f64) frame * 0.16) * 60.0 + 130.0)
                else 60
    let a = (u8) imax(imin(pulse, 255), 0)
    // Dashed warning line
    let mut x = field_x0 + 4
    loop
        if x > field_x1 - 10 then break
        fill(x, danger_y, 12, 3, 255u8, 70u8, 70u8, a)
        x = x + 22
    if close then
        fill(field_x0, danger_y + 3, field_x1 - field_x0, 40,
             255u8, 40u8, 40u8, amul(a, 12))

let draw_launcher = (w: world*, frame: i32) ->
    let a = deg2rad(w.game.angle)
    let dx = math.sin(a)
    let dy = -math.cos(a)
    let fx = (f64) shooter_x
    let fy = (f64) shooter_y

    // Barrel — long enough to read past the bubble sitting in the chamber
    thick_line(fx - dx * 8.0, fy - dy * 8.0, fx + dx * 68.0, fy + dy * 68.0,
               18, 44u8, 52u8, 78u8, 255u8)
    thick_line(fx - dx * 8.0, fy - dy * 8.0, fx + dx * 64.0, fy + dy * 64.0,
               10, 150u8, 175u8, 215u8, 255u8)
    // Muzzle ring
    disc((i32) (fx + dx * 64.0), (i32) (fy + dy * 64.0), 9,
         200u8, 220u8, 255u8, 255u8)

    // Turret base
    disc(shooter_x, shooter_y, 34, 40u8, 48u8, 72u8, 255u8)
    disc(shooter_x, shooter_y, 30, 62u8, 74u8, 108u8, 255u8)
    // Rotating trim so the launcher never looks frozen
    for i in 0..8 do
        let t = (f64) i * 0.7853981 + (f64) frame * 0.01
        let px = fx + math.cos(t) * 32.0
        let py = fy + math.sin(t) * 32.0
        fill((i32) px - 2, (i32) py - 2, 4, 4, 140u8, 170u8, 220u8, 200u8)

    // The bubble sitting in the chamber
    if !w.shot.active then
        draw_bubble(shooter_x, shooter_y, w.game.cur_color, 255u8, w.game.show_symbols)

// Walks the shot's path — bounces and all — and dots it out. Reuses the
// live collision test, so the guide can never disagree with the physics.
let draw_aim_guide = (w: world*) ->
    if w.shot.active then
        return
    let a = deg2rad(w.game.angle)
    let mut x = (f64) shooter_x
    let mut y = (f64) shooter_y
    let mut vx = math.sin(a) * 9.0
    let mut vy = -math.cos(a) * 9.0
    let { gr, gg, gb } = cell_rgb(w.game.cur_color)
    let plough = w.game.cur_color == shot_metal
    let left = (f64) (field_x0 + bubble_r)
    let right = (f64) (field_x1 - bubble_r)

    for i in 0..96 do
        x = x + vx
        y = y + vy
        if x < left then
            x = left
            vx = -vx
        if x > right then
            x = right
            vx = -vx
        if y - (f64) bubble_r <= (f64) ceiling_y then
            break
        if !plough && hits_bubble(w, x, y) then
            break
        if i % 3 == 0 then
            let fade = 190 - i * 2
            if fade > 20 then
                disc((i32) x, (i32) y, 4, gr, gg, gb, (u8) fade)

let draw_shot = (w: world*) ->
    if w.shot.active then
        draw_bubble((i32) w.shot.x, (i32) w.shot.y, w.shot.color, 255u8,
                    w.game.show_symbols)

// The turn clock made visible: it says nothing until the launcher starts to
// lose patience, then blinks, then blinks twice as fast for the last stretch
// before it fires on its own.
let draw_hurry = (w: world*) ->
    if w.shot.active || w.game.idle_timer < hurry_warn then
        return
    let urgent = w.game.idle_timer > (hurry_warn + hurry_fire) / 2
    let span = if urgent then 7 else 15
    if (w.game.idle_timer / span) % 2 == 0 then
        let g = if urgent then 70 else 160
        draw_text_centered("HURRY!", 640, 556, 6, 255u8, (u8) g, 70u8)

let draw_popup = (w: world*) ->
    if w.game.popup_timer > 0 then
        let rise = (75 - w.game.popup_timer) / 3
        let s = "+%d{w.game.popup_val}"
        let a = if w.game.popup_timer > 20 then 255 else w.game.popup_timer * 12
        draw_text_centered((const str) s, w.game.popup_x, w.game.popup_y - rise, 4,
                           255u8, (u8) imin(a, 255), 120u8)

// ============================================================
// HUD panels
// ============================================================

let draw_panel_bg = () ->
    fill(0, 0, field_x0, logical_h, 14u8, 16u8, 32u8, 255u8)
    fill(field_x1, 0, logical_w - field_x1, logical_h, 14u8, 16u8, 32u8, 255u8)
    fill(field_x0 - 4, 0, 4, logical_h, 90u8, 130u8, 200u8, 255u8)
    fill(field_x1, 0, 4, logical_h, 90u8, 130u8, 200u8, 255u8)

let draw_label_value = (label: const str, value: const str,
                        x: i32, y: i32, vr: u8, vg: u8, vb: u8) ->
    draw_text(label, x, y, 3, 110u8, 150u8, 210u8)
    draw_text(value, x, y + 26, 5, vr, vg, vb)

let draw_hud = (w: world*) ->
    // --- Left panel: identity and score ---
    draw_text("FUZZEL", 40, 40, 7, 120u8, 220u8, 255u8)
    draw_text("FOBBLE", 40, 100, 7, 255u8, 130u8, 190u8)
    fill(40, 160, 260, 3, 70u8, 90u8, 140u8, 255u8)

    let score_str = "%d{w.game.score}"
    draw_label_value("SCORE", (const str) score_str, 40, 200,
                     255u8, 255u8, 255u8)
    let high_str = "%d{w.game.high_score}"
    draw_label_value("BEST", (const str) high_str, 40, 300,
                     255u8, 230u8, 110u8)
    let level_str = "%d{w.game.level}"
    draw_label_value("LEVEL", (const str) level_str, 40, 400,
                     150u8, 255u8, 190u8)
    let shots_str = "%d{w.game.shots_fired}"
    draw_label_value("SHOTS", (const str) shots_str, 40, 500,
                     190u8, 200u8, 230u8)
    // Visible and falling, so the reward for clearing quickly is something
    // you can watch yourself spending.
    let bonus = clear_bonus(w.game.level_frames)
    let bonus_str = "%d{bonus}"
    let bg = if bonus > 0 then 190 else 90
    draw_label_value("BONUS", (const str) bonus_str, 40, 600,
                     255u8, (u8) bg, 90u8)

    // --- Right panel: what's coming, and how long you have ---
    let rx = field_x1 + 40
    draw_text("NEXT", rx, 200, 3, 110u8, 150u8, 210u8)
    disc(rx + 44, 262, 34, 26u8, 30u8, 52u8, 255u8)
    draw_bubble(rx + 44, 262, w.game.next_color, 255u8, w.game.show_symbols)

    draw_text("DROP IN", rx, 340, 3, 110u8, 150u8, 210u8)
    // One pip per shot left before the ceiling grinds down.
    for i in 0..w.game.shots_left do
        let px = rx + (i % 6) * 32
        let py = 372 + (i / 6) * 32
        disc(px + 10, py + 10, 9, 120u8, 200u8, 255u8, 230u8)
    let left_str = "%d{w.game.shots_left}"
    draw_text((const str) left_str, rx, 440, 4, 200u8, 220u8, 255u8)

    // --- Right panel: controls ---
    draw_text("ARROWS AIM", rx, 520, 2, 100u8, 120u8, 170u8)
    draw_text("SPACE FIRE", rx, 546, 2, 100u8, 120u8, 170u8)
    draw_text("TAB SWAP", rx, 572, 2, 100u8, 120u8, 170u8)
    draw_text("P PAUSE", rx, 598, 2, 100u8, 120u8, 170u8)
    draw_text("S MARKS", rx, 624, 2, 100u8, 120u8, 170u8)
    draw_text("ESC QUIT", rx, 650, 2, 100u8, 120u8, 170u8)

// ============================================================
// Overlays
// ============================================================

let draw_splash = (frame: i32) ->
    fill(field_x0, 0, field_x1 - field_x0, logical_h, 0u8, 0u8, 0u8, 190u8)

    // An arc of bubbles bobbing above the title
    for i in 0..6 do
        let t = (f64) frame * 0.04 + (f64) i * 0.9
        let x = field_x0 + 74 + i * 86
        let y = 190 + (i32) (math.sin(t) * 14.0)
        draw_bubble(x, y, i, 255u8, true)

    draw_text_centered("FUZZEL", 640, 260, 11, 120u8, 220u8, 255u8)
    draw_text_centered("FOBBLE", 640, 340, 11, 255u8, 130u8, 190u8)

    draw_text_centered("MATCH THREE TO POP", 640, 440, 3, 200u8, 215u8, 240u8)
    draw_text_centered("CUT THEM LOOSE TO SCORE", 640, 472, 3, 200u8, 215u8, 240u8)

    let blink = (frame / 26) % 2 == 0
    if blink then
        draw_text_centered("PRESS ENTER", 640, 560, 5, 255u8, 230u8, 80u8)
    draw_text_centered("C CLEARS BEST", 640, 630, 2, 110u8, 130u8, 180u8)

let draw_paused = () ->
    fill(field_x0, 300, field_x1 - field_x0, 120, 0u8, 0u8, 0u8, 190u8)
    draw_text_centered("PAUSED", 640, 330, 7, 255u8, 255u8, 255u8)

let draw_level_clear = (w: world*) ->
    fill(field_x0, 280, field_x1 - field_x0, 180, 0u8, 0u8, 0u8, 190u8)
    draw_text_centered("CLEAR.", 640, 310, 8, 130u8, 255u8, 180u8)
    if w.game.bonus_paid > 0 then
        let b = "SPEED BONUS %d{w.game.bonus_paid}"
        draw_text_centered((const str) b, 640, 372, 3, 255u8, 200u8, 90u8)
    let nxt = "LEVEL %d{w.game.level + 1}"
    draw_text_centered((const str) nxt, 640, 408, 4, 255u8, 255u8, 255u8)
    // Losing the guide without warning reads as a glitch rather than a rule.
    if w.game.level == guide_levels then
        draw_text_centered("AIM GUIDE OFF FROM HERE", 640, 436, 2,
                           255u8, 180u8, 90u8)

let draw_game_over = (w: world*) ->
    fill(field_x0, 250, field_x1 - field_x0, 240, 0u8, 0u8, 0u8, 200u8)
    draw_text_centered("GAME", 640, 280, 9, 255u8, 100u8, 100u8)
    draw_text_centered("OVER", 640, 350, 9, 255u8, 100u8, 100u8)
    if w.game.new_high then
        draw_text_centered("NEW BEST.", 640, 424, 4, 255u8, 230u8, 80u8)
    draw_text_centered("ENTER TO RETRY", 640, 460, 3, 200u8, 200u8, 220u8)

// ============================================================
// Per-frame render
// ============================================================

// Draws one frame of the game at logical size. The caller has already
// pointed raylib at the off-screen target; `present` below puts it on the
// window. Alpha blending is raylib's default state, so unlike the SDL2
// build there is no blend mode to set and unset around the clear.
let render = (w: world*, frame: i32) ->
    raylib.clear_background(rgba(8u8, 10u8, 24u8, 255u8))

    draw_field_bg()
    draw_drifters(w)
    draw_danger_line(w, frame)

    // The launcher is part of the machine and stays put whenever a board is
    // in play; the aim guide belongs to the turn, so it only shows when the
    // turn is actually yours.
    let live = match w.game.phase with
    | splash -> false
    | _ -> true
    let your_turn = match w.game.phase with
    | playing -> true
    | _ -> false
    // And the guide is the tutorial. Level 1 draws the bounce for you so the
    // geometry is legible; after that, reading the angle is the skill.
    let aiming = your_turn && w.game.level <= guide_levels

    if aiming then
        draw_aim_guide(w)
    draw_grid(w)
    draw_ceiling()
    draw_fallers(w)
    if live then
        draw_launcher(w, frame)
        draw_shot(w)
    draw_particles(w)
    // The turn clock runs at every level, guide or no guide.
    if your_turn then
        draw_hurry(w)
    draw_popup(w)

    // Panels last: they own the strips outside the playfield, so nothing
    // that leaks sideways can survive into the HUD.
    draw_panel_bg()
    draw_hud(w)

    match w.game.phase with
    | splash -> draw_splash(frame)
    | paused -> draw_paused()
    | level_clear -> draw_level_clear(w)
    | game_over -> draw_game_over(w)
    | _ -> void()

// raylib: SDL_RenderSetLogicalSize has no counterpart here, so the
// letterbox is ours to compute. The game draws at 1280x720 into an
// off-screen target and this blits it, scaled by whichever axis runs out
// first and centred in what's left over — which is what SDL2's logical
// size does for free, in one call at renderer setup.
//
// Three traps, all paid for once:
//
//   * The source height is *negative* on purpose. An OpenGL framebuffer's
//     rows run bottom-up, and flipping the source rectangle is how raylib
//     says "read it the other way".
//   * The sizes come from screen_width/screen_height, which is the space
//     raylib's own draw calls are in. render_* is the framebuffer, and
//     the two part company under FLAG_WINDOW_HIGHDPI — see `main`.
//   * The blit runs in blend_premultiplied, not the default alpha blend,
//     because drawing into a render texture corrupts its alpha channel.
//     raylib's BLEND_ALPHA is glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA)
//     — not glBlendFuncSeparate — so the source alpha scales the *alpha*
//     channel as well as the colour. A 62%-opaque white (the bubble
//     specular) leaves that texel at alpha = 0.62^2 + 0.38 = 0.764 rather
//     than the 1.0 an opaque target should have, and blitting that back
//     with alpha blending multiplies its colour by 0.764: every
//     translucent thing in the frame comes out 24% too dark. Premultiplied
//     blending is glBlendFunc(GL_ONE, GL_ONE_MINUS_SRC_ALPHA), which drops
//     the alpha factor from the colour term — exactly right here, since
//     the target is cleared opaque and nothing under it shows through.
//     The SDL2 build has no intermediate texture and so never meets this.
let present = (target: raylib.render_texture) ->
    let sw = raylib.screen_width()
    let sh = raylib.screen_height()
    let scale = math.min((f64) sw / (f64) logical_w, (f64) sh / (f64) logical_h)
    let dw = (f32) (scale * (f64) logical_w)
    let dh = (f32) (scale * (f64) logical_h)

    raylib.begin_drawing()
    raylib.clear_background(rgba(0u8, 0u8, 0u8, 255u8))
    raylib.begin_blend_mode(raylib.blend_premultiplied)
    raylib.draw_texture_pro(target.texture,
        raylib.rect { x = 0.0f32, y = 0.0f32,
                      width = (f32) logical_w, height = -(f32) logical_h },
        raylib.rect { x = ((f32) sw - dw) * 0.5f32, y = ((f32) sh - dh) * 0.5f32,
                      width = dw, height = dh },
        raylib.vec2 { x = 0.0f32, y = 0.0f32 }, 0.0f32,
        rgba(255u8, 255u8, 255u8, 255u8))
    raylib.end_blend_mode()
    raylib.end_drawing()

// ============================================================
// Main
// ============================================================

// raylib: the audio callback's trampoline, and the one global the SDL2
// build does not need.
//
// raylib's AudioCallback is `void (*)(void *buffer, unsigned int frames)`
// — no userdata pointer — so the engine instance it drives cannot be
// passed in and has to be reachable from file scope. FC allows a mutable
// binding at file scope only in the entry-point file, which is why this
// sits in the game rather than in opl_audio.fc beside the SDL callback it
// mirrors. Written once in `main` before the device opens, read only by
// the audio thread after.
let mut audio_engine = default(any*)

// Runs on miniaudio's audio thread. `buffer` is in the *stream's* format —
// mono i16 at the engine's rate — and `frames` is whatever raylib's
// resampler wants this call, so there is no fixed block size to match.
// `render` is the same drain-then-fill the SDL2 callback does inline.
let audio_callback = (buffer: any*, frames: u32) ->
    let a = (opl_audio.audio*) audio_engine
    let out = i16[] { ptr = (i16*) buffer, len = (i64) frames }
    opl_audio.render(a, out, (i32) frames)

let main = (args: str[]) ->
    io.write("=== FUZZEL FOBBLE ===\n", stdout)
    io.write("A Puzzle Bobble clone in FC (raylib)\n\n", stdout)
    io.write("Controls:\n", stdout)
    io.write("  Left/Right  Aim\n", stdout)
    io.write("  SPACE       Fire\n", stdout)
    io.write("  ENTER       Start / restart\n", stdout)
    io.write("  TAB         Swap current and next bubble\n", stdout)
    io.write("  P           Pause\n", stdout)
    io.write("  S           Toggle colour marks\n", stdout)
    io.write("  M           Mute / unmute the music\n", stdout)
    io.write("  F11         Toggle fullscreen\n", stdout)
    io.write("  ESC         Quit\n", stdout)
    io.write("  C (splash)  Clear best score\n\n", stdout)

    // raylib narrates every load and unload on stdout; the game's own
    // output is more useful than the inventory.
    raylib.set_log_level(raylib.log_warning)

    // raylib: config flags are set *before* the window exists — there is
    // no window-vs-renderer split, so vsync is requested here rather than
    // at renderer creation the way the SDL2 build does.
    //
    // Deliberately *not* flag_highdpi, which the SDL2 build's counterpart
    // (SDL_WINDOW_ALLOW_HIGHDPI) does pass. On a 2x X11 desktop it makes
    // screen_width() report physical pixels while raylib's own projection
    // stays in logical ones, so every measurement taken from raylib
    // disagrees with the space raylib draws into by the DPI factor and the
    // letterbox below lands at twice its size. Without it the two agree,
    // and the render texture is upscaled by the compositor instead of by
    // us — softer on a HiDPI panel, but correct everywhere.
    raylib.set_config_flags(raylib.flag_vsync | raylib.flag_resizable)

    let initial_w = 960
    let initial_h = 540
    // One call: window, OpenGL context, 2D renderer and input. There is no
    // handle — raylib keeps all of it in globals, and the rest of this
    // file names none of it.
    raylib.init_window(initial_w, initial_h, c"Fuzzel Fobble")
    raylib.maximize_window()
    raylib.set_min_size(logical_w / 2, logical_h / 2)
    raylib.hide_cursor()

    // The logical-size target. Everything the game draws goes here at
    // 1280x720 and `present` scales it to the window; see `present` for
    // why the letterbox is hand-rolled.
    let target = raylib.load_render_texture(logical_w, logical_h)
    raylib.set_texture_filter(target.texture, raylib.filter_bilinear)

    // The size at window creation, not after the maximise: raylib's window
    // state calls are GLFW requests the window manager honours on some
    // later frame, where SDL_MaximizeWindow followed by
    // SDL_GetRendererOutputSize reads back the new size straight away.
    // Nothing depends on this — `present` re-measures every frame — but it
    // is why the number below is the one that was asked for.
    io.write("Window at startup: %d{raylib.screen_width()}x%d{raylib.screen_height()} (logical %d{logical_w}x%d{logical_h}, letterboxed per frame)\n",
             stdout)

    let mut rng = pcg_random.make((u64) sys.time())

    // The world and its heap-backed slices. game_state and shot live inline
    // in the struct and start zero-filled — alloc zero-fills.
    let w = alloc(world)!
    w.grid = alloc(i32[168] { })!
    w.mark = alloc(i32[168] { })!
    w.anchor = alloc(i32[168] { })!
    w.stack = alloc(i32[168] { })!
    w.fallers = alloc(faller[96] { })!
    w.particles = alloc(particle[256] { })!
    w.drifters = alloc(drifter[40] { })!

    // Audio. The engine generates samples on the audio thread, in raylib's
    // stream callback, at the sound card's rate — never in this loop. A
    // game loop that produced the samples would also be their clock, and
    // every frame that ran long or short would bend the music's pitch and
    // tempo audibly. Here a slow frame cannot reach the sound at all.
    //
    // What that costs is a second thread on the chips, and it is paid in
    // one place: the calls below post commands onto a lock-free ring that
    // the callback drains. Nothing here ever waits on the audio thread.
    //
    // raylib: `audio_engine` is published before the device opens, because
    // the callback starts reading it the moment the stream plays, and the
    // callback has no other way to find it.
    let s = snd.init(44100)
    audio_engine = (any*) s
    if !opl_audio.start(s, &audio_callback) then
        io.write("Audio: device open failed - running silent\n", stdout)
    opl_audio.music_begin(s)

    // Startup state. A real board is built immediately so the splash has
    // something to sit in front of.
    w.game.high_score = load_high_score()
    w.game.level = 1
    // The colour-blind marks are an aid, not the default look.
    w.game.show_symbols = false
    w.game.angle = 0.0
    start_level(w, &rng)
    w.game.phase = game_phase.splash
    init_drifters(w, &rng)

    let mut frame_count = 0

    loop
        // raylib: window close and the ESC key both land here — ESC is
        // raylib's default exit key — so this one call is the SDL2 build's
        // `running` flag, its SDL_QUIT arm and its ESC arm together. It
        // clears the close flag as it reads it, so it belongs in exactly
        // one place, once a frame.
        if raylib.window_should_close() then break
        frame_count = frame_count + 1

        // --------- Input ---------
        // raylib: no event loop. raylib latches the keyboard once, inside
        // end_drawing, and answers every query below from that latch — so
        // this is a flat list of questions about the current frame rather
        // than a drain over a queue of changes. The SDL2 build's bounded
        // 256-event drain, its keydown/keyup split, and the `event` struct
        // it polls into all have no counterpart here.
        //
        // What is lost is the queue's exactness: two presses of the same
        // key inside one frame read as one, where SDL2 would deliver both.
        // At 60 Hz that is not a distinction a player can make, and this
        // game has no rhythm input, so the trade is free here — it would
        // not be in a fighting game.

        // raylib: ToggleBorderlessWindowed is the whole of what the SDL2
        // build hand-rolls as get-display-bounds, unborder, move, resize.
        // It restores the previous geometry on the way back too, so unlike
        // the SDL2 build there is no `fullscreen` flag to keep — the
        // library remembers which way the toggle goes.
        if raylib.is_key_pressed(raylib.key_f11) then
            raylib.toggle_borderless()

        if raylib.is_key_pressed(raylib.key_space) then
            match w.game.phase with
            | playing -> fire(w, &rng, s)
            | splash ->
                reset_game(w, &rng)
                opl_audio.music_begin(s)
            | game_over ->
                reset_game(w, &rng)
                opl_audio.music_begin(s)
            | _ -> void()

        if raylib.is_key_pressed(raylib.key_enter) then
            match w.game.phase with
            | splash ->
                reset_game(w, &rng)
                opl_audio.music_begin(s)
            | game_over ->
                reset_game(w, &rng)
                opl_audio.music_begin(s)
            | _ -> void()

        if raylib.is_key_pressed(raylib.key_tab) then
            match w.game.phase with
            | playing ->
                if !w.shot.active then
                    let tmp = w.game.cur_color
                    w.game.cur_color = w.game.next_color
                    w.game.next_color = tmp
            | _ -> void()

        if raylib.is_key_pressed(raylib.key_p) then
            match w.game.phase with
            | playing ->
                w.game.phase = game_phase.paused
                // Hold, don't end: the tune picks up mid-phrase
                // where it left off.
                opl_audio.music_hold(s)
            | paused ->
                w.game.phase = game_phase.playing
                opl_audio.music_unhold(s)
            | _ -> void()

        if raylib.is_key_pressed(raylib.key_s) then
            w.game.show_symbols = !w.game.show_symbols

        if raylib.is_key_pressed(raylib.key_m) then
            opl_audio.music_toggle_mute(s)

        if raylib.is_key_pressed(raylib.key_c) then
            match w.game.phase with
            | splash ->
                w.game.high_score = 0
                match sys.home_dir() with
                | some(hd) ->
                    ignore io.remove(alloca("%s{hd}/.fuzzel-fobble/highscore.txt"))
                    void()
                | none -> void()
            | _ -> void()

        // --------- Update ---------
        update_drifters(w, &rng)
        update_particles(w)
        update_fallers(w)
        if w.game.popup_timer > 0 then
            w.game.popup_timer = w.game.popup_timer - 1

        match w.game.phase with
        | playing ->
            w.game.level_frames = w.game.level_frames + 1
            // raylib: asked of the latch, here, at the point of use. The
            // SDL2 build reads two bools it has been maintaining out of
            // keydown/keyup events since the last frame.
            if raylib.is_key_down(raylib.key_left) || raylib.is_key_down(raylib.key_a) then
                w.game.angle = w.game.angle - aim_speed
            if raylib.is_key_down(raylib.key_right) || raylib.is_key_down(raylib.key_d) then
                w.game.angle = w.game.angle + aim_speed
            if w.game.angle < -aim_limit then
                w.game.angle = -aim_limit
            if w.game.angle > aim_limit then
                w.game.angle = aim_limit
            update_shot(w, &rng, s)
            // The turn clock only runs while the shot is yours to take. Sit
            // on it long enough and the launcher fires wherever you left it
            // aimed — deliberating is a cost, not a free action.
            if w.shot.active then
                w.game.idle_timer = 0
            else
                w.game.idle_timer = w.game.idle_timer + 1
                if w.game.idle_timer >= hurry_fire then
                    fire(w, &rng, s)
        | level_clear ->
            w.game.phase_timer = w.game.phase_timer - 1
            if w.game.phase_timer <= 0 then
                w.game.level = w.game.level + 1
                start_level(w, &rng)
                raylib.set_title(c"Fuzzel Fobble - Level %d{w.game.level}")
        | game_over ->
            // Lock in the best score exactly once on entering game_over.
            if w.game.phase_timer == 0 then
                w.game.phase_timer = 1
                if w.game.score > w.game.high_score then
                    w.game.high_score = w.game.score
                    w.game.new_high = true
                    save_high_score(w.game.score)
                    io.write("NEW BEST: %d{w.game.score}\n", stdout)
        | _ -> void()

        // --------- Render ---------
        // Two halves, where the SDL2 build has one: the game draws into
        // the logical-size target, then `present` scales that onto the
        // window. end_drawing (inside `present`) is also where raylib
        // swaps buffers, waits out vsync and re-latches the keyboard, so
        // there is no sleep to add here — the SDL2 build's SDL_Delay(1)
        // safety net is end_drawing's job.
        raylib.begin_texture_mode(target)
        render(w, frame_count)
        raylib.end_texture_mode()
        present(target)

    io.write("Final score: %d{w.game.score} (level %d{w.game.level})\n", stdout)

    // Deliberately no CloseAudioDevice and nothing freed out of the audio
    // engine: closing the device *joins* the audio callback thread, and a
    // host audio server that has wedged that thread makes the join - and
    // the exiting game - hang forever. The process is ending; the kernel
    // reaps the thread, the device and the memory. See `shutdown_note` at
    // the foot of demos/shared/opl_audio.fc.
    //
    // The window we do tear down: that is video, which an audio wedge
    // cannot block, and it closes the window cleanly. raylib's CloseWindow
    // does not touch the audio device.
    raylib.unload_render_texture(target)
    raylib.close_window()
    0
