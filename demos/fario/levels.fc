// Fario — the eight worlds, as plain text.
//
// Each level is fifteen strings, one per screen row, top to bottom; each
// character is one 48x48 tile. The view is fifteen tiles tall exactly, so a
// map never scrolls vertically — only its width varies. Rows may differ in
// length; anything past the end of a row is air. Edit these directly: the
// maps are the level editor.
//
// Tiles:
//   .  air                      B  brick (breaks when big)
//   #  terrain block            ?  block: coin
//   x  hard block               M  block: mushroom (flower when big)
//   C  coin                     S  block: star
//   =  platform block           1  block: 1-up
//   ( )  pipe caps              [ ]  pipe body
//   _  bridge plank (castles; collapses after the axe)
//   L  lava (kills)             ^  spikes / urchins (hurt)
//   F  flagpole                 A  the axe (ends a castle)
//   D  door (decoration)        *  checkpoint (invisible)
//
// Creatures (the tile becomes air; the spot becomes a spawn):
//   g  grumble      t  snapper      k  prickle (no stomping)
//   f  finn (water) j  jelly        v  chomper (above a pipe cap)
//   r  firebar anchor (becomes a hard block with a firebar on it)
//   G  Gnarl, the usurper king (level 8's bridge)
//
// The design concepts here are the platform genre's own — question blocks,
// pipes, flagpoles, castle bridges, an underwater world — but every layout,
// name and creature is this game's. Nothing is traced.

// Which family of look and rules a level uses. `night` draws like overworld
// after dark; `water` swims.
enum theme =
    | overworld
    | underground
    | water
    | castle
    | night

// One level, as levels.get hands it out.
struct level_def =
    rows: const (const str)[]
    kind: theme
    time: i32          // the clock the level starts with, in timer units
    name: const str

module levels =
    let count = 8

