    // Level `n`, 1-based. Out of range clamps to the nearest end, so a save
    // file with a wild level number still loads *something* coherent.
    let get = (n: i32) ->
        match n with
        | 1 -> level_def { rows = l1, kind = theme.overworld, time = 400, name = "GREEN MEADOWS" }
        | 2 -> level_def { rows = l2, kind = theme.underground, time = 400, name = "UNDER THE ROOTS" }
        | 3 -> level_def { rows = l3, kind = theme.overworld, time = 400, name = "SKYHOP HILLS" }
        | 4 -> level_def { rows = l4, kind = theme.castle, time = 300, name = "STONEKEEP" }
        | 5 -> level_def { rows = l5, kind = theme.overworld, time = 400, name = "PIPE ALLEY" }
        | 6 -> level_def { rows = l6, kind = theme.water, time = 400, name = "TIDEPOOL" }
        | 7 -> level_def { rows = l7, kind = theme.night, time = 400, name = "STAR FIELDS" }
        | 8 -> level_def { rows = l8, kind = theme.castle, time = 300, name = "GNARLS KEEP" }
        | _ -> level_def { rows = l1, kind = theme.overworld, time = 400, name = "GREEN MEADOWS" }
