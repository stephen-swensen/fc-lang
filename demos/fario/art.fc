// Fario — the look.
//
// Everything the game puts on screen: the 3x5 font, the sprite sheets, the
// tiles, the parallax backdrops, the HUD, the overlays, and `render`.
//
// The sprites are pixel art kept *as text*: a sprite is an array of strings,
// one character per pixel, drawn at three logical pixels a cell — the same
// move the level maps make, and for the same reason: the art stays editable
// as art. The palette is one global table (`pal`), and a sprite can be
// re-suited — fire Fario's whites, the star's rainbow, the 1-up's green —
// by remapping characters rather than by owning a second copy of itself.
//
// It reads game.fc's world and draws on gfx's three primitives, names no
// library and holds no handle. Coordinates are logical 1280x720; world
// coordinates become screen ones by subtracting the camera here and nowhere
// else.

import * from game
import math from std::

module art =
    // ============================================================
    // 3x5 pixel font (bitmap packed into an i32: 5 rows of 3 bits)
    // ============================================================

    let glyph = (ch: u8) ->
        match ch with
        | 'A' -> 2 | (5 << 3) | (7 << 6) | (5 << 9) | (5 << 12)
        | 'B' -> 6 | (5 << 3) | (6 << 6) | (5 << 9) | (6 << 12)
        | 'C' -> 3 | (4 << 3) | (4 << 6) | (4 << 9) | (3 << 12)
        | 'D' -> 6 | (5 << 3) | (5 << 6) | (5 << 9) | (6 << 12)
        | 'E' -> 7 | (4 << 3) | (6 << 6) | (4 << 9) | (7 << 12)
        | 'F' -> 7 | (4 << 3) | (6 << 6) | (4 << 9) | (4 << 12)
        | 'G' -> 3 | (4 << 3) | (5 << 6) | (5 << 9) | (3 << 12)
        | 'H' -> 5 | (5 << 3) | (7 << 6) | (5 << 9) | (5 << 12)
        | 'I' -> 7 | (2 << 3) | (2 << 6) | (2 << 9) | (7 << 12)
        | 'J' -> 1 | (1 << 3) | (1 << 6) | (5 << 9) | (2 << 12)
        | 'K' -> 5 | (6 << 3) | (4 << 6) | (6 << 9) | (5 << 12)
        | 'L' -> 4 | (4 << 3) | (4 << 6) | (4 << 9) | (7 << 12)
        | 'M' -> 5 | (7 << 3) | (5 << 6) | (5 << 9) | (5 << 12)
        | 'N' -> 5 | (7 << 3) | (7 << 6) | (5 << 9) | (5 << 12)
        | 'O' -> 2 | (5 << 3) | (5 << 6) | (5 << 9) | (2 << 12)
        | 'P' -> 6 | (5 << 3) | (6 << 6) | (4 << 9) | (4 << 12)
        | 'Q' -> 2 | (5 << 3) | (5 << 6) | (6 << 9) | (3 << 12)
        | 'R' -> 6 | (5 << 3) | (6 << 6) | (5 << 9) | (5 << 12)
        | 'S' -> 3 | (4 << 3) | (2 << 6) | (1 << 9) | (6 << 12)
        | 'T' -> 7 | (2 << 3) | (2 << 6) | (2 << 9) | (2 << 12)
        | 'U' -> 5 | (5 << 3) | (5 << 6) | (5 << 9) | (2 << 12)
        | 'V' -> 5 | (5 << 3) | (5 << 6) | (2 << 9) | (2 << 12)
        | 'W' -> 5 | (5 << 3) | (7 << 6) | (7 << 9) | (5 << 12)
        | 'X' -> 5 | (5 << 3) | (2 << 6) | (5 << 9) | (5 << 12)
        | 'Y' -> 5 | (5 << 3) | (2 << 6) | (2 << 9) | (2 << 12)
        | 'Z' -> 7 | (1 << 3) | (2 << 6) | (4 << 9) | (7 << 12)
        | '0' -> 7 | (5 << 3) | (5 << 6) | (5 << 9) | (7 << 12)
        | '1' -> 2 | (6 << 3) | (2 << 6) | (2 << 9) | (7 << 12)
        | '2' -> 7 | (1 << 3) | (7 << 6) | (4 << 9) | (7 << 12)
        | '3' -> 7 | (1 << 3) | (3 << 6) | (1 << 9) | (7 << 12)
        | '4' -> 5 | (5 << 3) | (7 << 6) | (1 << 9) | (1 << 12)
        | '5' -> 7 | (4 << 3) | (7 << 6) | (1 << 9) | (7 << 12)
        | '6' -> 3 | (4 << 3) | (7 << 6) | (5 << 9) | (7 << 12)
        | '7' -> 7 | (1 << 3) | (1 << 6) | (1 << 9) | (1 << 12)
        | '8' -> 7 | (5 << 3) | (7 << 6) | (5 << 9) | (7 << 12)
        | '9' -> 7 | (5 << 3) | (7 << 6) | (1 << 9) | (6 << 12)
        | '+' -> 0 | (2 << 3) | (7 << 6) | (2 << 9) | (0 << 12)
        | '-' -> 0 | (0 << 3) | (7 << 6) | (0 << 9) | (0 << 12)
        | ':' -> 0 | (2 << 3) | (0 << 6) | (2 << 9) | (0 << 12)
        | '!' -> 2 | (2 << 3) | (2 << 6) | (0 << 9) | (2 << 12)
        | '.' -> 0 | (0 << 3) | (0 << 6) | (0 << 9) | (2 << 12)
        | '?' -> 6 | (1 << 3) | (2 << 6) | (0 << 9) | (2 << 12)
        | _ -> 0

    let draw_char = (ch: u8, ox: i32, oy: i32, scale: i32,
                     cr: u8, cg: u8, cb: u8) ->
        let g = glyph(ch)
        for row in 0..5 do
            let bits = (g >> (row * 3)) & 7
            for col in 0..3 do
                if (bits >> (2 - col)) & 1 == 1 then
                    gfx.fill(ox + col * scale, oy + row * scale, scale, scale,
                             cr, cg, cb, 255u8)

    let text_width = (s: const str, scale: i32) ->
        (i32) s.len * 4 * scale - scale

    let draw_text = (s: const str, ox: i32, oy: i32, scale: i32,
                     cr: u8, cg: u8, cb: u8) ->
        let mut x = ox
        for ch in s do
            if ch != ' ' then
                draw_char(ch, x, oy, scale, cr, cg, cb)
            x = x + 4 * scale

    let draw_text_centered = (s: const str, cx: i32, oy: i32, scale: i32,
                              cr: u8, cg: u8, cb: u8) ->
        let w = text_width(s, scale)
        draw_text(s, cx - w / 2, oy, scale, cr, cg, cb)

    // A number padded with leading zeros, the arcade way.
    let draw_number = (v: i32, digits: i32, ox: i32, oy: i32, scale: i32,
                       cr: u8, cg: u8, cb: u8) ->
        let mut n = 1
        let mut probe = v
        loop
            if probe < 10 then break
            probe = probe / 10
            n = n + 1
        let mut x = ox
        for i in 0..(digits - n) do
            draw_char('0', x, oy, scale, cr, cg, cb)
            x = x + 4 * scale
        let s = "%d{v}"
        draw_text((const str) s, x, oy, scale, cr, cg, cb)

    // ============================================================
    // The sprite palette
    //
    // One character, one colour, NES-bright. A sprite's "suit" remaps a few
    // characters before lookup — fire Fario, the star shimmer, the 1-up —
    // so one drawing serves several wearers.
    // ============================================================

    let suit_normal = 0
    let suit_fire = 1
    let suit_star_a = 2
    let suit_star_b = 3
    let suit_green = 4

    private let resuit = (suit: i32, ch: u8) ->
        if suit == suit_fire then
            match ch with
            | 'g' -> 'w'
            | 'G' -> 'e'
            | 'o' -> 'r'
            | 'O' -> 'R'
            | _ -> ch
        else if suit == suit_star_a then
            match ch with
            | 'g' -> 'y'
            | 'G' -> 'Y'
            | 'o' -> 'w'
            | 'O' -> 'e'
            | _ -> ch
        else if suit == suit_star_b then
            match ch with
            | 'g' -> 'p'
            | 'G' -> 'P'
            | 'o' -> 'y'
            | 'O' -> 'Y'
            | _ -> ch
        else if suit == suit_green then
            match ch with
            | 'r' -> 'g'
            | 'R' -> 'G'
            | _ -> ch
        else ch

    // The colour of one palette character. `a == 0` is transparent.
    private let pal = (ch: u8) ->
        match ch with
        | 'k' -> { 24u8, 20u8, 20u8, 255u8 }       // outline
        | 'w' -> { 252u8, 252u8, 252u8, 255u8 }
        | 's' -> { 252u8, 216u8, 168u8, 255u8 }    // skin
        | 'c' -> { 252u8, 236u8, 180u8, 255u8 }    // cream
        | 'r' -> { 216u8, 40u8, 0u8, 255u8 }
        | 'R' -> { 136u8, 16u8, 0u8, 255u8 }
        | 'o' -> { 240u8, 140u8, 32u8, 255u8 }
        | 'O' -> { 176u8, 80u8, 0u8, 255u8 }
        | 'y' -> { 248u8, 208u8, 56u8, 255u8 }
        | 'Y' -> { 168u8, 120u8, 0u8, 255u8 }
        | 'g' -> { 72u8, 200u8, 72u8, 255u8 }
        | 'G' -> { 0u8, 120u8, 32u8, 255u8 }
        | 'b' -> { 64u8, 120u8, 248u8, 255u8 }
        | 'B' -> { 16u8, 48u8, 152u8, 255u8 }
        | 'n' -> { 160u8, 96u8, 32u8, 255u8 }
        | 'N' -> { 96u8, 48u8, 8u8, 255u8 }
        | 'e' -> { 188u8, 188u8, 188u8, 255u8 }
        | 'E' -> { 96u8, 96u8, 96u8, 255u8 }
        | 'p' -> { 216u8, 96u8, 200u8, 255u8 }
        | 'P' -> { 128u8, 40u8, 120u8, 255u8 }
        | 't' -> { 0u8, 168u8, 168u8, 255u8 }
        | _ -> { 0u8, 0u8, 0u8, 0u8 }

    // Stamp a sprite: `cell` logical pixels per art pixel, mirrored when
    // `flip`, characters re-suited first. Rows may vary in width; short
    // rows simply end early.
    //
    // Runs, not pixels: consecutive cells of one colour become one rect.
    // Pixel art is mostly flat spans — a sprite row is typically two to
    // four runs, not sixteen pixels — so this is a 3-5x cut in quads for
    // identical output.
    let stamp = (rws: const (const str)[], px: i32, py: i32, cell: i32,
                 flip: bool, suit: i32) ->
        for row in 0i64..rws.len do
            let line = rws[row]
            let mut col = 0i64
            loop
                if col >= line.len then break
                let src = if flip then line[line.len - 1i64 - col] else line[col]
                let ch = resuit(suit, src)
                let { cr, cg, cb, ca } = pal(ch)
                if ca == 0u8 then
                    col = col + 1i64
                else
                    let mut run = 1i64
                    loop
                        let nxt = col + run
                        if nxt >= line.len then break
                        let s2 = if flip then line[line.len - 1i64 - nxt]
                                 else line[nxt]
                        if resuit(suit, s2) != ch then break
                        run = run + 1i64
                    gfx.fill(px + (i32) col * cell, py + (i32) row * cell,
                             cell * (i32) run, cell, cr, cg, cb, ca)
                    col = col + run

