// Fario — a side-scrolling platformer in FC, in the spirit of the NES
// classics: eight worlds of running, stomping, block-bumping, swimming and
// castle-storming, ending at a flagpole or an axe.
//
// Pure FC: no C helper files. Every sound is FM-synthesised on an emulated
// OPL2 (YM3812) — the music is four original tunes shipped as Standard MIDI
// Files (written by tools/mkmusic.fc, which is where they stay editable as
// music), and the effects are instruments in sound.fc next door. All of it
// plays through the shared engine in demos/shared/.
//
// The layers, bottom to top — fuzzel-fobble's architecture, minus the
// second backend (this demo is raylib only):
//
//     plat.fc      the contract: what input looks like, what `gfx` must be
//     gfx.fc       `module gfx` on raylib — the only file that names it
//     levels.fc    the eight maps, as editable text
//     game.fc      the rules. No pixels, no keys, no library.
//     art.fc       the look, drawn on gfx's three primitives
//     sound.fc     the effect instruments and scripts
//     main.fc      this file: hand the pieces to each other and loop

import opl_audio from shared::
import opl_midi from shared::
import opl_bank_gm from shared::
import io from std::
import sys from std::
import text from std::
import pcg_random from std::random

// The four tunes, one per family of level. Paths are relative to the
// repository root, which run.sh changes to.
let music_dir = "demos/fario/music"

// Which playlist entry a theme plays. Night is the overworld after dark and
// keeps its song; everything else has its own.
let tune_for = (k: theme) ->
    match k with
    | overworld -> 0
    | night -> 0
    | underground -> 1
    | water -> 2
    | castle -> 3

// Read and parse one Standard MIDI File. A file that will not load costs
// its tune and nothing else — the slot stays silent and the game plays on.
let load_song = (path: const str) ->
    let bytes = match io.read_all(path) with
                | ok(b) -> b
                | err(e) ->
                    io.write(alloca("Music: cannot read %s{path}\n"), stdout)
                    return none(opl_midi.song)
    defer free(bytes)
    match opl_midi.parse(bytes) with
    | ok(s) -> some(s)
    | err(e) ->
        io.write(alloca("Music: %s{path} is not a MIDI file this can play\n"), stdout)
        none(opl_midi.song)

let silent_song = () ->
    opl_midi.song { events = alloc(opl_midi.event[0] {})!,
                    division = 480, length = 0 }

// The whole playlist: overworld, underground, water, castle, in the order
// `tune_for` numbers them. A missing file leaves a silent slot rather than
// shifting its neighbours onto the wrong levels.
let open_music = () ->
    let names = (const str)[4] { "overworld", "underground", "water", "castle" }
    let songs = alloc(opl_midi.song[4] {})!
    for i in 0i64..4i64 do
        let path = alloc("%s{music_dir}/%s{names[i]}.mid")!
        defer free(path)
        songs[i] = match load_song((const str) path) with
                   | some(sg) ->
                       io.write(alloca("Music: %s{path}\n"), stdout)
                       sg
                   | none -> silent_song()
    songs[0i64..4i64]

// `--stats` prints a frame-time line every five seconds: the average and
// the worst frame of the window, in milliseconds. Under vsync at 60 Hz a
// healthy game averages ~16.7 with a worst not far above it; a worst that
// spikes past ~17 is a skipped frame you can go looking for.
let has_arg = (args: str[], flag: const str) ->
    let mut i = 1i64
    loop
        if i >= args.len then break
        if args[i] == flag then return true
        i = i + 1i64
    false

// `--level N` starts the run picker at world N — a practice door, and the
// debug door, in one flag. It unlocks the picker for this run only; the
// earned frontier in ~/.fario/progress.txt is untouched.
let arg_level = (args: str[]) ->
    let mut i = 1i64
    loop
        if i >= args.len then break
        if args[i] == "--level" && i + 1i64 < args.len then
            match text.parse_i32(args[i + 1i64]) with
            | ok(v) -> return v
            | err(e) -> return 0
        i = i + 1i64
    0

let main = (args: str[]) ->
    io.write("=== FARIO ===\n", stdout)
    io.write("A platformer in FC (raylib + OPL2)\n\n", stdout)
    io.write("Controls (the NES pad, on a keyboard):\n", stdout)
    io.write("  Left/Right   Move\n", stdout)
    io.write("  CTRL or X    A - jump / swim\n", stdout)
    io.write("  ALT or Z     B - run, and throw fire when armed\n", stdout)
    io.write("  SPACE        Select - pick a starting world on the title\n", stdout)
    io.write("  ENTER        Start - and pause, in play\n", stdout)
    io.write("  M            Mute / unmute the music\n", stdout)
    io.write("  S then 1-9   Save the game to that slot\n", stdout)
    io.write("  L then 1-9   Load the game in that slot\n", stdout)
    io.write("  F11          Fullscreen\n", stdout)
    io.write("  ESC          Quit\n\n", stdout)
    io.write("Saves, best score and progress live in ~/.fario/\n\n", stdout)

    gfx.open(game.logical_w, game.logical_h, c"Fario")

    let mut rng = pcg_random.make((u64) sys.time())
    let w = game.create(&rng)

    // A practice start, if asked for.
    let lvl = arg_level(args)
    if lvl >= 1 && lvl <= levels.count then
        w.game.select_level = lvl
        if lvl > w.game.max_level then w.game.max_level = lvl

    // Audio: the engine renders on the host's audio thread, in the device
    // callback; this loop only ever posts commands. See opl_audio.fc.
    let pl = open_music()
    let music = opl_midi.init(44100, pl[0], opl_bank_gm.make())
    let s = snd.init(44100, music)
    opl_audio.set_playlist(s, pl)
    if !gfx.audio_start(s) then
        io.write("Audio: device open failed - running silent\n", stdout)
    opl_audio.music_begin(s)

    let mut inp = default(input)
    let mut frame = 0

    // The tune and the title are window facts, so main watches the world
    // for the change rather than the game reaching out — same pattern as
    // the fuzzel-fobble playlist.
    let mut tune_now = tune_for(w.game.kind)
    let mut level_now = 0

    let stats = has_arg(args, "--stats")
    let mut stat_acc = 0.0
    let mut stat_max = 0.0
    let mut stat_n = 0

    loop
        gfx.pump(&inp)
        if inp.quit then break
        frame = frame + 1

        game.step(w, &inp, &rng, s)

        // Posted after game.step so a level change's music_begin lands
        // first and the select swaps the song under it.
        let want = tune_for(w.game.kind)
        if want != tune_now then
            opl_audio.music_select(s, want)
            tune_now = want
        if w.game.level != level_now then
            level_now = w.game.level
            gfx.set_title(c"Fario - World %d{level_now}")

        art.render(w, frame)

        if stats then
            let ms = (f64) gfx.frame_ms()
            stat_acc = stat_acc + ms
            if ms > stat_max then stat_max = ms
            stat_n = stat_n + 1
            if stat_n >= 300 then
                io.write("stats: avg %.2f{stat_acc / (f64) stat_n} ms, worst %.2f{stat_max} ms over %d{stat_n} frames\n",
                         stdout)
                stat_acc = 0.0
                stat_max = 0.0
                stat_n = 0

    io.write("Final score: %d{w.game.score} (world %d{w.game.level})\n", stdout)
    gfx.close()
    0
