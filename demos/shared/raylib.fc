namespace shared::

// raylib bindings for the FC demos — a hand-picked subset of <raylib.h>,
// not a complete binding. It is scoped to the same ground `sdl2.fc` covers,
// so the two can be compared on the same game: init and lifecycle, window
// management, 2D shape drawing, render textures (raylib's stand-in for
// SDL's logical size), keyboard input, timing, and a raw audio stream.
//
// raylib's own names are rebound to FC convention — DrawRectangle becomes
// draw_rect, FLAG_WINDOW_RESIZABLE becomes flag_resizable — so calling code
// reads as FC rather than as C with an accent. Unlike SDL, raylib keeps the
// window, the GL context and the draw state in file-scope globals of its
// own, so there is no renderer handle to thread through: the drawing calls
// below take no context argument, and neither do the demo's helpers.
//
// raylib passes and returns its small structs (color, vec2, rect) **by
// value** where SDL passes pointers to them. FC handles both — an extern
// struct is a C struct — but it is the single most visible difference in
// the call sites, so the structs come first.
//
// Add to this file when a demo needs something it doesn't yet bind. Because
// every demo compiles it as a source file, an unused binding costs nothing:
// FC emits externs only where they are referenced.
//
// The library itself is not in this repository — `demos/*/run.sh` downloads
// and builds raylib into `demos/shared/raylib/` on first run, and that
// directory is gitignored.
module raylib from "raylib.h" =
    // --- Extern structs ---
    // Every drawing call takes one of these by value.
    extern struct Color as color =
        r: u8
        g: u8
        b: u8
        a: u8

    extern struct Vector2 as vec2 =
        x: f32
        y: f32

    // Note the float fields: raylib's rect is a drawing rect, not SDL's
    // integer pixel rect. Only the render-texture blit needs one.
    extern struct Rectangle as rect =
        x: f32
        y: f32
        width: f32
        height: f32

    extern struct Texture as texture =
        id: u32
        width: i32
        height: i32
        mipmaps: i32
        format: i32

    // Returned by value from load_render_texture, and passed by value to
    // begin_texture_mode.
    extern struct RenderTexture as render_texture =
        id: u32
        texture: texture
        depth: texture

    // `buffer` and `processor` are opaque to us — miniaudio owns them.
    extern struct AudioStream as audio_stream =
        buffer: any*
        processor: any*
        sample_rate: u32
        sample_size: u32
        channels: u32

    // --- Config flags (set before init_window) ---
    extern FLAG_VSYNC_HINT as flag_vsync: u32
    extern FLAG_WINDOW_RESIZABLE as flag_resizable: u32
    extern FLAG_WINDOW_HIGHDPI as flag_highdpi: u32
    extern FLAG_WINDOW_MAXIMIZED as flag_maximized: u32
    extern FLAG_MSAA_4X_HINT as flag_msaa_4x: u32
    extern FLAG_BORDERLESS_WINDOWED_MODE as flag_borderless: u32

    // --- Log levels ---
    extern LOG_ALL as log_all: i32
    extern LOG_INFO as log_info: i32
    extern LOG_WARNING as log_warning: i32
    extern LOG_ERROR as log_error: i32
    extern LOG_NONE as log_none: i32

    // --- Texture filters ---
    extern TEXTURE_FILTER_POINT as filter_point: i32
    extern TEXTURE_FILTER_BILINEAR as filter_bilinear: i32

    // --- Blend modes ---
    extern BLEND_ALPHA as blend_alpha: i32
    extern BLEND_ALPHA_PREMULTIPLY as blend_premultiplied: i32

    // --- Keys ---
    // raylib key codes are the printable ASCII value for character keys and
    // GLFW's numbering above that, so there is no key/scancode split to pick
    // between the way SDL has.
    extern KEY_NULL as key_none: i32
    extern KEY_UP as key_up: i32
    extern KEY_DOWN as key_down: i32
    extern KEY_LEFT as key_left: i32
    extern KEY_RIGHT as key_right: i32
    extern KEY_ESCAPE as key_escape: i32
    extern KEY_SPACE as key_space: i32
    extern KEY_ENTER as key_enter: i32
    extern KEY_TAB as key_tab: i32
    extern KEY_LEFT_SHIFT as key_lshift: i32
    extern KEY_LEFT_CONTROL as key_lctrl: i32
    extern KEY_LEFT_ALT as key_lalt: i32
    extern KEY_PAGE_UP as key_pageup: i32
    extern KEY_PAGE_DOWN as key_pagedown: i32
    extern KEY_F11 as key_f11: i32
    extern KEY_A as key_a: i32
    extern KEY_C as key_c: i32
    extern KEY_D as key_d: i32
    extern KEY_H as key_h: i32
    extern KEY_M as key_m: i32
    extern KEY_P as key_p: i32
    extern KEY_S as key_s: i32
    extern KEY_V as key_v: i32
    extern KEY_W as key_w: i32
    extern KEY_X as key_x: i32
    extern KEY_Y as key_y: i32
    extern KEY_Z as key_z: i32
    extern KEY_ONE as key_1: i32
    extern KEY_TWO as key_2: i32
    extern KEY_THREE as key_3: i32
    extern KEY_FOUR as key_4: i32

    // --- Lifecycle ---
    // init_window creates the window, the GL context and the 2D renderer in
    // one call; there is no separate renderer object to create or destroy.
    extern InitWindow as init_window: (i32, i32, const cstr) -> void
    extern CloseWindow as close_window: () -> void
    extern WindowShouldClose as window_should_close: () -> bool
    extern SetConfigFlags as set_config_flags: (u32) -> void
    extern SetTraceLogLevel as set_log_level: (i32) -> void

    // --- Window ---
    extern SetWindowTitle as set_title: (const cstr) -> void
    extern SetWindowMinSize as set_min_size: (i32, i32) -> void
    extern ToggleBorderlessWindowed as toggle_borderless: () -> void
    extern MaximizeWindow as maximize_window: () -> void
    extern RestoreWindow as restore_window: () -> void
    extern GetScreenWidth as screen_width: () -> i32
    extern GetScreenHeight as screen_height: () -> i32
    extern GetRenderWidth as render_width: () -> i32
    extern GetRenderHeight as render_height: () -> i32
    extern GetCurrentMonitor as current_monitor: () -> i32
    extern GetMonitorWidth as monitor_width: (i32) -> i32
    extern GetMonitorHeight as monitor_height: (i32) -> i32
    extern HideCursor as hide_cursor: () -> void
    extern ShowCursor as show_cursor: () -> void

    // --- Frame ---
    extern BeginDrawing as begin_drawing: () -> void
    extern EndDrawing as end_drawing: () -> void
    extern ClearBackground as clear_background: (color) -> void
    extern SetTargetFPS as set_target_fps: (i32) -> void
    extern GetFrameTime as frame_time: () -> f32
    extern GetTime as time: () -> f64
    extern GetFPS as fps: () -> i32

    // --- Render textures ---
    // FC's stand-in for SDL_RenderSetLogicalSize: draw the game at a fixed
    // logical size into an off-screen target, then blit it scaled. raylib
    // has no logical-size mode of its own, so the letterbox is the demo's
    // to compute.
    extern LoadRenderTexture as load_render_texture: (i32, i32) -> render_texture
    extern UnloadRenderTexture as unload_render_texture: (render_texture) -> void
    extern BeginTextureMode as begin_texture_mode: (render_texture) -> void
    extern EndTextureMode as end_texture_mode: () -> void
    extern SetTextureFilter as set_texture_filter: (texture, i32) -> void
    extern DrawTexturePro as draw_texture_pro: (texture, rect, rect, vec2, f32, color) -> void

    // Blending. Anything that draws into a render texture needs this, for a
    // reason that is not obvious: raylib's default alpha blend is a plain
    // glBlendFunc, not the ...Separate variant, so it corrupts the target's
    // alpha channel. See `frame_end` in fuzzel-fobble's gfx_raylib.fc for the
    // full story and the one-line fix.
    extern BeginBlendMode as begin_blend_mode: (i32) -> void
    extern EndBlendMode as end_blend_mode: () -> void

    // --- 2D shapes ---
    // The reason a demo reaches for raylib: circles, thick lines and regular
    // polygons are primitives here, where SDL2's renderer has only points,
    // lines and axis-aligned rects.
    extern DrawPixel as draw_pixel: (i32, i32, color) -> void
    extern DrawLine as draw_line: (i32, i32, i32, i32, color) -> void
    extern DrawLineEx as draw_line_ex: (vec2, vec2, f32, color) -> void
    extern DrawRectangle as fill_rect: (i32, i32, i32, i32, color) -> void
    extern DrawRectangleLines as draw_rect: (i32, i32, i32, i32, color) -> void
    extern DrawCircle as fill_circle: (i32, i32, f32, color) -> void
    extern DrawCircleV as fill_circle_v: (vec2, f32, color) -> void
    extern DrawCircleLines as draw_circle: (i32, i32, f32, color) -> void
    extern DrawPoly as fill_poly: (vec2, i32, f32, f32, color) -> void
    extern DrawPolyLinesEx as draw_poly: (vec2, i32, f32, f32, f32, color) -> void
    extern DrawTriangle as fill_triangle: (vec2, vec2, vec2, color) -> void

    // --- Input ---
    // Polled, not queued: raylib latches the keyboard once per end_drawing
    // and answers these from the latch, so there is no event loop to drain
    // and no need to mirror key state in the game's own struct.
    extern IsKeyDown as is_key_down: (i32) -> bool
    extern IsKeyPressed as is_key_pressed: (i32) -> bool
    extern IsKeyReleased as is_key_released: (i32) -> bool
    extern SetExitKey as set_exit_key: (i32) -> void

    // --- Audio ---
    // A raw stream fed by a callback, the same shape SDL_OpenAudioDevice's
    // callback has — with one difference that matters: raylib's callback
    // signature is `void (*)(void *buffer, unsigned int frames)` and carries
    // **no userdata pointer**, so whatever state the callback needs has to
    // be reachable from file scope. See `opl_audio.fc`.
    //
    // The buffer handed to the callback is in the stream's own format (here
    // mono i16 at the engine's rate); raylib resamples to the device.
    extern InitAudioDevice as init_audio_device: () -> void
    extern IsAudioDeviceReady as is_audio_device_ready: () -> bool
    extern SetMasterVolume as set_master_volume: (f32) -> void
    extern LoadAudioStream as load_audio_stream: (u32, u32, u32) -> audio_stream
    extern IsAudioStreamValid as is_audio_stream_valid: (audio_stream) -> bool
    extern PlayAudioStream as play_audio_stream: (audio_stream) -> void
    extern PauseAudioStream as pause_audio_stream: (audio_stream) -> void
    extern ResumeAudioStream as resume_audio_stream: (audio_stream) -> void
    extern SetAudioStreamCallback as set_audio_stream_callback: (audio_stream, any*) -> void
    extern SetAudioStreamBufferSizeDefault as set_audio_buffer_size: (i32) -> void
