// furl — a curl clone written in FC
// Demonstrates HTTP client networking with std::net.
// Supports GET, POST, custom headers, verbose output, and file output.

import net from std::
import io from std::
import sys from std::
import text from std::

// Prints "furl: <msg> (<condition>)" — the named FC condition when the code
// has one (error_name), the raw platform number otherwise — and returns the
// process exit code, so err arms can read `return fail(...)`.
let fail = (msg: const str, e: i32) ->
    match error_name(e) with
    | some(n) -> io.write(alloca("furl: %s{msg} (%s{n})\n"), stderr)
    | none -> io.write(alloca("furl: %s{msg} (error %d{e})\n"), stderr)
    1

// Sends the full HTTP request. Every send propagates its failure upward with
// `?`, so the first broken write surfaces at the call site as this void!.
let send_request = (fd: i32, method: const str, path: const str, host: const str,
                    hdrs: const str[], body: const str, verbose: bool) ->
    // Request line + Host header
    let req_line = alloc("%s{method} %s{path} HTTP/1.0\r\nHost: %s{host}\r\n")!
    defer free(req_line)
    if verbose then
        io.write(alloca("> %s{method} %s{path} HTTP/1.0\n"), stderr)
        io.write(alloca("> Host: %s{host}\n"), stderr)
    net.send_bytes(fd, req_line)?

    // Fixed headers
    net.send_bytes(fd, "User-Agent: furl/1.0\r\n")?
    if verbose then io.write("> User-Agent: furl/1.0\n", stderr)

    net.send_bytes(fd, "Accept: */*\r\n")?
    if verbose then io.write("> Accept: */*\n", stderr)

    net.send_bytes(fd, "Connection: close\r\n")?
    if verbose then io.write("> Connection: close\n", stderr)

    // Custom headers
    for hdr in hdrs do
        let hdr_line = alloc("%s{hdr}\r\n")!
        defer free(hdr_line)
        if verbose then io.write(alloca("> %s{hdr}\n"), stderr)
        net.send_bytes(fd, hdr_line)?

    // Content-Length if body present
    if body.len > 0 then
        let cl = alloc("Content-Length: %d{body.len}\r\n")!
        defer free(cl)
        if verbose then io.write("> Content-Length: %d{body.len}\n", stderr)
        net.send_bytes(fd, cl)?

    // End of headers
    net.send_bytes(fd, "\r\n")?
    if verbose then io.write(">\n", stderr)

    // Send body
    if body.len > 0 then
        net.send_bytes(fd, body)?
    ok

let main = (args: str[]) ->
    // --- Argument parsing ---
    let mut verbose = false
    let mut head_only = false
    let mut method = "GET"
    let mut out_file = ""
    let mut body_data = ""
    let mut url_arg = ""
    let mut custom_hdrs = str[16] {}
    let mut num_hdrs = 0

    let mut i = 1
    loop
        if i >= args.len then break
        let arg = args[i]
        if arg == "-v" then verbose = true
        else if arg == "-I" then head_only = true
        else if arg == "-X" then
            i = i + 1
            if i >= args.len then
                io.write("furl: -X requires a method\n", stderr)
                sys.exit(1)
            method = args[i]
        else if arg == "-o" then
            i = i + 1
            if i >= args.len then
                io.write("furl: -o requires a filename\n", stderr)
                sys.exit(1)
            out_file = args[i]
        else if arg == "-H" then
            i = i + 1
            if i >= args.len then
                io.write("furl: -H requires a header value\n", stderr)
                sys.exit(1)
            custom_hdrs[num_hdrs] = args[i]
            num_hdrs = num_hdrs + 1
        else if arg == "-d" then
            i = i + 1
            if i >= args.len then
                io.write("furl: -d requires data\n", stderr)
                sys.exit(1)
            body_data = args[i]
        else if text.starts_with(arg, "-") then
            io.write(alloca("furl: unknown option %s{arg}\n"), stderr)
            sys.exit(1)
        else url_arg = arg
        i = i + 1

    if url_arg.len == 0 then
        io.write("Usage: furl [options] <url>\n", stderr)
        io.write("Options:\n", stderr)
        io.write("  -v          Verbose (show request/response headers)\n", stderr)
        io.write("  -I          HEAD request (headers only)\n", stderr)
        io.write("  -X METHOD   HTTP method (GET, POST, PUT, DELETE, ...)\n", stderr)
        io.write("  -H HEADER   Add custom header (e.g. -H \"Accept: text/html\")\n", stderr)
        io.write("  -d DATA     Request body (auto-selects POST if method is GET)\n", stderr)
        io.write("  -o FILE     Write response body to file\n", stderr)
        sys.exit(1)

    // Auto-switch to POST when body is provided
    if body_data.len > 0 && method == "GET" then
        method = "POST"

    // --- URL parsing ---
    if !text.starts_with(url_arg, "http://") then
        io.write("furl: URL must start with http://\n", stderr)
        sys.exit(1)

    let rest = url_arg[7..url_arg.len]
    let slash_opt = text.index_of(rest, "/")

    let mut authority = rest
    let mut path = "/"
    if slash_opt.is_some then
        authority = rest[0..slash_opt!]
        path = rest[slash_opt!..rest.len]

    let colon_opt = text.index_of(authority, ":")
    let mut host = authority
    let mut port = 80
    if colon_opt.is_some then
        host = authority[0..colon_opt!]
        let port_str = authority[colon_opt! + 1..authority.len]
        port = match text.parse_i32(port_str) with
               | ok(v) -> v
               | err(e) -> return fail(alloca("invalid port '%s{port_str}'"), e)

    if host.len == 0 then
        io.write("furl: empty hostname\n", stderr)
        sys.exit(1)

    // --- DNS resolution ---
    let ip = match net.resolve(host) with
             | ok(v) -> v
             | err(e) -> return fail(alloca("could not resolve host %s{host}"), e)

    // --- Connect ---
    let fd = match net.open_tcp() with
             | ok(v) -> v
             | err(e) -> return fail("could not create socket", e)
    defer net.close(fd)

    let addr = net.make_addr(net.net_to_host32(ip), (u16) port)
    match net.connect_addr(fd, addr) with
    | ok -> void()
    | err(net.conn.refused) ->
        io.write(alloca("furl: %s{host}:%d{port} refused the connection — is the server listening?\n"), stderr)
        return 1
    | err(e) -> return fail(alloca("connection to %s{host} port %d{port} failed"), e)

    // --- Build and send HTTP request ---
    let actual_method = if head_only && method == "GET" then "HEAD" else method
    match send_request(fd, actual_method, path, host,
                       custom_hdrs[0..num_hdrs], body_data, verbose) with
    | ok -> void()
    | err(e) -> return fail("failed to send request", e)

    // --- Read response ---
    let mut header_buf = u8[8192] {}
    let mut header_len = 0i64
    let mut in_headers = true
    let mut recv_buf = u8[4096] {}

    // Output handle
    let mut out = stdout
    let mut out_opened = false
    if out_file.len > 0 then
        out = match io.open(out_file, "w") with
              | ok(f) -> f
              | err(e) -> return fail(alloca("could not open %s{out_file}"), e)
        out_opened = true

    loop
        let n = match net.recv_bytes(fd, recv_buf, 4096) with
                | ok(v) -> v
                | err(e) -> return fail("receive failed", e)
        if n == 0 then break

        if in_headers then
            // Accumulate into header buffer
            for j in 0..n do
                if header_len < 8192 then
                    header_buf[header_len] = recv_buf[j]
                    header_len = header_len + 1

            // Look for end-of-headers separator
            let hdr_view = header_buf[0..header_len]
            let sep = text.index_of(hdr_view, "\r\n\r\n")
            if sep.is_some then
                let sep_pos = sep!
                in_headers = false

                // Print response headers
                if verbose || head_only then
                    let headers = header_buf[0..sep_pos]
                    let lines = text.split(headers, "\r\n")
                    defer free(lines)
                    for line in lines do
                        if line.len > 0 then
                            if verbose then io.write(alloca("< %s{line}\n"), stderr)
                            if head_only then io.write(alloca("%s{line}\n"), out)
                    if verbose then io.write("<\n", stderr)

                // Output body portion from this chunk
                if !head_only then
                    let body_start = sep_pos + 4
                    if body_start < header_len then
                        io.write(header_buf[body_start..header_len], out)
        else
            // Past headers — stream body directly
            if !head_only then
                io.write(recv_buf[0..n], out)

    // A close failure on the output file means buffered response data may not
    // have reached disk — observe it rather than discard it.
    if out_opened then
        match io.close(out) with
        | ok -> void()
        | err(e) -> return fail(alloca("failed to finish writing %s{out_file}"), e)
    0
