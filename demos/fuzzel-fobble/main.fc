// Fuzzel Fobble — a Puzzle Bobble / Bust-a-Move clone written in FC.
//
// Aim the launcher, fire a bubble up into the hex-packed raft above, and match
// three or more of a colour to pop them. Anything left dangling — no longer
// connected to the ceiling — falls, and falling bubbles are where the points
// are. Every few shots the ceiling grinds down another row.
//
// Pure FC: no C helper files. Every sound is FM-synthesised on an emulated
// OPL2 (YM3812) — the chip module is demos/shared/opl2.fc, the instruments and
// sequencers are in sound.fc next door.
//
// ------------------------------------------------------------------
// One game, two backends
// ------------------------------------------------------------------
//
// The same program builds on SDL2 and on raylib, and which one it builds on is
// a compile-time flag:
//
//     ./run-sdl2.sh          fcc @sdl2.rsp    → --flag backend=sdl2
//     ./run-raylib.sh        fcc @raylib.rsp  → --flag backend=raylib
//
// The flag is required — a build without it fails on a static_assert in this
// file rather than compiling into something half-wired.
//
// The layers, bottom to top:
//
//     plat.fc         the contract: what input looks like, what `gfx` must be
//     gfx_sdl2.fc     ┐ one `module gfx` each. A build takes exactly one; the
//     gfx_raylib.fc   ┘ rsp files decide which, and they are the only files
//                       in the program that name SDL2 or raylib at all.
//     game.fc         the rules. No pixels, no keys, no library.
//     art.fc          the look, drawn on gfx's four primitives. Shared.
//     sound.fc        the instruments and the tunes. Shared.
//     main.fc         this file: hand the three to each other and loop.
//
// So the whole of what differs between an SDL2 build and a raylib build is
// one file, and evolving the game means editing game.fc once rather than two
// copies of it in step.

import opl_audio from shared::
import opl_midi from shared::
import opl_bank_gm from shared::
import io from std::
import sys from std::
import text from std::
import pcg_random from std::random

// Where the music comes from when `--music` doesn't say. Relative to the
// working directory, which the run scripts set to the repository root.
let default_music = "demos/fuzzel-fobble/music/minuet.mid"

// And where the rest of the music comes from, when there is any. The run
// scripts call fetch-music.sh, which downloads twenty pieces of the *Notebook
// for Anna Magdalena Bach* from the Mutopia Project into this directory and
// writes a playlist.txt naming them. Nothing there is committed and nothing
// there is required: with the directory absent the game plays its own minuet
// on every level, which is what it did before any of this existed.
let default_notebook = "demos/fuzzel-fobble/music/notebook"

// The value written after `flag` on the command line, if it is there.
//
// A flag written with nothing after it says so rather than being ignored in
// silence. It means the path never reached the program — a shell that wrapped
// the line, most often — and the failure is otherwise invisible: the game
// starts, plays perfectly, and quietly uses the default it was told not to.
let arg_after = (args: str[], flag: const str) ->
    let mut i = 1i64
    loop
        if i >= args.len then break
        if args[i] == flag then
            if i + 1i64 < args.len then return some(args[i + 1i64])
            io.write(alloca("%s{flag} needs a path after it — ignored\n"), stdout)
            break
        i = i + 1i64
    none(str)

// Read and parse one Standard MIDI File.
//
// Every failure here is one somebody experimenting with their own files will
// meet — a path that doesn't exist, a truncated download, a format 2 file —
// so each one says which it was. The caller runs the game either way: the
// music player is the only thing that needs a song, and sound effects live on
// the other chip entirely.
//
// The returned song owns its events; the bytes it was decoded from do not
// outlive this call.
let load_song = (path: const str) ->
    let bytes = match io.read_all(path) with
                | ok(b) -> b
                | err(e) ->
                    io.write(alloca("Music: cannot read %s{path}\n"), stdout)
                    return none(opl_midi.song)
    defer free(bytes)
    match opl_midi.parse(bytes) with
    | ok(s) -> some(s)
    | err(opl_midi.smf.unsupported_format) ->
        io.write(alloca("Music: %s{path} is an SMF format 2 file (independent pieces, not one song)\n"), stdout)
        none(opl_midi.song)
    | err(opl_midi.smf.truncated) ->
        io.write(alloca("Music: %s{path} is truncated — an incomplete copy?\n"), stdout)
        none(opl_midi.song)
    | err(e) ->
        io.write(alloca("Music: %s{path} is not a MIDI file this can play\n"), stdout)
        none(opl_midi.song)

// The music of a whole run: the songs in the order the levels play them, and
// what each is called on screen.
//
// Two parallel arrays rather than one array of pairs because the engine wants
// exactly the songs — `opl_audio.set_playlist` takes an `opl_midi.song[]` and
// has no business knowing that this game gave them names.
struct playlist =
    songs: opl_midi.song[]
    titles: str[]

// Read the notebook fetch-music.sh leaves in `dir`, with `first` — the
// game's own tune, which the title screen plays — at the head of it.
//
// `playlist.txt` is the authority on what is there and in what order — one
// line per piece, `file|notebook number|title` — rather than the directory
// itself. That is not only because FC's stdlib has no directory read: the
// order is the notebook's, which no filesystem knows, and a manifest written
// after each download is also what keeps a half-finished fetch from naming a
// file that isn't on disk.
//
// A missing manifest is the ordinary first-run case with no network, and it
// is not an error. What comes back is then the one song it was given, which
// is a playlist too — every level plays it, which is what the game did before
// there was anything else to play.
let load_notebook = (dir: const str, first: opl_midi.song, first_title: const str) ->
    let manifest = alloca("%s{dir}/playlist.txt")
    let src = match io.read_all((const str) manifest) with
              | ok(b) -> b
              | err(e) ->
                  // Said rather than passed over in silence: the run scripts
                  // fetch this, so a player who has one and is looking at a
                  // game that does not needs to be told which of the two it
                  // is. Not an error — a first run with no network reaches
                  // here, and the game is complete without it.
                  io.write(alloca("Music: no notebook in %s{default_notebook} — the minuet plays every level (run fetch-music.sh)\n"), stdout)
                  return playlist { songs = alloc(opl_midi.song[1] { first })!,
                                    titles = alloc(str[1] { text.copy(first_title) })! }

    // `src` is deliberately never freed. `text.split` hands back slices of it
    // rather than copies, so the titles below *are* this buffer, and they are
    // drawn for as long as the game runs. The playlist is program-lifetime
    // data and so is the text behind it.
    let lines = text.split((const str) src, "\n")
    defer free(lines)

    // One more than the manifest can hold: entry 0 is the game's own tune.
    let songs = alloc(opl_midi.song[lines.len + 1i64] {})!
    let titles = alloc(str[lines.len + 1i64] {})!
    songs[0] = first
    // `text.copy` because the two sources of a title do not agree on type:
    // a literal is a `const str` and `text.split` yields `str`. Copying the
    // one literal is cheaper to read than laundering const on it, and this
    // array outlives nothing it would have to be freed against.
    titles[0] = text.copy(first_title)
    let mut n = 1i64

    for li in 0i64..lines.len do
        let line = text.trim(lines[li])
        if line.len == 0i64 then
            continue
        let fields = text.split(line, "|")
        defer free(fields)
        if fields.len < 3i64 then
            continue
        // Heap rather than `alloca`: this is inside a loop, and stack
        // allocations in a loop are not released until the function returns.
        let path = alloc("%s{dir}/%s{fields[0]}")!
        defer free(path)
        // A piece that will not load drops out of the playlist and the levels
        // close up over it, exactly as one that would not download does.
        match load_song((const str) path) with
        | some(sg) ->
            songs[n] = sg
            titles[n] = fields[2]
            n = n + 1i64
        | none -> void()

    io.write(alloca("Music: %d{(i32) n - 1} pieces of the Anna Magdalena notebook, one per level\n"), stdout)
    playlist { songs = songs[0i64..n], titles = titles[0i64..n] }

// Which playlist entry level `level` plays.
//
// Entry 0 is the game's own five-channel arrangement of the minuet, and it
// belongs to the title screen — so the levels take the notebook behind it,
// straight through from the top in the book's own order. Level 1 is entry 1.
//
// It wraps rather than stopping: a run long enough to reach the end of the
// book starts it again, which is a better answer than silence and the only
// other one available.
//
// A one-entry playlist is every playlist with no notebook behind it — the
// `--music` case, and the ordinary case of a machine that has never fetched
// one. Then entry 0 is all there is, every level plays it, and the game
// sounds exactly as it did before the notebook existed.
let tune_for_level = (pl: playlist, level: i32) ->
    if pl.songs.len <= 1i64 then 0i64
    else
        let i = (i64) level - 1i64
        1i64 + (if i < 0i64 then 0i64 else i % (pl.songs.len - 1i64))

// And which entry should be sounding *now* — the same thing everywhere
// except the title screen, which is the one place the game's own arrangement
// plays. Phase rather than level, because the splash sits on level 1 and a
// run starting off it never moves the number, so watching the level alone
// would miss the one transition that always happens.
let tune_for = (pl: playlist, phase: game_phase, level: i32) ->
    match phase with
    | splash -> 0i64
    | _ -> tune_for_level(pl, level)

// Say what is playing, in the two places that say it: the window title, and
// — one level ahead — the level-clear banner, where the next piece is the
// reward for having cleared this one.
//
// Both go quiet when there is nothing to say. A one-entry playlist means the
// next level brings the same tune this one has, which is not news and does
// not belong on a banner announcing a reward; `--music` goes further and
// leaves the entry unnamed, because the person who passed a path already
// knows what they passed. An empty `next_tune` draws nothing.
let announce = (w: world*, pl: playlist, phase: game_phase, level: i32) ->
    let here = tune_for(pl, phase, level)
    // The piece the *next* level plays. Entry 0 is the title screen, where
    // nothing has been cleared yet and the level in front of you is this one
    // — and it is also the whole of a playlist with no notebook, where the
    // two come out equal and nothing is announced either way.
    let next = if here == 0i64 then tune_for_level(pl, level)
               else tune_for_level(pl, level + 1)
    let now = pl.titles[here]
    if now.len > 0i64 then
        gfx.set_title(c"Fuzzel Fobble - Level %d{level} - %.48s{now}")
    else
        gfx.set_title(c"Fuzzel Fobble - Level %d{level}")
    if next == here then
        w.next_tune = ""
    else
        w.next_tune = pl.titles[next]

// `--bank <path>` swaps the instruments the way `--music` swaps the tune: a
// `.op2`, `.wopl`, `.ibk` or `.sbi` file in place of the built-in General MIDI
// bank. Hearing the same piece through somebody else's instruments is the
// fastest way to judge either the bank or the player, and neither is worth a
// rebuild.
//
// A bank that will not load is not worth losing the music over, so it says
// which way it failed and carries on with the built-in one.
//
// Only `.wopl` can describe a drum kit for the chip's rhythm voices, and few
// do. A bank without one still plays its whole kit, on melodic voices, and
// `midi_render` is the quickest way to see which you have.
let load_bank_file = (path: const str) ->
    let bytes = match io.read_all(path) with
                | ok(b) -> b
                | err(e) ->
                    io.write(alloca("Bank: cannot read %s{path}\n"), stdout)
                    return opl_bank_gm.make()
    defer free(bytes)
    match opl_midi.load_bank(bytes) with
    | ok(k) ->
        io.write(alloca("Bank: %s{path} — %s{k.name}, %d{(i32) k.patches.len} instruments\n"), stdout)
        k
    | err(e) ->
        io.write(alloca("Bank: %s{path} is not a .op2, .wopl, .ibk or .sbi bank\n"), stdout)
        opl_bank_gm.make()

let open_bank = (args: str[]) ->
    match arg_after(args, "--bank") with
    | some(path) -> load_bank_file(path)
    | none -> opl_bank_gm.make()

// The tuning everything here is played in, unless the config file or
// `--tuning` says otherwise.
//
// Equal temperament — every semitone the same size, every key the same
// colour — is where this starts, because it is what a modern ear is tuned
// to, and a game that opened by sounding subtly wrong to most people would
// have spent its one first impression on a history lesson.
//
// It is not, though, what any of this music was written for. Everything the
// game plays is Bach — the notebook on the levels, and the game's own
// arrangement of the Minuet in G on the title screen — and equal temperament
// was a theoretical curiosity in 1725 that did not become the default until
// the nineteenth century. Twelve pure fifths overshoot seven octaves by about
// a quarter of a semitone, and a tuning is a decision about where to put that
// error: equal spreads it evenly, so nothing is pure and nothing is bad,
// while a *well* temperament spreads it unevenly and the keys stop sounding
// alike. `tuning kirnberger3` in the config file is the reading with the best
// claim to being Bach's own, and the config file the game writes lists all
// six with a line on each.
//
// A function rather than a constant because a file-level initializer has to be
// a C constant expression, and another module's constant is not one.
let default_tuning = () -> opl_midi.equal

// And the pitch it is sounded at: modern concert pitch, A = 440 Hz.
//
// The same argument, and a weaker fact underneath it. There was no pitch
// standard in 1725 — it was a local matter, set by whatever organ or wind
// band a town already owned, and surviving instruments of the period range
// over nearly a whole tone. Bach's Leipzig had two at once: the organs sat at
// Chorton, about A=465, and everything else at a Kammerton roughly a tone
// below, which is why he transposed organ parts to meet the players. The
// notebook is domestic keyboard music — a clavichord or harpsichord in the
// house — and A=415, a semitone below modern, is the early-music convention
// for that Kammerton. `pitch 415.3` is one line of config away.
let default_pitch = () -> opl_midi.concert_a

// ------------------------------------------------------------------
// The config file
// ------------------------------------------------------------------
//
// `~/.fuzzel-fobble/config`, beside the high score and the nine saved games,
// and the same shape of file as those: one setting per line, `//` for a
// comment, blank lines ignored, meant to be opened in an editor.
//
// What belongs here is a setting somebody would want to make once instead of
// typing at every launch — which is exactly what the tuning is. `--tuning`
// and `--pitch` still win for the run they are given on: a flag is what you
// reach for to hear two tunings against each other, and hearing them against
// each other is the only way to judge either.
//
// The game writes the file when it is missing and never touches it again. So
// a first run leaves behind a document of everything that can be set, with
// the defaults spelled out and the alternatives beside them, and an edit made
// to it is never overwritten by a later run.
module config =
    // Everything the file can say.
    //
    // One field, because `opl_midi.temperament` already carries both of the
    // things this file configures: the twelve deviations, and the pitch the
    // A above middle C is sounded at. They are independent axes — any of the
    // six tables can be sounded at any pitch — and the two settings below set
    // one each.
    struct settings =
        tuning: opl_midi.temperament

    // What a `pitch` line may say. A pitch standard has to land in the
    // audible part of the range for the F-number arithmetic downstream to
    // mean anything; the bounds are generous rather than musical, and they
    // are here rather than at the flag so that the file and the command line
    // agree about what a pitch is.
    let min_pitch = 100.0
    let max_pitch = 1000.0

    // The file itself. Heap rather than the stack an interpolated string
    // would give it, so it can outlive the call that built it.
    private let path_of = (hd: const str) -> alloc("%s{hd}/.fuzzel-fobble/config")!

    // The file the game leaves behind on a first run.
    //
    // It is written from `d` rather than from anything spelled out here, so
    // the defaults in the file are the defaults the program actually has, and
    // the set of tunings it lists is `opl_midi.temperaments` — the one place
    // that set is written down. A tuning added there appears here without
    // this function being touched; only its line of prose has to be added
    // below, and a tuning with no line of prose still gets listed.
    private let write_default = (fp: any*, d: settings) ->
        io.write("// Fuzzel Fobble settings.\n", fp)
        io.write("//\n", fp)
        io.write("// One setting per line, `name value`. Blank lines and lines\n", fp)
        io.write("// beginning with // are ignored, and a setting this build does\n", fp)
        io.write("// not know is reported and skipped rather than refused — a\n", fp)
        io.write("// file written by a newer build still works here.\n", fp)
        io.write("//\n", fp)
        io.write("// The command line wins: --tuning and --pitch override what is\n", fp)
        io.write("// here, for the run they are given on.\n", fp)
        io.write("//\n", fp)
        io.write("// The game wrote this file because it was not there, and will\n", fp)
        io.write("// not write it again. Edits stay put; delete it to get this\n", fp)
        io.write("// back.\n", fp)
        io.write("\n", fp)
        io.write("// tuning <name> — the temperament the music is played in: how\n", fp)
        io.write("// big each of the twelve semitones is. In every tuning but the\n", fp)
        io.write("// first they differ, which is the point — it is what gives a\n", fp)
        io.write("// key its colour, and what this music was written for.\n", fp)
        io.write("//\n", fp)
        // Padded to the longest name so the descriptions line up: a config
        // file is read down its left edge.
        let width = name_width()
        for i in 0i64..opl_midi.temperaments.len do
            let t = opl_midi.temperaments[i]
            io.write(alloca("//   %s{t.name}"), fp)
            let line = about(t.name)
            // A name with no sentence written for it is listed on its own
            // rather than padded out to a blank column.
            if line.len > 0i64 then
                for pad in 0i64..width - t.name.len do
                    io.write(" ", fp)
                io.write(alloca("  %s{line}"), fp)
            io.write("\n", fp)
        io.write("\n", fp)
        io.write(alloca("tuning %s{d.tuning.name}\n"), fp)
        io.write("\n", fp)
        io.write("// pitch <hz> — the frequency of the A above middle C, which is\n", fp)
        io.write("// what every other note is measured from. Independent of the\n", fp)
        io.write("// tuning above: any of the tunings can be sounded at any pitch.\n", fp)
        io.write("//\n", fp)
        io.write("//   440    modern concert pitch\n", fp)
        io.write("//   415.3  baroque chamber pitch, a semitone below modern —\n", fp)
        io.write("//          roughly where Bach's Leipzig played this music\n", fp)
        io.write("//   465    Chorton, the pitch his church organs sat at\n", fp)
        io.write("//\n", fp)
        io.write(alloca("// Anything from %.0f{min_pitch} to %.0f{max_pitch} works.\n"), fp)
        // A tenth of a hertz is about four tenths of a cent at this pitch,
        // and the chip tunes on a grid between 1.7 and 3.4 cents wide — so
        // one decimal place is already finer than anything it can sound, and
        // this is the same number the game prints at startup.
        io.write(alloca("pitch %.1f{d.tuning.a4}\n"), fp)

    // The longest name in `opl_midi.temperaments`, for the padding above.
    private let name_width = () ->
        let mut w = 0i64
        for i in 0i64..opl_midi.temperaments.len do
            if opl_midi.temperaments[i].name.len > w then
                w = opl_midi.temperaments[i].name.len
        w

    // A line about each tuning, for the file. Keyed by name rather than by
    // index so that it cannot silently slide out of step with the table, and
    // answering "" for a name it does not know so that a tuning added to
    // `opl_midi` is listed here whether or not anybody wrote it a sentence.
    private let about = (name: const str) ->
        if name == "equal" then
            "every key the same colour; the modern default, and this one"
        else if name == "werckmeister3" then
            "Werckmeister III (1691) — what a recording usually means"
        else if name == "kirnberger3" then
            "Kirnberger III (1779) — the best claim to being Bach's own"
        else if name == "vallotti" then
            "Vallotti (1754) — the gentlest; most period ensembles use it"
        else if name == "young2" then
            "Young II (1800) — Vallotti shifted one fifth sharper"
        else if name == "meantone" then
            "quarter-comma meantone — eight pure thirds, four dead keys"
        else ""

    // Reads the file over `d`, a setting at a time.
    //
    // Unlike a save file — a snapshot of a running game, refused whole if any
    // of it is wrong, because half a board is worse than none — a config file
    // is written by hand, and its worst line should cost only that line. A
    // name that names no tuning, a pitch that is not a number or not in
    // range, a setting this build has never heard of: each says so on stdout
    // and leaves everything else standing.
    private let apply = (src: const str, d: settings) ->
        let mut cur = d
        let lines = text.split(src, "\n")
        defer free(lines)
        for li in 0..lines.len do
            let line = text.trim(lines[li])
            if line.len == 0i64 || text.starts_with(line, "//") then
                continue
            // Split at the first space rather than into words: the value is
            // everything after the name, trimmed, so a setting whose value
            // has a space in it can be added later without touching this.
            let cut = match text.index_of(line, " ") with
                      | some(i) -> i
                      | none -> line.len
            let key = line[0i64..cut]
            let val = text.trim(line[cut..line.len])

            if key == "tuning" then
                cur.tuning = match opl_midi.temperament_named(val) with
                             // The pitch is not the tuning's to bring with
                             // it: the table's own `a4` is 440 for every
                             // entry, and a file that set the pitch above
                             // this line means it.
                             | some(t) -> opl_midi.at_pitch(t, cur.tuning.a4)
                             | none ->
                                 io.write(alloca("Config: no tuning named %s{val} — keeping %s{cur.tuning.name}\n"),
                                          stdout)
                                 cur.tuning
            else if key == "pitch" then
                cur.tuning = match text.parse_f64(val) with
                             | ok(hz) ->
                                 if hz >= min_pitch && hz <= max_pitch then
                                     opl_midi.at_pitch(cur.tuning, hz)
                                 else
                                     io.write(alloca("Config: pitch %s{val} is not between %.0f{min_pitch} and %.0f{max_pitch} Hz\n"),
                                              stdout)
                                     cur.tuning
                             | err(_) ->
                                 io.write(alloca("Config: pitch %s{val} is not a number\n"),
                                          stdout)
                                 cur.tuning
            else
                ignore io.write(alloca("Config: ignoring unknown setting %s{key}\n"),
                                stdout)
        cur

    // The settings for this run.
    //
    // A missing file is not a failure, it is a first run — and it is answered
    // by writing the file, which is how a player finds out there is one. A
    // home directory the game cannot write is not a failure either: it costs
    // the file and nothing else, and the defaults still play.
    let read = (d: settings) ->
        match sys.home_dir() with
        | none -> d
        | some(hd) ->
            let path = path_of(hd)
            defer free(path)
            if !io.exists(path) then
                ignore io.ensure_dir(alloca("%s{hd}/.fuzzel-fobble"))  // shared with highscore.txt
                match io.open(path, "w") with
                | ok(fp) ->
                    write_default(fp, d)
                    // Reported because it is the whole of how the file
                    // announces itself; a player who never sees this line
                    // never learns there is anything to edit.
                    match io.close(fp) with
                    | ok -> io.write(alloca("Config: wrote %s{path}\n"), stdout)
                    | err(_) -> io.write(alloca("Config: could not finish writing %s{path}\n"), stdout)
                | err(_) ->
                    io.write(alloca("Config: cannot write %s{path}\n"), stdout)
                return d
            match io.read_all(path) with
            | ok(bytes) ->
                defer free(bytes)
                apply((const str) bytes, d)
            | err(_) ->
                io.write(alloca("Config: cannot read %s{path} — using defaults\n"), stdout)
                d

// The settings this run starts from: the built-in defaults, then whatever
// the config file has to say about them.
let open_config = () ->
    config.read(config.settings {
        tuning = opl_midi.at_pitch(default_tuning(), default_pitch()) })

// `--tuning <name>` picks a temperament by name and `--pitch <hz>` the pitch
// standard the A above middle C is tuned to, each overriding the config file
// for this run. The two are independent: any temperament can be sounded at
// any pitch, so neither flag disturbs the other's setting.
//
// Neither is a rebuild for the same reason `--music` isn't: hearing two
// tunings against each other back to back is the only way to judge either, and
// on this chip the difference is a few cents per note.
//
// A name or a number that doesn't work says so and falls back, rather than
// leaving somebody wondering why nothing changed.
let open_tuning = (args: str[], cfg: config.settings) ->
    let base = match arg_after(args, "--tuning") with
               | none -> cfg.tuning
               | some(n) ->
                   match opl_midi.temperament_named(n) with
                   // Named tables all carry A=440; the pitch stays whatever
                   // the config file or `--pitch` says it is.
                   | some(t) -> opl_midi.at_pitch(t, cfg.tuning.a4)
                   | none ->
                       io.write(alloca("Tuning: no temperament named %s{n} — known:"),
                                stdout)
                       for i in 0i64..opl_midi.temperaments.len do
                           io.write(alloca(" %s{opl_midi.temperaments[i].name}"),
                                    stdout)
                       io.write("\n", stdout)
                       cfg.tuning
    match arg_after(args, "--pitch") with
    | none -> base
    | some(h) ->
        match text.parse_f64(h) with
        | ok(hz) ->
            if hz >= config.min_pitch && hz <= config.max_pitch then
                opl_midi.at_pitch(base, hz)
            else
                io.write(alloca("Tuning: --pitch %s{h} is not between %.0f{config.min_pitch} and %.0f{config.max_pitch} Hz\n"),
                         stdout)
                base
        | err(e) ->
            io.write(alloca("Tuning: --pitch %s{h} is not a number\n"), stdout)
            base

// The music for a whole run, as a playlist.
//
// `--music <path>` picks a different Standard MIDI File, and it means *that
// file* — it pins the music to one piece and the notebook stays out of it.
// Anything else would be a nasty surprise for the reason the flag exists:
// somebody testing their own MIDI does not want Bach at level 2.
//
// Without it, entry 0 is the game's own minuet, which the title screen
// plays, and the levels take whatever fetch-music.sh managed to download.
// Swapping the tune is the point of
// shipping it as a file rather than compiling it in, which is why both the
// flag and the notebook are files on disk and neither is a rebuild.
//
// An empty playlist is the one thing the caller must be ready for: it means
// no song loaded at all, and the game runs without music.
let open_music = (args: str[]) ->
    match arg_after(args, "--music") with
    | some(path) ->
        match load_song(path) with
        | some(sg) ->
            io.write(alloca("Music: %s{path}\n"), stdout)
            playlist { songs = alloc(opl_midi.song[1] { sg })!,
                       titles = alloc(str[1] { text.copy("") })! }
        | none -> playlist { songs = alloc(opl_midi.song[0] {})!,
                             titles = alloc(str[0] {})! }
    | none ->
        match load_song(default_music) with
        | some(sg) ->
            io.write(alloca("Music: %s{default_music}\n"), stdout)
            load_notebook(default_notebook, sg, "MINUET IN G - BWV ANH. 114")
        | none -> playlist { songs = alloc(opl_midi.song[0] {})!,
                             titles = alloc(str[0] {})! }

let main = (args: str[]) ->
#if backend != "sdl2" && backend != "raylib"
    static_assert(false, "fuzzel-fobble needs a backend: --flag backend=sdl2 or --flag backend=raylib (run demos/fuzzel-fobble/run-sdl2.sh or run-raylib.sh)")
#end

    io.write("=== FUZZEL FOBBLE ===\n", stdout)
#if backend == "sdl2"
    io.write("A Puzzle Bobble clone in FC (DPI-aware SDL2)\n\n", stdout)
#else
    io.write("A Puzzle Bobble clone in FC (raylib)\n\n", stdout)
#end
    io.write("Controls:\n", stdout)
    io.write("  Left/Right  Aim\n", stdout)
    io.write("  SPACE       Fire\n", stdout)
    io.write("  ENTER       Start / restart\n", stdout)
    io.write("  TAB         Swap current and next bubble\n", stdout)
    io.write("  P           Pause\n", stdout)
    io.write("  K           Toggle colour marks\n", stdout)
    io.write("  M           Mute / unmute the music\n", stdout)
    io.write("  S then 1-9  Save the game to that slot\n", stdout)
    io.write("  L then 1-9  Load the game in that slot\n", stdout)
    io.write("  F11         Toggle fullscreen\n", stdout)
    io.write("  ESC         Quit\n", stdout)
    io.write("  C (splash)  Clear best score\n\n", stdout)
    io.write("Saved games live in ~/.fuzzel-fobble/save<N>.txt\n", stdout)
    io.write("Settings live in ~/.fuzzel-fobble/config\n\n", stdout)

    // Read before the window opens, because what is in it is not only the
    // audio's business — it is the file every future setting goes in, and
    // the one line it may print about itself belongs with the rest of the
    // startup text rather than after a window has appeared.
    let cfg = open_config()

    gfx.open(game.logical_w, game.logical_h, c"Fuzzel Fobble")

    let mut rng = pcg_random.make((u64) sys.time())
    let w = game.create(&rng)

    // Audio. The engine generates samples on the host's own audio thread, in
    // the device's callback, at the sound card's rate — never in this loop. A
    // game loop that produced the samples would also be their clock, and every
    // frame that ran long or short would bend the music's pitch and tempo
    // audibly. Here a slow frame cannot reach the sound at all.
    //
    // What that costs is a second thread on the chips, and it is paid in one
    // place: every call into the engine posts a command onto a lock-free ring
    // that the callback drains. Nothing here ever waits on the audio thread.
    // Which device the callback hangs off is the backend's business — that is
    // all `gfx.audio_start` decides.
    // The tune is a Standard MIDI File on disk, played through the shared
    // General MIDI bank — so a player can drop another one in with `--music`
    // and hear the OPL2 make what it can of it. A file that will not load
    // costs the music and nothing else; the effects are on their own chip.
    let kit = open_bank(args)
    let pl = open_music(args)
    // One player for the whole playlist, not one per piece. The expensive
    // half of a player is the emulated chip it owns — 68 KB of it — and a
    // rack of twenty would be a rack of twenty chips to hear one at a time.
    // `opl_audio.music_select` moves the song under this one instead.
    let first = if pl.songs.len > 0i64 then pl.songs[0]
                else
                    io.write("Audio: running without music\n", stdout)
                    opl_midi.song { events = alloc(opl_midi.event[0] {})!,
                                    division = 480, length = 0 }
    // Tuned before the device opens, which is the last moment this thread may
    // touch the player at all — from `audio_start` on it belongs to the audio
    // callback. `set_temperament` is safe mid-phrase, but only from whoever
    // owns the chip.
    let music = opl_midi.init(44100, first, kit)
    let tuning = open_tuning(args, cfg)
    opl_midi.set_temperament(music, tuning)
    io.write(alloca("Tuning: %s{tuning.name}, A=%.1f{tuning.a4} Hz\n"), stdout)
    let s = snd.init(44100, music)
    // Before the device opens, which is the last moment this thread may touch
    // the playlist: from here it is the audio callback's.
    opl_audio.set_playlist(s, pl.songs)
    if !gfx.audio_start(s) then
        io.write("Audio: device open failed - running silent\n", stdout)
    opl_audio.music_begin(s)

    let mut inp = default(input)
    let mut frame = 0

    // What is sounding, and what the window last said. Both are watched
    // rather than pushed: main is the only place a phase and a level number
    // become a song and a window title, and watching for the change catches
    // every way they can move — a board cleared, a run restarted, a slot
    // loaded, or the title screen simply giving way to level 1.
    //
    // Only a *change* of piece is posted. With no notebook fetched every
    // level picks entry 0, and re-posting it would restart the minuet at
    // every level instead of letting it play through.
    let mut tune_now = tune_for(pl, w.game.phase, w.game.level)
    let mut level_now = w.game.level
    if pl.titles.len > 0i64 then
        announce(w, pl, w.game.phase, w.game.level)

    loop
        gfx.pump(&inp)
        if inp.quit then break
        frame = frame + 1

        // The title carries the level, which is a window fact rather than a
        // game one — so main watches for the change instead of game.step
        // reaching out to set it. The music is the same shape of fact.
        game.step(w, &inp, &rng, s)
        if pl.titles.len > 0i64 then
            let want = tune_for(pl, w.game.phase, w.game.level)
            // Posted after game.step rather than before, so the swap lands
            // behind whatever that frame already asked for — `start_run`
            // posts a music_start of its own, and a select arriving after it
            // is what makes level 1 open on the notebook's minuet instead of
            // the title screen's.
            if want != tune_now then
                opl_audio.music_select(s, (i32) want)
            if want != tune_now || w.game.level != level_now then
                announce(w, pl, w.game.phase, w.game.level)
            tune_now = want
            level_now = w.game.level

        art.render(w, frame)

    io.write("Final score: %d{w.game.score} (level %d{w.game.level})\n", stdout)
    gfx.close()
    0
