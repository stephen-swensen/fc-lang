// Fuzzel Fobble — the rules.
//
// The hex-packed raft, the shot in flight, the two flood fills that decide
// what pops and what falls, the scoring, the level pacing, the clocks. Every
// scrap of mutable gameplay state lives in `world`, and every function here
// takes it explicitly.
//
// Nothing in this file draws anything, opens anything, or reads a key. It is
// handed one `input` per frame (the platform contract, plat.fc) and one
// `world*` to evolve, and that is the whole of its contact with the outside.
// The look is art.fc; the window, the pixels and the keyboard are gfx_sdl2.fc
// or gfx_raylib.fc. Swapping those does not touch this file — which is the
// entire point of the split.
//
// The one thing that crosses the line the other way is sound: `opl_audio` is
// an FM synth, not a renderer, and both backends drive the same one. Which
// audio *device* it opens is the backend's business (see `gfx.audio_start`);
// posting "play the pop sound" is the game's.

import opl_audio from shared::
import io from std::
import text from std::
import sys from std::
import math from std::
import pcg_random from std::random

// ============================================================
// Types
// ============================================================

union game_phase =
    | splash
    | playing
    | paused
    | level_clear
    | game_over

// The bubble in flight. There is only ever one.
struct shot =
    x: f64
    y: f64
    vx: f64
    vy: f64
    color: i32
    active: bool

// A bubble that lost its grip on the ceiling and is on its way out.
struct faller =
    x: f64
    y: f64
    vx: f64
    vy: f64
    color: i32
    alive: bool

struct particle =
    x: f64
    y: f64
    vx: f64
    vy: f64
    life: i32
    max_life: i32
    r: u8
    g: u8
    b: u8

// Background decoration — soda bubbles drifting up behind the playfield.
struct drifter =
    x: f64
    y: f64
    speed: f64
    rad: i32
    alpha: u8

struct game_state =
    phase: game_phase
    phase_timer: i32

    level: i32
    score: i32
    high_score: i32
    new_high: bool

    // Launcher
    angle: f64              // degrees; 0 = straight up, negative = left
    cur_color: i32
    next_color: i32

    // Ceiling descent
    shots_left: i32
    drop_interval: i32
    row_parity: i32         // 0 = row 0 is a wide row, 1 = row 0 is offset
    shots_fired: i32

    // Clocks
    idle_timer: i32         // frames the turn has been sitting unfired
    level_frames: i32       // frames spent on this level, for the speed bonus
    bonus_paid: i32         // the speed bonus the last clear actually paid

    // Presentation
    show_symbols: bool
    popup_timer: i32
    popup_val: i32
    popup_x: i32
    popup_y: i32

// ============================================================
// World — every mutable scrap of gameplay state, born in `create` and
// threaded explicitly into the helpers that touch it. The renderer,
// the audio device, and the rng stay outside: they are channels
// (output, output, entropy), not state the game owns.
//
// It is a top-level type rather than a member of `module game` so that
// art.fc can name it without importing anything: top-level declarations
// are visible across every file in the same namespace.
// ============================================================

struct world =
    grid: i32[]             // grid_cells cells; -1 = empty, else colour index
    mark: i32[]             // flood-fill scratch: same-colour cluster
    anchor: i32[]           // flood-fill scratch: reachable from the ceiling
    stack: i32[]            // flood-fill scratch: work list of cell indices
    fallers: faller[]
    particles: particle[]
    drifters: drifter[]
    shot: shot
    game: game_state

module game =
    // ============================================================
    // Constants
    //
    // Everything here is in *logical* coordinates: a fixed 1280x720 board
    // that the backend scales to whatever the window happens to be. Neither
    // this file nor art.fc ever sees a physical pixel.
    // ============================================================

    let logical_w = 1280
    let logical_h = 720

    // The playfield is a centred column; the two side strips are HUD panels.
    let field_x0 = 352
    let field_x1 = 928
    let field_y0 = 80
    let field_y1 = 700

    // Hex-packed bubble raft. Even rows hold `grid_cols` bubbles; odd rows hold
    // one fewer, shifted right by a radius. row_h is the vertical pitch of a
    // hex packing: 48 * sqrt(3) / 2 = 41.57, rounded to 42.
    let bubble_d = 48
    let bubble_r = 24
    let grid_cols = 12
    let grid_rows = 14
    let grid_cells = 168           // grid_rows * grid_cols
    let row_h = 42
    let ceiling_y = 92             // top edge of row 0
    let death_row = 12             // a bubble reaching this row ends the run

    // A shot sticks when its centre comes within this distance of a settled
    // bubble's centre. It is three quarters of the drawn bubble, not a whole
    // one, and that gap between what you see and what stops you is the genre's
    // oldest tolerance: the sprite decides what the board looks like, a smaller
    // circle decides what the shot can get through.
    //
    // What it buys, in this raft's own numbers: a one-bubble hole in a row
    // leaves its two flanking centres 96 apart, so a shot threads it while its
    // centre stays 36 clear of each — a 24 wide lane down the middle of a 48
    // wide hole. At the old 44 that lane was 8 wide, less than one press of the
    // aim key moves the shot at raft range, so the needle-thread was a shot that
    // existed on paper and not in the hands.
    //
    // The floor is 27.9. Three touching bubbles leave an interstice with that
    // circumradius, and a sticking circle under it would let a shot tunnel clean
    // through a solid raft. 36 clears it by a third, so there is no hole in the
    // board that isn't a real one.
    let collide_d2 = 1296.0        // 36 * 36

    // What the metal shot destroys is a different question from what a colour
    // shot sticks to, so it keeps its own radius rather than riding the one
    // above — loosening the grab must not thin out the plough.
    let smash_d2 = 1936.0          // 44 * 44

    let shooter_x = 640
    let shooter_y = 656
    let danger_y = 620             // ceiling_y + death_row * row_h + bubble_r

    let shot_speed = 15.0
    let shot_substeps = 5
    let aim_limit = 78.0
    let aim_speed = 1.7

    // The aim guide walks the live shot's substep (shot_speed / shot_substeps =
    // 3 px) so it can't disagree with it, and draws one dot in nine — the same
    // 27 px spacing a coarser walk used to give, the same 29 dots, out to the
    // same 756 px. Only the collision sampling got finer. The walk runs a little
    // past where the fade gives out, which is what stops the dots.
    let guide_steps = 288
    let guide_dot_every = 9

    let max_fallers = 96
    let max_particles = 256
    let max_drifters = 40

    let num_colors = 6

    // A grid cell holds -1 for empty, a colour index below num_colors, or one of
    // these. `shot_metal` is a launcher payload only and never reaches the grid.
    // Anything that reads a cell value has to decide what it means for these
    // three, which is why `is_color` exists rather than a bare `>= 0` test.
    let cell_star = 6       // hit it with a colour and every bubble of that colour goes
    let cell_stone = 7      // indestructible: never pops, only falls
    let shot_metal = 8      // ploughs through the raft, sticks to nothing

    // When each special starts appearing, and how often. Stars and stones are
    // part of the board; a metal shot is handed to the launcher.
    let star_from_level = 2
    let stone_from_level = 3
    let metal_from_level = 2
    let star_pct = 6         // per placed bubble, once stars are in play
    let stone_pct = 7        // per placed bubble, never in the ceiling row
    let metal_pct = 5        // per launcher reload

    // The aim guide is a tutorial device: it draws the bounce for you while you
    // learn the geometry, and comes off after this level.
    let guide_levels = 1

    // Ceiling pacing. The countdown runs on shots landed and nothing else — a
    // pop scores, it does not buy time back. The interval itself comes from how
    // many colours are still on the board: a board down to two colours is an
    // easy board, so it earns a faster ceiling. Pressure tracks the position,
    // not the level number. (Both rules are how the arcade bubble-shooters have
    // always paced themselves; they are what keeps the game from stalling out
    // into a solved puzzle.)
    let drop_shots_min = 5
    let drop_shots_max = 10

    // The turn clock, in frames at roughly 60 Hz. Stall and the launcher starts
    // nagging; keep stalling and it fires without you. A shooter with no clock
    // lets every shot be solved at leisure, which is a different, slower game.
    let hurry_warn = 300
    let hurry_fire = 600

    // A dropped bubble is worth double the one before it, up to a ceiling on the
    // doublings — past that the curve is academic and the score runs away. This
    // is what makes cutting the raft loose at the neck the point of the game
    // rather than a bonus for tidiness.
    let drop_score_base = 20
    let drop_score_max_doubles = 14

    // Clearing the board pays for speed: the bonus decays every few seconds and
    // expires outright, so there is a reason to shoot rather than to study.
    let clear_bonus_base = 50000
    let clear_bonus_step = 5        // seconds per decay step
    let clear_bonus_expiry = 65     // seconds after which a clear pays no bonus

    // ============================================================
    // Small integer helpers
    // ============================================================

    let imin = (a: i32, b: i32) -> if a < b then a else b
    let imax = (a: i32, b: i32) -> if a > b then a else b
    let deg2rad = (d: f64) -> d * math.pi / 180.0

    // ============================================================
    // The palette
    //
    // A cell value's colour is game data, not art: the particles a pop
    // throws are tinted by the rules that spawned them, so the table has to
    // be reachable from here. art.fc reads the same three numbers and does
    // the rest — the shading, the highlights, the colour-blind marks.
    // ============================================================

    // The six playfield colours. A tuple keeps the three channels together
    // without a struct for what is really just a literal table.
    let bubble_rgb = (c: i32) ->
        match c with
        | 0 -> { 235u8, 72u8,  86u8 }      // cherry
        | 1 -> { 70u8,  132u8, 240u8 }     // blueberry
        | 2 -> { 74u8,  200u8, 104u8 }     // lime
        | 3 -> { 246u8, 202u8, 72u8 }      // lemon
        | 4 -> { 178u8, 96u8,  228u8 }     // grape
        | _ -> { 72u8,  214u8, 220u8 }     // mint

    // True for a plain playfield colour, false for empty and for every special.
    // Any code that treats a cell value as an index into a colour table has to
    // ask this first — `>= 0` alone will hand it a star or a stone.
    let is_color = (v: i32) -> v >= 0 && v < num_colors

    // Colour for any cell or shot value, specials included.
    let cell_rgb = (v: i32) ->
        if v == cell_star then
            // Near-white, not gold: a gold star sat two shades from lemon and the
            // two were a genuine muddle on a busy board. No playfield colour is
            // white, so white is the one hue that cannot be mistaken for a colour.
            { 252u8, 248u8, 232u8 }
        else if v == cell_stone then
            { 128u8, 134u8, 150u8 }
        else if v == shot_metal then
            { 206u8, 214u8, 228u8 }
        else
            bubble_rgb(v)

    // ============================================================
    // Grid geometry
    //
    // Rows alternate between wide (grid_cols bubbles, flush left) and narrow
    // (grid_cols - 1, shifted right by a radius). `row_parity` says which kind
    // row 0 currently is; it flips on every ceiling descent, which is exactly
    // what keeps each existing row's stagger intact as the raft slides down.
    // ============================================================

    let cell_index = (row: i32, col: i32) -> row * grid_cols + col

    let row_is_narrow = (w: world*, row: i32) -> (row + w.game.row_parity) % 2 == 1

    let row_cols = (w: world*, row: i32) ->
        if row_is_narrow(w, row) then grid_cols - 1 else grid_cols

    let cell_get = (w: world*, row: i32, col: i32) ->
        if row < 0 || row >= grid_rows || col < 0 || col >= row_cols(w, row) then
            return -1
        w.grid[cell_index(row, col)]

    let cell_center = (w: world*, row: i32, col: i32) ->
        let off = if row_is_narrow(w, row) then bubble_r else 0
        { (f64) (field_x0 + col * bubble_d + bubble_r + off),
          (f64) (ceiling_y + row * row_h + bubble_r) }

    // The six hex neighbours, k = 0..5: left, right, up-left, up-right,
    // down-left, down-right. A narrow row sits half a bubble to the right of
    // the wide row above it, so its upward neighbours are (col, col + 1) where
    // a wide row's are (col - 1, col).
    let neighbor = (w: world*, row: i32, col: i32, k: i32) ->
        let d = if row_is_narrow(w, row) then 1 else 0
        match k with
        | 0 -> { row,     col - 1 }
        | 1 -> { row,     col + 1 }
        | 2 -> { row - 1, col - 1 + d }
        | 3 -> { row - 1, col + d }
        | 4 -> { row + 1, col - 1 + d }
        | _ -> { row + 1, col + d }

    let count_bubbles = (w: world*) ->
        let mut n = 0
        for i in 0..grid_cells do
            if w.grid[i] >= 0 then n = n + 1
        n

    let deepest_row = (w: world*) ->
        let mut d = -1
        for row in 0..grid_rows do
            let rc = row_cols(w, row)
            for col in 0..rc do
                if w.grid[cell_index(row, col)] >= 0 && row > d then
                    d = row
        d

    let color_in_play = (w: world*, c: i32) ->
        let mut found = false
        for i in 0..grid_cells do
            if w.grid[i] == c then found = true
        found

    let count_colors_in_play = (w: world*) ->
        let mut seen = i32[6] { 0, 0, 0, 0, 0, 0 }
        for i in 0..grid_cells do
            let v = w.grid[i]
            if is_color(v) then
                seen[v] = 1
        let mut n = 0
        for c in 0..num_colors do
            if seen[c] == 1 then n = n + 1
        n

    // Shots between ceiling descents, derived from the colours still on the
    // board. Fewer colours is an easier board, so it gets a shorter fuse.
    let drop_interval_for = (colors: i32) ->
        imin(imax(colors + 4, drop_shots_min), drop_shots_max)

    // Re-derived after every landing, so a colour leaving the board tightens the
    // countdown at once. The clamp matters: the interval can shrink underneath a
    // countdown that is already running.
    let refresh_drop_interval = (w: world*) ->
        w.game.drop_interval = drop_interval_for(count_colors_in_play(w))
        if w.game.shots_left > w.game.drop_interval then
            w.game.shots_left = w.game.drop_interval

    // ============================================================
    // Scoring
    // ============================================================

    // Popped bubbles are flat rate; bubbles you cut loose double with each one
    // that falls, which is what makes severing the raft worth aiming for.
    let drop_score = (n: i32) ->
        if n <= 0 then
            return 0
        let mut v = drop_score_base
        let doubles = imin(n - 1, drop_score_max_doubles)
        for i in 0..doubles do
            v = v * 2
        v

    // The speed bonus for clearing a board: full value if you are quick, decayed
    // a notch for every few seconds after that, and nothing at all once the
    // clock runs past the expiry.
    let clear_bonus = (frames: i32) ->
        let secs = frames / 60
        if secs >= clear_bonus_expiry then
            return 0
        let mut v = clear_bonus_base
        let mut t = secs
        loop
            if t < clear_bonus_step then break
            v = v * 3 / 4
            t = t - clear_bonus_step
        v

    // ============================================================
    // Particles
    // ============================================================

    let spawn_burst = (w: world*, rng: pcg_random*, cx: f64, cy: f64, count: i32,
                       cr: u8, cg: u8, cb: u8) ->
        let mut spawned = 0
        for i in 0..max_particles do
            if spawned >= count then break
            if w.particles[i].life <= 0 then
                let angle = pcg_random.next_f64(rng) * 6.2831853
                let speed = 1.0 + pcg_random.next_f64(rng) * 4.5
                w.particles[i].x = cx
                w.particles[i].y = cy
                w.particles[i].vx = math.cos(angle) * speed
                w.particles[i].vy = math.sin(angle) * speed
                let life = 22 + (i32) (pcg_random.next_f64(rng) * 22.0)
                w.particles[i].life = life
                w.particles[i].max_life = life
                w.particles[i].r = cr
                w.particles[i].g = cg
                w.particles[i].b = cb
                spawned = spawned + 1

    let update_particles = (w: world*) ->
        for i in 0..max_particles do
            if w.particles[i].life > 0 then
                w.particles[i].x = w.particles[i].x + w.particles[i].vx
                w.particles[i].y = w.particles[i].y + w.particles[i].vy
                w.particles[i].vy = w.particles[i].vy + 0.14
                w.particles[i].vx = w.particles[i].vx * 0.98
                w.particles[i].life = w.particles[i].life - 1

    let clear_particles = (w: world*) ->
        for i in 0..max_particles do
            w.particles[i].life = 0

    // ============================================================
    // Falling bubbles
    // ============================================================

    let spawn_faller = (w: world*, rng: pcg_random*, x: f64, y: f64, color: i32) ->
        for i in 0..max_fallers do
            if !w.fallers[i].alive then
                w.fallers[i].x = x
                w.fallers[i].y = y
                w.fallers[i].vx = (pcg_random.next_f64(rng) - 0.5) * 3.0
                w.fallers[i].vy = -1.5 - pcg_random.next_f64(rng) * 2.0
                w.fallers[i].color = color
                w.fallers[i].alive = true
                return

    let update_fallers = (w: world*) ->
        for i in 0..max_fallers do
            if w.fallers[i].alive then
                w.fallers[i].vy = w.fallers[i].vy + 0.55
                w.fallers[i].x = w.fallers[i].x + w.fallers[i].vx
                w.fallers[i].y = w.fallers[i].y + w.fallers[i].vy
                if w.fallers[i].y > (f64) (logical_h + 60) then
                    w.fallers[i].alive = false

    let clear_fallers = (w: world*) ->
        for i in 0..max_fallers do
            w.fallers[i].alive = false

    // ============================================================
    // Background drifters
    // ============================================================

    let init_drifters = (w: world*, rng: pcg_random*) ->
        for i in 0..max_drifters do
            w.drifters[i].x = (f64) (field_x0 + 24) +
                              pcg_random.next_f64(rng) * (f64) (field_x1 - field_x0 - 48)
            w.drifters[i].y = (f64) field_y0 +
                              pcg_random.next_f64(rng) * (f64) (field_y1 - field_y0)
            w.drifters[i].speed = 0.25 + pcg_random.next_f64(rng) * 0.85
            w.drifters[i].rad = 4 + (i32) (pcg_random.next_f64(rng) * 13.0)
            w.drifters[i].alpha = (u8) (16.0 + pcg_random.next_f64(rng) * 26.0)

    let update_drifters = (w: world*, rng: pcg_random*) ->
        for i in 0..max_drifters do
            w.drifters[i].y = w.drifters[i].y - w.drifters[i].speed
            if w.drifters[i].y < (f64) (field_y0 - 24) then
                w.drifters[i].y = (f64) (field_y1 + 24)
                w.drifters[i].x = (f64) (field_x0 + 24) +
                                  pcg_random.next_f64(rng) * (f64) (field_x1 - field_x0 - 48)

    // ============================================================
    // Flood fills
    //
    // Two of them, both over the same explicit index stack: one gathers a
    // same-colour cluster from the bubble that just landed, the other marks
    // everything still hanging from row 0. What the second one *doesn't*
    // reach is what falls.
    // ============================================================

    let flood_same_color = (w: world*, row: i32, col: i32) ->
        for i in 0..grid_cells do
            w.mark[i] = 0
        // Only a plain colour has a cluster. A star or a stone matches nothing,
        // not even another of its own kind.
        let color = cell_get(w, row, col)
        if !is_color(color) then
            return 0

        let start = cell_index(row, col)
        w.mark[start] = 1
        w.stack[0] = start
        let mut top = 1
        let mut count = 0
        loop
            if top == 0 then break
            top = top - 1
            let ci = w.stack[top]
            let cr = ci / grid_cols
            let cc = ci % grid_cols
            count = count + 1
            for k in 0..6 do
                let { nr, nc } = neighbor(w, cr, cc, k)
                if cell_get(w, nr, nc) == color then
                    let ni = cell_index(nr, nc)
                    if w.mark[ni] == 0 then
                        w.mark[ni] = 1
                        w.stack[top] = ni
                        top = top + 1
        count

    let mark_anchored = (w: world*) ->
        for i in 0..grid_cells do
            w.anchor[i] = 0
        let mut top = 0
        let rc = row_cols(w, 0)
        for col in 0..rc do
            if cell_get(w, 0, col) >= 0 then
                let ci = cell_index(0, col)
                w.anchor[ci] = 1
                w.stack[top] = ci
                top = top + 1
        loop
            if top == 0 then break
            top = top - 1
            let ci = w.stack[top]
            let cr = ci / grid_cols
            let cc = ci % grid_cols
            for k in 0..6 do
                let { nr, nc } = neighbor(w, cr, cc, k)
                if cell_get(w, nr, nc) >= 0 then
                    let ni = cell_index(nr, nc)
                    if w.anchor[ni] == 0 then
                        w.anchor[ni] = 1
                        w.stack[top] = ni
                        top = top + 1

    // Pops every cell flagged in `mark`, returning how many went.
    let clear_marked = (w: world*, rng: pcg_random*) ->
        let mut popped = 0
        for row in 0..grid_rows do
            let rc = row_cols(w, row)
            for col in 0..rc do
                let ci = cell_index(row, col)
                if w.mark[ci] == 1 && w.grid[ci] >= 0 then
                    let c = w.grid[ci]
                    let { cx, cy } = cell_center(w, row, col)
                    let { pr, pg, pb } = cell_rgb(c)
                    spawn_burst(w, rng, cx, cy, 12, pr, pg, pb)
                    w.grid[ci] = -1
                    popped = popped + 1
        popped

    // Cuts loose everything no longer hanging from the ceiling.
    let drop_floaters = (w: world*, rng: pcg_random*) ->
        mark_anchored(w)
        let mut dropped = 0
        for row in 0..grid_rows do
            let rc = row_cols(w, row)
            for col in 0..rc do
                let ci = cell_index(row, col)
                if w.grid[ci] >= 0 && w.anchor[ci] == 0 then
                    let { cx, cy } = cell_center(w, row, col)
                    spawn_faller(w, rng, cx, cy, w.grid[ci])
                    w.grid[ci] = -1
                    dropped = dropped + 1
        dropped

    // ============================================================
    // Level setup
    // ============================================================

    let level_colors = (level: i32) -> imin(3 + (level - 1) / 2, num_colors)
    let level_rows = (level: i32) -> imin(5 + (level - 1) / 2, 8)

    let roll = (rng: pcg_random*, pct: i32) ->
        (i32) pcg_random.next_bounded_u32(rng, 100u32) < pct

    // Picks a colour for the launcher. Only colours actually on the board are
    // eligible — handing out a colour with nothing to match would be a dud shot.
    let pick_shot_color = (w: world*, rng: pcg_random*) ->
        let mut avail = i32[6] { 0, 0, 0, 0, 0, 0 }
        for i in 0..grid_cells do
            let v = w.grid[i]
            if is_color(v) then
                avail[v] = 1
        let mut n = 0
        for c in 0..num_colors do
            if avail[c] == 1 then n = n + 1
        if n == 0 then
            return (i32) pcg_random.next_bounded_u32(rng, (u32) level_colors(w.game.level))

        let pick = (i32) pcg_random.next_bounded_u32(rng, (u32) n)
        let mut seen = -1
        let mut result = 0
        for c in 0..num_colors do
            if avail[c] == 1 then
                seen = seen + 1
                if seen == pick then result = c
        result

    // What the launcher loads: usually a colour that is on the board, and now and
    // then a metal shot. Only the launcher queue draws from this — a descending
    // row uses the plain colour pick, since the specials are not the ceiling's
    // to hand out.
    let pick_launcher = (w: world*, rng: pcg_random*) ->
        if w.game.level >= metal_from_level && roll(rng, metal_pct) then
            return shot_metal
        pick_shot_color(w, rng)

    let build_level = (w: world*, rng: pcg_random*) ->
        for i in 0..grid_cells do
            w.grid[i] = -1
        w.game.row_parity = 0

        let colors = level_colors(w.game.level)
        let rows = level_rows(w.game.level)
        let stars = w.game.level >= star_from_level
        // A stone in the ceiling row could never be cut loose, and a board you
        // cannot finish is not a hard board, it is a broken one. Row 0 stays
        // clean, and since the raft only ever moves *down*, no stone can reach it.
        let stones = w.game.level >= stone_from_level
        for row in 0..rows do
            let rc = row_cols(w, row)
            let mut prev = -1
            for col in 0..rc do
                // The bottom row is ragged, which gives the opening shots
                // somewhere interesting to go.
                let hole = row == rows - 1 && roll(rng, 35)
                if hole then
                    prev = -1
                else if stones && row > 0 && roll(rng, stone_pct) then
                    w.grid[cell_index(row, col)] = cell_stone
                    prev = -1
                else if stars && roll(rng, star_pct) then
                    w.grid[cell_index(row, col)] = cell_star
                    prev = -1
                else
                    // Repeating the left neighbour part of the time clumps the
                    // colours into shapes worth shooting at, instead of static.
                    let mut c = (i32) pcg_random.next_bounded_u32(rng, (u32) colors)
                    if prev >= 0 && roll(rng, 45) then
                        c = prev
                    w.grid[cell_index(row, col)] = c
                    prev = c

    // Slides the whole raft down one row and grows a fresh row at the ceiling.
    // Flipping row_parity is what preserves each existing row's stagger: a row
    // moving from index r to r + 1 keeps its own width and offset.
    let descend = (w: world*, rng: pcg_random*) ->
        let mut row = grid_rows - 1
        loop
            if row <= 0 then break
            for col in 0..grid_cols do
                w.grid[cell_index(row, col)] = w.grid[cell_index(row - 1, col)]
            row = row - 1
        w.game.row_parity = 1 - w.game.row_parity

        for col in 0..grid_cols do
            w.grid[cell_index(0, col)] = -1
        let rc = row_cols(w, 0)
        let stars = w.game.level >= star_from_level
        for col in 0..rc do
            // Stars can ride down with a new row; stones cannot, for the reason
            // build_level gives.
            if stars && roll(rng, star_pct) then
                w.grid[cell_index(0, col)] = cell_star
            else
                w.grid[cell_index(0, col)] = pick_shot_color(w, rng)

    // ============================================================
    // Collision and settling
    // ============================================================

    // True if a bubble centred at (x, y) overlaps any settled bubble. Only the
    // rows that could possibly reach are scanned — the raft is 14 rows deep and
    // this runs 5 times a frame for the shot plus ~90 times for the aim guide.
    let hits_bubble = (w: world*, x: f64, y: f64) ->
        let approx = (i32) ((y - (f64) (ceiling_y + bubble_r)) / (f64) row_h)
        let lo = imax(approx - 2, 0)
        let hi = imin(approx + 2, grid_rows - 1)
        let mut hit = false
        for row in lo..(hi + 1) do
            if !hit then
                let rc = row_cols(w, row)
                for col in 0..rc do
                    if !hit && w.grid[cell_index(row, col)] >= 0 then
                        let { cx, cy } = cell_center(w, row, col)
                        let dx = x - cx
                        let dy = y - cy
                        if dx * dx + dy * dy < collide_d2 then
                            hit = true
        hit

    // The empty cell nearest the shot that something could actually hold onto:
    // row 0 hangs from the ceiling, anything else needs an occupied neighbour.
    // Nearest-attachable is more forgiving than snapping to the cell the shot
    // happens to be standing in, and it can never pick a floating cell.
    let settle_cell = (w: world*) ->
        let mut best = -1
        let mut best_d = 1000000000.0
        for row in 0..grid_rows do
            let rc = row_cols(w, row)
            for col in 0..rc do
                if w.grid[cell_index(row, col)] < 0 then
                    let mut attach = row == 0
                    for k in 0..6 do
                        if !attach then
                            let { nr, nc } = neighbor(w, row, col, k)
                            if cell_get(w, nr, nc) >= 0 then
                                attach = true
                    if attach then
                        let { cx, cy } = cell_center(w, row, col)
                        let dx = w.shot.x - cx
                        let dy = w.shot.y - cy
                        let d = dx * dx + dy * dy
                        if d < best_d then
                            best_d = d
                            best = cell_index(row, col)
        best

    // A queued colour that has left the board is a dud shot, so it gets swapped
    // out. A metal shot is never a dud — it needs nothing to match — so it is
    // exempt from the check rather than being quietly thrown away.
    let refresh_queue = (w: world*, rng: pcg_random*) ->
        if w.game.cur_color != shot_metal && !color_in_play(w, w.game.cur_color) then
            w.game.cur_color = pick_shot_color(w, rng)
        if w.game.next_color != shot_metal && !color_in_play(w, w.game.next_color) then
            w.game.next_color = pick_shot_color(w, rng)

    // Marks every cell holding `color`, plus the stars that set them off, and
    // pops the lot. This is the star's whole trick: it ignores adjacency, so a
    // single bubble against a star takes its entire colour off the board.
    let star_burst = (w: world*, rng: pcg_random*, color: i32) ->
        for i in 0..grid_cells do
            w.mark[i] = 0
        for row in 0..grid_rows do
            let rc = row_cols(w, row)
            for col in 0..rc do
                let ci = cell_index(row, col)
                if w.grid[ci] == color || w.grid[ci] == cell_star then
                    w.mark[ci] = 1
        clear_marked(w, rng)

    // Shared tail of a turn. A bubble that lands and a metal shot that ploughs
    // straight through both end up here: bank the points, run the countdown down
    // one, and see what the board has become.
    let finish_turn = (w: world*, rng: pcg_random*, s: opl_audio.audio*,
                       gained: i32, px: i32, py: i32) ->
        if gained > 0 then
            w.game.score = w.game.score + gained
            w.game.popup_val = gained
            w.game.popup_x = px
            w.game.popup_y = py - 30
            w.game.popup_timer = 75

        // The countdown runs on shots landed, full stop. A pop pays in points,
        // not in time — the ceiling is a metronome, not a penalty for missing.
        w.game.shots_left = w.game.shots_left - 1
        // That pop may also have taken a colour off the board, which shortens
        // the fuse from here on.
        refresh_drop_interval(w)

        if w.game.shots_left <= 0 then
            if count_bubbles(w) > 0 then
                descend(w, rng)
                // The new row can reintroduce a colour and slacken the fuse.
                refresh_drop_interval(w)
                opl_audio.play(s, snd.sfx_descend)
            w.game.shots_left = w.game.drop_interval

        if count_bubbles(w) == 0 then
            w.game.bonus_paid = clear_bonus(w.game.level_frames)
            w.game.score = w.game.score + 500 * w.game.level + w.game.bonus_paid
            w.game.phase = game_phase.level_clear
            w.game.phase_timer = 120
            opl_audio.play(s, snd.sfx_clear)
        else if deepest_row(w) >= death_row then
            w.game.phase = game_phase.game_over
            w.game.phase_timer = 0
            // The tune stops here rather than playing over the run's own
            // ending; `music_end` also rewinds, so the next game opens on
            // the first bar instead of wherever this one happened to die.
            opl_audio.music_end(s)
            opl_audio.play(s, snd.sfx_over)
        else
            refresh_queue(w, rng)

    let land_shot = (w: world*, rng: pcg_random*, s: opl_audio.audio*) ->
        w.shot.active = false
        let idx = settle_cell(w)
        if idx < 0 then
            return
        let row = idx / grid_cols
        let col = idx % grid_cols
        w.grid[idx] = w.shot.color

        // A star next door fires first, and it does not care how big the cluster
        // is — that is what makes a star worth aiming at rather than around.
        let mut hit_star = false
        for k in 0..6 do
            let { nr, nc } = neighbor(w, row, col, k)
            if cell_get(w, nr, nc) == cell_star then
                hit_star = true

        let mut gained = 0
        if hit_star then
            let popped = star_burst(w, rng, w.shot.color)
            gained = popped * 10
            let dropped = drop_floaters(w, rng)
            gained = gained + drop_score(dropped)
            // Two voices, both heard: the star's own sparkle, and the
            // glissando of whatever it cut loose on the way.
            opl_audio.play(s, snd.sfx_star)
            if dropped > 0 then
                opl_audio.play(s, snd.sfx_drop)
        else
            let cluster = flood_same_color(w, row, col)
            if cluster >= 3 then
                let popped = clear_marked(w, rng)
                gained = popped * 10
                let dropped = drop_floaters(w, rng)
                opl_audio.play(s, snd.sfx_pop)
                if dropped > 0 then
                    gained = gained + drop_score(dropped)
                    opl_audio.play(s, snd.sfx_drop)
            else
                opl_audio.play(s, snd.sfx_stick)

        let { px, py } = cell_center(w, row, col)
        finish_turn(w, rng, s, gained, (i32) px, (i32) py)

    // Everything the metal shot is currently touching, gone. Stones shrug it
    // off — indestructible has to mean indestructible or it means nothing — so
    // the metal passes through them without either one stopping.
    let metal_smash = (w: world*, rng: pcg_random*, x: f64, y: f64) ->
        let mut popped = 0
        for row in 0..grid_rows do
            let rc = row_cols(w, row)
            for col in 0..rc do
                let ci = cell_index(row, col)
                if w.grid[ci] >= 0 && w.grid[ci] != cell_stone then
                    let { cx, cy } = cell_center(w, row, col)
                    let dx = x - cx
                    let dy = y - cy
                    if dx * dx + dy * dy < smash_d2 then
                        let { pr, pg, pb } = cell_rgb(w.grid[ci])
                        spawn_burst(w, rng, cx, cy, 12, pr, pg, pb)
                        w.grid[ci] = -1
                        popped = popped + 1
        popped

    // The metal shot's whole flight: it never settles, so it is resolved when it
    // runs out of board rather than when it touches something.
    let update_metal = (w: world*, rng: pcg_random*, s: opl_audio.audio*) ->
        let mut gained = 0
        for step in 0..shot_substeps do
            if !w.shot.active then break
            w.shot.x = w.shot.x + w.shot.vx
            w.shot.y = w.shot.y + w.shot.vy

            let left = (f64) (field_x0 + bubble_r)
            let right = (f64) (field_x1 - bubble_r)
            if w.shot.x < left then
                w.shot.x = left
                w.shot.vx = -w.shot.vx
                spawn_burst(w, rng, w.shot.x - 6.0, w.shot.y, 3, 220u8, 240u8, 255u8)
                opl_audio.play(s, snd.sfx_bounce)
            if w.shot.x > right then
                w.shot.x = right
                w.shot.vx = -w.shot.vx
                spawn_burst(w, rng, w.shot.x + 6.0, w.shot.y, 3, 220u8, 240u8, 255u8)
                opl_audio.play(s, snd.sfx_bounce)

            let popped = metal_smash(w, rng, w.shot.x, w.shot.y)
            if popped > 0 then
                gained = gained + popped * 10
                opl_audio.play(s, snd.sfx_pop)

            if w.shot.y - (f64) bubble_r <= (f64) ceiling_y then
                w.shot.active = false

        if !w.shot.active then
            let px = (i32) w.shot.x
            let py = (i32) w.shot.y
            let dropped = drop_floaters(w, rng)
            if dropped > 0 then
                gained = gained + drop_score(dropped)
                opl_audio.play(s, snd.sfx_drop)
            finish_turn(w, rng, s, gained, px, py)

    let update_shot = (w: world*, rng: pcg_random*, s: opl_audio.audio*) ->
        if !w.shot.active then
            return
        if w.shot.color == shot_metal then
            update_metal(w, rng, s)
            return
        for step in 0..shot_substeps do
            if !w.shot.active then break
            w.shot.x = w.shot.x + w.shot.vx
            w.shot.y = w.shot.y + w.shot.vy

            let left = (f64) (field_x0 + bubble_r)
            let right = (f64) (field_x1 - bubble_r)
            if w.shot.x < left then
                w.shot.x = left
                w.shot.vx = -w.shot.vx
                spawn_burst(w, rng, w.shot.x - 6.0, w.shot.y, 3, 220u8, 240u8, 255u8)
                opl_audio.play(s, snd.sfx_bounce)
            if w.shot.x > right then
                w.shot.x = right
                w.shot.vx = -w.shot.vx
                spawn_burst(w, rng, w.shot.x + 6.0, w.shot.y, 3, 220u8, 240u8, 255u8)
                opl_audio.play(s, snd.sfx_bounce)

            if w.shot.y - (f64) bubble_r <= (f64) ceiling_y then
                w.shot.y = (f64) (ceiling_y + bubble_r)
                land_shot(w, rng, s)
            else if hits_bubble(w, w.shot.x, w.shot.y) then
                land_shot(w, rng, s)
            else if w.shot.y > (f64) (field_y1 + 40) then
                // Belt and braces: a shot can only travel upward, but never let
                // one escape the field and hang the turn.
                w.shot.active = false

    let fire = (w: world*, rng: pcg_random*, s: opl_audio.audio*) ->
        if w.shot.active then
            return
        let a = deg2rad(w.game.angle)
        let per_step = shot_speed / (f64) shot_substeps
        w.shot.x = (f64) shooter_x
        w.shot.y = (f64) shooter_y
        w.shot.vx = math.sin(a) * per_step
        w.shot.vy = -math.cos(a) * per_step
        w.shot.color = w.game.cur_color
        w.shot.active = true
        w.game.cur_color = w.game.next_color
        w.game.next_color = pick_launcher(w, rng)
        w.game.shots_fired = w.game.shots_fired + 1
        w.game.idle_timer = 0
        opl_audio.play(s, snd.sfx_shoot)

    // ============================================================
    // Round setup
    // ============================================================

    let start_level = (w: world*, rng: pcg_random*) ->
        w.shot.active = false
        clear_fallers(w)
        build_level(w, rng)
        w.game.drop_interval = drop_interval_for(count_colors_in_play(w))
        w.game.shots_left = w.game.drop_interval
        w.game.cur_color = pick_launcher(w, rng)
        w.game.next_color = pick_launcher(w, rng)
        w.game.angle = 0.0
        w.game.idle_timer = 0
        w.game.level_frames = 0
        w.game.popup_timer = 0
        w.game.phase = game_phase.playing
        w.game.phase_timer = 0

    let reset_game = (w: world*, rng: pcg_random*) ->
        w.game.level = 1
        w.game.score = 0
        w.game.new_high = false
        w.game.shots_fired = 0
        clear_particles(w)
        start_level(w, rng)

    // ============================================================
    // High score persistence
    // ============================================================

    let load_high_score = () ->
        match sys.home_dir() with
        | some(hd) ->
            match io.open(alloca("%s{hd}/.fuzzel-fobble/highscore.txt"), "r") with
            | ok(fp) ->
                let mut buf = u8[32] { }
                let n = io.read(buf, 32, fp)
                ignore io.close(fp)  // best-effort: contents already read
                match text.parse_i32(text.trim((const str) buf[0..n])) with
                | ok(v) -> v
                | err(_) -> 0
            | err(_) -> 0
        | none -> 0

    let save_high_score = (score: i32) ->
        match sys.home_dir() with
        | some(hd) ->
            ignore io.mkdir(alloca("%s{hd}/.fuzzel-fobble"))  // may already exist
            match io.open(alloca("%s{hd}/.fuzzel-fobble/highscore.txt"), "w") with
            | ok(fp) ->
                io.write("%d{score}\n", fp)
                ignore io.close(fp)  // best-effort: a lost high score is not an error
                return
            | err(_) -> return
        | none -> return

    // ============================================================
    // The world, and one frame of it
    //
    // `create` and `step` are the whole of what main.fc calls. Everything
    // above is reachable only through them — plus the handful of readers
    // art.fc uses to draw the board it is looking at.
    // ============================================================

    // Builds the world and everything it owns, and leaves it sitting on the
    // splash with a real board already behind it. `game_state` and `shot`
    // live inline in the struct and start zero-filled — alloc zero-fills.
    let create = (rng: pcg_random*) ->
        let w = alloc(world)!
        w.grid = alloc(i32[grid_cells] { })!
        w.mark = alloc(i32[grid_cells] { })!
        w.anchor = alloc(i32[grid_cells] { })!
        w.stack = alloc(i32[grid_cells] { })!
        w.fallers = alloc(faller[max_fallers] { })!
        w.particles = alloc(particle[max_particles] { })!
        w.drifters = alloc(drifter[max_drifters] { })!

        w.game.high_score = load_high_score()
        w.game.level = 1
        // The colour-blind marks are an aid, not the default look.
        w.game.show_symbols = false
        w.game.angle = 0.0
        start_level(w, rng)
        w.game.phase = game_phase.splash
        init_drifters(w, rng)
        w

    // Starting a run: the same thing from the splash and from a game over,
    // tune included.
    private let start_run = (w: world*, rng: pcg_random*, s: opl_audio.audio*) ->
        reset_game(w, rng)
        opl_audio.music_begin(s)

    // One frame: what the player asked for, then what the world does about
    // it. `inp` is the platform's report of this frame's input, already in
    // the game's own vocabulary — no key codes reach this far.
    let step = (w: world*, inp: const input*, rng: pcg_random*,
                s: opl_audio.audio*) ->
        // --------- What the player asked for ---------
        // Fire doubles as "get on with it" on the two standing-still
        // screens, because reaching for a different key to start a game you
        // are already holding the fire key for is a small daily annoyance.
        if plat.tap(inp, plat.fire) then
            match w.game.phase with
            | playing -> fire(w, rng, s)
            | splash -> start_run(w, rng, s)
            | game_over -> start_run(w, rng, s)
            | _ -> void()

        if plat.tap(inp, plat.start) then
            match w.game.phase with
            | splash -> start_run(w, rng, s)
            | game_over -> start_run(w, rng, s)
            | _ -> void()

        if plat.tap(inp, plat.swap) then
            match w.game.phase with
            | playing ->
                if !w.shot.active then
                    let tmp = w.game.cur_color
                    w.game.cur_color = w.game.next_color
                    w.game.next_color = tmp
            | _ -> void()

        if plat.tap(inp, plat.pause) then
            match w.game.phase with
            | playing ->
                w.game.phase = game_phase.paused
                // Hold, don't end: the tune picks up mid-phrase where it
                // left off.
                opl_audio.music_hold(s)
            | paused ->
                w.game.phase = game_phase.playing
                opl_audio.music_unhold(s)
            | _ -> void()

        if plat.tap(inp, plat.symbols) then
            w.game.show_symbols = !w.game.show_symbols

        if plat.tap(inp, plat.mute) then
            opl_audio.music_toggle_mute(s)

        if plat.tap(inp, plat.clear_best) then
            match w.game.phase with
            | splash ->
                w.game.high_score = 0
                match sys.home_dir() with
                | some(hd) ->
                    ignore io.remove(alloca("%s{hd}/.fuzzel-fobble/highscore.txt"))
                    void()
                | none -> void()
            | _ -> void()

        // --------- What the world does about it ---------
        // The decoration runs in every phase, splash included: a paused
        // board that freezes solid looks broken rather than paused.
        update_drifters(w, rng)
        update_particles(w)
        update_fallers(w)
        if w.game.popup_timer > 0 then
            w.game.popup_timer = w.game.popup_timer - 1

        match w.game.phase with
        | playing ->
            w.game.level_frames = w.game.level_frames + 1
            if plat.down(inp, plat.aim_left) then
                w.game.angle = w.game.angle - aim_speed
            if plat.down(inp, plat.aim_right) then
                w.game.angle = w.game.angle + aim_speed
            if w.game.angle < -aim_limit then
                w.game.angle = -aim_limit
            if w.game.angle > aim_limit then
                w.game.angle = aim_limit
            update_shot(w, rng, s)
            // The turn clock only runs while the shot is yours to take. Sit
            // on it long enough and the launcher fires wherever you left it
            // aimed — deliberating is a cost, not a free action.
            if w.shot.active then
                w.game.idle_timer = 0
            else
                w.game.idle_timer = w.game.idle_timer + 1
                if w.game.idle_timer >= hurry_fire then
                    fire(w, rng, s)
        | level_clear ->
            w.game.phase_timer = w.game.phase_timer - 1
            if w.game.phase_timer <= 0 then
                w.game.level = w.game.level + 1
                start_level(w, rng)
        | game_over ->
            // Lock in the best score exactly once on entering game_over.
            if w.game.phase_timer == 0 then
                w.game.phase_timer = 1
                if w.game.score > w.game.high_score then
                    w.game.high_score = w.game.score
                    w.game.new_high = true
                    save_high_score(w.game.score)
                    io.write("NEW BEST: %d{w.game.score}\n", stdout)
        | _ -> void()
