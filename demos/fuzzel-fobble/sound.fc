// Fuzzel Fobble — the sounds themselves.
//
// The engine is demos/shared/opl_audio.fc (OPL2 voices, an effect bank, a
// three-part music sequencer, and SDL's audio callback); the chip it plays
// through is demos/shared/opl2.fc. This file is only the content: eleven
// instruments, nine effect scripts, and one nursery tune.
//
// Reading an instrument: the modulator's TL is brightness, the carrier's
// TL is volume (and counts down — 0 is loudest), MULT is the frequency
// ratio that picks the timbre, and the EGT bit says whether a note holds
// while the key is down or decays away on its own. The engine's header
// comment has the longer version.

module snd =

    // ============================================================
    // Music voices
    // ============================================================

    // Melody: a music box. Modulator at 3× the carrier gives the
    // inharmonic ring of a struck metal bar, and both operators are
    // percussive (EGT clear) so a note blooms and fades on its own without
    // anyone having to release it. The ~1.2 s ring is twice the length of
    // a note at this tempo, which is what puts the shimmer of one note
    // under the next.
    private let ins_music_box = opl_audio.instrument {
        m_char = 0x03, m_scale = 0x53, m_atk = 0xF4, m_sus = 0x36, m_wave = 0x00,
        c_char = 0x01, c_scale = 0x02, c_atk = 0xF4, c_sus = 0x36, c_wave = 0x00,
        n_conn = 0x00 }

    // Bass: 1:1 ratio with heavy feedback — feedback on a 1:1 pair is what
    // turns the carrier's sine into a saw, which is the round, woody
    // bottom end this needs. Plucked, medium decay.
    private let ins_bass = opl_audio.instrument {
        m_char = 0x01, m_scale = 0x18, m_atk = 0xF4, m_sus = 0x36, m_wave = 0x00,
        c_char = 0x01, c_scale = 0x0B, c_atk = 0xF3, c_sus = 0x26, c_wave = 0x00,
        n_conn = 0x0A }

    // Inner arpeggio: the same music-box idea run quiet and short, so it
    // fills the gaps between melody notes without ever competing.
    private let ins_chime = opl_audio.instrument {
        m_char = 0x14, m_scale = 0x9A, m_atk = 0xF7, m_sus = 0x58, m_wave = 0x00,
        c_char = 0x11, c_scale = 0x4A, c_atk = 0xF6, c_sus = 0x37, c_wave = 0x00,
        n_conn = 0x00 }

    // ============================================================
    // Effect voices
    // ============================================================

    // Instrument slots, in the order the table below lists them.
    private let i_shoot   = 0
    private let i_bounce  = 1
    private let i_stick   = 2
    private let i_pop     = 3
    private let i_drop    = 4
    private let i_star    = 5
    private let i_descend = 6
    private let i_fanfare = 7
    private let i_reed    = 8

    private let instruments = opl_audio.instrument[9] {
        // Launch: 4:1 with deep modulation and feedback — the buzzy,
        // hollow "fwip" of something spat out of a tube. Gone in 150 ms;
        // the shot is on screen for a second and a half, and a launch
        // sound that outlasts the launch is one you stop noticing.
        opl_audio.instrument {
            m_char = 0x04, m_scale = 0x0B, m_atk = 0xF8, m_sus = 0x68, m_wave = 0x01,
            c_char = 0x01, c_scale = 0x04, c_atk = 0xF7, c_sus = 0x58, c_wave = 0x00,
            n_conn = 0x0A },
        // Wall bounce: a dry tick. Quiet and short by design — it fires
        // several times on a bank shot and must never draw attention.
        opl_audio.instrument {
            m_char = 0x02, m_scale = 0x1C, m_atk = 0xF9, m_sus = 0x69, m_wave = 0x00,
            c_char = 0x01, c_scale = 0x11, c_atk = 0xF8, c_sus = 0x39, c_wave = 0x00,
            n_conn = 0x00 },
        // Landing: a soft rubbery "thock". 1:1 with feedback and a fast
        // decay reads as something settling into place rather than
        // striking.
        opl_audio.instrument {
            m_char = 0x01, m_scale = 0x12, m_atk = 0xF8, m_sus = 0x78, m_wave = 0x00,
            c_char = 0x01, c_scale = 0x05, c_atk = 0xF7, c_sus = 0x57, c_wave = 0x00,
            n_conn = 0x08 },
        // Pop: half-sine on the modulator adds the odd harmonics that make
        // a short blip read as *wet* rather than as a beep.
        opl_audio.instrument {
            m_char = 0x02, m_scale = 0x0E, m_atk = 0xF7, m_sus = 0x67, m_wave = 0x01,
            c_char = 0x01, c_scale = 0x02, c_atk = 0xF6, c_sus = 0x47, c_wave = 0x00,
            n_conn = 0x02 },
        // Falling bubbles: the pop voice softened, so a glissando down it
        // doesn't machine-gun.
        opl_audio.instrument {
            m_char = 0x02, m_scale = 0x11, m_atk = 0xF5, m_sus = 0x45, m_wave = 0x00,
            c_char = 0x01, c_scale = 0x03, c_atk = 0xF6, c_sus = 0x36, c_wave = 0x00,
            n_conn = 0x00 },
        // Star burst: 7:1 is far enough up the harmonic series to be pure
        // glitter, with a long release so the sparkle hangs in the air.
        // Key scaling stays off — both KSR and KSL are pitch-dependent,
        // and up where this voice lives they would shorten it and quieten
        // it at exactly the moment it is supposed to ring out.
        opl_audio.instrument {
            m_char = 0x07, m_scale = 0x51, m_atk = 0xF3, m_sus = 0x25, m_wave = 0x00,
            c_char = 0x01, c_scale = 0x03, c_atk = 0xF4, c_sus = 0x26, c_wave = 0x00,
            n_conn = 0x00 },
        // Ceiling descent: a half-multiple modulator puts its sidebands an
        // octave below the note itself, which is how you get weight out of
        // a chip with no noise generator. Slow attack, so it grinds in
        // rather than hits.
        opl_audio.instrument {
            m_char = 0x20, m_scale = 0x05, m_atk = 0xC4, m_sus = 0x04, m_wave = 0x00,
            c_char = 0x21, c_scale = 0x03, c_atk = 0xD4, c_sus = 0x05, c_wave = 0x00,
            n_conn = 0x0C },
        // Level clear: a brass fanfare. Both operators sustain (EGT set)
        // at SL 0, so the notes hold at full weight for as long as the key
        // is down — SL 15 would *not* do that, the chip reads it as "decay
        // all the way out" — and feedback supplies the edge that makes
        // brass sound like brass.
        opl_audio.instrument {
            m_char = 0x21, m_scale = 0x0F, m_atk = 0xB4, m_sus = 0x06, m_wave = 0x00,
            c_char = 0x21, c_scale = 0x01, c_atk = 0xA4, c_sus = 0x06, c_wave = 0x00,
            n_conn = 0x0C },
        // Game over: a soft reed, sustaining, with a slow release that
        // lets the last note sag out instead of stopping.
        opl_audio.instrument {
            m_char = 0x21, m_scale = 0x1A, m_atk = 0x94, m_sus = 0x05, m_wave = 0x00,
            c_char = 0x21, c_scale = 0x03, c_atk = 0x93, c_sus = 0x06, c_wave = 0x00,
            n_conn = 0x06 }
    }

    // ============================================================
    // Effect scripts
    // ============================================================

    // Sound ids, as the game names them.
    let sfx_shoot   = 0
    let sfx_bounce  = 1
    let sfx_stick   = 2
    let sfx_pop     = 3
    let sfx_drop    = 4
    let sfx_star    = 5
    let sfx_descend = 6
    let sfx_clear   = 7
    let sfx_over    = 8
    let sfx_count   = 9

    // Effects tick at 140 Hz — the AdLib driver rate, and about as fine as
    // a pitch sweep needs before the steps stop being audible.
    private let tick_rate = 140

    // Every effect's steps, end to end: (note, ticks) pairs, where a note
    // is `octave * 12 + semitone` and 48 is middle C. The table below
    // slices this up; the step counts in the two must agree, which is why
    // each script sits on its own line here in the same order.
    private let script = i32[66] {
        72,1, 79,1, 84,3,                                       // shoot     3
        64,3,                                                   // bounce    1
        50,2, 45,3,                                             // stick     2
        76,1, 83,1, 88,3,                                       // pop       3
        84,1, 79,1, 74,1, 69,1, 64,1, 59,4,                     // drop      6
        67,1, 72,1, 76,1, 79,1, 76,1, 79,1, 83,6,               // star      7
        40,3, 36,4, 31,7,                                       // descend   3
        60,10, 64,10, 67,10, 72,34,                             // clear     4
        55,18, 52,18, 48,22, 43,46                              // over      4
    }

    private let sounds = opl_audio.sound[9] {
        opl_audio.sound { instr = i_shoot,   first = 0,  steps = 3 },
        opl_audio.sound { instr = i_bounce,  first = 3,  steps = 1 },
        opl_audio.sound { instr = i_stick,   first = 4,  steps = 2 },
        opl_audio.sound { instr = i_pop,     first = 6,  steps = 3 },
        opl_audio.sound { instr = i_drop,    first = 9,  steps = 6 },
        opl_audio.sound { instr = i_star,    first = 15, steps = 7 },
        opl_audio.sound { instr = i_descend, first = 22, steps = 3 },
        opl_audio.sound { instr = i_fanfare, first = 25, steps = 4 },
        opl_audio.sound { instr = i_reed,    first = 29, steps = 4 }
    }

    // ============================================================
    // The tune — "Twinkle, Twinkle, Little Star"
    // ============================================================

    private let tempo_bpm = 100

    // Melody as (note, length in eighths — the grid is set to 2 steps
    // per beat below). Twelve bars of 4/4 and a half-bar breath: 100
    // eighths, exactly the span the 25-entry chord table covers.
    private let melody = i32[86] {
        60,2, 60,2, 67,2, 67,2,     // Twin-kle twin-kle lit-tle star,
        69,2, 69,2, 67,4,           // how I won-der what you are.
        65,2, 65,2, 64,2, 64,2,     // Up a-bove the world so high,
        62,2, 62,2, 60,4,           // like a dia-mond in the sky.
        67,2, 67,2, 65,2, 65,2,     // Twin-kle twin-kle lit-tle star,
        64,2, 64,2, 62,4,           // how I won-der what you are.
        67,2, 67,2, 65,2, 65,2,
        64,2, 64,2, 62,4,
        60,2, 60,2, 67,2, 67,2,
        69,2, 69,2, 67,4,
        65,2, 65,2, 64,2, 64,2,
        62,2, 62,2, 60,4,
        -1,4                        // breath before the loop
    }

    // One chord per half-bar: 0 = C, 1 = F, 2 = G. Twenty-five of them,
    // the last carrying the breath, which is what makes the loop land back
    // on the tonic instead of butting one phrase against the next.
    private let chords = i32[25] {
        0,0,  1,0,   1,0,  2,0,
        0,1,  0,2,   0,1,  0,2,
        0,0,  1,0,   1,0,  2,0,
        0
    }

    // Root of each chord, two octaves under the melody's C.
    private let roots = i32[3] { 36, 41, 43 }

    // Four arpeggio notes per chord, voiced as inversions so the line
    // stays inside one octave and walks by step between chords rather than
    // leaping.
    private let arps = i32[12] {
        48, 52, 55, 52,     // C major:  C E G E
        48, 53, 57, 53,     // F major:  C F A F
        47, 50, 55, 50      // G major:  B D G D
    }

    // ============================================================
    // Assembly
    // ============================================================

    // Per-source trim. Music sits under the effects on purpose — it is a
    // nursery tune playing behind a game, not the thing you are meant to
    // be listening to.
    private let music_gain = 0.85
    private let sfx_gain   = 2.00

    // Build the engine with this game's sounds in it. The device is opened
    // separately by `opl_audio.start`, once the caller is ready to be
    // heard.
    let init = (sample_rate: i32) ->
        opl_audio.init(sample_rate,
            opl_audio.bank {
                instruments = instruments,
                sounds = sounds,
                script = script,
                tick_rate = tick_rate },
            opl_audio.song {
                melody = melody,
                chords = chords,
                roots = roots,
                arps = arps,
                grid = 2,           // eighth-note resolution
                arp_len = 4,
                bpm = tempo_bpm,
                lead = ins_music_box,
                bass = ins_bass,
                arp = ins_chime },
            music_gain, sfx_gain)
