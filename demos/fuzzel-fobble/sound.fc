// Fuzzel Fobble — the sounds themselves.
//
// The engine is demos/shared/opl_audio.fc (OPL2 voices, an effect bank, and
// the audio callback); the chip it plays through is demos/shared/opl2.fc.
// This file is only the effects: ten instruments and ten scripts.
//
// The music is not here any more. It is a Standard MIDI File in music/,
// played by demos/shared/opl_midi.fc through the instrument bank in
// demos/shared/opl_bank_gm.fc — so the tune is swappable at run time and this
// file has nothing to say about it beyond the gain it is mixed at.
//
// Reading an instrument: the modulator's TL is brightness, the carrier's
// TL is volume (and counts down — 0 is loudest), MULT is the frequency
// ratio that picks the timbre, and the EGT bit says whether a note holds
// while the key is down or decays away on its own. The engine's header
// comment has the longer version.
//
// Release rates — the low nibble of `*_sus` — are load-bearing here, which
// they did not used to be. `opl2.note_off` once wrote a zero F-number along
// with the key bit, which froze the operator's phase, so an effect's release
// came out as a decaying DC thump instead of the note dying away at pitch.
// That was a chip bug and it is fixed; the consequence is that four of these
// instruments were carrying release rates nobody had ever heard, and their
// tails ran two to thirteen times longer than the comments beside them claim
// (`stick` 319 ms, `pop` 253, `drop` 559, `descend` 1357). Retuned by
// measurement — render one effect at a time and time the decay to 0.1% of
// full scale — they now land at 176, 144, 311 and 414 ms. The other five
// were already right and are untouched.

import opl_audio from shared::
import opl_midi from shared::

module snd =

    // ============================================================
    // Effect voices
    // ============================================================

    // Instrument slots, in the order the table below lists them.
    private let i_shoot   = 0
    private let i_bounce  = 1
    private let i_stick   = 2
    private let i_pop     = 3
    private let i_drop    = 4
    private let i_star    = 5
    private let i_descend = 6
    private let i_fanfare = 7
    private let i_reed    = 8
    private let i_grind   = 9

    private let instruments = opl_audio.instrument[10] {
        // Launch: 4:1 with deep modulation and feedback — the buzzy,
        // hollow "fwip" of something spat out of a tube. Gone in 150 ms;
        // the shot is on screen for a second and a half, and a launch
        // sound that outlasts the launch is one you stop noticing.
        opl_audio.instrument {
            m_char = 0x04, m_scale = 0x0B, m_atk = 0xF8, m_sus = 0x68, m_wave = 0x01,
            c_char = 0x01, c_scale = 0x04, c_atk = 0xF7, c_sus = 0x58, c_wave = 0x00,
            n_conn = 0x0A },
        // Wall bounce: a dry tick. Quiet and short by design — it fires
        // several times on a bank shot and must never draw attention.
        opl_audio.instrument {
            m_char = 0x02, m_scale = 0x1C, m_atk = 0xF9, m_sus = 0x69, m_wave = 0x00,
            c_char = 0x01, c_scale = 0x11, c_atk = 0xF8, c_sus = 0x39, c_wave = 0x00,
            n_conn = 0x00 },
        // Landing: a soft rubbery "thock". 1:1 with feedback and a fast
        // decay reads as something settling into place rather than
        // striking.
        opl_audio.instrument {
            m_char = 0x01, m_scale = 0x12, m_atk = 0xF8, m_sus = 0x78, m_wave = 0x00,
            c_char = 0x01, c_scale = 0x05, c_atk = 0xF7, c_sus = 0x58, c_wave = 0x00,
            n_conn = 0x08 },
        // Pop: half-sine on the modulator adds the odd harmonics that make
        // a short blip read as *wet* rather than as a beep.
        opl_audio.instrument {
            m_char = 0x02, m_scale = 0x0E, m_atk = 0xF7, m_sus = 0x68, m_wave = 0x01,
            c_char = 0x01, c_scale = 0x02, c_atk = 0xF6, c_sus = 0x48, c_wave = 0x00,
            n_conn = 0x02 },
        // Falling bubbles: the pop voice softened, so a glissando down it
        // doesn't machine-gun.
        opl_audio.instrument {
            m_char = 0x02, m_scale = 0x11, m_atk = 0xF5, m_sus = 0x47, m_wave = 0x00,
            c_char = 0x01, c_scale = 0x03, c_atk = 0xF6, c_sus = 0x37, c_wave = 0x00,
            n_conn = 0x00 },
        // Star burst: 7:1 is far enough up the harmonic series to be pure
        // glitter, with a long release so the sparkle hangs in the air.
        // Key scaling stays off — both KSR and KSL are pitch-dependent,
        // and up where this voice lives they would shorten it and quieten
        // it at exactly the moment it is supposed to ring out.
        opl_audio.instrument {
            m_char = 0x07, m_scale = 0x51, m_atk = 0xF3, m_sus = 0x25, m_wave = 0x00,
            c_char = 0x01, c_scale = 0x03, c_atk = 0xF4, c_sus = 0x26, c_wave = 0x00,
            n_conn = 0x00 },
        // Ceiling descent: a half-multiple modulator puts its sidebands an
        // octave below the note itself, which is how you get weight out of
        // a chip with no noise generator. Slow attack, so it grinds in
        // rather than hits.
        opl_audio.instrument {
            m_char = 0x20, m_scale = 0x05, m_atk = 0xC4, m_sus = 0x07, m_wave = 0x00,
            c_char = 0x21, c_scale = 0x03, c_atk = 0xD4, c_sus = 0x07, c_wave = 0x00,
            n_conn = 0x0C },
        // Level clear: a brass fanfare. Both operators sustain (EGT set)
        // at SL 0, so the notes hold at full weight for as long as the key
        // is down — SL 15 would *not* do that, the chip reads it as "decay
        // all the way out" — and feedback supplies the edge that makes
        // brass sound like brass.
        //
        // That sustain is also why the carrier sits at TL 5 rather than up
        // near 0 where it started. Peak is the wrong yardstick for this
        // voice: every other effect here is a transient that is gone inside
        // 300 ms, while this one holds its peak for the better part of a
        // second, so matching their peak makes it the loudest thing in the
        // game by a distance. Rendered one at a time, the bank peaks
        // between 1.8k and 6.9k; at TL 1 the fanfare hit 7.5k, above all of
        // them. TL 5 is 3 dB down from there — 5.3k, inside the pack — and
        // the fanfare reads as a flourish over the game rather than a
        // gear change in the mix.
        opl_audio.instrument {
            m_char = 0x21, m_scale = 0x0F, m_atk = 0xB4, m_sus = 0x06, m_wave = 0x00,
            c_char = 0x21, c_scale = 0x05, c_atk = 0xA4, c_sus = 0x06, c_wave = 0x00,
            n_conn = 0x0C },
        // Game over: a soft reed, sustaining, with a slow release that
        // lets the last note sag out instead of stopping.
        opl_audio.instrument {
            m_char = 0x21, m_scale = 0x1A, m_atk = 0x94, m_sus = 0x05, m_wave = 0x00,
            c_char = 0x21, c_scale = 0x03, c_atk = 0x93, c_sus = 0x06, c_wave = 0x00,
            n_conn = 0x06 },
        // Metal on stone: a scrape rather than a note. Maximum feedback (FB 7)
        // drives the modulator into chaos, which is as close to noise as a
        // melodic OPL2 voice gets — the chip's only true noise source is in
        // rhythm mode, which the effect voices don't use. A 15:1 ratio then
        // puts the sidebands nowhere near a harmonic series, and pulse-sine on
        // the modulator adds the harsh odd harmonics a sine would round off.
        // The carrier's own MULT is 4, not the 1 every other voice here uses,
        // and that is what buys the inharmonicity: FM puts sidebands at
        // carrier +/- n*modulator, so 1:15 lands them on 1, 14, 16, 29 - whole
        // multiples of the fundamental, i.e. a harmonic series after all.
        // Against a carrier of 4 the same sidebands land on 4, 11, 19, 26,
        // which read against that fundamental as 1, 2.75, 4.75, 6.5. Nothing
        // there is a whole multiple of anything, which is the clang.
        // Deep modulation (modulator TL 0, i.e. as deep as the chip goes) is the
        // whole character here; back it off and this collapses into an ordinary
        // buzz.
        //
        // The carrier stays on wave 0 like every voice above it, and that is
        // not a stylistic choice: OPL2 waveforms 1-3 are all unipolar (the
        // negative half is zeroed, folded, or gated away), so one on a *carrier*
        // rectifies the voice's output and what you hear is a DC thud rather
        // than a note. On a modulator the same wave shapes phase, not output,
        // which is where it belongs.
        opl_audio.instrument {
            m_char = 0x0E, m_scale = 0x00, m_atk = 0xF2, m_sus = 0x6A, m_wave = 0x03,
            c_char = 0x04, c_scale = 0x04, c_atk = 0xF4, c_sus = 0x4A, c_wave = 0x00,
            n_conn = 0x0E }
    }

    // ============================================================
    // Effect scripts
    // ============================================================

    // Sound ids, as the game names them.
    let sfx_shoot   = 0
    let sfx_bounce  = 1
    let sfx_stick   = 2
    let sfx_pop     = 3
    let sfx_drop    = 4
    let sfx_star    = 5
    let sfx_descend = 6
    let sfx_clear   = 7
    let sfx_over    = 8
    let sfx_grind   = 9
    let sfx_count   = 10

    // Effects tick at 140 Hz — the AdLib driver rate, and about as fine as
    // a pitch sweep needs before the steps stop being audible.
    private let tick_rate = 140

    // Every effect's steps, end to end: (note, ticks) pairs, where a note
    // is `octave * 12 + semitone` and 48 is middle C. The table below
    // slices this up; the step counts in the two must agree, which is why
    // each script sits on its own line here in the same order.
    private let script = i32[98] {
        72,1, 79,1, 84,3,                                       // shoot     3
        64,3,                                                   // bounce    1
        50,2, 45,3,                                             // stick     2
        76,1, 83,1, 88,3,                                       // pop       3
        84,1, 79,1, 74,1, 69,1, 64,1, 59,4,                     // drop      6
        67,1, 72,1, 76,1, 79,1, 76,1, 79,1, 83,6,               // star      7
        40,3, 36,4, 31,7,                                       // descend   3
        60,10, 64,10, 67,10, 72,34,                             // clear     4
        55,18, 52,18, 48,22, 43,46,                             // over      4
        72,1, 65,1, 69,1, 62,1, 66,1, 59,1, 63,1, 56,1,         // grind    16
        60,1, 53,1, 57,1, 50,1, 54,1, 48,1, 52,1, 46,4
    }

    private let sounds = opl_audio.sound[10] {
        opl_audio.sound { instr = i_shoot,   first = 0,  steps = 3 },
        opl_audio.sound { instr = i_bounce,  first = 3,  steps = 1 },
        opl_audio.sound { instr = i_stick,   first = 4,  steps = 2 },
        opl_audio.sound { instr = i_pop,     first = 6,  steps = 3 },
        opl_audio.sound { instr = i_drop,    first = 9,  steps = 6 },
        opl_audio.sound { instr = i_star,    first = 15, steps = 7 },
        opl_audio.sound { instr = i_descend, first = 22, steps = 3 },
        opl_audio.sound { instr = i_fanfare, first = 25, steps = 4 },
        opl_audio.sound { instr = i_reed,    first = 29, steps = 4 },
        // Sixteen steps rather than one note: each step re-keys the voice, so
        // the rasp is the re-attacks. They also walk downward in a jagged
        // zig-zag, two steps down for one back up, which is what turns a flat
        // buzz into something dragging its way down the face of the stone.
        opl_audio.sound { instr = i_grind,   first = 33, steps = 16 }
    }

    // ============================================================
    // Assembly
    // ============================================================

    // Per-source trim. Music sits under the effects on purpose — it is a
    // minuet playing behind a game, not the thing you are meant to be
    // listening to.
    private let music_gain = 0.85
    private let sfx_gain   = 2.00

    // Build the engine with this game's sounds in it, over a music player
    // the caller has already loaded a song into. The device is opened
    // separately by the backend, once the caller is ready to be heard.
    let init = (sample_rate: i32, music: opl_midi.player*) ->
        opl_audio.init(sample_rate,
            opl_audio.bank {
                instruments = instruments,
                sounds = sounds,
                script = script,
                tick_rate = tick_rate },
            music, music_gain, sfx_gain)
