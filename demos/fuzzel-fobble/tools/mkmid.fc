// Writes Fuzzel Fobble's music out as a Standard MIDI File.
//
// The tune is an arrangement of the **Minuet in G major, BWV Anh. 114** — the
// one everybody knows from the *Notebook for Anna Magdalena Bach*, and which
// scholarship now attributes to Christian Petzold rather than to Bach himself.
// Public domain either way; the credit is the only thing in question.
//
// The melody and the harmony are the Minuet's. The voicing — which instrument
// plays what, the inner line, the chords, the drum part — is this file's, and
// exists to give the player something multi-timbral to chew on: the piece runs
// twice, thinly the first time and fully scored the second.
//
//     bars  1-16   music box melody, pizzicato bass, light hi-hat
//     bars 17-32   the same, plus a celesta inner line, harpsichord chords
//                  and a fuller drum part
//
// Six tracks in SMF format 1, five sounding channels, and up to eight
// simultaneous notes in the second half — enough to work the voice allocator
// without pinning it. The two note-off encodings are used deliberately: the
// melody and bass end notes with a real 0x80 status, the other parts with the
// 0x90-and-velocity-zero form, so the shipped file exercises both paths
// through `opl_midi.parse`. Running status is emitted wherever it applies, for
// the same reason.
//
// Run it once and check the result in; it is here for provenance and so the
// tune stays editable as music rather than as bytes.
//
//     fcc demos/fuzzel-fobble/tools/mkmid.fc stdlib/io.fc stdlib/text.fc -o /tmp/mkmid.c
//     cc -std=c11 -o /tmp/mkmid /tmp/mkmid.c && /tmp/mkmid demos/fuzzel-fobble/music/minuet.mid

import io from std::

// ============================================================
// The music
// ============================================================

module tune =

    // Ticks per quarter note, and the bar length that follows from 3/4 time.
    let division = 480
    let beat = 480
    let bar = 1440
    let half = 960
    let eighth = 240

    // Sixteen bars, one pass. Sixteen more of the same follow it, and the
    // whole thing loops on the bar line at the end of the second.
    let pass_ticks = 16 * 1440
    let song_ticks = 32 * 1440

    // ---- Melody --------------------------------------------------
    //
    // (note, duration) pairs, played end to end with no rests, so the bar
    // lines below are a reading aid rather than something the data encodes.
    // Middle C is 60, so the tune sits between F#4 (66) and G5 (79).
    let melody = i32[128] {
        74, 480,  67, 240,  69, 240,  71, 240,  72, 240,   // 1   d' | g a b c
        74, 480,  67, 480,  67, 480,                       // 2   d' | g | g
        76, 480,  72, 240,  74, 240,  76, 240,  78, 240,   // 3   e' | c d e f#
        79, 480,  67, 480,  67, 480,                       // 4   g' | g | g
        72, 480,  74, 240,  72, 240,  71, 240,  69, 240,   // 5   c  | d c b a
        71, 480,  72, 240,  71, 240,  69, 240,  67, 240,   // 6   b  | c b a g
        66, 480,  67, 240,  69, 240,  71, 240,  67, 240,   // 7   f# | g a b g
        69, 1440,                                          // 8   a......
        74, 480,  67, 240,  69, 240,  71, 240,  72, 240,   // 9   (as bar 1)
        74, 480,  67, 480,  67, 480,                       // 10
        76, 480,  72, 240,  74, 240,  76, 240,  78, 240,   // 11
        79, 480,  67, 480,  67, 480,                       // 12
        72, 480,  74, 240,  72, 240,  71, 240,  69, 240,   // 13
        71, 480,  72, 240,  71, 240,  69, 240,  67, 240,   // 14
        69, 480,  71, 240,  69, 240,  67, 240,  66, 240,   // 15  a  | b a g f#
        67, 1440 }                                         // 16  g......

    // ---- Bass ----------------------------------------------------
    //
    // Root on the downbeat, fifth on the third beat — the plain minuet
    // pattern. The harmony it spells out is
    //   G G C G/B C G D D  G G C G/B C G D G
    let bass = i32[60] {
        43, 960,  50, 480,                                 // 1   G
        43, 960,  50, 480,                                 // 2   G
        48, 960,  55, 480,                                 // 3   C
        47, 960,  50, 480,                                 // 4   G/B
        48, 960,  55, 480,                                 // 5   C
        43, 960,  50, 480,                                 // 6   G
        50, 960,  45, 480,                                 // 7   D
        50, 1440,                                          // 8   D
        43, 960,  50, 480,                                 // 9   G
        43, 960,  50, 480,                                 // 10  G
        48, 960,  55, 480,                                 // 11  C
        47, 960,  50, 480,                                 // 12  G/B
        48, 960,  55, 480,                                 // 13  C
        43, 960,  50, 480,                                 // 14  G
        50, 960,  45, 480,                                 // 15  D
        43, 1440 }                                         // 16  G

    // ---- Inner line ----------------------------------------------
    //
    // One sustained note per bar, sitting an octave under the melody and
    // moving as little as the harmony allows. It is there to thicken the
    // second pass, not to be noticed.
    let inner = i32[16] {
        59, 59, 60, 59, 60, 59, 57, 57,
        59, 59, 60, 59, 60, 59, 57, 59 }

    // ---- Chords --------------------------------------------------
    //
    // Three notes on each downbeat, one quarter long, following the same
    // harmony as the bass. Written low to high, three per bar.
    let chords = i32[48] {
        55, 59, 62,   55, 59, 62,   60, 64, 67,   59, 62, 67,    // 1-4
        60, 64, 67,   55, 59, 62,   62, 66, 69,   62, 66, 69,    // 5-8
        55, 59, 62,   55, 59, 62,   60, 64, 67,   59, 62, 67,    // 9-12
        60, 64, 67,   55, 59, 62,   62, 66, 69,   55, 59, 62 }   // 13-16

    // General MIDI programs, 0-based as the wire format numbers them.
    let prog_music_box = 10
    let prog_celesta = 8
    let prog_pizzicato = 45
    let prog_harpsichord = 6

    // General MIDI percussion notes.
    let drum_kick = 36
    let drum_hat = 42
    let drum_tamb = 54

// ============================================================
// Event lists
// ============================================================

// One MIDI message with the tick it happens on. Three bytes covers every
// message this writer emits; `size` says whether the third one counts.
struct ev =
    tick: i32
    status: i32
    d1: i32
    d2: i32
    size: i32

// A track under construction: its events, and how many there are. The cap is
// generous and checked — a tool that silently truncated the music would be
// worse than one that stops.
struct track =
    evs: ev[]
    n: i64

let track_new = () ->
    track { evs = alloc(ev[4096] {})!, n = 0i64 }

let emit = (t: track*, tick: i32, status: i32, d1: i32, d2: i32, size: i32) ->
    assert(t.n < t.evs.len)
    t.evs[t.n] = ev { tick = tick, status = status, d1 = d1, d2 = d2, size = size }
    t.n = t.n + 1i64

// A note, as its on and off pair. `off_style` picks which of the two legal
// note-off encodings to use: a real 0x80 status, or 0x90 with velocity zero.
// Both appear in the finished file on purpose — see the header.
let note = (t: track*, ch: i32, tick: i32, dur: i32, n: i32, vel: i32,
            off_style: i32) ->
    emit(t, tick, 0x90 | ch, n, vel, 3)
    if off_style == 0 then emit(t, tick + dur, 0x80 | ch, n, 0, 3)
    else emit(t, tick + dur, 0x90 | ch, n, 0, 3)

// Sort a track into tick order, stably. Insertion sort because the lists
// arrive nearly sorted — notes are added in time order and only their
// note-offs land out of place — and because stability is what keeps a
// program change ahead of the note that needs it.
let sort_track = (t: track*) ->
    for i in 1i64..t.n do
        let v = t.evs[i]
        let mut j = i
        loop
            if j == 0i64 then break
            if t.evs[j - 1i64].tick <= v.tick then break
            t.evs[j] = t.evs[j - 1i64]
            j = j - 1i64
        t.evs[j] = v

// ============================================================
// SMF bytes
// ============================================================

struct writer =
    b: u8[]
    n: i64

let writer_new = (cap: i64) ->
    writer { b = alloc(u8[cap] {})!, n = 0i64 }

let put8 = (w: writer*, v: i32) ->
    assert(w.n < w.b.len)
    w.b[w.n] = (u8) (v & 255)
    w.n = w.n + 1i64

let put16 = (w: writer*, v: i32) ->
    put8(w, v >> 8)
    put8(w, v)

let put32 = (w: writer*, v: i32) ->
    put8(w, v >> 24)
    put8(w, v >> 16)
    put8(w, v >> 8)
    put8(w, v)

let put_tag = (w: writer*, s: const str) ->
    for i in 0i64..s.len do
        put8(w, (i32) s[i])

// A variable-length quantity: seven bits a byte, high bit set on all but the
// last. Written high group first, which means finding the top group before
// emitting anything.
let put_vlq = (w: writer*, v: i32) ->
    let mut shift = 21
    loop
        if shift == 0 then break
        if (v >> shift) != 0 then break
        shift = shift - 7
    loop
        let last = shift == 0
        let seven = (v >> shift) & 127
        put8(w, if last then seven else seven | 128)
        if last then break
        shift = shift - 7

// Write one track chunk: the header, the events as deltas, an end-of-track
// meta event, and the length patched back into the header once it is known.
//
// Running status is emitted wherever the status byte repeats, which is both
// what a real file looks like and what makes the parser's handling of it
// something this file actually tests.
let put_track = (w: writer*, t: track*, end_tick: i32) ->
    put_tag(w, "MTrk")
    let len_at = w.n
    put32(w, 0)
    let body_at = w.n
    let mut last_tick = 0
    let mut running = -1
    for i in 0i64..t.n do
        let e = t.evs[i]
        put_vlq(w, e.tick - last_tick)
        last_tick = e.tick
        if e.status >= 0xF0 then
            // Meta and system messages carry no running status and clear it.
            put8(w, e.status)
            running = -1
        else if e.status != running then
            put8(w, e.status)
            running = e.status
        put8(w, e.d1)
        if e.size == 3 then put8(w, e.d2)
    // End of track, placed on the song's final bar line rather than after
    // the last note. `opl_midi` loops at this tick, so putting it here is
    // what makes the repeat land on the downbeat instead of a hair early.
    put_vlq(w, if end_tick > last_tick then end_tick - last_tick else 0)
    put8(w, 0xFF)
    put8(w, 0x2F)
    put8(w, 0x00)
    let body_len = (i32) (w.n - body_at)
    let save = w.n
    w.n = len_at
    put32(w, body_len)
    w.n = save

// ============================================================
// The arrangement
// ============================================================

// Track 0: tempo and metre, no notes — the conductor track, which is how a
// format 1 file conventionally carries them, and which gives the merge in
// `opl_midi.parse` a track whose every event is meta.
//
// Its two events have payload shapes the three-byte `ev` cannot describe, so
// this track is written directly rather than built and sorted.
let put_conductor = (w: writer*) ->
    put_tag(w, "MTrk")
    let len_at = w.n
    put32(w, 0)
    let body_at = w.n
    put_vlq(w, 0)
    put8(w, 0xFF)                       // meta
    put8(w, 0x58)                       // time signature
    put8(w, 0x04)
    put8(w, 3)                          // 3/4
    put8(w, 2)
    put8(w, 24)
    put8(w, 8)
    put_vlq(w, 0)
    put8(w, 0xFF)                       // meta
    put8(w, 0x51)                       // set tempo
    put8(w, 0x03)
    put8(w, 500000 >> 16)
    put8(w, (500000 >> 8) & 255)
    put8(w, 500000 & 255)
    put_vlq(w, 0)
    put8(w, 0xFF)
    put8(w, 0x2F)
    put8(w, 0x00)
    let body_len = (i32) (w.n - body_at)
    let save = w.n
    w.n = len_at
    put32(w, body_len)
    w.n = save

// Lay a (note, duration) list down from `base`, returning nothing — the list
// is continuous, so each note starts where the last one ended.
let lay_line = (t: track*, ch: i32, base: i32, pairs: const i32[], vel: i32,
                off_style: i32) ->
    let mut at = base
    for i in 0i64..(pairs.len / 2i64) do
        let n = pairs[i * 2i64]
        let d = pairs[i * 2i64 + 1i64]
        note(t, ch, at, d - 20, n, vel, off_style)   // a hair of separation
        at = at + d

let build_melody = () ->
    let mut t = track_new()
    emit(&t, 0, 0xC0, tune.prog_music_box, 0, 2)
    lay_line(&t, 0, 0, tune.melody, 100, 0)
    lay_line(&t, 0, tune.pass_ticks, tune.melody, 112, 0)
    sort_track(&t)
    t

let build_bass = () ->
    let mut t = track_new()
    emit(&t, 0, 0xC2, tune.prog_pizzicato, 0, 2)
    lay_line(&t, 2, 0, tune.bass, 84, 0)
    lay_line(&t, 2, tune.pass_ticks, tune.bass, 92, 0)
    sort_track(&t)
    t

// The inner line and the chords play only on the second pass, which is the
// whole shape of the arrangement: the same sixteen bars, scored twice.
let build_inner = () ->
    let mut t = track_new()
    emit(&t, 0, 0xC1, tune.prog_celesta, 0, 2)
    for b in 0..16 do
        let at = tune.pass_ticks + b * tune.bar
        note(&t, 1, at, tune.bar - 40, tune.inner[b], 66, 1)
    sort_track(&t)
    t

let build_chords = () ->
    let mut t = track_new()
    emit(&t, 0, 0xC3, tune.prog_harpsichord, 0, 2)
    for b in 0..16 do
        let at = tune.pass_ticks + b * tune.bar
        for k in 0..3 do
            note(&t, 3, at, tune.beat - 60, tune.chords[b * 3 + k], 62, 1)
    sort_track(&t)
    t

// Percussion, on General MIDI's channel 9. Light through the first pass —
// hi-hat on the second and third beats and nothing on the downbeat, which is
// what keeps a minuet feeling like one — and a full pattern through the
// second.
let build_drums = () ->
    let mut t = track_new()
    for b in 0..32 do
        let at = b * tune.bar
        let second = b >= 16
        if second then note(&t, 9, at, 120, tune.drum_kick, 82, 1)
        note(&t, 9, at + tune.beat, 120, tune.drum_hat, if second then 52 else 44, 1)
        note(&t, 9, at + tune.beat * 2, 120, tune.drum_hat,
            if second then 52 else 44, 1)
        if second && (b - 16) % 4 == 0 then
            note(&t, 9, at, 120, tune.drum_tamb, 58, 1)
    sort_track(&t)
    t

let run = (path: const str) ->
    let mut melody = build_melody()
    let mut inner = build_inner()
    let mut bass = build_bass()
    let mut chords = build_chords()
    let mut drums = build_drums()

    let mut w = writer_new(65536i64)
    put_tag(&w, "MThd")
    put32(&w, 6)
    put16(&w, 1)                        // format 1: parallel tracks
    put16(&w, 6)                        // six of them, conductor included
    put16(&w, tune.division)
    put_conductor(&w)
    put_track(&w, &melody, tune.song_ticks)
    put_track(&w, &inner, tune.song_ticks)
    put_track(&w, &bass, tune.song_ticks)
    put_track(&w, &chords, tune.song_ticks)
    put_track(&w, &drums, tune.song_ticks)

    let f = match io.open(path, "wb") with
            | ok(h) -> h
            | err(e) ->
                io.write("mkmid: cannot open output\n", stderr)
                return 1
    io.write(w.b[0i64..w.n], f)
    match io.close(f) with
    | ok -> void()
    | err(e) ->
        io.write("mkmid: close failed\n", stderr)
        void()
    io.write("wrote %d{(i32) w.n} bytes\n", stdout)
    0

let main = (args: str[]) ->
    if args.len > 1i64 then run(args[1])
    else run("demos/fuzzel-fobble/music/minuet.mid")
