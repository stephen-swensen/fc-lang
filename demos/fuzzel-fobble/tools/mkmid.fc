// Writes Fuzzel Fobble's music out as a Standard MIDI File.
//
// The tune is the **Minuet in G major, BWV Anh. 114** — the one everybody
// knows from the *Notebook for Anna Magdalena Bach*, and which scholarship now
// attributes to Christian Petzold rather than to Bach himself. Public domain
// either way; the credit is the only thing in question.
//
// Both halves are here, all thirty-two bars, melody and bass exactly as the
// score has them. What this file adds is the scoring — which instrument plays
// what, the sustained harmony, the keyboard figuration, the drum part — and
// that exists to give the player something multi-timbral to chew on.
//
// ------------------------------------------------------------------
// The shape
// ------------------------------------------------------------------
//
// The minuet is two sixteen-bar halves, each marked to be repeated. Taking
// those repeats gives four sections and sixty-four bars, and the repeat is
// where the arrangement changes rather than the notes:
//
//     bars  1-16   part I           melody, bass, sustained harmony, hi-hat
//     bars 17-32   part I repeated  + harpsichord figuration, kick, tambourine
//     bars 33-48   part II          melody, bass, harmony, hi-hat, kick
//     bars 49-64   part II repeated + harpsichord figuration, full drums
//
// Every section carries harmony under the melody, which is the whole point of
// the layout: an earlier version left the accompaniment to one chord stab and
// one held note per bar, and measured against the melody's 89% those parts
// sounded 2% and 5% of the time. You could hear the tune and essentially
// nothing else. The sustained string part below is what fixes that — it holds
// through the bar on a patch whose EGT bit is set, so it fills time instead of
// decaying out of the way.
//
// Six tracks in SMF format 1, five sounding channels, and at most six
// simultaneous notes — enough to work the voice allocator without ever making
// it steal. Each channel sets its own CC7 volume, so the balance lives in the
// file where it can be edited, not in the player. The two note-off encodings
// are used deliberately: the melody and bass end notes with a real 0x80
// status, the other parts with the 0x90-and-velocity-zero form, so the shipped
// file exercises both paths through `opl_midi.parse`. Running status is
// emitted wherever it applies, for the same reason.
//
// Run it once and check the result in; it is here for provenance and so the
// tune stays editable as music rather than as bytes.
//
//     fcc demos/fuzzel-fobble/tools/mkmid.fc stdlib/io.fc stdlib/text.fc -o /tmp/mkmid.c
//     cc -std=c11 -o /tmp/mkmid /tmp/mkmid.c && /tmp/mkmid demos/fuzzel-fobble/music/minuet.mid

import io from std::

// ============================================================
// The music
// ============================================================

module tune =

    // Ticks per quarter note, and the bar length that follows from 3/4 time.
    let division = 480
    let beat = 480
    let bar = 1440
    let eighth = 240

    // Four sixteen-bar sections: part I, part I again, part II, part II again.
    let section_bars = 16
    let section_ticks = 16 * 1440
    let song_ticks = 4 * 16 * 1440

    // ---- Melody, part I (bars 1-16) ------------------------------
    //
    // (note, duration) pairs, played end to end with no rests, so the bar
    // lines below are a reading aid rather than something the data encodes.
    // Middle C is 60, so this half sits between F#4 (66) and G5 (79).
    let melody_a = i32[128] {
        74, 480,  67, 240,  69, 240,  71, 240,  72, 240,   // 1   d' | g a b c
        74, 480,  67, 480,  67, 480,                       // 2   d' | g | g
        76, 480,  72, 240,  74, 240,  76, 240,  78, 240,   // 3   e' | c d e f#
        79, 480,  67, 480,  67, 480,                       // 4   g' | g | g
        72, 480,  74, 240,  72, 240,  71, 240,  69, 240,   // 5   c  | d c b a
        71, 480,  72, 240,  71, 240,  69, 240,  67, 240,   // 6   b  | c b a g
        66, 480,  67, 240,  69, 240,  71, 240,  67, 240,   // 7   f# | g a b g
        69, 1440,                                          // 8   a......
        74, 480,  67, 240,  69, 240,  71, 240,  72, 240,   // 9   (as bar 1)
        74, 480,  67, 480,  67, 480,                       // 10
        76, 480,  72, 240,  74, 240,  76, 240,  78, 240,   // 11
        79, 480,  67, 480,  67, 480,                       // 12
        72, 480,  74, 240,  72, 240,  71, 240,  69, 240,   // 13
        71, 480,  72, 240,  71, 240,  69, 240,  67, 240,   // 14
        69, 480,  71, 240,  69, 240,  67, 240,  66, 240,   // 15  a  | b a g f#
        67, 1440 }                                         // 16  g......

    // ---- Melody, part II (bars 17-32) ----------------------------
    //
    // The second half opens an octave above where the first one lives —
    // B5 (83) is the top note of the piece — works down through a rising
    // scale in bar 21, and comes home through the running eighths of bar 29.
    let melody_b = i32[124] {
        83, 480,  79, 240,  81, 240,  83, 240,  79, 240,   // 17  b' | g a b g
        81, 480,  74, 240,  76, 240,  78, 240,  74, 240,   // 18  a  | d e f# d
        79, 480,  76, 240,  78, 240,  79, 240,  74, 240,   // 19  g  | e f# g d
        73, 480,  71, 240,  73, 240,  69, 480,             // 20  c# | b c# | a
        69, 240,  71, 240,  73, 240,  74, 240,  76, 240,  78, 240,
                                                           // 21  a b c# d e f#
        79, 480,  78, 480,  76, 480,                       // 22  g | f# | e
        78, 480,  69, 480,  73, 480,                       // 23  f# | a | c#
        74, 1440,                                          // 24  d......
        74, 480,  67, 240,  66, 240,  67, 480,             // 25  d | g f# | g
        76, 480,  67, 240,  66, 240,  67, 480,             // 26  e | g f# | g
        74, 480,  72, 480,  71, 480,                       // 27  d | c | b
        69, 240,  67, 240,  66, 240,  67, 240,  69, 480,   // 28  a g f# g | a
        62, 240,  64, 240,  66, 240,  67, 240,  69, 240,  71, 240,
                                                           // 29  d e f# g a b
        72, 480,  71, 480,  69, 480,                       // 30  c | b | a
        71, 240,  74, 240,  67, 480,  66, 480,             // 31  b d | g | f#
        67, 1440 }                                         // 32  g......

    // ---- Bass, part I --------------------------------------------
    //
    // The score's own left hand, not a root-and-fifth reduction of it: it
    // walks in bars 8 and 12 and steps down to the low G at the cadence,
    // and those are the moments that make the half sound finished.
    let bass_a = i32[70] {
        55, 960,  57, 480,                                 // 1   G . | A
        59, 1440,                                          // 2   B
        60, 1440,                                          // 3   C
        59, 1440,                                          // 4   B
        57, 1440,                                          // 5   A
        55, 1440,                                          // 6   G
        62, 480,  59, 480,  55, 480,                       // 7   D B G
        62, 480,  50, 240,  60, 240,  59, 240,  57, 240,   // 8   D | d c b a
        59, 960,  57, 480,                                 // 9   B . | A
        55, 480,  59, 480,  55, 480,                       // 10  G B G
        60, 1440,                                          // 11  C
        59, 480,  60, 240,  59, 240,  57, 240,  55, 240,   // 12  B | c b a g
        57, 960,  54, 480,                                 // 13  A . | F#
        55, 960,  59, 480,                                 // 14  G . | B
        60, 480,  62, 480,  50, 480,                       // 15  C D d
        55, 960,  43, 480 }                                // 16  G . | G,

    // ---- Bass, part II -------------------------------------------
    //
    // A rest in bar 28 — the one place the bass stops — which is why
    // `lay_line` understands a negative note as a rest.
    let bass_b = i32[72] {
        55, 1440,                                          // 17  G
        54, 1440,                                          // 18  F#
        52, 480,  55, 480,  52, 480,                       // 19  E G E
        57, 960,  45, 480,                                 // 20  A . | A,
        57, 1440,                                          // 21  A
        59, 480,  62, 480,  61, 480,                       // 22  B D C#
        62, 480,  54, 480,  57, 480,                       // 23  D F# A
        62, 480,  50, 480,  60, 480,                       // 24  D d C
        59, 960,  59, 480,                                 // 25  B . | B
        60, 960,  60, 480,                                 // 26  C . | C
        59, 480,  57, 480,  55, 480,                       // 27  B A G
        62, 960,  -1, 480,                                 // 28  D . | rest
        50, 1440,                                          // 29  d
        52, 480,  55, 480,  54, 480,                       // 30  E G F#
        55, 480,  47, 480,  50, 480,                       // 31  G B, d
        55, 480,  50, 480,  43, 480 }                      // 32  G d G,

    // ---- Sustained harmony ---------------------------------------
    //
    // Two notes a bar, held for the whole bar on a patch that sustains, so
    // there is always something under the melody. A zero means the bar is
    // left open — the four bars where the harmony moves faster than one
    // chord would cover, and where the bass and melody are busy enough on
    // their own. Written low note first, both between F#3 (54) and G4 (67)
    // so the part sits under the melody and over the bass.
    let pad_a = i32[32] {
        59, 62,   62, 67,   64, 67,   62, 67,              // 1-4    G  G/B C  G/B
        62, 66,   59, 62,   59, 62,   54, 60,              // 5-8    D  G   G  D7
        62, 67,   59, 62,   64, 67,   62, 67,              // 9-12   G  G   C  G/B
        62, 66,   59, 62,    0,  0,   59, 62 }             // 13-16  D  G   -  G

    let pad_b = i32[32] {
        59, 62,   57, 62,   59, 64,   61, 64,              // 17-20  G  D  Em  A
        61, 64,    0,  0,   57, 62,   54, 60,              // 21-24  A  -  D   D7
        62, 67,   64, 67,    0,  0,   57, 62,              // 25-28  G/B C  -  D
        54, 60,    0,  0,    0,  0,   59, 62 }             // 29-32  D7 -  -  G

    // General MIDI programs, 0-based as the wire format numbers them.
    let prog_music_box = 10
    let prog_strings = 48
    let prog_bass = 32
    let prog_harpsichord = 6

    // General MIDI percussion notes.
    let drum_kick = 36
    let drum_hat = 42
    let drum_tamb = 54

// Which of the four sections is which. A section is "full" when it is a
// repeat, and the second pair of sections plays part II.
let section_start = (s: i32) -> s * tune.section_ticks
let is_full = (s: i32) -> s % 2 == 1
let is_part_b = (s: i32) -> s >= 2

// ============================================================
// Event lists
// ============================================================

// One MIDI message with the tick it happens on. Three bytes covers every
// message this writer emits; `size` says whether the third one counts.
struct ev =
    tick: i32
    status: i32
    d1: i32
    d2: i32
    size: i32

// A track under construction: its events, and how many there are. The cap is
// generous and checked — a tool that silently truncated the music would be
// worse than one that stops.
struct track =
    evs: ev[]
    n: i64

let track_new = () ->
    track { evs = alloc(ev[4096] {})!, n = 0i64 }

let emit = (t: track*, tick: i32, status: i32, d1: i32, d2: i32, size: i32) ->
    assert(t.n < t.evs.len)
    t.evs[t.n] = ev { tick = tick, status = status, d1 = d1, d2 = d2, size = size }
    t.n = t.n + 1i64

// A note, as its on and off pair. `off_style` picks which of the two legal
// note-off encodings to use: a real 0x80 status, or 0x90 with velocity zero.
// Both appear in the finished file on purpose — see the header.
let note = (t: track*, ch: i32, tick: i32, dur: i32, n: i32, vel: i32,
            off_style: i32) ->
    emit(t, tick, 0x90 | ch, n, vel, 3)
    if off_style == 0 then emit(t, tick + dur, 0x80 | ch, n, 0, 3)
    else emit(t, tick + dur, 0x90 | ch, n, 0, 3)

// Channel volume, so the balance between the parts is a property of the file
// rather than of whatever plays it. It takes a tick because the harmony part
// uses it twice — see `build_pad`.
let set_volume = (t: track*, ch: i32, tick: i32, v: i32) ->
    emit(t, tick, 0xB0 | ch, 7, v, 3)

// Sort a track into tick order, stably. Insertion sort because the lists
// arrive nearly sorted — notes are added in time order and only their
// note-offs land out of place — and because stability is what keeps a
// program change ahead of the note that needs it.
let sort_track = (t: track*) ->
    for i in 1i64..t.n do
        let v = t.evs[i]
        let mut j = i
        loop
            if j == 0i64 then break
            if t.evs[j - 1i64].tick <= v.tick then break
            t.evs[j] = t.evs[j - 1i64]
            j = j - 1i64
        t.evs[j] = v

// ============================================================
// SMF bytes
// ============================================================

struct writer =
    b: u8[]
    n: i64

let writer_new = (cap: i64) ->
    writer { b = alloc(u8[cap] {})!, n = 0i64 }

let put8 = (w: writer*, v: i32) ->
    assert(w.n < w.b.len)
    w.b[w.n] = (u8) (v & 255)
    w.n = w.n + 1i64

let put16 = (w: writer*, v: i32) ->
    put8(w, v >> 8)
    put8(w, v)

let put32 = (w: writer*, v: i32) ->
    put8(w, v >> 24)
    put8(w, v >> 16)
    put8(w, v >> 8)
    put8(w, v)

let put_tag = (w: writer*, s: const str) ->
    for i in 0i64..s.len do
        put8(w, (i32) s[i])

// A variable-length quantity: seven bits a byte, high bit set on all but the
// last. Written high group first, which means finding the top group before
// emitting anything.
let put_vlq = (w: writer*, v: i32) ->
    let mut shift = 21
    loop
        if shift == 0 then break
        if (v >> shift) != 0 then break
        shift = shift - 7
    loop
        let last = shift == 0
        let seven = (v >> shift) & 127
        put8(w, if last then seven else seven | 128)
        if last then break
        shift = shift - 7

// Write one track chunk: the header, the events as deltas, an end-of-track
// meta event, and the length patched back into the header once it is known.
//
// Running status is emitted wherever the status byte repeats, which is both
// what a real file looks like and what makes the parser's handling of it
// something this file actually tests.
let put_track = (w: writer*, t: track*, end_tick: i32) ->
    put_tag(w, "MTrk")
    let len_at = w.n
    put32(w, 0)
    let body_at = w.n
    let mut last_tick = 0
    let mut running = -1
    for i in 0i64..t.n do
        let e = t.evs[i]
        put_vlq(w, e.tick - last_tick)
        last_tick = e.tick
        if e.status >= 0xF0 then
            // Meta and system messages carry no running status and clear it.
            put8(w, e.status)
            running = -1
        else if e.status != running then
            put8(w, e.status)
            running = e.status
        put8(w, e.d1)
        if e.size == 3 then put8(w, e.d2)
    // End of track, placed on the song's final bar line rather than after
    // the last note. `opl_midi` loops at this tick, so putting it here is
    // what makes the repeat land on the downbeat instead of a hair early.
    put_vlq(w, if end_tick > last_tick then end_tick - last_tick else 0)
    put8(w, 0xFF)
    put8(w, 0x2F)
    put8(w, 0x00)
    let body_len = (i32) (w.n - body_at)
    let save = w.n
    w.n = len_at
    put32(w, body_len)
    w.n = save

// ============================================================
// The arrangement
// ============================================================

// Track 0: tempo and metre, no notes — the conductor track, which is how a
// format 1 file conventionally carries them, and which gives the merge in
// `opl_midi.parse` a track whose every event is meta.
//
// Its two events have payload shapes the three-byte `ev` cannot describe, so
// this track is written directly rather than built and sorted.
let put_conductor = (w: writer*) ->
    put_tag(w, "MTrk")
    let len_at = w.n
    put32(w, 0)
    let body_at = w.n
    put_vlq(w, 0)
    put8(w, 0xFF)                       // meta
    put8(w, 0x58)                       // time signature
    put8(w, 0x04)
    put8(w, 3)                          // 3/4
    put8(w, 2)
    put8(w, 24)
    put8(w, 8)
    put_vlq(w, 0)
    put8(w, 0xFF)                       // meta
    put8(w, 0x51)                       // set tempo
    put8(w, 0x03)
    // 500000 us a quarter is 120 bpm. Editions mark this minuet anywhere
    // from 120 to 140; the slower end leaves room for the sound effects.
    put8(w, 500000 >> 16)
    put8(w, (500000 >> 8) & 255)
    put8(w, 500000 & 255)
    put_vlq(w, 0)
    put8(w, 0xFF)
    put8(w, 0x2F)
    put8(w, 0x00)
    let body_len = (i32) (w.n - body_at)
    let save = w.n
    w.n = len_at
    put32(w, body_len)
    w.n = save

// Lay a (note, duration) list down from `base`. The list is continuous, so
// each note starts where the last one ended; a negative note is a rest, which
// advances the clock and sounds nothing.
let lay_line = (t: track*, ch: i32, base: i32, pairs: const i32[], vel: i32,
                off_style: i32) ->
    let mut at = base
    for i in 0i64..(pairs.len / 2i64) do
        let n = pairs[i * 2i64]
        let d = pairs[i * 2i64 + 1i64]
        if n >= 0 then note(t, ch, at, d - 20, n, vel, off_style)
        at = at + d

let build_melody = () ->
    let mut t = track_new()
    emit(&t, 0, 0xC0, tune.prog_music_box, 0, 2)
    set_volume(&t, 0, 0, 95)
    for s in 0..4 do
        let at = section_start(s)
        let vel = if is_full(s) then 110 else 100
        if is_part_b(s) then lay_line(&t, 0, at, tune.melody_b, vel, 0)
        else lay_line(&t, 0, at, tune.melody_a, vel, 0)
    sort_track(&t)
    t

let build_bass = () ->
    let mut t = track_new()
    emit(&t, 0, 0xC2, tune.prog_bass, 0, 2)
    set_volume(&t, 2, 0, 66)
    for s in 0..4 do
        let at = section_start(s)
        let vel = if is_full(s) then 100 else 92
        if is_part_b(s) then lay_line(&t, 2, at, tune.bass_b, vel, 0)
        else lay_line(&t, 2, at, tune.bass_a, vel, 0)
    sort_track(&t)
    t

// One harmony note of one bar, or 0 where the bar is left open.
let pad_note = (s: i32, b: i32, k: i32) ->
    if is_part_b(s) then tune.pad_b[b * 2 + k] else tune.pad_a[b * 2 + k]

// The sustained part, and the reason the texture is never just melody: the
// notes are a whole bar long and the patch holds them, so this channel sounds
// essentially all the time.
let build_pad = () ->
    let mut t = track_new()
    emit(&t, 0, 0xC1, tune.prog_strings, 0, 2)
    for s in 0..4 do
        let base = section_start(s)
        let vel = if is_full(s) then 82 else 74
        // The harmony steps back where the harpsichord plays. It is the
        // harpsichord's masker — the two share a register, and the strings
        // hold while the plucks are short — so the way to make the
        // figuration audible is to open a hole for it rather than to shout
        // over it, which is what raising the harpsichord instead did to the
        // headroom the sound effects need.
        set_volume(&t, 1, base, if is_full(s) then 66 else 83)
        for b in 0..tune.section_bars do
            let at = base + b * tune.bar
            for k in 0..2 do
                let n = pad_note(s, b, k)
                if n > 0 then note(&t, 1, at, tune.bar - 40, n, vel, 1)
    sort_track(&t)
    t

// Keyboard figuration on the repeats: the bar's two harmony notes alternating
// as four eighths across beats two and three, which is what a minuet's left
// hand does and what leaves beat one to the bass.
//
// Octave-doubled, because one note was not enough to hear. A single plucked
// eighth measured thirteen decibels under the rest of the mix in its own
// strongest band and moved the sum by 0.07 dB — inaudible, and not for want
// of level: the patch's carrier already sits at TL 0, so velocity had barely
// six decibels left to give. Two notes an octave apart cost one more voice
// out of nine and buy three decibels that velocity could not.
let build_harpsi = () ->
    let mut t = track_new()
    emit(&t, 0, 0xC3, tune.prog_harpsichord, 0, 2)
    set_volume(&t, 3, 0, 127)
    for s in 0..4 do
        if is_full(s) then
            let base = section_start(s)
            for b in 0..tune.section_bars do
                let lo = pad_note(s, b, 0)
                let hi = pad_note(s, b, 1)
                if lo > 0 && hi > 0 then
                    let at = base + b * tune.bar + tune.beat
                    for k in 0..4 do
                        let n = if k % 2 == 0 then lo else hi
                        note(&t, 3, at + k * tune.eighth, tune.eighth - 30,
                            n, 100, 1)
                        note(&t, 3, at + k * tune.eighth, tune.eighth - 30,
                            n + 12, 100, 1)
    sort_track(&t)
    t

// Percussion, on General MIDI's channel 9. Nothing on the downbeat through
// the opening section — which is what keeps a minuet feeling like one — and
// progressively more from there.
// Percussion, on General MIDI's channel 9. The velocities here are not
// dynamics, they are level: the hi-hat used to be written at 44, which on
// opl_midi's velocity curve is 12.75 dB of attenuation applied to the
// quietest voice in the bank, and the result was a drum part nobody could
// hear. A quiet part is written quiet in the *mix* — that is what CC7 is
// for — not by throttling velocity into the floor.
let build_drums = () ->
    let mut t = track_new()
    set_volume(&t, 9, 0, 127)
    for b in 0..64 do
        let at = b * tune.bar
        let sec = b / tune.section_bars
        let full = is_full(sec)
        if full || is_part_b(sec) then
            note(&t, 9, at, 120, tune.drum_kick, 96, 1)
        note(&t, 9, at + tune.beat, 120, tune.drum_hat,
            if full then 92 else 80, 1)
        note(&t, 9, at + tune.beat * 2, 120, tune.drum_hat,
            if full then 92 else 80, 1)
        if full && b % 4 == 0 then
            note(&t, 9, at, 120, tune.drum_tamb, 84, 1)
    sort_track(&t)
    t

let run = (path: const str) ->
    let mut melody = build_melody()
    let mut pad = build_pad()
    let mut bass = build_bass()
    let mut harpsi = build_harpsi()
    let mut drums = build_drums()

    let mut w = writer_new(131072i64)
    put_tag(&w, "MThd")
    put32(&w, 6)
    put16(&w, 1)                        // format 1: parallel tracks
    put16(&w, 6)                        // six of them, conductor included
    put16(&w, tune.division)
    put_conductor(&w)
    put_track(&w, &melody, tune.song_ticks)
    put_track(&w, &pad, tune.song_ticks)
    put_track(&w, &bass, tune.song_ticks)
    put_track(&w, &harpsi, tune.song_ticks)
    put_track(&w, &drums, tune.song_ticks)

    let f = match io.open(path, "wb") with
            | ok(h) -> h
            | err(e) ->
                io.write("mkmid: cannot open output\n", stderr)
                return 1
    io.write(w.b[0i64..w.n], f)
    match io.close(f) with
    | ok -> void()
    | err(e) ->
        io.write("mkmid: close failed\n", stderr)
        void()
    io.write("wrote %d{(i32) w.n} bytes\n", stdout)
    0

let main = (args: str[]) ->
    if args.len > 1i64 then run(args[1])
    else run("demos/fuzzel-fobble/music/minuet.mid")
