# Fuzzel Fobble — the SDL2 build.
#
# Used by run-sdl2.sh (`fcc @demos/fuzzel-fobble/sdl2.rsp`), and by the editor
# when lsp.rsp points here. Paths are relative to this file.

# The backend. Required: main.fc static_asserts on it, and gfx_sdl2.fc
# static_asserts that it names *this* backend, so a build cannot end up with
# one backend's sources and the other's flag.
--flag backend=sdl2

# The backend, and the bindings only it needs.
../shared/sdl2.fc
gfx_sdl2.fc

# The game, identical in both builds.
plat.fc
game.fc
art.fc
sound.fc
main.fc

# Sound engine, and the SDL2 device for it. opl_audio.fc names no library
# and reads no flag; the device file next to it is the SDL2 half of the same
# either/or the gfx line above is.
../shared/opl2.fc
../shared/opl2_tables.fc
../shared/opl_midi.fc
../shared/opl_bank_gm.fc
../shared/opl_audio.fc
../shared/opl_audio_sdl.fc

# stdlib modules this demo imports
../../stdlib/io.fc
../../stdlib/text.fc
../../stdlib/sys.fc
../../stdlib/math.fc
../../stdlib/random.fc
