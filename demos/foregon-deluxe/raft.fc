// Foregon Deluxe — the Columbia.
//
// The last stretch, for those who chose the river: the raft drifts down a
// gorge seen from above, the water carrying it at its own pace, and you
// steer left and right between the banks and the rocks. Each rock struck
// costs something — a crate over the side, or worse — and game.fc settles
// the cost when the river lets you go.

import pcg_random from std::random
import math from std::

struct rock =
    x: f64
    y: f64
    r: i32              // half-size
    live: bool

struct raft_state =
    x: f64              // the raft's center
    dist: f64           // how far down the river
    rocks: rock[14]
    spawn_t: f64
    hits: i32
    bump: f64           // time since the last hit: brief immunity, a shake
    done: bool
    sfx: i32[8]
    nsfx: i32
    rng: pcg_random

module raft =
    let raft_y = 138.0
    let length = 2400.0     // pixels of river: about 40 seconds
    let flow = 60.0         // the current, pixels a second
    let raft_half = 7

    private let rnd = (r: raft_state*) -> pcg_random.next_f64(&r.rng)

    private let sound = (r: raft_state*, id: i32) ->
        if r.nsfx < 8 then
            r.sfx[r.nsfx] = id
            r.nsfx = r.nsfx + 1

    // The river's banks at a point `d` pixels downstream: two slow waves,
    // so the gorge narrows and bends.
    let left_bank = (d: f64) -> 70.0 + 30.0 * math.sin(d / 170.0) + 12.0 * math.sin(d / 53.0)
    let right_bank = (d: f64) -> 250.0 + 28.0 * math.sin(d / 190.0 + 1.3) - 10.0 * math.sin(d / 61.0)

    let begin = (r: raft_state*, seed: u64) ->
        *r = raft_state { x = 160.0, bump = 9.0, spawn_t = 1.0, rng = pcg_random.make(seed) }
        r.x = (left_bank(0.0 + raft_y) + right_bank(0.0 + raft_y)) / 2.0

    // The distance down the river at screen row y (the view scrolls down).
    let river_at = (r: const raft_state*, y: f64) -> r.dist + (180.0 - y)

    let step = (r: raft_state*, inp: const input*, dt: f64) ->
        r.nsfx = 0
        if r.done then return
        r.dist = r.dist + flow * dt
        r.bump = r.bump + dt

        let mut dx = 0.0
        if plat.is_down(inp, plat.left) then dx = dx - 1.0
        if plat.is_down(inp, plat.right) then dx = dx + 1.0
        r.x = r.x + dx * 72.0 * dt

        // The banks push back.
        let d = river_at(r, raft_y)
        let lo = left_bank(d) + (f64) raft_half
        let hi = right_bank(d) - (f64) raft_half
        if r.x < lo then
            r.x = lo + 2.0
            if r.bump > 0.6 then sound(r, snd.sfx_bump)
            r.bump = if r.bump > 0.6 then 0.3 else r.bump
        if r.x > hi then
            r.x = hi - 2.0
            if r.bump > 0.6 then sound(r, snd.sfx_bump)
            r.bump = if r.bump > 0.6 then 0.3 else r.bump

        // Rocks come down with the current.
        r.spawn_t = r.spawn_t - dt
        if r.spawn_t <= 0.0 && r.dist < length - 200.0 then
            r.spawn_t = 0.9 + rnd(r) * 1.0
            let mut slot = -1
            for i in 0..14 do
                if !r.rocks[i].live && slot < 0 then slot = i
            if slot >= 0 then
                let dd = river_at(r, -10.0)
                let l = left_bank(dd)
                let w = right_bank(dd) - l
                let k = &r.rocks[slot]
                k.r = 4 + (i32) (rnd(r) * 5.0)
                k.x = l + (f64) k.r + rnd(r) * (w - 2.0 * (f64) k.r)
                k.y = -10.0
                k.live = true
        for i in 0..14 do
            let k = &r.rocks[i]
            if k.live then
                k.y = k.y + flow * dt
                if k.y > 196.0 then k.live = false
                else if r.bump > 1.2 then
                    let hit_x = math.abs(k.x - r.x) < (f64) (k.r + raft_half)
                    if hit_x && math.abs(k.y - raft_y) < (f64) (k.r + 5) then
                        r.hits = r.hits + 1
                        r.bump = 0.0
                        r.x = r.x + (if k.x < r.x then 8.0 else -8.0)
                        sound(r, snd.sfx_crash)

        if r.dist >= length then r.done = true
