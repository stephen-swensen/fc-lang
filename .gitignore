# Build output (binary, object files, all OS subdirectories)
/build/

# Stale in-tree artifacts (older builds put these alongside sources)
*.o
*.exe

# Default C compiler output
a.out

# Generated C from test runs
tests/cases/**/*.c

# Error-code maps (written automatically beside every compiled .c that declares errors)
*.errcodes

# Scratch Dir
scratch*/

# Editor/IDE
*.swp
*.swo
*~
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Vendored raylib source + build, fetched on demand by the raylib demos'
# run scripts (demos/fuzzel-fobble/run-raylib.sh, demos/fario/run.sh).
# Never committed.
/demos/shared/raylib/

# Borrowed OPL instrument banks, for listening tests only. Not fetched by
# anything and never committed: nearly every bank in circulation was extracted
# from a commercial game and carries attribution terms this repo would then
# have to honour. demos/shared/opl_bank_gm.fc is the one that ships.
/demos/shared/banks/

# The Notebook for Anna Magdalena Bach, fetched on demand by
# demos/fuzzel-fobble/fetch-music.sh. Never committed — the game ships one
# tune (music/minuet.mid, ours) and downloads the rest of the book if it can.
/demos/fuzzel-fobble/music/notebook/
