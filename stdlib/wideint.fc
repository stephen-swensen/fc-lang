namespace std::

// Fixed-width integers wider than the built-in types, parameterized by their
// bit width as a const generic: unsigned uwide<'n> and signed (two's
// complement) iwide<'n>, where 'n is any multiple of 32 from 64 up
// (uwide<128>, uwide<256>, iwide<1024>, ... — each width is its own type).
// A value is a struct wrapping an inline little-endian array of u32 limbs
// (limbs[0] is least significant) with no heap storage, paired with a
// companion module of the same name holding its operations; all arithmetic
// runs on a shared limb core, so every width shares one implementation.
// Values are plain by-value structs: copy with `=`, compare with `==`, zero
// with `default(uwide<256>)`.
//
// Arithmetic wraps modulo 2^width by default (matching FC's built-in
// integers); the `add_carry` / `sub_borrow` / `mul_wide` variants expose the
// bits a wrapping op would drop, and the `checked_*` variants abort on
// overflow. There is no operator overloading in FC, so every operation is a
// named function: `wideint.uwide.add(a, b)`, not `a + b`. Operations whose
// arguments carry the width infer it (`uwide.add(a, b)`); constructors and
// constants name it (`uwide<128>.from_u64(x)`, `uwide<256>.max()`).
module wideint =
    // Named parse failure conditions, shared by every width's parse functions.
    error parse =
        | invalid       // empty input or a character that is not a valid digit
        | overflow      // the value does not fit the target width

    // An 'n-bit unsigned integer: 'n/32 inline little-endian u32 limbs, no
    // heap. 'n must be a multiple of 32, at least 64 — any other width fails
    // to instantiate. Plain by-value data — copy with `=`, compare with
    // `==`, zero with `default(uwide<'n>)` (which is the value 0).
    struct uwide =
        static_assert('n % 32 == 0 && 'n >= 64,
            "uwide width must be a multiple of 32, at least 64")
        limbs: u32['n / 32]      // little-endian: limbs[0] is least significant

    // An 'n-bit signed integer: 'n/32 inline little-endian u32 limbs
    // interpreted as two's complement. 'n must be a multiple of 32, at least
    // 64 — any other width fails to instantiate. Plain by-value data — copy
    // with `=`, compare with `==`, zero with `default(iwide<'n>)`.
    struct iwide =
        static_assert('n % 32 == 0 && 'n >= 64,
            "iwide width must be a multiple of 32, at least 64")
        limbs: u32['n / 32]      // little-endian two's complement; limbs[0] is least significant

    // ===================================================================
    // Shared limb core (private). Every routine works on u32[] slices of
    // equal length unless noted, treating them as little-endian magnitudes.
    // ===================================================================

    // dst = a + b. Returns the carry out of the top limb (0 or 1).
    private let limbs_add = (dst: u32[], a: u32[], b: u32[]) ->
        let mut carry = 0u64
        for i in 0..dst.len do
            let s = (u64) a[i] + (u64) b[i] + carry
            dst[i] = (u32) s
            carry = s >> 32
        (u32) carry

    // dst = a - b. Returns the borrow out of the top limb (0 or 1).
    private let limbs_sub = (dst: u32[], a: u32[], b: u32[]) ->
        let mut borrow = 0u64
        for i in 0..dst.len do
            let d = (u64) a[i] - (u64) b[i] - borrow
            dst[i] = (u32) d
            borrow = (d >> 32) & 1u64
        (u32) borrow

    // dst = a * b, full product. Requires dst pre-zeroed and
    // dst.len >= a.len + b.len. Used for the widening multiplies.
    private let limbs_mul_full = (dst: u32[], a: u32[], b: u32[]) ->
        for i in 0..a.len do
            let mut carry = 0u64
            for j in 0..b.len do
                let p = (u64) a[i] * (u64) b[j] + (u64) dst[i + j] + carry
                dst[i + j] = (u32) p
                carry = p >> 32
            dst[i + b.len] = (u32) carry

    // dst = (a * b) mod 2^(32*dst.len), i.e. the low dst.len limbs of the
    // product. Requires dst pre-zeroed and a.len == b.len == dst.len.
    private let limbs_mul_wrap = (dst: u32[], a: u32[], b: u32[]) ->
        for i in 0..a.len do
            let mut carry = 0u64
            for j in 0..(a.len - i) do
                let p = (u64) a[i] * (u64) b[j] + (u64) dst[i + j] + carry
                dst[i + j] = (u32) p
                carry = p >> 32

    private let limbs_and = (dst: u32[], a: u32[], b: u32[]) ->
        for i in 0..dst.len do
            dst[i] = a[i] & b[i]

    private let limbs_or = (dst: u32[], a: u32[], b: u32[]) ->
        for i in 0..dst.len do
            dst[i] = a[i] | b[i]

    private let limbs_xor = (dst: u32[], a: u32[], b: u32[]) ->
        for i in 0..dst.len do
            dst[i] = a[i] ^ b[i]

    private let limbs_not = (dst: u32[], a: u32[]) ->
        for i in 0..dst.len do
            dst[i] = ~a[i]

    // dst = a << n (logical), wrapping to dst.len limbs. a.len == dst.len.
    private let limbs_shl = (dst: u32[], a: u32[], n: u32) ->
        let ws = (i64) (n / 32u32)
        let bs = n % 32u32
        for i in 0..dst.len do
            let src = i - ws
            let mut v = 0u32
            if src >= 0 && src < a.len then
                v = a[src] << bs
            if bs > 0u32 && (src - 1) >= 0 && (src - 1) < a.len then
                v = v | (a[src - 1] >> (32u32 - bs))
            dst[i] = v

    // dst = a >> n (logical). a.len == dst.len.
    private let limbs_shr = (dst: u32[], a: u32[], n: u32) ->
        let ws = (i64) (n / 32u32)
        let bs = n % 32u32
        for i in 0..dst.len do
            let src = i + ws
            let mut v = 0u32
            if src >= 0 && src < a.len then
                v = a[src] >> bs
            if bs > 0u32 && (src + 1) < a.len then
                v = v | (a[src + 1] << (32u32 - bs))
            dst[i] = v

    // Unsigned compare of equal-length magnitudes: -1 (a<b), 0 (a==b), 1 (a>b).
    private let limbs_cmp = (a: u32[], b: u32[]) ->
        let mut result = 0
        let n = a.len
        for k in 0..n do
            let i = n - 1 - k
            if result == 0 then
                if a[i] < b[i] then result = -1
                else if a[i] > b[i] then result = 1
        result

    private let limbs_is_zero = (a: u32[]) ->
        let mut z = true
        for i in 0..a.len do
            if a[i] != 0u32 then z = false
        z

    // dst = a * m (single-limb multiplier). In-place safe. Returns carry out.
    private let limbs_mul_small = (dst: u32[], a: u32[], m: u32) ->
        let mut carry = 0u64
        for i in 0..dst.len do
            let p = (u64) a[i] * (u64) m + carry
            dst[i] = (u32) p
            carry = p >> 32
        (u32) carry

    // dst = a + s (single-limb addend). In-place safe. Returns carry out.
    private let limbs_add_small = (dst: u32[], a: u32[], s: u32) ->
        let mut carry = (u64) s
        for i in 0..dst.len do
            let t = (u64) a[i] + carry
            dst[i] = (u32) t
            carry = t >> 32
        (u32) carry

    // dst = a / d (single-limb divisor, d != 0). In-place safe. Returns a % d.
    private let limbs_divmod_small = (dst: u32[], a: u32[], d: u32) ->
        let mut rem = 0u64
        let n = a.len
        for k in 0..n do
            let i = n - 1 - k
            let cur = (rem << 32) | (u64) a[i]
            dst[i] = (u32) (cur / (u64) d)
            rem = cur % (u64) d
        (u32) rem

    // dst = a (copy). dst.len == a.len.
    private let limbs_copy = (dst: u32[], a: u32[]) ->
        for i in 0..dst.len do
            dst[i] = a[i]

    // dst <<= 1 in place. Returns the bit shifted out of the top limb (0 or 1).
    private let limbs_shl1 = (dst: u32[]) ->
        let mut carry = 0u32
        for i in 0..dst.len do
            let nc = dst[i] >> 31
            dst[i] = (dst[i] << 1) | carry
            carry = nc
        carry

    // q = a / b, r = a % b (unsigned), by binary long division. q and r must be
    // pre-zeroed; all four slices share length n. Aborts if b is zero, matching
    // the built-in `/`. O(n) bit iterations — correct and simple, not the
    // fastest possible (a Knuth-D core could replace it without touching callers).
    private let limbs_divmod = (q: u32[], r: u32[], a: u32[], b: u32[]) ->
        assert(!limbs_is_zero(b), "wideint division by zero")
        let total_bits = a.len * 32
        for step in 0..total_bits do
            let idx = total_bits - 1 - step        // consume a from MSB to LSB
            let limb = idx / 32
            let off = idx % 32
            let carried = limbs_shl1(r)            // r <<= 1 (may overflow n limbs)
            r[0] = r[0] | ((a[limb] >> off) & 1u32)
            // r_true >= b when the shift overflowed n limbs, or the low n limbs compare >=
            if carried == 1u32 || limbs_cmp(r, b) >= 0 then
                limbs_sub(r, r, b)                 // borrow cancels the overflow bit
                q[limb] = q[limb] | (1u32 << off)

    // --- signed (two's complement) limb helpers ---

    // Sign bit of a: 1 if negative, 0 if non-negative.
    private let limbs_sign = (a: u32[]) ->
        a[a.len - 1] >> 31

    // dst = -a (two's complement: ~a + 1). In-place safe.
    private let limbs_neg = (dst: u32[], a: u32[]) ->
        limbs_not(dst, a)
        limbs_add_small(dst, dst, 1u32)

    // Signed compare of equal-length two's-complement values: -1/0/1.
    private let limbs_cmp_signed = (a: u32[], b: u32[]) ->
        let asign = limbs_sign(a)
        let bsign = limbs_sign(b)
        if asign != bsign then
            if asign == 1u32 then -1 else 1     // a negative => a < b
        else
            limbs_cmp(a, b)                      // same sign: magnitudes order correctly

    // dst = a >> n (arithmetic: the sign bit fills the vacated positions).
    private let limbs_sar = (dst: u32[], a: u32[], n: u32) ->
        let fill = if limbs_sign(a) == 1u32 then 0xFFFFFFFFu32 else 0u32
        let ws = (i64) (n / 32u32)
        let bs = n % 32u32
        for i in 0..dst.len do
            let src = i + ws
            let lo = if src < a.len then a[src] else fill
            let hi = if (src + 1) < a.len then a[src + 1] else fill
            if bs == 0u32 then dst[i] = lo
            else dst[i] = (lo >> bs) | (hi << (32u32 - bs))

    // True iff a == 2^(bits-1) — top limb 0x80000000, all lower limbs 0. This
    // is the magnitude of the most-negative value, the one valid negative whose
    // magnitude has the sign bit set.
    private let limbs_is_min_mag = (a: u32[]) ->
        let n = a.len
        let mut yes = a[n - 1] == 0x80000000u32
        for i in 0..(n - 1) do
            if a[i] != 0u32 then yes = false
        yes

    // Given a 2n-limb magnitude `full` = |x| * |y|, does the product fit a
    // signed n-limb result whose sign is `neg_result`? A non-negative result
    // fits when full < 2^(n*32-1); a negative result also admits full ==
    // 2^(n*32-1) (the value `min`).
    private let limbs_signed_mul_fits = (full: u32[], neg_result: bool) ->
        let n = full.len / 2
        let high_zero = limbs_is_zero(full[n..full.len])
        let low_top_clear = (full[n - 1] >> 31) == 0u32
        if neg_result then high_zero && (low_top_clear || limbs_is_min_mag(full[0..n]))
        else high_zero && low_top_clear

    // Value of an ASCII digit in the given radix, or -1 if it is not a digit
    // (or not valid for that radix).
    private let digit_val = (c: u8, radix: u32) ->
        let mut v = -1
        if c >= '0' && c <= '9' then v = (i32) (c - '0')
        else if c >= 'a' && c <= 'f' then v = (i32) (c - 'a') + 10
        else if c >= 'A' && c <= 'F' then v = (i32) (c - 'A') + 10
        if v >= (i32) radix then v = -1
        v

    // ASCII character for a digit value 0..15.
    private let hex_digit = (v: u32) ->
        if v < 10u32 then '0' + (u8) v
        else 'a' + (u8) (v - 10u32)

    // Parse s into pre-zeroed dst at the given radix. On success the value is
    // written into dst and the result is `ok`; failures are err(parse.invalid)
    // for empty input or a non-digit, err(parse.overflow) past dst's width.
    private let limbs_parse = (dst: u32[], s: const str, radix: u32) ->
        if s.len == 0 then return err(void, parse.invalid)
        for i in 0..s.len do
            let dv = digit_val(s[i], radix)
            if dv < 0 then return err(void, parse.invalid)
            let cm = limbs_mul_small(dst, dst, radix)
            let ca = limbs_add_small(dst, dst, (u32) dv)
            if cm != 0u32 || ca != 0u32 then return err(void, parse.overflow)
        ok

    // Format work (destroyed in place) into buf at the given radix, returning
    // the written subslice of buf. buf must be large enough for the value.
    private let limbs_format = (buf: u8[], work: u32[], radix: u32) ->
        if limbs_is_zero(work) then
            buf[0] = '0'
            buf[0..1]
        else
            let mut pos = buf.len
            loop
                let rem = limbs_divmod_small(work, work, radix)
                pos = pos - 1
                buf[pos] = hex_digit(rem)
                if limbs_is_zero(work) then break
            buf[pos..buf.len]

    // Heap-allocated copy of s (caller must free).
    private let heap_copy = (s: const str) ->
        let out = alloc(u8[s.len] {})!
        for i, c in s do
            out[i] = c
        out

    // Heap-allocated '-' followed by digits (caller must free).
    private let heap_copy_neg = (digits: const str) ->
        let out = alloc(u8[digits.len + 1i64] {})!
        out[0] = '-'
        for i, c in digits do
            out[i + 1] = c
        out

    // ===================================================================
    // uwide<'n> — 'n-bit unsigned ('n/32 x u32 limbs)
    // ===================================================================

    // Operations for the unsigned uwide<'n> type: construction and constants,
    // wrapping and checked arithmetic, bitwise logic, comparison, and
    // decimal/hex string conversion. Width is inferred from an argument that
    // carries it (uwide.add(a, b)) and named explicitly where none does
    // (uwide<128>.from_u64(x), uwide<256>.max()).
    module uwide =
        // A uwide<'n> holding x (zero-extended).
        let from_u64 = <'n>(x: u64) ->
            let r = default(uwide<'n>)
            r.limbs[0] = (u32) x
            r.limbs[1] = (u32) (x >> 32)
            r

        // Low 64 bits of a as a u64 if a fits in 64 bits, else none.
        let try_to_u64 = (a: uwide<'n>) ->
            let mut hi_zero = true
            for i in 2..('n / 32) do
                if a.limbs[i] != 0u32 then hi_zero = false
            if hi_zero then some((u64) a.limbs[0] | ((u64) a.limbs[1] << 32))
            else none(u64)

        // The smallest uwide<'n>, 0 — the same value as default(uwide<'n>).
        let min = <'n>() -> default(uwide<'n>)

        // The largest uwide<'n>, 2^'n - 1 (all bits set).
        let max = <'n>() ->
            let r = default(uwide<'n>)
            limbs_not(r.limbs, r.limbs)
            r

        // a + b, wrapping mod 2^'n.
        let add = (a: uwide<'n>, b: uwide<'n>) ->
            let r = default(uwide<'n>)
            limbs_add(r.limbs, a.limbs, b.limbs)
            r

        // a + b as {sum, carry}; carry is true on overflow past 'n bits.
        let add_carry = (a: uwide<'n>, b: uwide<'n>) ->
            let r = default(uwide<'n>)
            let c = limbs_add(r.limbs, a.limbs, b.limbs)
            { r, c != 0u32 }

        // a - b, wrapping mod 2^'n.
        let sub = (a: uwide<'n>, b: uwide<'n>) ->
            let r = default(uwide<'n>)
            limbs_sub(r.limbs, a.limbs, b.limbs)
            r

        // a - b as {difference, borrow}; borrow is true when a < b.
        let sub_borrow = (a: uwide<'n>, b: uwide<'n>) ->
            let r = default(uwide<'n>)
            let c = limbs_sub(r.limbs, a.limbs, b.limbs)
            { r, c != 0u32 }

        // a * b, wrapping mod 2^'n.
        let mul = (a: uwide<'n>, b: uwide<'n>) ->
            let r = default(uwide<'n>)
            limbs_mul_wrap(r.limbs, a.limbs, b.limbs)
            r

        // Full 2*'n-bit product of a and b (no truncation).
        let mul_wide = (a: uwide<'n>, b: uwide<'n>) ->
            let r = default(uwide<'n * 2>)
            limbs_mul_full(r.limbs, a.limbs, b.limbs)
            r

        // Bitwise a & b.
        let and = (a: uwide<'n>, b: uwide<'n>) ->
            let r = default(uwide<'n>)
            limbs_and(r.limbs, a.limbs, b.limbs)
            r

        // Bitwise a | b.
        let or = (a: uwide<'n>, b: uwide<'n>) ->
            let r = default(uwide<'n>)
            limbs_or(r.limbs, a.limbs, b.limbs)
            r

        // Bitwise a ^ b.
        let xor = (a: uwide<'n>, b: uwide<'n>) ->
            let r = default(uwide<'n>)
            limbs_xor(r.limbs, a.limbs, b.limbs)
            r

        // Bitwise complement of a — every one of the 'n bits flipped.
        let not = (a: uwide<'n>) ->
            let r = default(uwide<'n>)
            limbs_not(r.limbs, a.limbs)
            r

        // a << n, wrapping mod 2^'n (n >= 'n yields 0).
        let shl = (a: uwide<'n>, n: u32) ->
            let r = default(uwide<'n>)
            limbs_shl(r.limbs, a.limbs, n)
            r

        // a >> n (logical; n >= 'n yields 0).
        let shr = (a: uwide<'n>, n: u32) ->
            let r = default(uwide<'n>)
            limbs_shr(r.limbs, a.limbs, n)
            r

        // -1 if a<b, 0 if a==b, 1 if a>b.
        let cmp = (a: uwide<'n>, b: uwide<'n>) ->
            limbs_cmp(a.limbs, b.limbs)

        // True if a is zero. Equivalent to a == default(uwide<'n>), but
        // stops at the first non-zero limb.
        let is_zero = (a: uwide<'n>) ->
            limbs_is_zero(a.limbs)

        // a / b, truncated. Aborts if b is zero.
        let div = (a: uwide<'n>, b: uwide<'n>) ->
            let q = default(uwide<'n>)
            let r = default(uwide<'n>)
            limbs_divmod(q.limbs, r.limbs, a.limbs, b.limbs)
            q

        // a % b. Aborts if b is zero.
        let rem = (a: uwide<'n>, b: uwide<'n>) ->
            let q = default(uwide<'n>)
            let r = default(uwide<'n>)
            limbs_divmod(q.limbs, r.limbs, a.limbs, b.limbs)
            r

        // {quotient, remainder} of a / b in one division. Aborts if b is zero.
        let divmod = (a: uwide<'n>, b: uwide<'n>) ->
            let q = default(uwide<'n>)
            let r = default(uwide<'n>)
            limbs_divmod(q.limbs, r.limbs, a.limbs, b.limbs)
            { q, r }

        // a + b, aborting on overflow past 'n bits.
        let checked_add = (a: uwide<'n>, b: uwide<'n>) ->
            let r = default(uwide<'n>)
            let c = limbs_add(r.limbs, a.limbs, b.limbs)
            assert(c == 0u32, "uwide.checked_add: overflow past %d{'n} bits")
            r

        // a - b, aborting on underflow (a < b).
        let checked_sub = (a: uwide<'n>, b: uwide<'n>) ->
            let r = default(uwide<'n>)
            let bor = limbs_sub(r.limbs, a.limbs, b.limbs)
            assert(bor == 0u32, "uwide.checked_sub: underflow (a < b) at %d{'n} bits")
            r

        // a * b, aborting on overflow past 'n bits.
        let checked_mul = (a: uwide<'n>, b: uwide<'n>) ->
            let full = u32['n / 16] { }
            limbs_mul_full(full, a.limbs, b.limbs)
            assert(limbs_is_zero(full[('n / 32)..('n / 16)]),
                "uwide.checked_mul: overflow past %d{'n} bits")
            let r = default(uwide<'n>)
            limbs_copy(r.limbs, full[0..('n / 32)])
            r

        // Parse s as an unsigned decimal integer.
        // returns: uwide<'n>! — ok(value), err(parse.invalid) on empty / bad
        //   digit, err(parse.overflow) past 'n bits.
        let parse = <'n>(s: const str) ->
            let r = default(uwide<'n>)
            limbs_parse(r.limbs, s, 10u32)?
            ok(r)

        // Parse s as unsigned hexadecimal (no 0x prefix). Same error contract.
        let parse_hex = <'n>(s: const str) ->
            let r = default(uwide<'n>)
            limbs_parse(r.limbs, s, 16u32)?
            ok(r)

        // Heap-allocated decimal text of a (caller must free).
        let to_str = (a: uwide<'n>) ->
            let work = a
            let scratch = u8['n * 5 / 16] { }
            heap_copy(limbs_format(scratch, work.limbs, 10u32))

        // Heap-allocated lowercase hex text of a (caller must free).
        let to_hex = (a: uwide<'n>) ->
            let work = a
            let scratch = u8['n * 5 / 16] { }
            heap_copy(limbs_format(scratch, work.limbs, 16u32))

    // ===================================================================
    // iwide<'n> — 'n-bit signed (two's complement, 'n/32 x u32 limbs)
    // ===================================================================

    // Operations for the signed, two's-complement iwide<'n> type: the same
    // repertoire as uwide plus sign-aware neg/abs, truncating division whose
    // remainder takes the dividend's sign, and arithmetic (sign-extending)
    // shift. Width is inferred from an argument that carries it
    // (iwide.add(a, b)) and named explicitly where none does
    // (iwide<128>.from_i64(x), iwide<256>.min()).
    module iwide =
        // An iwide<'n> holding x (sign-extended).
        let from_i64 = <'n>(x: i64) ->
            let r = default(iwide<'n>)
            r.limbs[0] = (u32) x
            r.limbs[1] = (u32) (x >> 32)
            let fill = if x < 0i64 then 0xFFFFFFFFu32 else 0u32
            for i in 2..('n / 32) do
                r.limbs[i] = fill
            r

        // a as an i64 if it fits [i64.min, i64.max], else none.
        let try_to_i64 = (a: iwide<'n>) ->
            let fill = if (a.limbs[1] >> 31) == 1u32 then 0xFFFFFFFFu32 else 0u32
            let mut fits = true
            for i in 2..('n / 32) do
                if a.limbs[i] != fill then fits = false
            if fits then some((i64) ((u64) a.limbs[0] | ((u64) a.limbs[1] << 32)))
            else none(i64)

        // The most negative iwide<'n>, -2^('n-1) (only the sign bit set).
        let min = <'n>() ->
            let r = default(iwide<'n>)
            r.limbs['n / 32 - 1] = 0x80000000u32
            r

        // The largest iwide<'n>, 2^('n-1) - 1 (every bit but the sign set).
        let max = <'n>() ->
            let r = default(iwide<'n>)
            limbs_not(r.limbs, r.limbs)
            r.limbs['n / 32 - 1] = 0x7FFFFFFFu32
            r

        // True if a is negative — that is, if its top bit is set.
        let is_neg = (a: iwide<'n>) ->
            limbs_sign(a.limbs) == 1u32

        // -a (two's complement; neg(min) wraps to min).
        let neg = (a: iwide<'n>) ->
            let r = default(iwide<'n>)
            limbs_neg(r.limbs, a.limbs)
            r

        // |a| (abs(min) wraps to min).
        let abs = (a: iwide<'n>) ->
            if limbs_sign(a.limbs) == 1u32 then iwide.neg(a) else a

        // a + b, wrapping mod 2^'n.
        let add = (a: iwide<'n>, b: iwide<'n>) ->
            let r = default(iwide<'n>)
            limbs_add(r.limbs, a.limbs, b.limbs)
            r

        // a - b, wrapping mod 2^'n.
        let sub = (a: iwide<'n>, b: iwide<'n>) ->
            let r = default(iwide<'n>)
            limbs_sub(r.limbs, a.limbs, b.limbs)
            r

        // a * b, wrapping mod 2^'n.
        let mul = (a: iwide<'n>, b: iwide<'n>) ->
            let r = default(iwide<'n>)
            limbs_mul_wrap(r.limbs, a.limbs, b.limbs)
            r

        // a / b, truncated toward zero. Aborts if b is zero.
        let div = (a: iwide<'n>, b: iwide<'n>) ->
            let an = limbs_sign(a.limbs) == 1u32
            let bn = limbs_sign(b.limbs) == 1u32
            let ua = if an then iwide.neg(a) else a
            let ub = if bn then iwide.neg(b) else b
            let q = default(iwide<'n>)
            let r = default(iwide<'n>)
            limbs_divmod(q.limbs, r.limbs, ua.limbs, ub.limbs)
            if an != bn then iwide.neg(q) else q

        // a % b (sign follows the dividend). Aborts if b is zero.
        let rem = (a: iwide<'n>, b: iwide<'n>) ->
            let an = limbs_sign(a.limbs) == 1u32
            let bn = limbs_sign(b.limbs) == 1u32
            let ua = if an then iwide.neg(a) else a
            let ub = if bn then iwide.neg(b) else b
            let q = default(iwide<'n>)
            let r = default(iwide<'n>)
            limbs_divmod(q.limbs, r.limbs, ua.limbs, ub.limbs)
            if an then iwide.neg(r) else r

        // {quotient, remainder} of a / b (truncated). Aborts if b is zero.
        let divmod = (a: iwide<'n>, b: iwide<'n>) ->
            let an = limbs_sign(a.limbs) == 1u32
            let bn = limbs_sign(b.limbs) == 1u32
            let ua = if an then iwide.neg(a) else a
            let ub = if bn then iwide.neg(b) else b
            let q = default(iwide<'n>)
            let r = default(iwide<'n>)
            limbs_divmod(q.limbs, r.limbs, ua.limbs, ub.limbs)
            let qf = if an != bn then iwide.neg(q) else q
            let rf = if an then iwide.neg(r) else r
            { qf, rf }

        // a + b, aborting on signed overflow.
        let checked_add = (a: iwide<'n>, b: iwide<'n>) ->
            let r = iwide.add(a, b)
            let sa = limbs_sign(a.limbs)
            assert(!(sa == limbs_sign(b.limbs) && limbs_sign(r.limbs) != sa),
                "iwide.checked_add: signed overflow at %d{'n} bits")
            r

        // a - b, aborting on signed overflow.
        let checked_sub = (a: iwide<'n>, b: iwide<'n>) ->
            let r = iwide.sub(a, b)
            let sa = limbs_sign(a.limbs)
            assert(!(sa != limbs_sign(b.limbs) && limbs_sign(r.limbs) != sa),
                "iwide.checked_sub: signed overflow at %d{'n} bits")
            r

        // a * b, aborting on signed overflow.
        let checked_mul = (a: iwide<'n>, b: iwide<'n>) ->
            let an = limbs_sign(a.limbs) == 1u32
            let bn = limbs_sign(b.limbs) == 1u32
            let ua = if an then iwide.neg(a) else a
            let ub = if bn then iwide.neg(b) else b
            let full = u32['n / 16] { }
            limbs_mul_full(full, ua.limbs, ub.limbs)
            assert(limbs_signed_mul_fits(full, an != bn),
                "iwide.checked_mul: signed overflow at %d{'n} bits")
            iwide.mul(a, b)

        // -a, aborting when a is min (it has no positive counterpart).
        let checked_neg = (a: iwide<'n>) ->
            assert(!limbs_is_min_mag(a.limbs),
                "iwide.checked_neg: a is iwide<%d{'n}>.min")
            iwide.neg(a)

        // |a|, aborting when a is min.
        let checked_abs = (a: iwide<'n>) ->
            assert(!limbs_is_min_mag(a.limbs),
                "iwide.checked_abs: a is iwide<%d{'n}>.min")
            iwide.abs(a)

        // a / b, aborting on min / -1 overflow (and on b == 0, via div).
        let checked_div = (a: iwide<'n>, b: iwide<'n>) ->
            let minus_one = iwide.not(default(iwide<'n>))
            assert(!(limbs_is_min_mag(a.limbs) && b == minus_one),
                "iwide.checked_div: iwide<%d{'n}>.min / -1 overflows")
            iwide.div(a, b)

        // Bitwise a & b, on the raw two's-complement bits.
        let and = (a: iwide<'n>, b: iwide<'n>) ->
            let r = default(iwide<'n>)
            limbs_and(r.limbs, a.limbs, b.limbs)
            r

        // Bitwise a | b, on the raw two's-complement bits.
        let or = (a: iwide<'n>, b: iwide<'n>) ->
            let r = default(iwide<'n>)
            limbs_or(r.limbs, a.limbs, b.limbs)
            r

        // Bitwise a ^ b, on the raw two's-complement bits.
        let xor = (a: iwide<'n>, b: iwide<'n>) ->
            let r = default(iwide<'n>)
            limbs_xor(r.limbs, a.limbs, b.limbs)
            r

        // Bitwise complement of a — every one of the 'n bits flipped, so
        // not(a) is -a - 1 and not(0) is -1.
        let not = (a: iwide<'n>) ->
            let r = default(iwide<'n>)
            limbs_not(r.limbs, a.limbs)
            r

        // a << n, wrapping mod 2^'n (n >= 'n yields 0).
        let shl = (a: iwide<'n>, n: u32) ->
            let r = default(iwide<'n>)
            limbs_shl(r.limbs, a.limbs, n)
            r

        // a >> n, arithmetic (sign-extending; n >= 'n yields 0 or -1).
        let shr = (a: iwide<'n>, n: u32) ->
            let r = default(iwide<'n>)
            limbs_sar(r.limbs, a.limbs, n)
            r

        // -1 if a<b, 0 if a==b, 1 if a>b (signed).
        let cmp = (a: iwide<'n>, b: iwide<'n>) ->
            limbs_cmp_signed(a.limbs, b.limbs)

        // True if a is zero. Equivalent to a == default(iwide<'n>), but
        // stops at the first non-zero limb.
        let is_zero = (a: iwide<'n>) ->
            limbs_is_zero(a.limbs)

        // Parse s as a signed decimal integer (optional leading '-').
        // returns: iwide<'n>! — err(parse.invalid) on empty / bad digit,
        //   err(parse.overflow) outside [-2^('n-1), 2^('n-1)-1].
        let parse = <'n>(s: const str) ->
            if s.len > 0i64 && s[0] == '-' then
                let mag = default(iwide<'n>)
                limbs_parse(mag.limbs, s[1..s.len], 10u32)?
                if limbs_sign(mag.limbs) == 1u32 && !limbs_is_min_mag(mag.limbs) then
                    err(iwide<'n>, wideint.parse.overflow)
                else
                    let r = default(iwide<'n>)
                    limbs_neg(r.limbs, mag.limbs)
                    ok(r)
            else
                let r = default(iwide<'n>)
                limbs_parse(r.limbs, s, 10u32)?
                if limbs_sign(r.limbs) == 1u32 then err(iwide<'n>, wideint.parse.overflow)
                else ok(r)

        // Parse s as raw two's-complement hexadecimal (no 0x prefix); the bit
        // pattern is taken as-is, so "ff…ff" is -1.
        let parse_hex = <'n>(s: const str) ->
            let r = default(iwide<'n>)
            limbs_parse(r.limbs, s, 16u32)?
            ok(r)

        // Heap-allocated decimal text of a, leading '-' if negative (free it).
        let to_str = (a: iwide<'n>) ->
            let scratch = u8['n * 5 / 16] { }
            if limbs_sign(a.limbs) == 1u32 then
                let mag = iwide.neg(a)
                let work = mag
                heap_copy_neg(limbs_format(scratch, work.limbs, 10u32))
            else
                let work = a
                heap_copy(limbs_format(scratch, work.limbs, 10u32))

        // Heap-allocated raw two's-complement hex text (caller must free).
        let to_hex = (a: iwide<'n>) ->
            let work = a
            let scratch = u8['n * 5 / 16] { }
            heap_copy(limbs_format(scratch, work.limbs, 16u32))
