namespace std::

// String parsing and manipulation over str (a u8[] of bytes, conventionally
// UTF-8): numeric parsing, searching (contains, starts_with, ends_with,
// index_of), trimming, ASCII case conversion, and split/join.
//
// parse_i32, parse_i64, parse_f32, and parse_f64 return results and are
// whole-string strict — every byte of the input must belong to the number,
// so leading whitespace or a trailing character fails rather than being
// silently skipped; trim first when the input may carry whitespace. Failures
// are fully named in `error parse` (text.parse.invalid, overflow, too_long),
// with nothing passed through raw: the platform has no code for "not a
// number", so every parse failure is FC's own judgement. Not finding a
// substring is absence rather than failure, so index_of stays i64?.
//
// Watch what each function gives back. trim, trim_left, and trim_right
// return a subslice of the input and allocate nothing. copy, to_upper,
// to_lower, and join return a heap-allocated string, and split returns a
// heap-allocated array whose elements are subslices of the input (the array
// is the caller's to free; the parts are views, not copies). Case conversion
// and the case helpers are ASCII-only — they leave every other byte alone,
// which keeps them safe on UTF-8 data but is not Unicode case folding.
module text =
    // Named parse failure conditions. Parse errors are FC-judged (the
    // platform has no code for "not a number"), so every failure is named —
    // this module passes nothing through raw.
    error parse =
        | invalid
        | overflow
        | too_long

    private module c from "stdlib.h" =
        extern strtoll: (const cstr, cstr*, i32) -> i64
        extern strtod: (const cstr, cstr*) -> f64
        extern strtof: (const cstr, cstr*) -> f32

    // strtoll/strtod report range errors through errno (ERANGE). The value
    // comes from <errno.h> at C-compile time.
    private module ec from "errno.h" =
        extern ERANGE as erange: i32

    // errno is a C macro, not a symbol, so reading (and clearing) it from FC
    // goes through the per-platform accessor function behind the macro.
#if os == "windows"
    private module er from "errno.h" =
        extern _errno as loc: () -> i32*
#else if os == "macos" || os == "freebsd"
    private module er from "errno.h" =
        extern __error as loc: () -> i32*
#else
    private module er from "errno.h" =
        extern __errno_location as loc: () -> i32*
#end

    // Numeric parsing converts s to a null-terminated cstr, which copies it
    // onto the stack (an alloca of s.len + 1). An unbounded length would risk a
    // stack overflow — undefined behavior, not a clean failure — so inputs
    // longer than this cap fail with parse.too_long. 512 bytes comfortably
    // holds any real numeric token (i64 is at most 20 digits; even
    // full-decimal f64 extremes fit), so only pathological/corrupt input is
    // ever rejected.
    private let max_parse_len = 512i64

    // Whole-string pre-check shared by the parse functions. Parsing is strict —
    // every byte of s must belong to the number — but the C parsers silently
    // skip leading whitespace and stop at an embedded NUL, so both must be
    // rejected before s reaches them (the endptr-at-the-terminator check after
    // the call catches every other stray character).
    private let strict_reject = (s: const str) ->
        if s.len == 0 then true
        else if s[0] == 32u8 || (s[0] >= 9u8 && s[0] <= 13u8) then true
        else
            let mut has_nul = false
            for i in 0..s.len do
                if s[i] == 0u8 then has_nul = true
            has_nul

    // Parses a string as a 32-bit signed integer (base 10). Strict: the whole
    // string must be one integer (an optional +/- sign, then digits) — leading
    // whitespace or trailing characters fail; trim first if the input may
    // carry whitespace.
    // returns: i32! — ok(value) on success; err(parse.invalid) if s is not
    //   entirely an integer, err(parse.overflow) if the value doesn't fit i32,
    //   err(parse.too_long) past max_parse_len.
    let parse_i32 = (s: const str) ->
        if s.len > max_parse_len then err(i32, parse.too_long)
        else if strict_reject(s) then err(i32, parse.invalid)
        else
            let cs = alloca((cstr) s)
            let mut endptr = default(cstr)
            let ep = er.loc()
            *ep = 0
            let val = c.strtoll(cs, &endptr, 10)
            if endptr == cs || *endptr != 0u8 then err(i32, parse.invalid)
            else if *ep == ec.erange then err(i32, parse.overflow)
            else if val > i32.max || val < i32.min then err(i32, parse.overflow)
            else ok((i32) val)

    // Parses a string as a 64-bit signed integer (base 10). Strict: the whole
    // string must be one integer (an optional +/- sign, then digits).
    // returns: i64! — ok(value) on success; err(parse.invalid) if s is not
    //   entirely an integer, err(parse.overflow) if the value doesn't fit i64,
    //   err(parse.too_long) past max_parse_len.
    let parse_i64 = (s: const str) ->
        if s.len > max_parse_len then err(i64, parse.too_long)
        else if strict_reject(s) then err(i64, parse.invalid)
        else
            let cs = alloca((cstr) s)
            let mut endptr = default(cstr)
            let ep = er.loc()
            *ep = 0
            let val = c.strtoll(cs, &endptr, 10)
            if endptr == cs || *endptr != 0u8 then err(i64, parse.invalid)
            else if *ep == ec.erange then err(i64, parse.overflow)
            else ok(val)

    // Parses a string as a 32-bit float. Strict: the whole string must be one
    // number in C's float grammar (optionally signed decimal or hex-float,
    // exponent allowed; "inf"/"nan" accepted) — leading whitespace or trailing
    // characters fail.
    // returns: f32! — ok(value) on success; err(parse.invalid) if s is not
    //   entirely a number, err(parse.overflow) if the magnitude exceeds f32
    //   (underflow to zero/denormal is NOT an error), err(parse.too_long)
    //   past max_parse_len.
    let parse_f32 = (s: const str) ->
        if s.len > max_parse_len then err(f32, parse.too_long)
        else if strict_reject(s) then err(f32, parse.invalid)
        else
            let cs = alloca((cstr) s)
            let mut endptr = default(cstr)
            let ep = er.loc()
            *ep = 0
            let val = c.strtof(cs, &endptr)
            if endptr == cs || *endptr != 0u8 then err(f32, parse.invalid)
            else if *ep == ec.erange && (val == f32.inf || val == f32.neg_inf) then
                err(f32, parse.overflow)
            else ok(val)

    // Parses a string as a 64-bit float. Strict: the whole string must be one
    // number in C's float grammar (optionally signed decimal or hex-float,
    // exponent allowed; "inf"/"nan" accepted) — leading whitespace or trailing
    // characters fail.
    // returns: f64! — ok(value) on success; err(parse.invalid) if s is not
    //   entirely a number, err(parse.overflow) if the magnitude exceeds f64
    //   (underflow to zero/denormal is NOT an error), err(parse.too_long)
    //   past max_parse_len.
    let parse_f64 = (s: const str) ->
        if s.len > max_parse_len then err(f64, parse.too_long)
        else if strict_reject(s) then err(f64, parse.invalid)
        else
            let cs = alloca((cstr) s)
            let mut endptr = default(cstr)
            let ep = er.loc()
            *ep = 0
            let val = c.strtod(cs, &endptr)
            if endptr == cs || *endptr != 0u8 then err(f64, parse.invalid)
            else if *ep == ec.erange && (val == f64.inf || val == f64.neg_inf) then
                err(f64, parse.overflow)
            else ok(val)

    // Returns a heap-allocated copy of a string. Caller must free.
    let copy = (s: const str) ->
        let buf = alloc(u8[s.len] {})!
        let mut i = 0i64
        loop
            if i >= s.len then break
            buf[i] = s[i]
            i = i + 1i64
        buf

    // True if haystack contains needle as a substring.
    let contains = (haystack: const str, needle: const str) ->
        if needle.len == 0i64 then true
        else if needle.len > haystack.len then false
        else
            let limit = haystack.len - needle.len + 1i64
            let mut i = 0i64
            let mut found = false
            loop
                if i >= limit then break
                if haystack[i..i + needle.len] == needle then found = true
                i = i + 1i64
            found

    // True if s begins with prefix.
    let starts_with = (s: const str, prefix: const str) ->
        if prefix.len > s.len then false
        else s[0i64..prefix.len] == prefix

    // True if s ends with suffix.
    let ends_with = (s: const str, suffix: const str) ->
        if suffix.len > s.len then false
        else s[s.len - suffix.len..s.len] == suffix

    // Returns the position of the first occurrence of needle in haystack.
    // returns: i64? — some(index) if found, none if not found.
    let index_of = (haystack: const str, needle: const str) ->
        if needle.len == 0i64 then some(0i64)
        else if needle.len > haystack.len then default(i64?)
        else
            let limit = haystack.len - needle.len + 1i64
            let mut i = 0i64
            loop
                if i >= limit then break
                if haystack[i..i + needle.len] == needle then return some(i)
                i = i + 1i64
            default(i64?)

    // Strips leading and trailing ASCII whitespace. Returns a subslice of s (no allocation).
    let trim = (s: const str) ->
        let mut start = 0i64
        loop
            if start >= s.len then break
            let b = s[start]
            if b != 32u8 && b != 9u8 && b != 10u8 && b != 13u8 then break
            start = start + 1i64
        let mut end = s.len
        loop
            if end <= start then break
            let b = s[end - 1i64]
            if b != 32u8 && b != 9u8 && b != 10u8 && b != 13u8 then break
            end = end - 1i64
        s[start..end]

    // Strips leading ASCII whitespace. Returns a subslice of s (no allocation).
    let trim_left = (s: const str) ->
        let mut start = 0i64
        loop
            if start >= s.len then break
            let b = s[start]
            if b != 32u8 && b != 9u8 && b != 10u8 && b != 13u8 then break
            start = start + 1i64
        s[start..s.len]

    // Strips trailing ASCII whitespace. Returns a subslice of s (no allocation).
    let trim_right = (s: const str) ->
        let mut end = s.len
        loop
            if end <= 0i64 then break
            let b = s[end - 1i64]
            if b != 32u8 && b != 9u8 && b != 10u8 && b != 13u8 then break
            end = end - 1i64
        s[0i64..end]

    // Converts an ASCII lowercase byte to uppercase.
    let to_upper_char = (b: u8) ->
        if b >= 97u8 && b <= 122u8 then b - 32u8
        else b

    // Converts an ASCII uppercase byte to lowercase.
    let to_lower_char = (b: u8) ->
        if b >= 65u8 && b <= 90u8 then b + 32u8
        else b

    // Returns a heap-allocated copy with ASCII lowercase converted to uppercase.
    // Caller must free the returned string.
    let to_upper = (s: const str) ->
        let result = alloc(u8[s.len] {})!
        let mut i = 0i64
        loop
            if i >= s.len then break
            result[i] = to_upper_char(s[i])
            i = i + 1i64
        result

    // Returns a heap-allocated copy with ASCII uppercase converted to lowercase.
    // Caller must free the returned string.
    let to_lower = (s: const str) ->
        let result = alloc(u8[s.len] {})!
        let mut i = 0i64
        loop
            if i >= s.len then break
            result[i] = to_lower_char(s[i])
            i = i + 1i64
        result

    // Splits a string by a delimiter. Returns a heap-allocated array of subslices of s.
    // Caller must free the returned array. The individual strings are views into s (not copies).
    let split = (s: const str, delim: const str) ->
        let mut count = 1i64
        if delim.len > 0i64 then
            let mut i = 0i64
            loop
                if i > s.len - delim.len then break
                if s[i..i + delim.len] == delim then
                    count = count + 1i64
                    i = i + delim.len
                else i = i + 1i64
        let parts = alloc(str[count] {})!
        let mut idx = 0i64
        let mut start = 0i64
        if delim.len == 0i64 then
            parts[0] = (str) s
        else
            let mut i = 0i64
            loop
                if i > s.len - delim.len then break
                if s[i..i + delim.len] == delim then
                    parts[idx] = (str) s[start..i]
                    idx = idx + 1i64
                    start = i + delim.len
                    i = start
                else i = i + 1i64
            parts[idx] = (str) s[start..s.len]
        parts

    // Joins an array of strings with a delimiter. Returns a heap-allocated string.
    // Caller must free the returned string.
    let join = (parts: const str[], delim: const str) ->
        let mut total = 0i64
        let mut pi = 0i64
        loop
            if pi >= parts.len then break
            if pi > 0i64 then total = total + delim.len
            total = total + parts[pi].len
            pi = pi + 1i64
        let result = alloc(u8[total] {})!
        let mut pos = 0i64
        let mut pi = 0i64
        loop
            if pi >= parts.len then break
            if pi > 0i64 then
                let mut j = 0i64
                loop
                    if j >= delim.len then break
                    result[pos] = delim[j]
                    pos = pos + 1i64
                    j = j + 1i64
            let part = parts[pi]
            let mut j = 0i64
            loop
                if j >= part.len then break
                result[pos] = part[j]
                pos = pos + 1i64
                j = j + 1i64
            pi = pi + 1i64
        result
